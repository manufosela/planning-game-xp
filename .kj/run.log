gEntries.get(devId) || { order: [], items: {} };\n      const order = Array.isArray(entry.order) ? entry.order : [];\n      const items = entry.items || {};\n      const orderedItems = [];\n      const seen = new Set();\n\n      for (const key of order) {\n        if (items[key]) {\n          orderedItems.push({ key, ...items[key] });\n          seen.add(key);\n        }\n      }\n\n      for (const [key, value] of Object.entries(items)) {\n        if (!seen.has(key)) {\n          orderedItems.push({ key, ...value });\n        }\n      }\n\n      const activeWip = wipEntries.get(devId);\n      const seenCardIds = new Set();\n      const filteredItems = orderedItems.filter(item => {\n        if (!item) return false;\n        if (activeWip && activeWip.taskId && (item.cardId === activeWip.taskId || item.cardKey?.endsWith(`|${activeWip.taskId}`))) {\n          return false;\n        }\n        const status = (item.status || '').toLowerCase();\n        if (status === 'in progress') return false;\n        // Dedupe by cardId to avoid showing duplicates with different cardKeys\n        const cardId = item.cardId || item.cardKey;\n        if (seenCardIds.has(cardId)) return false;\n        seenCardIds.add(cardId);\n        return true;\n      });\n\n      const list = filteredItems.length ? filteredItems.map((item, idx) => {\n        const cardType = item.cardType || '';\n        const section = cardType.includes('proposal') ? 'proposals' : (cardType.includes('bug') ? 'bugs' : 'tasks');\n        const cardLink = '#';\n        return `\n          <div class=\"backlog-row\" draggable=\"${canEditBacklog(devId)}\" data-dev=\"${devId}\" data-key=\"${item.cardKey}\">\n            <div class=\"drag-cell\" title=\"Arrastrar para reordenar\">☰</div>\n            <div class=\"cell cell-title\">${item.title || item.cardId || item.cardKey}</div>\n            <div class=\"cell\">${item.projectId || '-'}</div>\n            <div class=\"cell\">${(item.cardType || '').replace('-card', '')