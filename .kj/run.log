    box-shadow: var(--shadow-xl, 0 18px 36px rgba(15, 23, 42, 0.08));\n   154→    padding: 1.2rem;\n   155→    min-height: 400px;\n   156→  }\n   157→\n   158→  @media (max-width: 820px) {\n   159→    .sprintview-container { padding: 1rem; }\n   160→  }\n   161→</style>\n   162→\n   163→</div>\n   164→"}]},"parent_tool_use_id":null,"session_id":"090f70b5-7077-4308-b00f-8c0e9128924e","uuid":"c9da2898-50f2-4a9a-815c-3b403e6e97a2","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/sprintview.astro","content":"<div data-main>\n  <section class=\"sprintview-container\">\n    <h1>Sprint View</h1>\n    <div class=\"sprintview-controls\">\n      <label for=\"projectSelector\">Proyecto:</label>\n      <select id=\"projectSelector\">\n        <option value=\"\">Selecciona un proyecto</option>\n      </select>\n    </div>\n    <div id=\"ganttContainer\" class=\"gantt-wrapper\"></div>\n  </section>\n\n\n<script type=\"module\">\n  import { database, ref, get } from '/firebase-config.js';\n  import { isCurrentUserSuperAdmin, normalizeEmail as normalizeEmailSafe } from '/js/utils/super-admin-check.js';\n  import { URLStateManager } from '/js/utils/url-utils.js';\n  import '/js/wc/GanttChart.js';\n  import '/js/core/app-initializer.js';\n\n  const projectSelector = document.getElementById('projectSelector');\n  const ganttContainer = document.getElementById('ganttContainer');\n  let currentGanttChart = null;\n\n  async function loadUserProjects() {\n    const userEmail = document.body.dataset.userEmail || '';\n    const projectsSnapshot = await get(ref(database, '/projects'));\n    if (!projectsSnapshot.exists()) return [];\n\n    const allProjects = Object.keys(projectsSnapshot.val());\n    const isSuperAdmin = await isCurrentUserSuperAdmin(normalizeEmailSafe(userEmail));\n    if (isSuperAdmin) return allProjects;\n\n    const { encodeEmailForFirebase } = await import('/js/utils/email-sanitizer.js');\n    const encodedEmail = encodeEmailForFirebase(userEmail);\n    const userProjectsSnapshot = await get(ref(database, `/data/projectsByUser/${encodedEmail}`));\n\n    if (!userProjectsSnapshot.exists()) return [];\n\n    const userProjectsValue = userProjectsSnapshot.val();\n    if (userProjectsValue === 'All') return allProjects;\n\n    const userProjects = userProjectsValue.split(',').map(p => p.trim());\n    return allProjects.filter(p => userProjects.includes(p));\n  }\n\n  function renderGanttChart(projectId) {\n    ganttContainer.innerHTML = '';\n    currentGanttChart = null;\n\n    if (!projectId) return;\n\n    const ganttChart = document.createElement('gantt-chart');\n    ganttChart.project = projectId;\n    ganttChart.year = new Date().getFullYear();\n    ganttContainer.appendChild(ganttChart);\n    currentGanttChart = ganttChart;\n  }\n\n  function selectProject(projectId, updateUrl = true) {\n    projectSelector.value = projectId;\n    renderGanttChart(projectId);\n    if (updateUrl) {\n      URLStateManager.updateState({ projectId });\n    }\n  }\n\n  async function init() {\n    const projects = await loadUserProjects();\n\n    projects.sort((a, b) => a.localeCompare(b));\n    projects.forEach(projectId => {\n      const option = document.createElement('option');\n      option.value = projectId;\n      option.textContent = projectId;\n      projectSelector.appendChild(option);\n    });\n\n    projectSelector.addEventListener('change', () => {\n      selectProject(projectSelector.value);\n    });\n\n    URLStateManager.onPopState((state) => {\n      if (state.projectId) {\n        selectProject(state.projectId, false);\n      }\n    });\n\n    // Restore project from URL or select first available\n    const urlState = URLStateManager.getState();\n    if (urlState.projectId && projects.includes(urlState.projectId)) {\n      selectProject(urlState.projectId, false);\n    } else if (projects.length > 0) {\n      selectProject(projects[0], true);\n    }\n  }\n\n  // Wait for auth if needed\n  const userEmail = document.body.dataset.userEmail || '';\n  if (userEmail) {\n    init();\n  } else {\n    document.addEventListener('user-authenticated', () => init(), { once: true });\n  }\n</script>\n\n<style is:global>\n  body { background: var(--bg-secondary, #f5f7fb); }\n\n  .sprintview-container {\n    padding: 1.5rem 2rem;\n  }\n\n  .sprintview-container h1 {\n    margin: 0 0 1rem;\n    color: var(--text-primary, #111827);\n  }\n\n  .sprintview-controls {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    margin-bottom: 1.5rem;\n  }\n\n  .sprintview-controls label {\n    font-weight: 700;\n    color: var(--text-secondary, #374151);\n    font-size: 0.95rem;\n  }\n\n  .sprintview-controls select {\n    padding: 0.5rem 0.75rem;\n    border: 1px solid var(--border-default, #d1d5db);\n    border-radius: 8px;\n    background: var(--bg-primary, #fff);\n    color: var(--text-primary, #111827);\n    font-size: 0.95rem;\n    min-width: 200px;\n    cursor: pointer;\n  }\n\n  .sprintview-controls select:focus {\n    outline: none;\n    border-color: var(--primary-color, #3b82f6);\n    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);\n  }\n\n  .gantt-wrapper {\n    background: var(--bg-primary, white);\n    border-radius: 16px;\n    border: 1px solid var(--border-subtle, #e2e8f0);\n    box-shadow: var(--shadow-xl, 0 18px 36px rgba(15, 23, 42, 0.08));\n    padding: 1.2rem;\n    min-height: 400px;\n  }\n\n  @media (max-width: 820px) {\n    .sprintview-container { padding: 1rem; }\n  }\n</style>\n\n</div>\n","numLines":164,"startLine":1,"totalLines":164}}} (stream=stdout)
