iables globales para permisos\n   344→  let isResponsable = false;"}]},"parent_tool_use_id":null,"session_id":"559d5f17-efbc-4351-b1c9-b915eca702cc","uuid":"e9db1b84-6397-429e-9b32-e3c317a512aa","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/adminproject.astro","content":"</style>\n\n<script>\n  // CRÍTICO: Establecer projectId ANTES de cualquier otra cosa\n  // Este script es síncrono y se ejecuta inmediatamente\n  (function() {\n    const urlParams = new URLSearchParams(window.location.search);\n    const projectId = urlParams.get('projectId') || '';\n\n    // Establecer en todas las ubicaciones posibles\n    window.currentProjectId = projectId;\n    window.initialProjectId = projectId;\n    document.body.dataset.projectId = projectId;\n\n    // Add class to body for CSS-based hiding when no project\n    if (!projectId) {\n      document.body.classList.add('no-project-selected');\n    }\n  })();\n</script>\n\n<script>\n  // Show \"select project\" message when DOM is ready\n  document.addEventListener('astro:page-load', () => {\n    if (!window.currentProjectId) {\n      const noProjectMsg = document.getElementById('noProjectMessage');\n      if (noProjectMsg) {\n        noProjectMsg.style.display = 'flex';\n      }\n    }\n  });\n\n  // Navigate to selected project when changed from the selector\n  document.addEventListener('project-changed', (e) => {\n    const projectId = e.detail?.projectId;\n    if (projectId) {\n      const url = new URL(window.location);\n      url.searchParams.set('projectId', projectId);\n      if (window.appShellRouter?.navigate) {\n        window.appShellRouter.navigate(url.toString());\n      } else {\n        window.location.href = url.toString();\n      }\n    }\n  });\n</script>\n\n<script>\n  // Variables globales para permisos\n  let isResponsable = false;","numLines":50,"startLine":295,"totalLines":2594}}} (stream=stdout)
