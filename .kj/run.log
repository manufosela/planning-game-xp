rue;\n   864→    render();\n   865→    setStatus('Escaneando tareas...', 'info');\n   866→\n   867→    try {\n   868→      // Asegurar que el directorio esté inicializado\n   869→      await entityDirectoryService.waitForInit();\n   870→\n   871→      const projectsSnap = await get(ref(database, '/projects'));\n   872→      if (!projectsSnap.exists()) {\n   873→        setStatus('No hay proyectos.', 'error');\n   874→        scanning = false;\n   875→        render();\n   876→        return;\n   877→      }\n   878→\n   879→      const projects = Object.keys(projectsSnap.val() || {});\n   880→      const foundWip = new Map(); // devId -> entry\n   881→\n   882→      for (const projectId of projects) {\n   883→        const tasksPath = `/cards/${projectId}/TASKS_${projectId}`;\n   884→        const tasksSnap = await get(ref(database, tasksPath));\n   885→        if (!tasksSnap.exists()) {\n   886→          continue;\n   887→        }\n   888→\n   889→        const tasks = tasksSnap.val() || {};\n   890→        const statusCounts = {};\n   891→        for (const t of Object.values(tasks)) {\n   892→          const s = t.status || '(vacío)';\n   893→          statusCounts[s] = (statusCounts[s] || 0) + 1;\n   894→        }\n   895→\n   896→        for (const [taskKey, task] of Object.entries(tasks)) {\n   897→          const status = (task.status || '').toLowerCase();\n   898→          if (status === 'in progress') {\n   899→          }\n   900→          if (status !== 'in progress') continue;\n   901→\n   902→          const developerRaw = task.developer || '';\n   903→          if (!developerRaw) {\n   904→            continue;\n   905→          }\n   906→\n   907→          // Resolver developer a ID (puede venir como email, nombre o ya como ID)\n   908→          let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n   909→\n   910→          // Si no existe, crear una entrada nueva\n   911→          if (!devId) {\n   912→            devId = await entityDirectoryService.findOrCreateDeveloper(\n   913→              developerRaw.includes('@') ? developerRaw : '',\n   914→              developerRaw.includes('@') ? null : developerRaw\n   915→            );\n   916→          }\n   917→\n   918→          if (!devId) {\n   919→            continue;"}]},"parent_tool_use_id":null,"session_id":"2edfc113-b934-4d7c-a467-727bc44ab6eb","uuid":"629570ff-76af-4e38-a2e2-205a679d3379","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/wip.astro","content":"        userEmail,\n        expanded: true,\n        statusList,\n        developerList: developersList,\n        developers: developersList,\n        globalSprintList: projectSprintList,\n        isNew: true,\n        _skipClone: true\n      });\n\n      const { showExpandedCardInModal } = await import('/js/utils/common-functions.js');\n      showExpandedCardInModal(cardElement);\n    } catch (error) {\n      setStatus('Error creando tarea: ' + error.message, 'error');\n    }\n  }\n\n  async function loadCardData(section, projectId, cardId) {\n    const path = FirebaseService.getPathBySectionAndProjectId(section, projectId);\n    const cards = await FirebaseService.getCards(path);\n    if (!cards) return null;\n\n    if (cards[cardId]) {\n      return { ...cards[cardId], firebaseId: cardId, cardId: cards[cardId].cardId || cardId };\n    }\n\n    for (const [firebaseId, card] of Object.entries(cards)) {\n      if (!card) continue;\n      if (card.cardId === cardId || card.id === cardId) {\n        return { ...card, firebaseId, cardId: card.cardId || firebaseId };\n      }\n    }\n\n    return null;\n  }\n\n  async function loadStatusList(cardType) {\n    const cached = statusCache.get(cardType);\n    if (cached) return cached;\n\n    const raw = await FirebaseService.getStatusList(cardType);\n    const list = Array.isArray(raw) ? raw : Object.keys(raw || {});\n    if (!list.length) {\n      throw new Error(`Sin status list para ${cardType}`);\n    }\n    statusCache.set(cardType, list);\n    return list;\n  }\n\n  function handleBacklogDragStart(e) {\n    const item = e.currentTarget.closest('.backlog-item, .backlog-row') || e.currentTarget;\n    draggedItem = item;\n    item.classList.add('dragging');\n    e.dataTransfer.effectAllowed = 'move';\n  }\n\n  function handleBacklogDragEnd() {\n    if (draggedItem) {\n      draggedItem.classList.remove('dragging');\n      draggedItem = null;\n    }\n  }\n\n  function handleBacklogDragOver(e) {\n    e.preventDefault();\n    const list = e.currentTarget.closest('.backlog-items, .backlog-rows');\n    if (!list || !draggedItem) return;\n    if (list.dataset.dev !== draggedItem.dataset.dev) return;\n\n    const target = e.target.closest('.backlog-item, .backlog-row');\n    if (!target || target === draggedItem) return;\n\n    const bounding = target.getBoundingClientRect();\n    const offset = e.clientY - bounding.top;\n    const shouldInsertAfter = offset > bounding.height / 2;\n    if (shouldInsertAfter) {\n      target.insertAdjacentElement('afterend', draggedItem);\n    } else {\n      target.insertAdjacentElement('beforebegin', draggedItem);\n    }\n  }\n\n  async function handleBacklogDrop(e) {\n    e.preventDefault();\n    const list = e.currentTarget;\n    const devId = list.dataset.dev;\n    if (!draggedItem || list.dataset.dev !== draggedItem.dataset.dev) {\n      handleBacklogDragEnd();\n      return;\n    }\n\n    openState.set(devId, true);\n    const container = list.closest('details');\n    if (container) container.setAttribute('open', '');\n\n    const newOrder = Array.from(list.querySelectorAll('.backlog-item, .backlog-row')).map(item => item.dataset.key);\n    try {\n      await developerBacklogService.reorder(devId, newOrder);\n      setStatus('Backlog reordenado.', 'success');\n    } catch (error) {\n      setStatus('Error al reordenar: ' + error.message, 'error');\n    }\n\n    handleBacklogDragEnd();\n  }\n\n  async function handleAction(action, devKey, taskId, projectId) {\n    const taskPath = `/cards/${projectId}/TASKS_${projectId}/${taskId}`;\n    const snap = await get(ref(database, taskPath));\n    if (!snap.exists()) throw new Error('Tarea no encontrada');\n\n    const task = snap.val();\n    task.firebaseId = taskId; // taskId is the Firebase key\n    task.id = taskId;\n    task.projectId = projectId;\n    task.group = 'tasks';\n    task.cardType = 'task-card';\n\n    if (action === 'tovalidate') {\n      const missingFields = [];\n      if (!task.title || task.title.trim() === '') missingFields.push('Título');\n      if (!task.developer) missingFields.push('Developer');\n      if (!task.startDate) missingFields.push('Fecha inicio');\n\n      if (missingFields.length > 0) {\n        throw new Error(`Faltan campos obligatorios: ${missingFields.join(', ')}`);\n      }\n\n      task.status = 'To Validate';\n      task.endDate = generateTimestamp(new Date(), 'end');\n    } else if (action === 'unassign') {\n      task.status = 'To Do';\n      task.developer = '';\n      task.developerName = '';\n    }\n\n    const { FirebaseService } = await import('/js/services/firebase-service.js');\n    await FirebaseService.saveCard(task, { silent: true });\n  }\n\n  // Scan all tasks across all projects\n  async function scanAllTasks() {\n    if (scanning) return;\n    scanning = true;\n    render();\n    setStatus('Escaneando tareas...', 'info');\n\n    try {\n      // Asegurar que el directorio esté inicializado\n      await entityDirectoryService.waitForInit();\n\n      const projectsSnap = await get(ref(database, '/projects'));\n      if (!projectsSnap.exists()) {\n        setStatus('No hay proyectos.', 'error');\n        scanning = false;\n        render();\n        return;\n      }\n\n      const projects = Object.keys(projectsSnap.val() || {});\n      const foundWip = new Map(); // devId -> entry\n\n      for (const projectId of projects) {\n        const tasksPath = `/cards/${projectId}/TASKS_${projectId}`;\n        const tasksSnap = await get(ref(database, tasksPath));\n        if (!tasksSnap.exists()) {\n          continue;\n        }\n\n        const tasks = tasksSnap.val() || {};\n        const statusCounts = {};\n        for (const t of Object.values(tasks)) {\n          const s = t.status || '(vacío)';\n          statusCounts[s] = (statusCounts[s] || 0) + 1;\n        }\n\n        for (const [taskKey, task] of Object.entries(tasks)) {\n          const status = (task.status || '').toLowerCase();\n          if (status === 'in progress') {\n          }\n          if (status !== 'in progress') continue;\n\n          const developerRaw = task.developer || '';\n          if (!developerRaw) {\n            continue;\n          }\n\n          // Resolver developer a ID (puede venir como email, nombre o ya como ID)\n          let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n\n          // Si no existe, crear una entrada nueva\n          if (!devId) {\n            devId = await entityDirectoryService.findOrCreateDeveloper(\n              developerRaw.includes('@') ? developerRaw : '',\n              developerRaw.includes('@') ? null : developerRaw\n            );\n          }\n\n          if (!devId) {\n            continue;","numLines":200,"startLine":720,"totalLines":1769}}} (stream=stdout)
