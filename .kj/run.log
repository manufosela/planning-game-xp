ion kebab(s) { return s.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase(); }\n    41→          function apply(obj, prefix) {\n    42→            for (var k in obj) {\n    43→              if (!obj.hasOwnProperty(k)) continue;\n    44→              var name = prefix ? '--' + prefix + '-' + kebab(k) : '--' + kebab(k);\n    45→              var v = obj[k];\n    46→              if (typeof v === 'object' && v !== null) {\n    47→                apply(v, prefix ? prefix + '-' + kebab(k) : kebab(k));\n    48→              } else {\n    49→                root.style.setProperty(name, v);\n    50→              }\n    51→            }\n    52→          }\n    53→          apply(tokens, '');\n    54→          // Apply text-on-primary alias for header/footer\n    55→          if (tokens.text && tokens.text.onPrimary) {\n    56→            root.style.setProperty('--text-on-primary', tokens.text.onPrimary);\n    57→            root.style.setProperty('--footer-text', tokens.text.onPrimary);\n    58→          }\n    59→          // Apply dark/light mode from cache\n    60→          var theme = localStorage.getItem('pgxp-theme');\n    61→          if (theme === 'dark') {\n    62→            root.classList.add('dark-theme');\n    63→            // Apply critical dark tokens before ThemeManagerService loads\n    64→            var dt = {\n    65→              '--bg-primary':'#0f172a','--bg-secondary':'#1e293b','--bg-tertiary':'#334155',\n    66→              '--text-primary':'#f8fafc','--text-secondary':'#e2e8f0','--text-muted':'#94a3b8',\n    67→              '--border-default':'#475569','--border-subtle':'#334155',\n    68→              '--card-bg':'#1e293b','--input-bg':'#1e293b','--input-border':'#475569',\n    69→              '--header-bg':'#0f172a','--modal-bg':'#0f172a',\n    70→              '--dropdown-bg':'#1e293b','--dropdown-border':'#334155',\n    71→              '--table-header-bg':'#1e293b','--table-row-bg':'#0f172a'\n    72→            };\n    73→            for (var p in dt) root.style.setProperty(p, dt[p]);\n    74→          }\n    75→        } catch(e) {}\n    76→      })();\n    77→    </script>\n    78→    <!-- Import Maps for npm packages -->\n    79→    <script type=\"importmap\">\n    80→    {\n    81→      \"imports\": {\n    82→        \"lit\": \"https://cdn.jsdelivr.net/npm/lit@3.2.1/+esm\",\n    83→        \"lit/\": \"https://cdn.jsdelivr.net/npm/lit@3.2.1/\",\n    84→        \"lit-html\": \"https://cdn.jsdelivr.net/npm/lit-html@3.2.1/+esm\",\n    85→        \"lit-html/\": \"https://cdn.jsdelivr.net/npm/lit-html@3.2.1/\",\n    86→        \"@lit/reactive-element\": \"https://cdn.jsdelivr.net/npm/@lit/reactive-element@2.0.4/+esm\",\n    87→        \"@lit/reactive-element/\": \"https://cdn.jsdelivr.net/npm/@lit/reactive-element@2.0.4/\",\n    88→        \"@manufosela/slide-notification\": \"https://unpkg.com/@manufosela/slide-notification@2.1.0/src/slide-notification.js\",\n    89→        \"@manufosela/multi-select\": \"https://unpkg.com/@manufosela/multi-select@2.1.0/src/multi-select.js\",\n    90→        \"@manufosela/app-modal\": \"https://unpkg.com/@manufosela/app-modal@2.2.0/src/app-modal.js\"\n    91→      }\n    92→    }\n    93→    </script>\n    94→    <!-- Precargar módulos críticos para evitar retrasos en el renderizado -->\n    95→    <link rel=\"modulepreload\" href=\"https://cdn.jsdelivr.net/npm/lit@3.2.1/+esm\" />\n    96→    <link rel=\"modulepreload\" href=\"/firebase-config.js\" />\n    97→    <!-- System Capabilities Lit Components - UMD Bundle para SSG -->\n    98→    <script src=\"https://cdn.jsdelivr.net/npm/@system-capabilities/lit@1.1.1/dist/system-capabilities-lit.umd.min.js\"></script>\n    99→  </head>\n   100→  <body"}]},"parent_tool_use_id":null,"session_id":"090f70b5-7077-4308-b00f-8c0e9128924e","uuid":"6e455410-e5c3-45c6-a40e-829151bd02c1","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/layouts/Layout.astro","content":"---\nimport { ViewTransitions } from 'astro:transitions';\nimport MenuNav from '../components/MenuNav.astro';\nimport AppFooter from '../components/AppFooter.astro';\n\ninterface Props {\n  title: string;\n  shellRoute?: string;\n  shellPartial?: string;\n  shellRoutes?: Record<string, string | { partial?: string; partialUrl?: string; cache?: boolean }>;\n}\n\nconst { title, shellRoute = '', shellPartial = '', shellRoutes } = Astro.props;\nlet user = null;\n---\n\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"description\" content=\"XP Planning Game\" />\n    <meta name=\"viewport\" content=\"width=device-width\" />\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n    <title>{title}</title>\n    <ViewTransitions />\n    <link rel=\"manifest\" href=\"/manifest.json\">\n    <!-- Blocking: apply cached theme tokens before first paint to prevent FOUC -->\n    <script is:inline>\n      (function() {\n        try {\n          var raw = localStorage.getItem('pgxp-theme-config');\n          if (!raw) return;\n          var config = JSON.parse(raw);\n          var tokens = config && config.tokens;\n          if (!tokens) return;\n          var root = document.documentElement;\n          function kebab(s) { return s.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase(); }\n          function apply(obj, prefix) {\n            for (var k in obj) {\n              if (!obj.hasOwnProperty(k)) continue;\n              var name = prefix ? '--' + prefix + '-' + kebab(k) : '--' + kebab(k);\n              var v = obj[k];\n              if (typeof v === 'object' && v !== null) {\n                apply(v, prefix ? prefix + '-' + kebab(k) : kebab(k));\n              } else {\n                root.style.setProperty(name, v);\n              }\n            }\n          }\n          apply(tokens, '');\n          // Apply text-on-primary alias for header/footer\n          if (tokens.text && tokens.text.onPrimary) {\n            root.style.setProperty('--text-on-primary', tokens.text.onPrimary);\n            root.style.setProperty('--footer-text', tokens.text.onPrimary);\n          }\n          // Apply dark/light mode from cache\n          var theme = localStorage.getItem('pgxp-theme');\n          if (theme === 'dark') {\n            root.classList.add('dark-theme');\n            // Apply critical dark tokens before ThemeManagerService loads\n            var dt = {\n              '--bg-primary':'#0f172a','--bg-secondary':'#1e293b','--bg-tertiary':'#334155',\n              '--text-primary':'#f8fafc','--text-secondary':'#e2e8f0','--text-muted':'#94a3b8',\n              '--border-default':'#475569','--border-subtle':'#334155',\n              '--card-bg':'#1e293b','--input-bg':'#1e293b','--input-border':'#475569',\n              '--header-bg':'#0f172a','--modal-bg':'#0f172a',\n              '--dropdown-bg':'#1e293b','--dropdown-border':'#334155',\n              '--table-header-bg':'#1e293b','--table-row-bg':'#0f172a'\n            };\n            for (var p in dt) root.style.setProperty(p, dt[p]);\n          }\n        } catch(e) {}\n      })();\n    </script>\n    <!-- Import Maps for npm packages -->\n    <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"lit\": \"https://cdn.jsdelivr.net/npm/lit@3.2.1/+esm\",\n        \"lit/\": \"https://cdn.jsdelivr.net/npm/lit@3.2.1/\",\n        \"lit-html\": \"https://cdn.jsdelivr.net/npm/lit-html@3.2.1/+esm\",\n        \"lit-html/\": \"https://cdn.jsdelivr.net/npm/lit-html@3.2.1/\",\n        \"@lit/reactive-element\": \"https://cdn.jsdelivr.net/npm/@lit/reactive-element@2.0.4/+esm\",\n        \"@lit/reactive-element/\": \"https://cdn.jsdelivr.net/npm/@lit/reactive-element@2.0.4/\",\n        \"@manufosela/slide-notification\": \"https://unpkg.com/@manufosela/slide-notification@2.1.0/src/slide-notification.js\",\n        \"@manufosela/multi-select\": \"https://unpkg.com/@manufosela/multi-select@2.1.0/src/multi-select.js\",\n        \"@manufosela/app-modal\": \"https://unpkg.com/@manufosela/app-modal@2.2.0/src/app-modal.js\"\n      }\n    }\n    </script>\n    <!-- Precargar módulos críticos para evitar retrasos en el renderizado -->\n    <link rel=\"modulepreload\" href=\"https://cdn.jsdelivr.net/npm/lit@3.2.1/+esm\" />\n    <link rel=\"modulepreload\" href=\"/firebase-config.js\" />\n    <!-- System Capabilities Lit Components - UMD Bundle para SSG -->\n    <script src=\"https://cdn.jsdelivr.net/npm/@system-capabilities/lit@1.1.1/dist/system-capabilities-lit.umd.min.js\"></script>\n  </head>\n  <body","numLines":100,"startLine":1,"totalLines":1469}}} (stream=stdout)
