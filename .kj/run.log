T_SHELL_CONFIG.scriptMarker}]`).forEach(script => {\n   253→      script.remove();\n   254→    });\n   255→  }\n   256→\n   257→  _injectStylesheets(stylesheets) {\n   258→    document.querySelectorAll('[data-shell-style]').forEach(el => el.remove());\n   259→    for (const node of stylesheets) {\n   260→      const clone = node.cloneNode(true);\n   261→      clone.setAttribute('data-shell-style', '');\n   262→      document.head.append(clone);\n   263→    }\n   264→  }\n   265→\n   266→  _normalizePartialUrl(partialUrl) {\n   267→    if (partialUrl.endsWith('/')) return partialUrl;\n   268→    return `${partialUrl}/`;\n   269→  }\n   270→\n   271→  _getRouteConfigForPath(pathname) {\n   272→    if (this.routesMap.size) {\n   273→      const match = this.routesMap.get(normalizeRoutePath(pathname));\n   274→      return match ? { ...match } : null;\n   275→    }\n   276→    if (!this.partialUrl) return null;\n   277→    return { partialUrl: this.partialUrl, cache: true };\n   278→  }\n   279→\n   280→  async _onPopState() {\n   281→    if (!this.canHandle(window.location)) return;\n   282→    const routeConfig = this._getRouteConfigForPath(window.location.pathname);\n   283→    if (!routeConfig) return;\n   284→    await this.load(routeConfig.partialUrl, routeConfig.cache);\n   285→  }\n   286→}\n   287→\n   288→export function initAppShellRouterFromDataset() {\n   289→  const routesRaw = document.body.dataset.shellRoutes || '';\n   290→  let routes = null;\n   291→  if (routesRaw) {\n   292→    try {\n   293→      const parsed = JSON.parse(routesRaw);\n   294→      if (parsed && typeof parsed === 'object') {\n   295→        routes = parsed;\n   296→      }\n   297→    } catch (error) {\n   298→      console.warn('[AppShellRouter] Failed to parse shell routes dataset.', error);\n   299→    }\n   300→  }\n   301→\n   302→  if (routes) {\n   303→    const router = new AppShellRouter({ routes });\n   304→    router.init();\n   305→    return router;\n   306→  }\n   307→