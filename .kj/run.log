function showLoading(message = 'Sincronizando backlogs...') {\n   969→    if (!loadingLayer) {\n   970→      loadingLayer = document.createElement('loading-layer');\n   971→      loadingLayer.setAttribute('color', '#003b82');\n   972→      loadingLayer.setAttribute('size', '60');\n   973→    }\n   974→    loadingLayer.setAttribute('message', message);\n   975→    document.body.appendChild(loadingLayer);\n   976→  }\n   977→\n   978→  // Hide loading layer\n   979→  function hideLoading() {\n   980→    if (loadingLayer && loadingLayer.parentNode) {\n   981→      loadingLayer.parentNode.removeChild(loadingLayer);\n   982→    }\n   983→  }\n   984→\n   985→  // Sync backlogs from existing \"To Do\" tasks\n   986→  async function syncBacklogs() {\n   987→    if (scanning) return;\n   988→    scanning = true;\n   989→    showLoading('Sincronizando backlogs...');\n   990→    render();\n   991→\n   992→    try {\n   993→      await entityDirectoryService.waitForInit();\n   994→\n   995→      const projectsSnap = await get(ref(database, '/projects'));\n   996→      if (!projectsSnap.exists()) {\n   997→        setStatus('No hay proyectos.', 'error');\n   998→        scanning = false;\n   999→        render();\n  1000→        return;\n  1001→      }\n  1002→\n  1003→      const projects = Object.keys(projectsSnap.val() || {});\n  1004→      const backlogsByDev = new Map(); // devId -> { order: [], items: {} }\n  1005→      let taskCount = 0;\n  1006→\n  1007→      for (const projectId of projects) {\n  1008→        // Scan tasks\n  1009→        const tasksPath = `/cards/${projectId}/TASKS_${projectId}`;\n  1010→        const tasksSnap = await get(ref(database, tasksPath));\n  1011→\n  1012→        if (tasksSnap.exists()) {\n  1013→          const tasks = tasksSnap.val() || {};\n  1014→\n  1015→          for (const [taskKey, task] of Object.entries(tasks)) {\n  1016→            const status = (task.status || '').toLowerCase();\n  1017→            // Only \"To Do\" tasks go to