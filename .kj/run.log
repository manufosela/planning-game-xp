{\n        detail: {\n          options: {\n            title: 'Guía de Tasks',\n            message: `${taskGuideStyles}<div class=\"task-guide-content\">${html}</div>`,\n            button1Text: 'Cerrar',\n            button1css: 'background-color: var(--brand-primary, #6366f1); color: var(--text-on-primary, white);',\n            button1Action: () => {},\n            maxWidth: '800px',\n            maxHeight: '85vh',\n            showHeader: true\n          }\n        }\n      }));\n    } catch (error) {\n}\n  }\n\n  // Basic markdown to HTML converter\n  function markdownToHtml(md) {\n    return md\n      // Code blocks with language\n      .replace(/```(\\w+)?\\n([\\s\\S]*?)```/g, '<pre><code>$2</code></pre>')\n      // Inline code\n      .replace(/`([^`]+)`/g, '<code>$1</code>')\n      // Headers\n      .replace(/^### (.*$)/gm, '<h4>$1</h4>')\n      .replace(/^## (.*$)/gm, '<h3>$1</h3>')\n      .replace(/^# (.*$)/gm, '<h2>$1</h2>')\n      // Bold\n      .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n      // Italic\n      .replace(/\\*(.*?)\\*/g, '<em>$1</em>')\n      // Horizontal rule\n      .replace(/^---$/gm, '<hr>')\n      // Tables (basic)\n      .replace(/^\\|(.+)\\|$/gm, (match, content) => {\n        const cells = content.split('|').map(c => c.trim());\n        if (cells.every(c => /^[-:]+$/.test(c))) return '';\n        const tag = cells.some(c => c.includes('**')) ? 'th' : 'td';\n        return '<tr>' + cells.map(c => `<${tag}>${c.replace(/\\*\\*/g, '')}</${tag}>`).join('') + '</tr>';\n      })\n      // Unordered lists\n      .replace(/^- (.+)$/gm, '<li>$1</li>')\n      .replace(/(<li>.*<\\/li>\\n?)+/g, '<ul>$&</ul>')\n      // Ordered lists\n      .replace(/^\\d+\\. (.+)$/gm, '<li>$1</li>')\n      // Checkboxes\n      .replace(/\\[ \\]/g, '☐')\n      .replace(/\\[x\\]/g, '☑')\n      // Links\n      .replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, '<a href=\"$2\" target=\"_blank\">$1</a>')\n      // Paragraphs\n      .replace(/\\n\\n/g, '</p><p>')