t = email.split('@')[0] || email;\n   150→    return localPart.replace(/[._-]+/g, ' ').replace(/\\s+/g, ' ').trim()\n   151→      .split(' ').filter(Boolean)\n   152→      .map(part => part.charAt(0).toUpperCase() + part.slice(1))\n   153→      .join(' ');\n   154→  }\n   155→\n   156→  function isExcludedDeveloper(devId, devName) {\n   157→    if (!devId && !devName) return true;\n   158→    const idLower = (devId || '').toLowerCase().trim();\n   159→    const nameLower = (devName || '').toLowerCase().trim();\n   160→    return excludedDevNames.some(excluded =>\n   161→      idLower.includes(excluded) || nameLower.includes(excluded)\n   162→    );\n   163→  }\n   164→\n   165→  function canEditRow(devId) {\n   166→    if (!currentUserEmail) return false;\n   167→    if (isSuperAdmin) return true;\n   168→    if (!devId) return false;\n   169→    // Comparar por ID o por email\n   170→    if (currentUserId && devId === currentUserId) return true;\n   171→    const devInfo = developerDirectory.get(devId);\n   172→    return devInfo && normalizeEmailSafe(devInfo.email) === currentUserEmail;\n   173→  }\n   174→\n   175→  const canEditBacklog = (devId) => canEditRow(devId);\n   176→\n   177→  // Render\n   178→  function renderWip() {\n   179→    const rows = [];\n   180→    const processedIds = new Set();\n   181→\n   182→    // Primero, iterar sobre todos los developers del directorio\n   183→    for (const [devId, devInfo] of developerDirectory.entries()) {\n   184→      if (!devInfo.active) continue; // Solo mostrar activos\n   185→      if (isExcludedDeveloper(devId, devInfo.name)) continue; // Excluir tests/bots\n   186→      processedIds.add(devId);\n   187→      const wipEntry = wipEntries.get(devId);\n   188→      const isActive = wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle';\n   189→\n   190→      rows.push({\n   191→        key: devId,\n   192→        developerName: wipEntry?.developerName || devInfo.name || formatNameFromEmail(devInfo.email) || devId,\n   193→        developerEmail: devInfo.email || '',\n   194→        projectId: isActive ? wipEntry.projectId : '-',\n   195→        taskId: isActive ? wipEntry.taskId : '',\n   196→        taskLabel: isActive ? (wipEntry.taskTitle || wipEntry.taskId) : 'Sin tarea',\n   197→        startedAt: isActive ? wipEntry.startedAt : null,\n   198→        duration: isActive ? getWorkdaysDuration(wipEntry.startedAt) : '-',\n   199→        statusLabel: isActive ? 'En progreso' : 'Disponible',\n   200→        isActive\n   201→      });\n   202→    }\n   203→\n   204→    // Luego, añadir developers que están en /wip pero no en el directorio\n   205→    for (const [devId, wipEntry] of wipEntries.entries()) {\n   206→      if (processedIds.has(devId)) continue;\n   207→      const devName = wipEntry.developerName || formatNameFromEmail(wipEntry.developer) || devId;\n   208→      if (isExcludedDeveloper(devId, devName)) continue; // Excluir tests/bots\n   209→      const isActive = wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle';\n   210→      if (!isActive) continue; // Solo mostrar si tienen tarea activa\n   211→\n   212→      rows.push({\n   213→        key: devId,\n   214→        developerName: wipEntry.developerName || formatNameFromEmail(wipEntry.developer) || devId,\n   215→        developerEmail: wipEntry.developer || '',\n   216→        projectId: wipEntry.projectId || '-',\n   217→        taskId: wipEntry.taskId || '',\n   218→        taskLabel: wipEntry.taskTitle || wipEntry.taskId || 'Tarea',\n   219→        startedAt: wipEntry.startedAt || null,\n   220→        duration: getWorkdaysDuration(wipEntry.startedAt),\n   221→        statusLabel: 'En progreso',\n   222→        isActive: true\n   223→      });\n   224→    }\n   225→"}]},"parent_tool_use_id":null,"session_id":"8322c8f3-f005-48c6-b817-6d3207902d26","uuid":"4a95b60a-fd9c-4072-b012-5ab541d20d27","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/wip.astro","content":"<script type=\"module\">\n  import { database, ref, onValue, get, set } from '/firebase-config.js';\n  import { isCurrentUserSuperAdmin, normalizeEmail as normalizeEmailSafe } from '/js/utils/super-admin-check.js';\n  import { getWorkdaysDuration } from '/js/utils/workday-utils.js';\n  import { entityDirectoryService } from '/js/services/entity-directory-service.js';\n  import { developerBacklogService } from '/js/services/developer-backlog-service.js';\n  import { FirebaseService } from '/js/services/firebase-service.js';\n  import { CardRealtimeService } from '/js/services/card-realtime-service.js';\n  import { URLStateManager } from '/js/utils/url-utils.js';\n  import { generateTimestamp } from '/js/utils/timestamp-utils.js';\n  import '/js/core/app-initializer.js';\n  import 'https://cdn.jsdelivr.net/npm/@manufosela/loading-layer@2.0.1/+esm';\n\n  // DOM elements\n  const wipContent = document.getElementById('wipContent');\n  const backlogContent = document.getElementById('backlogContent');\n  const tabButtons = Array.from(document.querySelectorAll('.tab-button'));\n  const tabWip = document.getElementById('tab-wip');\n  const tabBacklog = document.getElementById('tab-backlog');\n  let loadingLayer = null;\n\n  // State\n  let developerDirectory = new Map(); // devId (dev_XXX) -> { id, email, name, active }\n  let wipEntries = new Map();         // devId -> { taskId, taskTitle, projectId, startedAt, developer, developerName }\n  let backlogEntries = new Map();     // devId -> { order: [], items: {} }\n  let currentUserEmail = '';\n  let currentUserId = '';\n  let isSuperAdmin = false;\n  let scanning = false;\n  let activeTab = 'wip';\n  let activeBacklogDev = null;\n  let hasTriedToSelectCurrentUser = false; // Track if we've tried to auto-select current user\n  let draggedItem = null;\n  const openState = new Map();\n  const userEmail = document.body.dataset.userEmail || '';\n  let modalDevContext = '';\n  const statusCache = new Map();\n\n  // Developers to exclude from WIP and Backlog views (tests, placeholders, bots)\n  const excludedDevNames = [\n    'tests',\n    'no developer assigned',\n    'becaria',\n    'test',\n    'bot'\n  ];\n  let isRemovingFromBacklog = false; // Flag to prevent render during remove operation\n\n  const normalizeSortKey = (value) => (value || '').toString().trim().toLowerCase();\n\n  function sortDevelopersForBacklog(entries) {\n    return entries.sort((a, b) => {\n      if (a.id === currentUserId) return -1;\n      if (b.id === currentUserId) return 1;\n      const labelA = normalizeSortKey(a.info?.name || a.info?.email || a.id);\n      const labelB = normalizeSortKey(b.info?.name || b.info?.email || b.id);\n      return labelA.localeCompare(labelB);\n    });\n  }\n\n  // Helpers\n  function setStatus(message, type = 'info') {\n    if (!message) return;\n    // Use toast notifications instead of inline status\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message, type: type === 'ok' ? 'success' : type } }\n    }));\n  }\n\n  function updateTabs(tab, updateUrl = true) {\n    if (tab) activeTab = tab;\n    tabButtons.forEach(btn => {\n      btn.classList.toggle('active', btn.dataset.tab === activeTab);\n    });\n    if (activeTab === 'backlog') {\n      tabBacklog.classList.remove('hidden');\n      tabWip.classList.add('hidden');\n      // No auto-sync - user can click \"Sincronizar Backlogs\" button manually\n    } else {\n      tabBacklog.classList.add('hidden');\n      tabWip.classList.remove('hidden');\n    }\n\n    // Update URL with tab state (use pushState for navigation history)\n    if (updateUrl) {\n      const urlUpdates = { tab: activeTab };\n      // Clear developer from URL when switching away from backlog tab\n      if (activeTab !== 'backlog') {\n        urlUpdates.developer = null;\n      }\n      URLStateManager.updateState(urlUpdates);\n    }\n  }\n\n  // Restore tab and developer from URL on page load\n  function restoreTabFromUrl() {\n    const urlState = URLStateManager.getState();\n    if (urlState.tab && (urlState.tab === 'wip' || urlState.tab === 'backlog')) {\n      updateTabs(urlState.tab, false); // Don't update URL again\n    }\n    if (urlState.developer) {\n      activeBacklogDev = urlState.developer;\n    }\n  }\n\n  // Listen for browser back/forward navigation\n  URLStateManager.onPopState((state) => {\n    if (state.tab && (state.tab === 'wip' || state.tab === 'backlog')) {\n      updateTabs(state.tab, false);\n    }\n    if (state.tab === 'backlog' && state.developer) {\n      activeBacklogDev = state.developer;\n      renderBacklog();\n    }\n  });\n\n  function formatTime(iso) {\n    if (!iso) return '-';\n    return new Date(iso).toLocaleString([], { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });\n  }\n\n  function formatNameFromEmail(email) {\n    if (!email || typeof email !== 'string') return '';\n    const localPart = email.split('@')[0] || email;\n    return localPart.replace(/[._-]+/g, ' ').replace(/\\s+/g, ' ').trim()\n      .split(' ').filter(Boolean)\n      .map(part => part.charAt(0).toUpperCase() + part.slice(1))\n      .join(' ');\n  }\n\n  function isExcludedDeveloper(devId, devName) {\n    if (!devId && !devName) return true;\n    const idLower = (devId || '').toLowerCase().trim();\n    const nameLower = (devName || '').toLowerCase().trim();\n    return excludedDevNames.some(excluded =>\n      idLower.includes(excluded) || nameLower.includes(excluded)\n    );\n  }\n\n  function canEditRow(devId) {\n    if (!currentUserEmail) return false;\n    if (isSuperAdmin) return true;\n    if (!devId) return false;\n    // Comparar por ID o por email\n    if (currentUserId && devId === currentUserId) return true;\n    const devInfo = developerDirectory.get(devId);\n    return devInfo && normalizeEmailSafe(devInfo.email) === currentUserEmail;\n  }\n\n  const canEditBacklog = (devId) => canEditRow(devId);\n\n  // Render\n  function renderWip() {\n    const rows = [];\n    const processedIds = new Set();\n\n    // Primero, iterar sobre todos los developers del directorio\n    for (const [devId, devInfo] of developerDirectory.entries()) {\n      if (!devInfo.active) continue; // Solo mostrar activos\n      if (isExcludedDeveloper(devId, devInfo.name)) continue; // Excluir tests/bots\n      processedIds.add(devId);\n      const wipEntry = wipEntries.get(devId);\n      const isActive = wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle';\n\n      rows.push({\n        key: devId,\n        developerName: wipEntry?.developerName || devInfo.name || formatNameFromEmail(devInfo.email) || devId,\n        developerEmail: devInfo.email || '',\n        projectId: isActive ? wipEntry.projectId : '-',\n        taskId: isActive ? wipEntry.taskId : '',\n        taskLabel: isActive ? (wipEntry.taskTitle || wipEntry.taskId) : 'Sin tarea',\n        startedAt: isActive ? wipEntry.startedAt : null,\n        duration: isActive ? getWorkdaysDuration(wipEntry.startedAt) : '-',\n        statusLabel: isActive ? 'En progreso' : 'Disponible',\n        isActive\n      });\n    }\n\n    // Luego, añadir developers que están en /wip pero no en el directorio\n    for (const [devId, wipEntry] of wipEntries.entries()) {\n      if (processedIds.has(devId)) continue;\n      const devName = wipEntry.developerName || formatNameFromEmail(wipEntry.developer) || devId;\n      if (isExcludedDeveloper(devId, devName)) continue; // Excluir tests/bots\n      const isActive = wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle';\n      if (!isActive) continue; // Solo mostrar si tienen tarea activa\n\n      rows.push({\n        key: devId,\n        developerName: wipEntry.developerName || formatNameFromEmail(wipEntry.developer) || devId,\n        developerEmail: wipEntry.developer || '',\n        projectId: wipEntry.projectId || '-',\n        taskId: wipEntry.taskId || '',\n        taskLabel: wipEntry.taskTitle || wipEntry.taskId || 'Tarea',\n        startedAt: wipEntry.startedAt || null,\n        duration: getWorkdaysDuration(wipEntry.startedAt),\n        statusLabel: 'En progreso',\n        isActive: true\n      });\n    }\n","numLines":200,"startLine":26,"totalLines":1769}}} (stream=stdout)
