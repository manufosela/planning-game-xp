\">\n      <button class=\"dev-tab active\" data-tab=\"summary\">Resumen global</button>\n      <button class=\"dev-tab\" data-tab=\"projects\">Por proyecto</button>\n    </div>\n\n    <div id=\"devTabSummary\" class=\"dev-tab-content active\">\n      <div id=\"devSummaryCards\" class=\"summary-cards\"></div>\n      <div id=\"devDeveloperTableContainer\" class=\"developer-table-container\"></div>\n    </div>\n\n    <div id=\"devTabProjects\" class=\"dev-tab-content\">\n      <div id=\"devProjectBreakdown\" class=\"project-breakdown\"></div>\n    </div>\n  </section>\n\n\n<script type=\"module\">\n  import { database, ref, get, auth, superAdminEmail as envSuperAdminEmail } from '/firebase-config.js';\n  import { encodeEmailForFirebase } from '/js/utils/email-sanitizer.js';\n  import { normalizeDeveloperEntry, getDeveloperKey } from '/js/utils/developer-normalizer.js';\nconst normalizeEmail = (email) => (email || '').toString().trim().toLowerCase();\n  const legacyEncodeEmail = (email) => normalizeEmail(email).replace(/[@.#$\\[\\]\\/]/g, '_');\n\n  class DevelopmentAnalytics {\n    constructor() {\n      this.projects = [];\n      this.datasets = [];\n      this.metrics = null;\n      this.selectedScope = 'all';\n      this.selectedYear = new Date().getFullYear().toString();\n      this.developerMap = new Map(); // Map of developer ID/email to name\n      this.sprintYearMap = new Map(); // Map of sprint ID to year\n\n      this.elements = {\n        loading: document.getElementById('devLoadingState'),\n        contentSection: document.getElementById('devContentSection'),\n        summaryCards: document.getElementById('devSummaryCards'),\n        tableContainer: document.getElementById('devDeveloperTableContainer'),\n        projectBreakdown: document.getElementById('devProjectBreakdown'),\n        scopeSelect: document.getElementById('devScopeSelect'),\n        yearSelect: document.getElementById('devYearSelect'),\n        reloadButton: document.getElementById('devReloadButton'),\n        projectCount: document.getElementById('devProjectCount'),\n        tabSummary: document.getElementById('devTabSummary'),\n        tabProjects: document.getElementById('devTabProjects')\n      };\n\n      this.activeTab = 'summary';\n\n      this.init();\n    }\n\n    async init() {\n      if (!this.elements.loading || !this.elements.contentSection) {\n        return;\n      }\n      try {\n        this.setLoading('Autenticando usuario...');\n        const currentUser = await this.waitForAuth();\n        if (!currentUser) {\n          this.setError('Inicia sesión para ver las métricas de desarrollo.');\n          return;\n        }\n\n        this.setLoading('Cargando proyectos disponibles...');\n        this.projects = await this.loadAccessibleProjects(currentUser);\n        if (!this.projects.length) {\n          this.setError('No tienes proyectos asignados. Solicita acceso a un administrador.');\n          return;\n        }\n        this.populateProjectSelect();\n        this.populateYearSelect();\n        await Promise.all([\n          this.loadDeveloperMappings(),\n          this.loadSprintMappings()\n        ]);\n        this.elements.projectCount.textContent = `${this.projects.length} proyecto${this.projects.length === 1 ? '' : 's'}`;\n\n        await this.loadMetrics();\n        this.bindEvents();\n        // render() is now called inside loadMetrics()\n      } catch (error) {\nthis.setError('No se pudo cargar la vista de desarrollo.');\n      }\n    }\n\n    async waitForAuth() {\n      if (auth.currentUser) {\n        return auth.currentUser;\n      }\n\n      return new Promise((resolve) => {\n        const unsubscribe = auth.onAuthStateChanged((user) => {\n          unsubscribe();\n          resolve(user);\n        });\n        setTimeout(() => {\n          unsubscribe();\n          resolve(null);\n        }, 10000);\n      });\n    }\n\n    async loadAccessibleProjects(user) {\n      try {\n        const projectsRef = ref(database, '/projects');\n        const projectsSnap = await get(projectsRef);\n        if (!projectsSnap.exists()) {\n          return [];\n        }\n\n        const allProjects = Object.entries(projectsSnap.val() || {}).map(([id, project]) => ({\n          id,\n          name: project.name || id\n        }));\n\n        // SuperAdmin always sees all projects\n        const isSuperAdmin = envSuperAdminEmail && user.email.toLowerCase() === envSuperAdminEmail.toLowerCase();\n        if (isSuperAdmin) {\n          return allProjects;\n        }\n\n        const userKey = encodeEmailForFirebase(user.email);\n        const userProjectsRef = ref(database, `/data/projectsByUser/${userKey}`);\n        const userProjectsSnap = await get(userProjectsRef);\n        const userProjectData = userProjectsSnap.val();\n\n        if (userProjectData === 'All') {\n          return allProjects;\n        }\n\n        if (typeof userProjectData === 'string') {\n          const allowed = userProjectData.split(',').map((p) => p.trim()).filter(Boolean);\n          return allProjects.filter((project) => allowed.includes(project.id) || allowed.includes(project.name));\n        }\n\n        return [];\n      } catch (error) {\nreturn [];\n      }\n    }\n\n    bindEvents() {\n      if (this.elements.scopeSelect) {\n        this.elements.scopeSelect.addEventListener('change', (event) => {\n          this.selectedScope = event.target.value || 'all';\n          this.render();\n        });\n      }\n\n      if (this.elements.yearSelect) {\n        this.elements.yearSelect.addEventListener('change', (event) => {\n          this.selectedYear = event.target.value || 'all';\n          this.loadMetrics(true);\n        });\n      }\n\n      if (this.elements.reloadButton) {\n        this.elements.reloadButton.addEventListener('click', () => {\n          this.loadMetrics(true);\n        });\n      }\n\n      // Tab switching\n      document.querySelectorAll('.dev-tab').forEach(tab => {\n        tab.addEventListener('click', (event) => {\n          const tabName = event.target.dataset.tab;\n          this.switchTab(tabName);\n        });\n      });\n    }\n\n    switchTab(tabName) {\n      this.activeTab = tabName;\n\n      // Update tab buttons\n      document.querySelectorAll('.dev-tab').forEach(tab => {\n        tab.classList.toggle('active', tab.dataset.tab === tabName);\n      });\n\n      // Update tab content\n      if (this.elements.tabSummary) {\n        this.elements.tabSummary.classList.toggle('active', tabName === 'summary');\n      }\n      if (this.elements.tabProjects) {\n        this.elements.tabProjects.classList.toggle('active', tabName === 'projects');\n      }\n    }\n\n    populateProjectSelect() {\n      const select = this.elements.scopeSelect;\n      if (!select) return;\n\n      select.innerHTML = '';\n      const optionAll = document.createElement('option');\n      optionAll.value = 'all';\n      optionAll.textContent = 'Todos mis proyectos';\n      select.appendChild(optionAll);\n\n      this.projects.forEach((project) => {\n        const option = document.createElement('option');\n        option.value = project.id;\n        option.textContent = project.name || project.id;\n        select.appendChild(option);\n      });\n\n      select.disabled = false;\n      this.elements.reloadButton.disabled = false;\n    }\n\n    populateYearSelect() {\n      const select = this.elements.yearSelect;\n      if (!select) return;\n\n      select.innerHTML = '';\n\n      // Add \"All years\" option\n      const optionAll = document.createElement('option');\n      optionAll.value = 'all';\n      optionAll.textContent = 'Todos los años';\n      select.appendChild(optionAll);\n\n      // Add years from current year back to 2020\n      const currentYear = new Date().getFullYear();\n      for (let year = currentYear; year >= 2020; year--) {\n        const option = document.createElement('option');\n        option.value = year.toString();\n        option.textContent = year.toString();\n        select.appendChild(option);\n      }\n\n      // Set the value directly to ensure it's selected\n      select.value = this.selectedYear;\n      select.disabled = false;\n    }\n\n    async loadDeveloperMappings() {\n      // Load developer info from global entities and projects\n      try {\n        // First, load from global developers (/data/developers) - source of truth\n        const entitiesSnap = await get(ref(database, '/data/developers'));\n        if (entitiesSnap.exists()) {\n          const entities = entitiesSnap.val() || {};\n          Object.entries(entities).forEach(([id, dev]) => {\n            if (!dev) return;\n            const name = dev.name || '';\n            const email = (dev.email || '').toLowerCase();\n\n            // Map dev_XXX ID to name\n            if (id && name) {\n              this.developerMap.set(id.toLowerCase(), name);\n            }\n            // Map email to name\n            if (email && name) {\n              this.developerMap.set(email, name);\n            }\n          });\n        }\n\n        // Then, load from each project's developers list\n        for (const project of this.projects) {\n          const projectSnap = await get(ref(database, `/projects/${project.id}`));\n          if (projectSnap.exists()) {\n            const projectData = projectSnap.val() || {};\n            const developers = projectData.developers || [];\n\n            // Process each developer entry\n            (Array.isArray(developers) ? developers : Object.values(developers)).forEach(dev => {\n              if (!dev) return;\n\n              const id = dev.id || dev.name || '';\n              const name = dev.name || '';\n              const email = (dev.email || '').toLowerCase();\n\n              // Map ID to name (don't overwrite if already exists from entities)\n              if (id && name && !this.developerMap.has(id.toLowerCase())) {\n                this.developerMap.set(id.toLowerCase(), name);\n              }\n              // Map email to name\n              if (email && name && !this.developerMap.has(email)) {\n                this.developerMap.set(email, name);\n              }\n            });\n          }\n        }\n      } catch (error) {\n        // Silently ignore errors loading developer mappings\n      }\n    }\n\n    async loadSprintMappings() {\n      // Load sprint data to get year field for each sprint\n      try {\n        for (const project of this.projects) {\n          const sprintsSnap = await get(ref(database, `/cards/${project.id}/SPRINTS_${project.id}`));\n          if (sprintsSnap.exists()) {\n            const sprints = sprintsSnap.val() || {};\n            Object.entries(sprints).forEach(([sprintId, sprint]) => {\n              if (!sprint) return;\n\n              // Use sprint's year field directly\n              let sprintYear = sprint.year ? parseInt(sprint.year, 10) : null;\n\n              // Fallback to startDate if no year field\n              if (!sprintYear && sprint.startDate) {\n                sprintYear = new Date(sprint.startDate).getFullYear();\n              }\n\n              if (sprintYear) {\n                // Map by multiple keys for flexible lookup\n                const keysToMap = [\n                  sprintId,\n                  sprint.cardId,\n                  sprint.title,\n                  sprint.name,\n                  // Also map lowercase versions\n                  sprintId?.toLowerCase?.(),\n                  sprint.cardId?.toLowerCase?.(),\n                  sprint.title?.toLowerCase?.(),\n                  sprint.name?.toLowerCase?.()\n                ].filter(Boolean);\n\n                keysToMap.forEach(key => {\n                  this.sprintYearMap.set(key, sprintYear);\n                });\n              }\n            });\n          }\n        }\n      } catch (error) {\n        // Silently ignore errors loading sprint mappings\n      }\n    }\n\n    async loadMetrics(force = false) {\n      try {\n        if (!force && this.datasets.length) {\n          this.metrics = this.buildMetrics(this.datasets);\n          this.setReady();\n          this.render();\n          return;\n        }\n\n        this.setLoading('Calculando métricas de tareas y bugs...');\n        this.datasets = await Promise.all(this.projects.map((project) => this.fetchProjectDataset(project)));\n        this.metrics = this.buildMetrics(this.datasets);\n        this.setReady();\n        this.render();\n      } catch (error) {\nthis.setError('Error calculando métricas de desarrollo.');\n      }\n    }\n\n    async fetchProjectDataset(project) {\n      try {\n        const [tasksSnap, bugsSnap] = await Promise.all([\n          get(ref(database, `/cards/${project.id}/TASKS_${project.id}`)),\n          get(ref(database, `/cards/${project.id}/BUGS_${project.id}`))\n        ]);\n\n        let tasks = tasksSnap.exists() ? Object.values(tasksSnap.val() || {}) : [];\n        let bugs = bugsSnap.exists() ? Object.values(bugsSnap.val() || {}) : [];\n\n        // Filter by year if a specific year is selected\n        if (this.selectedYear && this.selectedYear !== 'all') {\n          tasks = tasks.filter(task => this.isFromYear(task, this.selectedYear));\n          bugs = bugs.filter(bug => this.isFromYear(bug, this.selectedYear));\n        }\n\n        return {\n          project,\n          tasks,\n          bugs\n        };\n      } catch (error) {\nreturn {\n          project,\n          tasks: [],\n          bugs: []\n        };\n      }\n    }\n\n    isFromYear(card, year) {\n      const yearInt = parseInt(year, 10);\n      const currentYear = new Date().getFullYear();\n\n      // Primary: use task's year field directly\n      if (card.year !== undefined && card.year !== null && card.year !== '') {\n        return parseInt(card.year, 10) === yearInt;\n      }\n\n      // Secondary: use sprint's year field\n      if (card.sprint) {\n        let sprintYear = this.sprintYearMap.get(card.sprint);\n        if (!sprintYear && typeof card.sprint === 'string') {\n          sprintYear = this.sprintYearMap.get(card.sprint.toLowerCase());\n        }\n        if (sprintYear) {\n          return sprintYear === yearInt;\n        }\n      }\n\n      // No year field and no sprint: show in current year\n      return yearInt === currentYear;\n    }\n\n    buildMetrics(datasets) {\n      const globalMap = new Map();\n      const projectsMap = new Map();\n\n      datasets.forEach(({ project, tasks, bugs }) => {\n        const projectMap = new Map();\n\n        tasks.forEach((task) => {\n          const normalized = this.normalizeDeveloper(task.developer);\n          if (!normalized) return;\n\n          const projectStats = this.getOrCreateStats(projectMap, normalized, project);\n          const globalStats = this.getOrCreateStats(globalMap, normalized, project);\n\n          this.processTask(projectStats, task);\n          this.processTask(globalStats, task);\n        });\n\n        bugs.forEach((bug) => {\n          const normalized = this.normalizeDeveloper(bug.developer || bug.assignee);\n          if (!normalized) return;\n\n          const projectStats = this.getOrCreateStats(projectMap, normalized, project);\n          const globalStats = this.getOrCreateStats(globalMap, normalized, project);\n\n          this.processBug(projectStats, bug);\n          this.processBug(globalStats, bug);\n        });\n\n        projectsMap.set(project.id, this.generateMetricsPayload(projectMap, project));\n      });\n\n      return {\n        global: this.generateMetricsPayload(globalMap),\n        projects: projectsMap\n      };\n    }\n\n    normalizeDeveloper(rawDeveloper) {\n      const normalized = normalizeDeveloperEntry(rawDeveloper || '');\n      const needsFallbackUnassigned = !normalized.isUnassigned && !normalized.name && !normalized.email;\n      const isUnassigned = normalized.isUnassigned || needsFallbackUnassigned;\n      const developerKey = isUnassigned\n        ? 'developer:unassigned'\n        : (getDeveloperKey(rawDeveloper || normalized.name) || `developer:${(normalized.name || '').toLowerCase()}`);\n\n      // Try to resolve name from developerMap using various keys\n      let resolvedName = null;\n      if (!isUnassigned) {\n        const rawLower = (rawDeveloper || '').toString().toLowerCase();\n        const emailLower = (normalized.email || '').toLowerCase();\n\n        // Try raw value (could be ID like \"dev_abc\")\n        if (this.developerMap.has(rawLower)) {\n          resolvedName = this.developerMap.get(rawLower);\n        }\n        // Try email\n        else if (emailLower && this.developerMap.has(emailLower)) {\n          resolvedName = this.developerMap.get(emailLower);\n        }\n        // Try normalized name\n        else if (normalized.name && this.developerMap.has(normalized.name.toLowerCase())) {\n          resolvedName = this.developerMap.get(normalized.name.toLowerCase());\n        }\n      }\n\n      const developerName = isUnassigned\n        ? 'Sin asignar'\n        : (resolvedName || normalized.name || this.formatNameFromEmail(normalized.email) || 'Sin asignar');\n\n      const developerEmail = normalized.isUnassigned ? '' : (normalized.email || normalized.sourceEmail || '');\n\n      return {\n        key: developerKey,\n        name: developerName,\n        email: developerEmail\n      };\n    }\n\n    getOrCreateStats(map, developerInfo, project) {\n      if (!map.has(developerInfo.key)) {\n        map.set(developerInfo.key, {\n          developerKey: developerInfo.key,\n          developer: developerInfo.name,\n          email: developerInfo.email,\n          projectNames: new Set(),\n          totalTasks: 0,\n          completedTasks: 0,\n          inProgressTasks: 0,\n          blockedTasks: 0,\n          devPointsDone: 0,\n          totalDevPoints: 0,\n          bugsTotal: 0,\n          bugsResolved: 0,\n          bugsOpen: 0,\n          aiTaskCount: 0,\n          aiSessionCount: 0,\n          aiTotalTokens: 0,\n          aiTotalCostUSD: 0\n        });\n      }\n\n      const stats = map.get(developerInfo.key);\n      if (project) {\n        stats.projectNames.add(project.name || project.id);\n      }\n      return stats;\n    }\n\n    processTask(stats, task) {\n      stats.totalTasks += 1;\n      const status = (task.status || '').toLowerCase();\n      const devPoints = Number(task.devPoints) || 0;\n\n      if (status.includes('in progress')) {\n        stats.inProgressTasks += 1;\n      }\n\n      if (this.isTaskBlocked(task)) {\n        stats.blockedTasks += 1;\n      }\n\n      const isDone = status.includes('done') || status.includes('completed') || status.includes('ready for qa');\n      if (isDone) {\n        stats.completedTasks += 1;\n        stats.devPointsDone += devPoints;\n      }\n\n      stats.totalDevPoints += devPoints;\n\n      // Accumulate AI usage metrics\n      const aiUsage = Array.isArray(task.aiUsage) ? task.aiUsage : [];\n      if (aiUsage.length > 0) {\n        stats.aiTaskCount += 1;\n        stats.aiSessionCount += aiUsage.length;\n        for (const entry of aiUsage) {\n          stats.aiTotalTokens += Number(entry.totalTokens) || 0;\n          stats.aiTotalCostUSD += Number(entry.estimatedCostUSD) || 0;\n        }\n      }\n    }\n\n    processBug(stats, bug) {\n      stats.bugsTotal += 1;\n      const status = (bug.status || '').toLowerCase();\n      const resolved = status.includes('done') || status.includes('fixed') || status.includes('closed') || status.includes('resolved');\n      if (resolved) {\n        stats.bugsResolved += 1;\n      } else {\n        stats.bugsOpen += 1;\n      }\n\n      // Accumulate AI usage metrics from bugs\n      const aiUsage = Array.isArray(bug.aiUsage) ? bug.aiUsage : [];\n      if (aiUsage.length > 0) {\n        stats.aiTaskCount += 1;\n        stats.aiSessionCount += aiUsage.length;\n        for (const entry of aiUsage) {\n          stats.aiTotalTokens += Number(entry.totalTokens) || 0;\n          stats.aiTotalCostUSD += Number(entry.estimatedCostUSD) || 0;\n        }\n      }\n    }\n\n    generateMetricsPayload(map, project = null) {\n      const developers = Array.from(map.values()).map((stats) => ({\n        ...stats,\n        projectList: Array.from(stats.projectNames)\n      })).sort((a, b) => b.completedTasks - a.completedTasks || b.totalTasks - a.totalTasks);\n\n      const totals = developers.reduce((acc, row) => {\n        acc.totalTasks += row.totalTasks;\n        acc.completedTasks += row.completedTasks;\n        acc.inProgressTasks += row.inProgressTasks;\n        acc.blockedTasks += row.blockedTasks;\n        acc.devPointsDone += row.devPointsDone;\n        acc.totalDevPoints += row.totalDevPoints;\n        acc.bugsTotal += row.bugsTotal;\n        acc.bugsResolved += row.bugsResolved;\n        acc.bugsOpen += row.bugsOpen;\n        acc.aiTaskCount += row.aiTaskCount;\n        acc.aiSessionCount += row.aiSessionCount;\n        acc.aiTotalTokens += row.aiTotalTokens;\n        acc.aiTotalCostUSD += row.aiTotalCostUSD;\n        return acc;\n      }, {\n        totalTasks: 0,\n        completedTasks: 0,\n        inProgressTasks: 0,\n        blockedTasks: 0,\n        devPointsDone: 0,\n        totalDevPoints: 0,\n        bugsTotal: 0,\n        bugsResolved: 0,\n        bugsOpen: 0,\n        aiTaskCount: 0,\n        aiSessionCount: 0,\n        aiTotalTokens: 0,\n        aiTotalCostUSD: 0\n      });\n\n      return {\n        projectId: project?.id || null,\n        projectName: project?.name || null,\n        developers,\n        totals\n      };\n    }\n\n    render() {\n      if (!this.metrics) {\n        this.setError('No hay métricas disponibles.');\n        return;\n      }\n\n      const scopeData = this.selectedScope === 'all'\n        ? this.metrics.global\n        : this.metrics.projects.get(this.selectedScope);\n\n      if (!scopeData) {\n        this.setError('No existen datos para el proyecto seleccionado.');\n        return;\n      }\n\n      this.renderSummary(scopeData);\n      this.renderDeveloperTable(scopeData);\n      this.renderProjectBreakdown();\n    }\n\n    renderSummary(scopeData) {\n      const totals = scopeData.totals || {};\n      const cards = [\n        {\n          label: 'Tareas totales',\n          value: totals.totalTasks,\n          detail: `${this.formatNumber(totals.completedTasks)} completadas`\n        },\n        {\n          label: 'En progreso',\n          value: totals.inProgressTasks,\n          detail: `${this.formatNumber(totals.blockedTasks)} bloqueadas`\n        },\n        {\n          label: 'Dev points',\n          value: totals.devPointsDone,\n          detail: `${this.formatNumber(totals.totalDevPoints)} estimados`\n        },\n        {\n          label: 'Bugs',\n          value: totals.bugsOpen,\n          detail: `${this.formatNumber(totals.bugsResolved)} resueltos`\n        },\n        ...(totals.aiTaskCount > 0 ? [\n          {\n            label: 'Tareas con IA',\n            value: totals.aiTaskCount,\n            detail: `${this.formatNumber(totals.aiSessionCount)} sesiones`\n          },\n          {\n            label: 'Coste IA',\n            value: `$${totals.aiTotalCostUSD.toFixed(2)}`,\n            detail: `${this.formatNumber(totals.aiTotalTokens)} tokens`\n          }\n        ] : [])\n      ];\n\n      this.elements.summaryCards.innerHTML = cards.map((card) => `\n        <article class=\"summary-card\">\n          <p class=\"card-label\">${card.label}</p>\n          <p class=\"card-value\">${this.formatNumber(card.value)}</p>\n          <p class=\"card-detail\">${card.detail}</p>\n        </article>\n      `).join('');\n    }\n\n    renderDeveloperTable(scopeData) {\n      const rows = scopeData.developers || [];\n      if (!rows.length) {\n        this.elements.tableContainer.innerHTML = '<div class=\"dev-empty\">No hay developers con métricas registradas.</div>';\n        return;\n      }\n\n      const tableRows = rows.map((row) => {\n        const projectsLabel = row.projectList.length <= 2\n          ? row.projectList.join(', ')\n          : `${row.projectList.length} proyectos`;\n        return `\n          <tr>\n            <td>${row.developer}</td>\n            <td>${projectsLabel || '—'}</td>\n            <td>${this.formatNumber(row.totalTasks)}</td>\n            <td>${this.formatNumber(row.completedTasks)}</td>\n            <td>${this.formatNumber(row.inProgressTasks)}</td>\n            <td>${this.formatNumber(row.blockedTasks)}</td>\n            <td>${this.formatNumber(row.devPointsDone)}</td>\n            <td>${this.formatNumber(row.bugsOpen)} / ${this.formatNumber(row.bugsTotal)}</td>\n          </tr>\n        `;\n      }).join('');\n\n      const scopeLabel = this.selectedScope === 'all' ? 'Todos mis proyectos' : scopeData.projectName;\n      const highlightRow = rows[0];\n\n      this.elements.tableContainer.innerHTML = `\n        <div class=\"developer-table-header\">\n          <div>\n            <p class=\"eyebrow\">Resumen · ${scopeLabel}</p>\n            <h2>Performance de developers</h2>\n            <p class=\"subtitle\">Tareas, bloqueos y carga de bugs por persona.</p>\n          </div>\n          ${highlightRow ? `\n            <div class=\"dev-highlight-card\">\n              <p class=\"highlight-label\">Top performer</p>\n              <p class=\"highlight-name\">${highlightRow.developer}</p>\n              <p class=\"highlight-metrics\">${this.formatNumber(highlightRow.completedTasks)} tareas done · ${this.formatNumber(highlightRow.bugsOpen)} bugs abiertos</p>\n            </div>` : ''}\n        </div>\n        <div class=\"developer-table-wrapper\">\n          <table class=\"developer-summary-table\">\n            <thead>\n              <tr>\n                <th>Developer</th>\n                <th>Proyectos</th>\n                <th>Asignadas</th>\n                <th>Completadas</th>\n                <th>En progreso</th>\n                <th>Bloqueadas</th>\n                <th>Dev points (Done)</th>\n                <th>Bugs (Abiertos/Totales)</th>\n              </tr>\n            </thead>\n            <tbody>\n              ${tableRows}\n            </tbody>\n          </table>\n        </div>\n      `;\n    }\n\n    renderProjectBreakdown() {\n      if (!this.metrics || !this.metrics.projects || !this.metrics.projects.size) {\n        this.elements.projectBreakdown.innerHTML = '<div class=\"dev-empty\">No hay datos de proyectos disponibles.</div>';\n        return;\n      }\n\n      const cards = Array.from(this.metrics.projects.values()).map((projectMetric) => {\n        const totals = projectMetric.totals || {};\n        const topDevelopers = (projectMetric.developers || []).slice(0, 3);\n        const topList = topDevelopers.length\n          ? topDevelopers.map((dev) => `\n            <li>\n              <span class=\"dev-name\">${dev.developer}</span>\n              <span class=\"dev-metric\"><strong>${this.formatNumber(dev.completedTasks)}</strong> done</span>\n              <span class=\"dev-metric\"><strong>${this.formatNumber(dev.bugsOpen)}</strong> bugs abiertos</span>\n            </li>\n          `).join('')\n          : '<li class=\"dev-empty-item\">Sin developers asignados</li>';\n\n        const completionRate = totals.totalTasks ? (totals.completedTasks / Math.max(totals.totalTasks, 1)) * 100 : 0;\n        const bugRatio = totals.bugsTotal ? (totals.bugsOpen / Math.max(totals.bugsTotal, 1)) * 100 : 0;\n        const stats = [\n          { label: 'Completadas', value: totals.completedTasks },\n          { label: 'En progreso', value: totals.inProgressTasks },\n          { label: 'Bloqueadas', value: totals.blockedTasks },\n          { label: 'Dev points (done)', value: totals.devPointsDone }\n        ];\n\n        return `\n          <article class=\"project-card\">\n            <header>\n              <div>\n                <h3>${projectMetric.projectName || projectMetric.projectId}</h3>\n                <p>${this.formatNumber(totals.totalTasks)} tareas · ${this.formatNumber(totals.bugsOpen)} bugs abiertos</p>\n              </div>\n              <span class=\"project-chip\">${projectMetric.projectName?.slice(0, 3).toUpperCase() || 'PRJ'}</span>\n            </header>\n            <div class=\"project-stat-grid\">\n              ${stats.map((stat) => `\n                <div class=\"project-stat\">\n                  <span class=\"stat-label\">${stat.label}</span>\n                  <strong class=\"stat-value\">${this.formatNumber(stat.value)}</strong>\n                </div>\n              `).join('')}\n            </div>\n            <div class=\"project-progress\">\n              <div class=\"progress-block\">\n                <div class=\"progress-label\">Tareas completadas</div>\n                <div class=\"progress-track\">\n                  <div class=\"progress-fill completed\" style=\"width:${completionRate}%\"></div>\n                </div>\n                <div class=\"progress-values\">${this.formatNumber(totals.completedTasks)} / ${this.formatNumber(totals.totalTasks)}</div>\n              </div>\n              <div class=\"progress-block\">\n                <div class=\"progress-label\">Bugs abiertos</div>\n                <div class=\"progress-track\">\n                  <div class=\"progress-fill bugs\" style=\"width:${bugRatio}%\"></div>\n                </div>\n                <div class=\"progress-values\">${this.formatNumber(totals.bugsOpen)} / ${this.formatNumber(totals.bugsTotal)}</div>\n              </div>\n            </div>\n            <div class=\"top-devs\">\n              <p>Top developers</p>\n              <ul>${topList}</ul>\n            </div>\n          </article>\n        `;\n      }).join('');\n\n      this.elements.projectBreakdown.innerHTML = `\n        <h2>Detalle por proyecto</h2>\n        <div class=\"project-card-grid\">\n          ${cards}\n        </div>\n      `;\n    }\n\n    setLoading(message) {\n      if (!this.elements.loading || !this.elements.contentSection) return;\n      this.elements.loading.textContent = message;\n      this.elements.loading.classList.remove('hidden');\n      this.elements.contentSection.classList.add('hidden');\n    }\n\n    setReady() {\n      if (!this.elements.loading || !this.elements.contentSection) return;\n      this.elements.loading.classList.add('hidden');\n      this.elements.contentSection.classList.remove('hidden');\n    }\n\n    setError(message) {\n      if (!this.elements.loading || !this.elements.contentSection) return;\n      this.elements.loading.textContent = message;\n      this.elements.loading.classList.remove('hidden');\n      this.elements.contentSection.classList.add('hidden');\n    }\n\n    formatNumber(value) {\n      if (value === null || value === undefined) {\n        return '0';\n      }\n      return Number(value).toLocaleString('es-ES');\n    }\n\n    formatNameFromEmail(email) {\n      if (!email || typeof email !== 'string') {\n        return email || '';\n      }\n      const localPart = email.split('@')[0] || email;\n      let cleaned = localPart.replace(/#ext#/gi, '');\n      cleaned = cleaned.replace(/[._-]+/g, ' ');\n      cleaned = cleaned.replace(/\\s+/g, ' ').trim();\n      if (!cleaned) {\n        return email;\n      }\n      return cleaned.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\n    }\n\n    isTaskBlocked(task) {\n      if (!task) return false;\n      const status = (task.status || '').toLowerCase();\n      return status.includes('block') || Boolean(task.blockedByBusiness) || Boolean(task.blockedByDevelopment);\n    }\n  }\n\n  // Security check: redirect if not super admin\n  async function checkSuperAdminAccess() {\n    try {\n      const currentUserEmail = document.body.dataset.userEmail;\n      const normalizedUserEmail = normalizeEmail(currentUserEmail);\n\n      if (!normalizedUserEmail) {\nwindow.location.href = '/';\n        return false;\n      }\n\n      let hasAccess = false;\n\n      // First check: Environment variable (fastest)\n      const normalizedSuperAdmin = normalizeEmail(envSuperAdminEmail);\n      if (normalizedSuperAdmin && normalizedUserEmail === normalizedSuperAdmin) {\n        hasAccess = true;\n}\n\n      // NOTE: /data/superAdminEmails is DEPRECATED - SuperAdmin is only from .env\nif (!hasAccess) {\nwindow.location.href = '/dashboard/';\n        return false;\n      }\n\n      return true;\n    } catch (error) {\nwindow.location.href = '/dashboard/';\n      return false;\n    }\n  }\n\n  document.addEventListener('astro:page-load', async () => {\n    // Wait for user authentication using auth.currentUser or onAuthStateChanged\n    const waitForUser = () => new Promise((resolve) => {\n      if (auth.currentUser) {\n        document.body.dataset.userEmail = auth.currentUser.email;\n        resolve(auth.currentUser);\n      } else {\n        const unsubscribe = auth.onAuthStateChanged((user) => {\n          unsubscribe();\n          if (user) {\n            document.body.dataset.userEmail = user.email;\n          }\n          resolve(user);\n        });\n        // Timeout after 10 seconds\n        setTimeout(() => {\n          unsubscribe();\n          resolve(null);\n        }, 10000);\n      }\n    });\n\n    const user = await waitForUser();\n    if (!user) {\n      window.location.href = '/';\n      return;\n    }\n\n    const isAllowed = await checkSuperAdminAccess();\n\n    // Only initialize if access is allowed\n    if (isAllowed) {\n      new DevelopmentAnalytics();\n    }\n  });\n</script>\n\n<style is:global>\n  :global(body) {\n    background: var(--bg-secondary, #f5f7fb);\n  }\n\n  .dev-content {\n    margin-top: 1.5rem;\n  }\n\n  .dev-tabs {\n    display: flex;\n    gap: 0.5rem;\n    margin-bottom: 1.5rem;\n    border-bottom: 2px solid var(--border-default, #e1e5ef);\n    padding-bottom: 0;\n  }\n\n  .dev-tab {\n    padding: 0.75rem 1.5rem;\n    border: none;\n    background: transparent;\n    font-size: 1rem;\n    font-weight: 600;\n    color: var(--text-muted, #6b7280);\n    cursor: pointer;\n    border-bottom: 3px solid transparent;\n    margin-bottom: -2px;\n    transition: all 0.2s ease;\n  }\n\n  .dev-tab:hover {\n    color: var(--text-secondary, #374151);\n  }\n\n  .dev-tab.active {\n    color: var(--brand-primary, #2563eb);\n    border-bottom-color: var(--brand-primary, #2563eb);\n  }\n\n  .dev-tab-content {\n    display: none;\n  }\n\n  .dev-tab-content.active {\n    display: block;\n  }\n\n  .dev-dashboard-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: 1.5rem;\n    padding: 2rem 1rem;\n    background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);\n    color: var(--text-on-primary, #fff);\n    border-radius: 18px;\n    margin-bottom: 2rem;\n  }\n\n  .dev-dashboard-header h1 {\n    margin: 0;\n    font-size: 2.5rem;\n  }\n\n  .dev-dashboard-header p {\n    margin: 0.35rem 0 0;\n    color: rgba(255, 255, 255, 0.8);\n  }\n\n  .dev-header-actions {\n    font-weight: 600;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    opacity: 0.8;\n  }\n\n  .dev-controls {\n    display: flex;\n    gap: 1rem;\n    flex-wrap: wrap;\n    padding: 1rem;\n    background: var(--bg-primary, white);\n    border-radius: 12px;\n    border: 1px solid var(--border-default, #e1e5ef);\n    margin-bottom: 1.5rem;\n  }\n\n  .control-group {\n    display: flex;\n    flex-direction: column;\n    min-width: 220px;\n  }\n\n  .control-group label {\n    font-size: 0.85rem;\n    font-weight: 600;\n    margin-bottom: 0.25rem;\n    color: var(--text-secondary, #4a5568);\n  }\n\n  .control-group select {\n    padding: 0.5rem 0.75rem;\n    border-radius: 8px;\n    border: 1px solid var(--border-default, #cbd5f5);\n    font-size: 1rem;\n    background: var(--input-bg, var(--bg-primary, white));\n    color: var(--text-primary, #111827);\n  }\n\n  .ghost {\n    padding: 0.55rem 1.25rem;\n    border-radius: 8px;\n    border: 1px solid var(--border-default, #cbd5f5);\n    color: var(--text-primary, #111827);\n    background: transparent;\n    cursor: pointer;\n    font-weight: 600;\n  }\n\n  .ghost:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n\n  .dev-loading {\n    padding: 2.5rem;\n    text-align: center;\n    border-radius: 12px;\n    border: 1px dashed var(--border-default, #d0d7eb);\n    background: var(--bg-primary, white);\n    color: var(--text-primary, #111827);\n    margin-bottom: 1.5rem;\n    font-weight: 500;\n  }\n\n  .hidden {\n    display: none !important;\n  }\n\n  .summary-cards {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 1rem;\n  }\n\n  .summary-card {\n    background: var(--bg-primary, white);\n    border-radius: 12px;\n    border: 1px solid var(--border-subtle, #e6e9f3);\n    padding: 1.25rem;\n    box-shadow: 0 10px 30px -25px rgba(15, 23, 42, 0.65);\n  }\n\n  .summary-card .card-label {\n    margin: 0;\n    text-transform: uppercase;\n    font-size: 0.75rem;\n    letter-spacing: 0.1em;\n    color: var(--text-muted, #6b7280);\n  }\n\n  .summary-card .card-value {\n    font-size: 2rem;\n    margin: 0.25rem 0 0.15rem;\n    font-weight: 600;\n    color: var(--text-primary, #111827);\n  }\n\n  .summary-card .card-detail {\n    margin: 0;\n    color: var(--text-secondary, #4b5563);\n  }\n\n  .developer-table-container {\n    margin-top: 2rem;\n    background: var(--bg-primary, white);\n    border-radius: 12px;\n    border: 1px solid var(--border-default, #e1e5ef);\n    padding: 1.5rem;\n  }\n\n  .developer-table-header {\n    margin-bottom: 1.5rem;\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    align-items: center;\n  }\n\n  .developer-table-header h2 {\n    margin: 0.15rem 0 0;\n  }\n\n  .dev-highlight-card {\n    background: linear-gradient(120deg, rgba(14,165,233,0.12), rgba(79,70,229,0.12));\n    border: 1px solid rgba(59,130,246,0.3);\n    border-radius: 16px;\n    padding: 0.85rem 1.15rem;\n    min-width: 240px;\n  }\n\n  .dev-highlight-card .highlight-label {\n    margin: 0;\n    text-transform: uppercase;\n    font-size: 0.7rem;\n    letter-spacing: 0.12em;\n    color: var(--brand-primary, #2563eb);\n  }\n\n  .dev-highlight-card .highlight-name {\n    margin: 0.25rem 0 0;\n    font-size: 1.1rem;\n    font-weight: 600;\n  }\n\n  .dev-highlight-card .highlight-metrics {\n    margin: 0.15rem 0 0;\n    color: var(--text-secondary, #4b5563);\n    font-size: 0.9rem;\n  }\n\n  .developer-table-wrapper {\n    overflow-x: auto;\n  }\n\n  table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  .developer-summary-table {\n    border-radius: 18px;\n    overflow: hidden;\n    border: 1px solid var(--border-subtle, #e5e7f3);\n    box-shadow: var(--shadow-lg, 0 15px 40px -35px rgba(15,23,42,0.7));\n    min-width: 900px;\n  }\n\n  thead th {\n    text-align: left;\n    padding: 1rem;\n    background: var(--table-header-bg, linear-gradient(120deg, #eef2ff, #fdf2ff));\n    font-size: 0.9rem;\n    color: var(--text-secondary, #4a5568);\n    border-bottom: 1px solid var(--border-subtle, #dee5fb);\n  }\n\n  tbody td {\n    padding: 1rem;\n    border-bottom: 1px solid var(--border-subtle, #f0f4ff);\n    font-size: 0.95rem;\n    color: var(--text-primary, #111827);\n  }\n\n  tbody tr:nth-child(even) {\n    background: var(--bg-tertiary, #fbfcff);\n  }\n\n  tbody tr:hover {\n    background: var(--hover-overlay, rgba(99, 102, 241, 0.08));\n  }\n\n  .project-breakdown {\n    margin-top: 2rem;\n  }\n\n  .project-card-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n    gap: 1.25rem;\n  }\n\n  .project-card {\n    background: var(--card-bg, linear-gradient(145deg, rgba(255,255,255,0.95), rgba(245,247,255,0.9)));\n    border-radius: 20px;\n    border: 1px solid var(--border-subtle, rgba(147, 155, 183, 0.2));\n    padding: 1.75rem;\n    box-shadow: var(--shadow-lg, 0 35px 65px -45px rgba(15, 23, 42, 0.8));\n  }\n\n  .project-card header h3 {\n    margin: 0 0 0.35rem;\n  }\n\n  .project-card header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 1rem;\n    border-bottom: 1px solid rgba(148, 163, 184, 0.25);\n    padding-bottom: 0.75rem;\n  }\n\n  .project-card header p {\n    margin: 0;\n    color: var(--text-secondary, #4a5568);\n  }\n\n  .project-chip {\n    padding: 0.3rem 0.75rem;\n    border-radius: 999px;\n    font-weight: 600;\n    letter-spacing: 0.05em;\n    font-size: 0.85rem;\n    color: var(--text-primary, #1d3557);\n    background: var(--hover-overlay, rgba(29, 53, 87, 0.08));\n  }\n\n  .project-stat-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n    gap: 0.75rem;\n    margin: 1rem 0 1.5rem;\n  }\n\n  .project-stat {\n    background: rgba(22, 82, 240, 0.07);\n    border-radius: 14px;\n    padding: 0.85rem 1rem;\n    border: 1px solid rgba(22, 82, 240, 0.15);\n    backdrop-filter: blur(12px);\n  }\n\n  .project-stat .stat-label {\n    display: block;\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--text-muted, #5c6b8a);\n    margin-bottom: 0.25rem;\n  }\n\n  .project-stat .stat-value {\n    font-size: 1.45rem;\n    color: var(--text-primary, #1f2937);\n  }\n\n  .project-progress {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 1rem;\n    margin-bottom: 1.2rem;\n  }\n\n  .progress-block {\n    background: rgba(15, 23, 42, 0.035);\n    border-radius: 12px;\n    padding: 0.75rem 1rem;\n    border: 1px dashed rgba(99, 102, 241, 0.3);\n  }\n\n  .progress-label {\n    font-size: 0.8rem;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--text-muted, #6b7280);\n    margin-bottom: 0.4rem;\n  }\n\n  .progress-track {\n    height: 8px;\n    border-radius: 999px;\n    background: var(--progress-track-bg, rgba(229, 231, 235, 0.9));\n    overflow: hidden;\n    margin-bottom: 0.35rem;\n  }\n\n  .progress-fill {\n    height: 100%;\n    border-radius: 999px;\n    transition: width 0.4s ease;\n  }\n\n  .progress-fill.completed {\n    background: linear-gradient(135deg, #22d3ee, #6366f1);\n  }\n\n  .progress-fill.bugs {\n    background: linear-gradient(135deg, #f97316, #ef4444);\n  }\n\n  .progress-values {\n    font-size: 0.85rem;\n    color: var(--text-primary, #1f2937);\n  }\n\n  .top-devs ul {\n    margin: 0.5rem 0 0;\n    padding-left: 0;\n  }\n\n  .top-devs ul li {\n    margin-bottom: 0.35rem;\n    list-style: none;\n    padding: 0.55rem 0.85rem;\n    border-radius: 12px;\n    background: rgba(15, 23, 42, 0.04);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n    align-items: center;\n  }\n\n  .top-devs ul li .dev-name {\n    font-weight: 600;\n    color: var(--text-primary, #111827);\n  }\n\n  .top-devs ul li .dev-metric {\n    font-size: 0.9rem;\n    color: var(--text-secondary, #4b5563);\n  }\n\n  .dev-empty-item {\n    opacity: 0.7;\n  }\n\n  .dev-empty {\n    padding: 2rem;\n    text-align: center;\n    color: var(--text-muted, #6b7280);\n  }\n\n  @media (max-width: 768px) {\n    .dev-controls {\n      flex-direction: column;\n    }\n    .control-group {\n      width: 100%;\n    }\n  }\n</style>\n\n</div>\n","numLines":1408,"startLine":1,"totalLines":1408}}} (stream=stdout)
