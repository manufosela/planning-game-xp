getFormData();\n\n  try {\n    // Build project data, excluding undefined values (Firebase doesn't accept undefined)\n    const projectData = {\n      name: formData.projectName,\n      abbreviation: formData.abbreviation,\n      scoringSystem: formData.scoringSystem,\n      stakeholders: formData.stakeholders,\n      developers: formData.developers,\n      allowExecutables: formData.allowExecutables || false,\n      description: formData.description || '',\n      repoUrl: formData.repoUrl || '',\n      languages: formData.languages || [],\n      frameworks: formData.frameworks || [],\n      businessContext: formData.businessContext || '',\n      iaEnabled: formData.useIa || false,\n      updatedAt: new Date().toISOString(),\n      updatedBy: auth.currentUser?.email || 'unknown',\n      archived: originalData?.archived || false\n    };\n\n    // Only include optional fields if they exist in originalData\n    if (originalData?.order !== undefined) {\n      projectData.order = originalData.order;\n    }\n    if (originalData?.createdAt !== undefined) {\n      projectData.createdAt = originalData.createdAt;\n    }\n    if (originalData?.createdBy !== undefined) {\n      projectData.createdBy = originalData.createdBy;\n    }\n\n    if (formData.projectName !== originalProjectName) {\n      await set(ref(database, `/projects/${formData.projectName}`), projectData);\n      await set(ref(database, `/projects/${originalProjectName}`), null);\n    } else {\n      await set(ref(database, `/projects/${originalProjectName}`), projectData);\n    }\n\n    // Sync team assignments to /users/ for entityDirectoryService consistency\n    const targetProjectName = formData.projectName || originalProjectName;\n    await syncProjectTeamToUsers(targetProjectName, formData.developers || [], formData.stakeholders || []);\n\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: 'Proyecto actualizado exitosamente!' } }\n    }));\n\n    // Reload page if name changed\n    if (formData.projectName !== originalProjectName) {\n      window.location.href = `/adminproject?projectId=${encodeURIComponent(formData.projectName)}`;\n    }\n\n  } catch (error) {\n    console.error('Error updating project:', error);\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: 'Error al actualizar el proyecto', type: 'error' } }\n    }));\n  }\n}\n\nasync function archiveProject(projectName, archived) {\n  try {\n    await set(ref(database, `/projects/${projectName}/archived`), archived);\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: archived ? 'Proyecto archivado' : 'Proyecto desarchivado' } }\n    }));\n  } catch (error) {\n    console.error('Error archiving project:', error);\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: 'Error al archivar el proyecto', type: 'error' } }\n    }));\n  }\n}\n\nasync function deleteProject(projectName) {\n  try {\n    await set(ref(database, `/projects/${projectName}`), null);\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: 'Proyecto eliminado' } }\n    }));\n    window.location.href = '/';\n  } catch (error) {\n    console.error('Error deleting project:', error);\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: 'Error al eliminar el proyecto', type: 'error' } }\n    }));\n  }\n}\n\n// === Trash Tab ===\n\nlet trashLoaded = false;\n\nasync function loadTrashCards(projectName) {\n  if (trashLoaded) return;\n\n  const container = document.getElementById('trashCardsList');\n  if (!container) return;\n\n  container.innerHTML = '<p class=\"loading-message\">Cargando papelera...</p>';\n\n  try {\n    const trashRef = ref(database, `/trash/cards/${projectName}`);\n    const snapshot = await get(trashRef);\n    const trashData = snapshot.val();\n\n    if (!trashData) {\n      container.innerHTML = '<p class=\"empty-message\">La papelera está vacía.</p>';\n      trashLoaded = true;\n      return;\n    }\n\n    const items = [];\n    for (const [cardType, cards] of Object.entries(trashData)) {\n      for (const [firebaseId, card] of Object.entries(cards)) {\n        items.push({ ...card, _firebaseId: firebaseId, _cardType: cardType });\n      }\n    }\n\n    items.sort((a, b) => (b.deletedAt || '').localeCompare(a.deletedAt || ''));\n\n    if (items.length === 0) {\n      container.innerHTML = '<p class=\"empty-message\">La papelera está vacía.</p>';\n      trashLoaded = true;\n      return;\n    }\n\n    const table = document.createElement('table');\n    table.className = 'trash-table';\n    table.innerHTML = `\n      <thead>\n        <tr>\n          <th>Card ID</th>\n          <th>Tipo</th>\n          <th>Título</th>\n          <th>Estado</th>\n          <th>Eliminado por</th>\n          <th>Fecha eliminación</th>\n          <th>Acciones</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${items.map(item => {\n          const type = (item._cardType || '').replace(`_${projectName}`, '');\n          const deletedDate = item.deletedAt\n            ? new Date(item.deletedAt).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' })\n            : '-';\n          const reason = item.deleteReason === 'moved_to_project'\n            ? `Movido a ${item.movedTo?.projectId || '?'}`\n            : '';\n          return `<tr>\n            <td>${item.cardId || '-'}</td>\n            <td>${type}</td>\n            <td>${item.title || '-'}</td>\n            <td>${item.status || '-'} ${reason ? `<span class=\"moved-badge\">${reason}</span>` : ''}</td>\n            <td>${item.deletedBy || '-'}</td>\n            <td>${deletedDate}</td>\n            <td><button class=\"btn-restore\" data-action=\"restore\" data-firebase-id=\"${item._firebaseId}\" data-card-type=\"${item._cardType}\">Restaurar</button></td>\n          </tr>`;\n        }).join('')}\n      </tbody>\n    `;\n    container.innerHTML = '';\n    container.append(table);\n\n    // Attach restore button handlers\n    table.querySelectorAll('[data-action=\"restore\"]').forEach(btn => {\n      btn.addEventListener('click', async () => {\n        const fbId = btn.dataset.firebaseId;\n        const cardType = btn.dataset.cardType;\n        btn.disabled = true;\n        btn.textContent = 'Restaurando...';\n        try {\n          await FirebaseService.restoreCard(projectName, cardType, fbId);\n          trashLoaded = false;\n          loadTrashCards(projectName);\n        } catch {\n          btn.disabled = false;\n          btn.textContent = 'Restaurar';\n        }\n      });\n    });\n\n    trashLoaded = true;\n  } catch (error) {\n    console.error('Error loading trash:', error);\n    container.innerHTML = '<p class=\"error-message\">Error al cargar la papelera.</p>';\n  }\n}\n\ndocument.addEventListener('tab-changed', (e) => {\n  const section = e.detail?.section;\n  if (section === 'trash') {\n    const projectName = new URLSearchParams(window.location.search).get('projectId');\n    if (projectName) loadTrashCards(projectName);\n  }\n});\n\n// Invalidate trash cache when a card is deleted or restored so it reloads on next visit\ndocument.addEventListener('card-deleted', () => {\n  trashLoaded = false;\n});\ndocument.addEventListener('card-restored', () => {\n  trashLoaded = false;\n});\n\n// Initialize on page load\ndocument.addEventListener('astro:page-load', () => {\n  initEditProjectButton();\n});\n</script>\n\n<script type=\"module\">\n// Task Guide Modal\n  const taskGuideStyles = `\n    <style>\n      /* Override modal centering for this content */","numLines":220,"startLine":1423,"totalLines":2594}}} (stream=stdout)
