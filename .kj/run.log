  1393→    } else {\n  1394→      document.addEventListener('user-authenticated', async (event) => {\n  1395→        const email = event?.detail?.user?.email || document.body.dataset.userEmail || '';\n  1396→        currentUserEmail = normalizeEmailSafe(email);\n  1397→        currentUserId = entityDirectoryService.resolveDeveloperId(currentUserEmail) || '';\n  1398→        isSuperAdmin = await isCurrentUserSuperAdmin(currentUserEmail);\n  1399→        setupCardEventHandlers();\n  1400→        setupPermissionHandlers();\n  1401→        tabButtons.forEach(btn => btn.addEventListener('click', () => updateTabs(btn.dataset.tab, true)));\n  1402→        document.getElementById('refreshBacklogBtn')?.addEventListener('click', () => syncBacklogs());\n  1403→        listenDevelopers();\n  1404→        listenWip();\n  1405→        listenBacklogs();\n  1406→        restoreTabFromUrl(); // Restore tab from URL on page load\n  1407→        render();\n  1408→      }, { once: true });\n  1409→    }\n  1410→  }\n  1411→\n  1412→  init();\n  1413→</script>\n  1414→\n  1415→<style>\n  1416→  .wip-tabs {\n  1417→    display: flex;\n  1418→    gap: 0.5rem;\n  1419→    margin: 1rem 0;"}]},"parent_tool_use_id":null,"session_id":"f9921051-c3ba-42d8-b3a6-3b4ba65da7a0","uuid":"5af8d558-2a02-4452-87a3-d957e62123d4","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/wip.astro","content":"    syncDirectory();\n    entityDirectoryService.addChangeListener((type) => {\n      if (type === 'projects' || type === 'developers') {\n        syncDirectory();\n      }\n    });\n  }\n\n  function listenWip() {\n    const wipRef = ref(database, '/wip');\n    onValue(wipRef, (snapshot) => {\n      wipEntries.clear();\n      if (snapshot.exists()) {\n        const data = snapshot.val() || {};\n        for (const [devId, entry] of Object.entries(data)) {\n          if (entry) {\n            wipEntries.set(devId, entry);\n          }\n        }\n      }\n      render();\n    });\n  }\n\n  function listenBacklogs() {\n    const backlogRef = ref(database, '/developerBacklogs');\n    onValue(backlogRef, (snapshot) => {\n      backlogEntries.clear();\n      if (snapshot.exists()) {\n        const raw = snapshot.val() || {};\n        for (const [devId, data] of Object.entries(raw)) {\n          backlogEntries.set(devId, {\n            order: Array.isArray(data.order) ? data.order : [],\n            items: data.items || {},\n            email: data.email || ''\n          });\n        }\n      }\n      // Don't render if we're in the middle of removing an item\n      if (!isRemovingFromBacklog) {\n        render();\n      }\n    });\n  }\n\n  function setupCardEventHandlers() {\n    // Enable request-card-action (needed for _updateExistingTaskStatus in TaskCard)\n    FirebaseService.init();\n\n    // Handle request-project-tasks (needed for _validateDeveloperInProgressLimit in TaskCard)\n    document.addEventListener('request-project-tasks', async (e) => {\n      const { projectId, callback, fullData = false } = e.detail;\n      try {\n        const path = FirebaseService.getPathBySectionAndProjectId('tasks', projectId);\n        const tasks = await FirebaseService.getCards(path);\n\n        let taskList;\n        if (fullData) {\n          taskList = Object.entries(tasks || {}).map(([id, task]) => ({\n            id,\n            firebaseId: id,\n            ...task\n          }));\n        } else {\n          taskList = Object.entries(tasks || {}).map(([id, task]) => ({\n            id,\n            cardId: task.cardId,\n            title: task.title || 'Sin título'\n          }));\n        }\n\n        // Also check global /wip for cross-project In Progress tasks\n        if (fullData) {\n          const wipSnap = await get(ref(database, '/wip'));\n          if (wipSnap.exists()) {\n            const wipData = wipSnap.val() || {};\n            for (const [devId, wipEntry] of Object.entries(wipData)) {\n              if (!wipEntry || !wipEntry.taskId || wipEntry.projectId === projectId) continue;\n              const alreadyIncluded = taskList.some(t =>\n                t.firebaseId === wipEntry.taskId || t.cardId === wipEntry.cardId\n              );\n              if (!alreadyIncluded) {\n                // Fetch full card data from the other project\n                const wipTaskPath = FirebaseService.getPathBySectionAndProjectId('tasks', wipEntry.projectId);\n                const wipTasksData = await FirebaseService.getCards(wipTaskPath);\n                if (wipTasksData && wipTasksData[wipEntry.taskId]) {\n                  taskList.push({\n                    ...wipTasksData[wipEntry.taskId],\n                    id: wipEntry.taskId,\n                    firebaseId: wipEntry.taskId,\n                    group: 'tasks',\n                    cardType: 'task-card'\n                  });\n                }\n              }\n            }\n          }\n        }\n\n        if (callback) callback(taskList);\n      } catch (error) {\n        if (callback) callback([]);\n      }\n    });\n\n    // Handle save-card event (needed for BaseCard._handleSave to persist to Firebase)\n    document.addEventListener('save-card', async (e) => {\n      const { cardData } = e.detail;\n      if (!cardData) return;\n\n      if (!cardData.projectId) {\n        cardData.projectId = cardData.projectId || '';\n      }\n\n      try {\n        await FirebaseService.saveCard(cardData);\n      } catch (error) {\n        console.error('[WIP] Error saving card:', error);\n        document.dispatchEvent(new CustomEvent('card-save-error', {\n          detail: { error: error.message, cardData }\n        }));\n      }\n    });\n  }\n\n  function setupPermissionHandlers() {\n    document.addEventListener('request-task-permissions', (e) => {\n      const { callback } = e.detail;\n      const devMatch = modalDevContext && modalDevContext === currentUserId;\n      const isAdmin = isSuperAdmin || devMatch;\n      const permissions = {\n        canEdit: isAdmin,\n        canSave: isAdmin,\n        canDelete: isSuperAdmin,\n        userRole: { isResponsable: isAdmin },\n        viewMode: 'management'\n      };\n      if (callback) callback(permissions);\n    });\n\n    document.addEventListener('request-ownership-permissions', (e) => {\n      const { createdBy, callback } = e.detail;\n      const current = normalizeEmailSafe(userEmail);\n      const isOwner = createdBy && current && normalizeEmailSafe(createdBy) === current;\n      const devMatch = modalDevContext && modalDevContext === currentUserId;\n      const isAdmin = isSuperAdmin || devMatch;\n      const canEdit = isAdmin || isOwner;\n      const permissions = {\n        canEdit,\n        canSave: canEdit,\n        canDelete: isSuperAdmin,\n        canConvertToTask: canEdit,\n        userRole: { isResponsable: isAdmin },\n        viewMode: 'management',\n        isOwner,\n        isAdmin\n      };\n      if (callback) callback(permissions);\n    });\n  }\n\n  // Init\n  async function init() {\n    // Inicializar el servicio de directorio\n    await entityDirectoryService.init();\n    if (!window.cardRealtimeService) {\n      window.cardRealtimeService = new CardRealtimeService(FirebaseService);\n    }\n\n    const email = document.body.dataset.userEmail || '';\n    if (email) {\n      currentUserEmail = normalizeEmailSafe(email);\n      currentUserId = entityDirectoryService.resolveDeveloperId(currentUserEmail) || '';\n      isSuperAdmin = await isCurrentUserSuperAdmin(currentUserEmail);\n      setupCardEventHandlers();\n      setupPermissionHandlers();\n      tabButtons.forEach(btn => btn.addEventListener('click', () => updateTabs(btn.dataset.tab, true)));\n      document.getElementById('refreshBacklogBtn')?.addEventListener('click', () => syncBacklogs());\n      listenDevelopers();\n      listenWip();\n      listenBacklogs();\n      restoreTabFromUrl(); // Restore tab from URL on page load\n      render();\n    } else {\n      document.addEventListener('user-authenticated', async (event) => {\n        const email = event?.detail?.user?.email || document.body.dataset.userEmail || '';\n        currentUserEmail = normalizeEmailSafe(email);\n        currentUserId = entityDirectoryService.resolveDeveloperId(currentUserEmail) || '';\n        isSuperAdmin = await isCurrentUserSuperAdmin(currentUserEmail);\n        setupCardEventHandlers();\n        setupPermissionHandlers();\n        tabButtons.forEach(btn => btn.addEventListener('click', () => updateTabs(btn.dataset.tab, true)));\n        document.getElementById('refreshBacklogBtn')?.addEventListener('click', () => syncBacklogs());\n        listenDevelopers();\n        listenWip();\n        listenBacklogs();\n        restoreTabFromUrl(); // Restore tab from URL on page load\n        render();\n      }, { once: true });\n    }\n  }\n\n  init();\n</script>\n\n<style>\n  .wip-tabs {\n    display: flex;\n    gap: 0.5rem;\n    margin: 1rem 0;","numLines":210,"startLine":1210,"totalLines":1769}}} (stream=stdout)
