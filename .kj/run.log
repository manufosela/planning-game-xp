 455→    }\n   456→\n   457→    const tabs = backlogLists.map(({ id, info }) => `\n   458→      <button class=\"dev-tab ${id === activeBacklogDev ? 'active' : ''}\" data-dev=\"${id}\">\n   459→        ${info.name || formatNameFromEmail(info.email) || id}\n   460→      </button>\n   461→    `).join('');\n   462→\n   463→    const activeContent = backlogLists.find(d => d.id === activeBacklogDev);\n   464→    const body = activeContent ? `${activeContent.content.header}${activeContent.content.table}` : '';\n   465→\n   466→    const syncBacklogBtn = isSuperAdmin ? `\n   467→      <div class=\"backlog-sync-section\" style=\"margin-bottom:1rem;padding:0.75rem;background:var(--bg-tertiary, #f3f4f6);border-radius:8px;display:flex;align-items:center;justify-content:space-between;\">\n   468→        <span style=\"color:var(--text-muted, #6b7280);font-size:0.875rem;\">Sincronizar backlogs desde tareas \"To Do\" asignadas</span>\n   469→        <button id=\"syncBacklogBtn\" class=\"btn\" ${scanning ? 'disabled' : ''}>${scanning ? 'Sincronizando...' : 'Sincronizar Backlogs'}</button>\n   470→      </div>\n   471→    ` : '';\n   472→\n   473→    backlogContent.innerHTML = `\n   474→      ${syncBacklogBtn}\n   475→      <div class=\"dev-tabs-row\" style=\"display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;\">\n   476→        <div class=\"dev-tabs\" style=\"flex:1;\">${tabs}</div>\n   477→      </div>\n   478→      <div class=\"backlog-card\" data-dev=\"${activeBacklogDev}\">\n   479→        ${body}\n   480→      </div>\n   481→    `;\n   482→\n   483→    backlogContent.querySelectorAll('.dev-tab').forEach(btn => {\n   484→      btn.onclick = () => {\n   485→        activeBacklogDev = btn.dataset.dev;\n   486→        URLStateManager.updateState({ developer: activeBacklogDev });\n   487→        renderBacklog();\n   488→      };\n   489→    });\n   490→\n   491→    bindBacklogActions();\n   492→  }\n   493→\n   494→  function render() {\n   495→    renderWip();\n   496→    renderBacklog();\n   497→    updateTabs();\n   498→  }\n   499→\n   500→  function bindActions() {\n   501→    wipContent.querySelectorAll('button[data-action]').forEach(btn => {\n   502→      btn.onclick = async () => {\n   503→        const { action, key, task, project } = btn.dataset;\n   504→        if (!canEditRow(key)) return;\n   505→\n   506→        setStatus('Procesando...', 'info');\n   507→        try {\n   508→          await handleAction(action, key, task, project);\n   509→          setStatus('Actualizado correctamente.', 'success');\n   510→        } catch (error) {\n   511→          setStatus('Error: ' + error.message, 'error');\n   512→        }\n   513→      };\n   514→    });\n   515→\n   516→    const scanBtn = document.getElementById('scanBtn');\n   517→    if (scanBtn) {\n   518→      scanBtn.onclick = () => scanAllTasks();\n   519→    }\n   520→  }\n   521→\n   522→  function bindBacklogActions() {"}]},"parent_tool_use_id":null,"session_id":"2edfc113-b934-4d7c-a467-727bc44ab6eb","uuid":"3cc022bc-d35a-44f2-b50b-4d526645287a","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/wip.astro","content":"              ${list}\n            </div>\n          </div>\n        `\n      };\n    };\n\n    const invalidDevNames = ['', 'null', 'undefined', 'no developer', 'unassigned', 'no developer assigned', 'sin asignar', 'none'];\n\n    // Build list ONLY from developers that have actual tasks (backlog items or active WIP)\n    const devsWithTasks = new Set();\n\n    // Add developers with backlog items\n    for (const [devId, backlog] of backlogEntries.entries()) {\n      if (backlog && backlog.items && Object.keys(backlog.items).length > 0) {\n        devsWithTasks.add(devId);\n      }\n    }\n\n    // Add developers with active WIP\n    for (const [devId, wipEntry] of wipEntries.entries()) {\n      if (wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle' && wipEntry.taskId.trim() !== '') {\n        devsWithTasks.add(devId);\n      }\n    }\n\n    // Now build the list only with developers that have tasks\n    const devEntries = sortDevelopersForBacklog(\n      Array.from(devsWithTasks)\n        .filter(devId => {\n          if (!devId || !devId.trim()) return false;\n          const devIdLower = devId.toLowerCase().trim();\n          if (invalidDevNames.includes(devIdLower)) return false;\n          // Also check developer name from directory\n          const dirInfo = developerDirectory.get(devId);\n          const devName = dirInfo?.name || '';\n          if (dirInfo) {\n            const nameLower = (dirInfo.name || '').toLowerCase().trim();\n            if (invalidDevNames.includes(nameLower)) return false;\n          }\n          // Exclude test developers/bots\n          if (isExcludedDeveloper(devId, devName)) return false;\n          return true;\n        })\n        .map(devId => {\n          // Get info from directory if available, otherwise create basic info\n          const dirInfo = developerDirectory.get(devId);\n          const backlogEntry = backlogEntries.get(devId);\n          const info = dirInfo || {\n            id: devId,\n            email: backlogEntry?.email || devId,\n            name: formatNameFromEmail(backlogEntry?.email || devId),\n            active: true\n          };\n          return { id: devId, info };\n        })\n    );\n\n    const backlogLists = [];\n\n    devEntries.forEach(({ id, info }) => {\n      backlogLists.push({ id, info, content: makeList(id, info) });\n    });\n\n    if (backlogLists.length === 0) {\n      backlogContent.innerHTML = '<div class=\"backlog-empty\">Sin developers con backlog.</div>';\n      return;\n    }\n\n    // Seleccionar dev activo (primero el usuario actual)\n    const currentUserInList = backlogLists.find(d => d.id === currentUserId);\n    const activeDevStillValid = activeBacklogDev && backlogLists.find(d => d.id === activeBacklogDev);\n\n    // Si no hay dev activo válido, seleccionar uno\n    if (!activeDevStillValid) {\n      activeBacklogDev = currentUserInList ? currentUserInList.id : backlogLists[0].id;\n      if (currentUserInList) hasTriedToSelectCurrentUser = true;\n    }\n    // Si el usuario actual está en la lista y aún no lo hemos seleccionado automáticamente\n    else if (currentUserInList && !hasTriedToSelectCurrentUser) {\n      activeBacklogDev = currentUserId;\n      hasTriedToSelectCurrentUser = true;\n    }\n\n    const tabs = backlogLists.map(({ id, info }) => `\n      <button class=\"dev-tab ${id === activeBacklogDev ? 'active' : ''}\" data-dev=\"${id}\">\n        ${info.name || formatNameFromEmail(info.email) || id}\n      </button>\n    `).join('');\n\n    const activeContent = backlogLists.find(d => d.id === activeBacklogDev);\n    const body = activeContent ? `${activeContent.content.header}${activeContent.content.table}` : '';\n\n    const syncBacklogBtn = isSuperAdmin ? `\n      <div class=\"backlog-sync-section\" style=\"margin-bottom:1rem;padding:0.75rem;background:var(--bg-tertiary, #f3f4f6);border-radius:8px;display:flex;align-items:center;justify-content:space-between;\">\n        <span style=\"color:var(--text-muted, #6b7280);font-size:0.875rem;\">Sincronizar backlogs desde tareas \"To Do\" asignadas</span>\n        <button id=\"syncBacklogBtn\" class=\"btn\" ${scanning ? 'disabled' : ''}>${scanning ? 'Sincronizando...' : 'Sincronizar Backlogs'}</button>\n      </div>\n    ` : '';\n\n    backlogContent.innerHTML = `\n      ${syncBacklogBtn}\n      <div class=\"dev-tabs-row\" style=\"display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;\">\n        <div class=\"dev-tabs\" style=\"flex:1;\">${tabs}</div>\n      </div>\n      <div class=\"backlog-card\" data-dev=\"${activeBacklogDev}\">\n        ${body}\n      </div>\n    `;\n\n    backlogContent.querySelectorAll('.dev-tab').forEach(btn => {\n      btn.onclick = () => {\n        activeBacklogDev = btn.dataset.dev;\n        URLStateManager.updateState({ developer: activeBacklogDev });\n        renderBacklog();\n      };\n    });\n\n    bindBacklogActions();\n  }\n\n  function render() {\n    renderWip();\n    renderBacklog();\n    updateTabs();\n  }\n\n  function bindActions() {\n    wipContent.querySelectorAll('button[data-action]').forEach(btn => {\n      btn.onclick = async () => {\n        const { action, key, task, project } = btn.dataset;\n        if (!canEditRow(key)) return;\n\n        setStatus('Procesando...', 'info');\n        try {\n          await handleAction(action, key, task, project);\n          setStatus('Actualizado correctamente.', 'success');\n        } catch (error) {\n          setStatus('Error: ' + error.message, 'error');\n        }\n      };\n    });\n\n    const scanBtn = document.getElementById('scanBtn');\n    if (scanBtn) {\n      scanBtn.onclick = () => scanAllTasks();\n    }\n  }\n\n  function bindBacklogActions() {","numLines":150,"startLine":373,"totalLines":1769}}} (stream=stdout)
