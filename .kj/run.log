 (tasksSnap.exists()) {\n          const tasks = tasksSnap.val() || {};\n\n          for (const [taskKey, task] of Object.entries(tasks)) {\n            const status = (task.status || '').toLowerCase();\n            // Only \"To Do\" tasks go to backlog (In Progress go to WIP)\n            if (!['to do', 'todo', 'pending'].includes(status)) continue;\n\n            const developerRaw = task.developer || '';\n            if (!developerRaw) continue;\n\n            let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n\n            if (!devId && developerRaw.startsWith('dev_')) {\n              devId = developerRaw; // Trust dev_XXX format\n            }\n            if (!devId) {\n              devId = await entityDirectoryService.findOrCreateDeveloper(\n                developerRaw.includes('@') ? developerRaw : '',\n                developerRaw.includes('@') ? null : developerRaw\n              );\n            }\n            if (!devId) continue;\n\n            const cardKey = `${projectId}|task-card|${taskKey}`;\n\n            if (!backlogsByDev.has(devId)) {\n              backlogsByDev.set(devId, { order: [], items: {}, email: entityDirectoryService.getDeveloper(devId)?.email || '' });\n            }\n\n            const devBacklog = backlogsByDev.get(devId);\n            if (!devBacklog.items[cardKey]) {\n              devBacklog.order.push(cardKey);\n              devBacklog.items[cardKey] = {\n                cardKey,\n                cardId: task.cardId || taskKey,\n                firebaseKey: taskKey,\n                projectId,\n                cardType: 'task-card',\n                title: task.title || task.cardId || taskKey,\n                status: task.status,\n                addedBy: 'sync',\n                addedAt: new Date().toISOString()\n              };\n              taskCount++;\n            }\n          }\n        }\n\n        // Scan proposals\n        const proposalsPath = `/cards/${projectId}/PROPOSALS_${projectId}`;\n        const proposalsSnap = await get(ref(database, proposalsPath));\n\n        if (proposalsSnap.exists()) {\n          const proposals = proposalsSnap.val() || {};\n          for (const [propKey, prop] of Object.entries(proposals)) {\n            const status = (prop.status || '').toLowerCase();\n            if (!['to do', 'todo', 'pending', ''].includes(status)) continue;\n\n            const developerRaw = prop.developer || '';\n            if (!developerRaw) continue;\n\n            let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n            if (!devId && developerRaw.startsWith('dev_')) {\n              devId = developerRaw;\n            }\n            if (!devId) continue;\n\n            const cardKey = `${projectId}|proposal-card|${prop.cardId || propKey}`;\n\n            if (!backlogsByDev.has(devId)) {\n              backlogsByDev.set(devId, { order: [], items: {}, email: entityDirectoryService.getDeveloper(devId)?.email || '' });\n            }\n\n            const devBacklog = backlogsByDev.get(devId);\n            if (!devBacklog.items[cardKey]) {\n              devBacklog.order.push(cardKey);\n              devBacklog.items[cardKey] = {\n                cardKey,\n                cardId: prop.cardId || propKey,\n                projectId,\n                cardType: 'proposal-card',\n                title: prop.title || prop.cardId || propKey,\n                status: prop.status || 'To Do',\n                addedBy: 'sync',\n                addedAt: new Date().toISOString()\n              };\n              taskCount++;\n            }\n          }\n        }\n\n        // Scan bugs (assigned, not finalized)\n        const bugsPath = `/cards/${projectId}/BUGS_${projectId}`;\n        const bugsSnap = await get(ref(database, bugsPath));\n\n        if (bugsSnap.exists()) {\n          const bugs = bugsSnap.val() || {};\n          // Bug statuses that are considered \"finalized\" (should NOT appear in backlog)\n          const finalizedBugStatuses = ['fixed', 'verified', 'closed', 'won\\'t fix', 'wontfix', 'duplicate', 'invalid'];\n\n          for (const [bugKey, bug] of Object.entries(bugs)) {\n            const status = (bug.status || '').toLowerCase();\n            // Skip finalized bugs\n            if (finalizedBugStatuses.includes(status)) continue;\n\n            const developerRaw = bug.developer || '';","numLines":200,"startLine":919,"totalLines":1769}}} (stream=stdout)
