00:59:04.303 [agent:output] [coder] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JYqvcUhD4Mf3iXi8DnLSy7","type":"tool_result","content":"<persisted-output>\nOutput too large (74.5KB). Full output saved to: /home/manu/.claude/projects/-home-manu-ws-firebase-planning-game-xp/f9921051-c3ba-42d8-b3a6-3b4ba65da7a0/tool-results/toolu_01JYqvcUhD4Mf3iXi8DnLSy7.txt\n\nPreview (first 2KB):\n    26→<script type=\"module\">\n    27→  import { database, ref, onValue, get, set } from '/firebase-config.js';\n    28→  import { isCurrentUserSuperAdmin, normalizeEmail as normalizeEmailSafe } from '/js/utils/super-admin-check.js';\n    29→  import { getWorkdaysDuration } from '/js/utils/workday-utils.js';\n    30→  import { entityDirectoryService } from '/js/services/entity-directory-service.js';\n    31→  import { developerBacklogService } from '/js/services/developer-backlog-service.js';\n    32→  import { FirebaseService } from '/js/services/firebase-service.js';\n    33→  import { CardRealtimeService } from '/js/services/card-realtime-service.js';\n    34→  import { URLStateManager } from '/js/utils/url-utils.js';\n    35→  import { generateTimestamp } from '/js/utils/timestamp-utils.js';\n    36→  import '/js/core/app-initializer.js';\n    37→  import 'https://cdn.jsdelivr.net/npm/@manufosela/loading-layer@2.0.1/+esm';\n    38→\n    39→  // DOM elements\n    40→  const wipContent = document.getElementById('wipContent');\n    41→  const backlogContent = document.getElementById('backlogContent');\n    42→  const tabButtons = Array.from(document.querySelectorAll('.tab-button'));\n    43→  const tabWip = document.getElementById('tab-wip');\n    44→  const tabBacklog = document.getElementById('tab-backlog');\n    45→  let loadingLayer = null;\n    46→\n    47→  // State\n    48→  let developerDirectory = new Map(); // devId (dev_XXX) -> { id, email, name, active }\n    49→  let wipEntries = new Map();         // devId -> { taskId, taskTitle, projectId, startedAt, developer, developerName }\n    50→  let backlogEntries = new Map();     // devId -> { order: [], items: {} }\n    51→  let currentUserEmail = '';\n    52→  let currentUserId = '';\n    53→  let isSuperAdmin = false;\n    54→  let scanning = false;\n    55→  let activeTab = 'wip';\n    56→  let activeBacklogDev = null;\n    57→  let hasTriedToSelectCurrentUser = false; // Track if we've tried to auto-select current user\n...\n</persisted-output>"}]},"parent_tool_use_id":null,"session_id":"f9921051-c3ba-42d8-b3a6-3b4ba65da7a0","uuid":"d30b976d-f0d5-40f6-ad09-465a5853cc9b","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/wip.astro","content":"<script type=\"module\">\n  import { database, ref, onValue, get, set } from '/firebase-config.js';\n  import { isCurrentUserSuperAdmin, normalizeEmail as normalizeEmailSafe } from '/js/utils/super-admin-check.js';\n  import { getWorkdaysDuration } from '/js/utils/workday-utils.js';\n  import { entityDirectoryService } from '/js/services/entity-directory-service.js';\n  import { developerBacklogService } from '/js/services/developer-backlog-service.js';\n  import { FirebaseService } from '/js/services/firebase-service.js';\n  import { CardRealtimeService } from '/js/services/card-realtime-service.js';\n  import { URLStateManager } from '/js/utils/url-utils.js';\n  import { generateTimestamp } from '/js/utils/timestamp-utils.js';\n  import '/js/core/app-initializer.js';\n  import 'https://cdn.jsdelivr.net/npm/@manufosela/loading-layer@2.0.1/+esm';\n\n  // DOM elements\n  const wipContent = document.getElementById('wipContent');\n  const backlogContent = document.getElementById('backlogContent');\n  const tabButtons = Array.from(document.querySelectorAll('.tab-button'));\n  const tabWip = document.getElementById('tab-wip');\n  const tabBacklog = document.getElementById('tab-backlog');\n  let loadingLayer = null;\n\n  // State\n  let developerDirectory = new Map(); // devId (dev_XXX) -> { id, email, name, active }\n  let wipEntries = new Map();         // devId -> { taskId, taskTitle, projectId, startedAt, developer, developerName }\n  let backlogEntries = new Map();     // devId -> { order: [], items: {} }\n  let currentUserEmail = '';\n  let currentUserId = '';\n  let isSuperAdmin = false;\n  let scanning = false;\n  let activeTab = 'wip';\n  let activeBacklogDev = null;\n  let hasTriedToSelectCurrentUser = false; // Track if we've tried to auto-select current user\n  let draggedItem = null;\n  const openState = new Map();\n  const userEmail = document.body.dataset.userEmail || '';\n  let modalDevContext = '';\n  const statusCache = new Map();\n\n  // Developers to exclude from WIP and Backlog views (tests, placeholders, bots)\n  const excludedDevNames = [\n    'tests',\n    'no developer assigned',\n    'becaria',\n    'test',\n    'bot'\n  ];\n  let isRemovingFromBacklog = false; // Flag to prevent render during remove operation\n\n  const normalizeSortKey = (value) => (value || '').toString().trim().toLowerCase();\n\n  function sortDevelopersForBacklog(entries) {\n    return entries.sort((a, b) => {\n      if (a.id === currentUserId) return -1;\n      if (b.id === currentUserId) return 1;\n      const labelA = normalizeSortKey(a.info?.name || a.info?.email || a.id);\n      const labelB = normalizeSortKey(b.info?.name || b.info?.email || b.id);\n      return labelA.localeCompare(labelB);\n    });\n  }\n\n  // Helpers\n  function setStatus(message, type = 'info') {\n    if (!message) return;\n    // Use toast notifications instead of inline status\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message, type: type === 'ok' ? 'success' : type } }\n    }));\n  }\n\n  function updateTabs(tab, updateUrl = true) {\n    if (tab) activeTab = tab;\n    tabButtons.forEach(btn => {\n      btn.classList.toggle('active', btn.dataset.tab === activeTab);\n    });\n    if (activeTab === 'backlog') {\n      tabBacklog.classList.remove('hidden');\n      tabWip.classList.add('hidden');\n      // No auto-sync - user can click \"Sincronizar Backlogs\" button manually\n    } else {\n      tabBacklog.classList.add('hidden');\n      tabWip.classList.remove('hidden');\n    }\n\n    // Update URL with tab state (use pushState for navigation history)\n    if (updateUrl) {\n      const urlUpdates = { tab: activeTab };\n      // Clear developer from URL when switching away from backlog tab\n      if (activeTab !== 'backlog') {\n        urlUpdates.developer = null;\n      }\n      URLStateManager.updateState(urlUpdates);\n    }\n  }\n\n  // Restore tab and developer from URL on page load\n  function restoreTabFromUrl() {\n    const urlState = URLStateManager.getState();\n    if (urlState.tab && (urlState.tab === 'wip' || urlState.tab === 'backlog')) {\n      updateTabs(urlState.tab, false); // Don't update URL again\n    }\n    if (urlState.developer) {\n      activeBacklogDev = urlState.developer;\n    }\n  }\n\n  // Listen for browser back/forward navigation\n  URLStateManager.onPopState((state) => {\n    if (state.tab && (state.tab === 'wip' || state.tab === 'backlog')) {\n      updateTabs(state.tab, false);\n    }\n    if (state.tab === 'backlog' && state.developer) {\n      activeBacklogDev = state.developer;\n      renderBacklog();\n    }\n  });\n\n  function formatTime(iso) {\n    if (!iso) return '-';\n    return new Date(iso).toLocaleString([], { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });\n  }\n\n  function formatNameFromEmail(email) {\n    if (!email || typeof email !== 'string') return '';\n    const localPart = email.split('@')[0] || email;\n    return localPart.replace(/[._-]+/g, ' ').replace(/\\s+/g, ' ').trim()\n      .split(' ').filter(Boolean)\n      .map(part => part.charAt(0).toUpperCase() + part.slice(1))\n      .join(' ');\n  }\n\n  function isExcludedDeveloper(devId, devName) {\n    if (!devId && !devName) return true;\n    const idLower = (devId || '').toLowerCase().trim();\n    const nameLower = (devName || '').toLowerCase().trim();\n    return excludedDevNames.some(excluded =>\n      idLower.includes(excluded) || nameLower.includes(excluded)\n    );\n  }\n\n  function canEditRow(devId) {\n    if (!currentUserEmail) return false;\n    if (isSuperAdmin) return true;\n    if (!devId) return false;\n    // Comparar por ID o por email\n    if (currentUserId && devId === currentUserId) return true;\n    const devInfo = developerDirectory.get(devId);\n    return devInfo && normalizeEmailSafe(devInfo.email) === currentUserEmail;\n  }\n\n  const canEditBacklog = (devId) => canEditRow(devId);\n\n  // Render\n  function renderWip() {\n    const rows = [];\n    const processedIds = new Set();\n\n    // Primero, iterar sobre todos los developers del directorio\n    for (const [devId, devInfo] of developerDirectory.entries()) {\n      if (!devInfo.active) continue; // Solo mostrar activos\n      if (isExcludedDeveloper(devId, devInfo.name)) continue; // Excluir tests/bots\n      processedIds.add(devId);\n      const wipEntry = wipEntries.get(devId);\n      const isActive = wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle';\n\n      rows.push({\n        key: devId,\n        developerName: wipEntry?.developerName || devInfo.name || formatNameFromEmail(devInfo.email) || devId,\n        developerEmail: devInfo.email || '',\n        projectId: isActive ? wipEntry.projectId : '-',\n        taskId: isActive ? wipEntry.taskId : '',\n        taskLabel: isActive ? (wipEntry.taskTitle || wipEntry.taskId) : 'Sin tarea',\n        startedAt: isActive ? wipEntry.startedAt : null,\n        duration: isActive ? getWorkdaysDuration(wipEntry.startedAt) : '-',\n        statusLabel: isActive ? 'En progreso' : 'Disponible',\n        isActive\n      });\n    }\n\n    // Luego, añadir developers que están en /wip pero no en el directorio\n    for (const [devId, wipEntry] of wipEntries.entries()) {\n      if (processedIds.has(devId)) continue;\n      const devName = wipEntry.developerName || formatNameFromEmail(wipEntry.developer) || devId;\n      if (isExcludedDeveloper(devId, devName)) continue; // Excluir tests/bots\n      const isActive = wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle';\n      if (!isActive) continue; // Solo mostrar si tienen tarea activa\n\n      rows.push({\n        key: devId,\n        developerName: wipEntry.developerName || formatNameFromEmail(wipEntry.developer) || devId,\n        developerEmail: wipEntry.developer || '',\n        projectId: wipEntry.projectId || '-',\n        taskId: wipEntry.taskId || '',\n        taskLabel: wipEntry.taskTitle || wipEntry.taskId || 'Tarea',\n        startedAt: wipEntry.startedAt || null,\n        duration: getWorkdaysDuration(wipEntry.startedAt),\n        statusLabel: 'En progreso',\n        isActive: true\n      });\n    }\n\n    // Ordenar por nombre\n    rows.sort((a, b) => (a.developerName || '').localeCompare(b.developerName || ''));\n\n    const activeCount = rows.filter(r => r.isActive).length;\n\n    const table = `\n      <div class=\"wip-card\">\n        <div class=\"summary-chips\">\n          <span class=\"summary-chip\">Total: ${rows.length}</span>\n          <span class=\"summary-chip chip-active\">En progreso: ${activeCount}</span>\n          <span class=\"summary-chip chip-idle\">Disponibles: ${rows.length - activeCount}</span>\n        </div>\n        <table class=\"wip-table\" role=\"table\">\n          <thead>\n            <tr>\n              <th scope=\"col\">Developer</th>\n              <th scope=\"col\">Estado</th>\n              <th scope=\"col\">Proyecto</th>\n              <th scope=\"col\">Tarea</th>\n              <th scope=\"col\">Inicio</th>\n              <th scope=\"col\" title=\"Jornadas laborables (excluye fines de semana y festivos)\">Jornadas</th>\n              <th scope=\"col\" class=\"actions-col\">Acciones</th>\n            </tr>\n          </thead>\n          <tbody>\n            ${rows.map(row => `\n              <tr class=\"${row.isActive ? 'row-active' : 'row-idle'}\">\n                <td class=\"dev\">${row.developerName}</td>\n                <td><span class=\"pill ${row.isActive ? 'pill-active' : 'pill-idle'}\">${row.statusLabel}</span></td>\n                <td><span class=\"pill\">${row.projectId}</span></td>\n                <td class=\"task\">${row.taskLabel}</td>\n                <td>${row.startedAt ? formatTime(row.startedAt) : '-'}</td>\n                <td class=\"duration\">${row.duration}</td>\n                <td class=\"actions\">\n                  ${row.isActive && canEditRow(row.key) ? `\n                    <button class=\"btn ghost\" data-action=\"tovalidate\" data-key=\"${row.key}\" data-task=\"${row.taskId}\" data-project=\"${row.projectId}\">To Validate</button>\n                    <button class=\"btn ghost danger\" data-action=\"unassign\" data-key=\"${row.key}\" data-task=\"${row.taskId}\" data-project=\"${row.projectId}\">Desasignar</button>\n                  ` : '<span class=\"muted\">-</span>'}\n                </td>\n              </tr>\n            `).join('')}\n          </tbody>\n        </table>\n      </div>\n    `;\n\n    const scanSection = `\n      <div class=\"wip-card wip-scan\">\n        <div class=\"wip-card__header\">\n          <div>\n            <div class=\"eyebrow\">Sincronizar WIP</div>\n            <p style=\"margin:0;color:var(--text-muted, #6b7280)\">Escanea todas las tareas In Progress de todos los proyectos y actualiza /wip.</p>\n          </div>\n          <button id=\"scanBtn\" class=\"btn\" ${scanning ? 'disabled' : ''}>${scanning ? 'Escaneando...' : 'Escanear tareas'}</button>\n        </div>\n      </div>\n    `;\n\n    wipContent.innerHTML = table + scanSection;\n    bindActions();\n  }\n\n  function renderBacklog() {\n    const processed = new Set();\n\n    const makeList = (devId, devInfo) => {\n      const entry = backlogEntries.get(devId) || { order: [], items: {} };\n      const order = Array.isArray(entry.order) ? entry.order : [];\n      const items = entry.items || {};\n      const orderedItems = [];\n      const seen = new Set();\n\n      for (const key of order) {\n        if (items[key]) {\n          orderedItems.push({ key, ...items[key] });\n          seen.add(key);\n        }\n      }\n\n      for (const [key, value] of Object.entries(items)) {\n        if (!seen.has(key)) {\n          orderedItems.push({ key, ...value });\n        }\n      }\n\n      const activeWip = wipEntries.get(devId);\n      const seenCardIds = new Set();\n      const filteredItems = orderedItems.filter(item => {\n        if (!item) return false;\n        if (activeWip && activeWip.taskId && (item.cardId === activeWip.taskId || item.cardKey?.endsWith(`|${activeWip.taskId}`))) {\n          return false;\n        }\n        const status = (item.status || '').toLowerCase();\n        if (status === 'in progress') return false;\n        // Dedupe by cardId to avoid showing duplicates with different cardKeys\n        const cardId = item.cardId || item.cardKey;\n        if (seenCardIds.has(cardId)) return false;\n        seenCardIds.add(cardId);\n        return true;\n      });\n\n      const list = filteredItems.length ? filteredItems.map((item, idx) => {\n        const cardType = item.cardType || '';\n        const section = cardType.includes('proposal') ? 'proposals' : (cardType.includes('bug') ? 'bugs' : 'tasks');\n        const cardLink = '#';\n        return `\n          <div class=\"backlog-row\" draggable=\"${canEditBacklog(devId)}\" data-dev=\"${devId}\" data-key=\"${item.cardKey}\">\n            <div class=\"drag-cell\" title=\"Arrastrar para reordenar\">☰</div>\n            <div class=\"cell cell-title\">${item.title || item.cardId || item.cardKey}</div>\n            <div class=\"cell\">${item.projectId || '-'}</div>\n            <div class=\"cell\">${(item.cardType || '').replace('-card', '') || '-'}</div>\n            <div class=\"cell\"><span class=\"pill pill-${(item.status || 'pending').toLowerCase().replace(/\\s+/g, '-')}\" title=\"Estado\">${item.status || 'Pending'}</span></div>\n            <div class=\"cell cell-action\">\n              <button class=\"btn-icon btn-view\" data-project=\"${item.projectId || ''}\" data-cardid=\"${item.cardId || ''}\" data-cardtype=\"${item.cardType || ''}\" data-section=\"${section}\" data-key=\"${item.cardKey}\" data-firebasekey=\"${item.firebaseKey || item.firebaseId || ''}\" data-dev=\"${devId}\" title=\"Editar tarea\">✏️</button>\n              ${canEditBacklog(devId) ? `<button class=\"btn-icon btn-remove\" data-remove=\"${item.cardKey}\" data-dev=\"${devId}\" data-cardid=\"${item.cardId || ''}\" data-title=\"${(item.title || '').replace(/\"/g, '&quot;')}\" title=\"Desasignar developer\">✕</button>` : ''}\n            </div>\n          </div>\n        `;\n      }).join('') : '<div class=\"backlog-empty\">Sin elementos en backlog</div>';\n\n      const wipLabel = activeWip?.taskTitle ? `WIP: ${activeWip.taskTitle}` : 'Sin WIP';\n      const wipBadge = activeWip?.taskTitle ? `<span class=\"pill pill-active\">${wipLabel}</span>` : `<span class=\"pill pill-idle\">${wipLabel}</span>`;\n\n      return {\n        devId,\n        header: `\n          <div class=\"backlog-card__header\">\n            <div class=\"summary-left\">\n              <div class=\"summary-name\">${devInfo.name || formatNameFromEmail(devInfo.email) || devId}</div>\n              <div class=\"summary-email\">${devInfo.email || ''}</div>\n            </div>\n            <div class=\"summary-right\">\n              ${wipBadge}\n              <span class=\"pill pill-light\">Pendientes: ${filteredItems.length}</span>\n            </div>\n          </div>`,\n        table: `\n          <div class=\"backlog-table-wrapper\">\n            <div class=\"backlog-table-head\">\n              <div class=\"head-cell\" style=\"width:32px;\"></div>\n              <div class=\"head-cell\">Título</div>\n              <div class=\"head-cell\">Proyecto</div>\n              <div class=\"head-cell\">Tipo</div>\n              <div class=\"head-cell\">Estado</div>\n              <div class=\"head-cell\" style=\"width:110px;\">Acción</div>\n            </div>\n            <div class=\"backlog-rows\" data-dev=\"${devId}\">\n              ${list}\n            </div>\n          </div>\n        `\n      };\n    };\n\n    const invalidDevNames = ['', 'null', 'undefined', 'no developer', 'unassigned', 'no developer assigned', 'sin asignar', 'none'];\n\n    // Build list ONLY from developers that have actual tasks (backlog items or active WIP)\n    const devsWithTasks = new Set();\n\n    // Add developers with backlog items\n    for (const [devId, backlog] of backlogEntries.entries()) {\n      if (backlog && backlog.items && Object.keys(backlog.items).length > 0) {\n        devsWithTasks.add(devId);\n      }\n    }\n\n    // Add developers with active WIP\n    for (const [devId, wipEntry] of wipEntries.entries()) {\n      if (wipEntry && wipEntry.taskId && wipEntry.taskId !== 'idle' && wipEntry.taskId.trim() !== '') {\n        devsWithTasks.add(devId);\n      }\n    }\n\n    // Now build the list only with developers that have tasks\n    const devEntries = sortDevelopersForBacklog(\n      Array.from(devsWithTasks)\n        .filter(devId => {\n          if (!devId || !devId.trim()) return false;\n          const devIdLower = devId.toLowerCase().trim();\n          if (invalidDevNames.includes(devIdLower)) return false;\n          // Also check developer name from directory\n          const dirInfo = developerDirectory.get(devId);\n          const devName = dirInfo?.name || '';\n          if (dirInfo) {\n            const nameLower = (dirInfo.name || '').toLowerCase().trim();\n            if (invalidDevNames.includes(nameLower)) return false;\n          }\n          // Exclude test developers/bots\n          if (isExcludedDeveloper(devId, devName)) return false;\n          return true;\n        })\n        .map(devId => {\n          // Get info from directory if available, otherwise create basic info\n          const dirInfo = developerDirectory.get(devId);\n          const backlogEntry = backlogEntries.get(devId);\n          const info = dirInfo || {\n            id: devId,\n            email: backlogEntry?.email || devId,\n            name: formatNameFromEmail(backlogEntry?.email || devId),\n            active: true\n          };\n          return { id: devId, info };\n        })\n    );\n\n    const backlogLists = [];\n\n    devEntries.forEach(({ id, info }) => {\n      backlogLists.push({ id, info, content: makeList(id, info) });\n    });\n\n    if (backlogLists.length === 0) {\n      backlogContent.innerHTML = '<div class=\"backlog-empty\">Sin developers con backlog.</div>';\n      return;\n    }\n\n    // Seleccionar dev activo (primero el usuario actual)\n    const currentUserInList = backlogLists.find(d => d.id === currentUserId);\n    const activeDevStillValid = activeBacklogDev && backlogLists.find(d => d.id === activeBacklogDev);\n\n    // Si no hay dev activo válido, seleccionar uno\n    if (!activeDevStillValid) {\n      activeBacklogDev = currentUserInList ? currentUserInList.id : backlogLists[0].id;\n      if (currentUserInList) hasTriedToSelectCurrentUser = true;\n    }\n    // Si el usuario actual está en la lista y aún no lo hemos seleccionado automáticamente\n    else if (currentUserInList && !hasTriedToSelectCurrentUser) {\n      activeBacklogDev = currentUserId;\n      hasTriedToSelectCurrentUser = true;\n    }\n\n    const tabs = backlogLists.map(({ id, info }) => `\n      <button class=\"dev-tab ${id === activeBacklogDev ? 'active' : ''}\" data-dev=\"${id}\">\n        ${info.name || formatNameFromEmail(info.email) || id}\n      </button>\n    `).join('');\n\n    const activeContent = backlogLists.find(d => d.id === activeBacklogDev);\n    const body = activeContent ? `${activeContent.content.header}${activeContent.content.table}` : '';\n\n    const syncBacklogBtn = isSuperAdmin ? `\n      <div class=\"backlog-sync-section\" style=\"margin-bottom:1rem;padding:0.75rem;background:var(--bg-tertiary, #f3f4f6);border-radius:8px;display:flex;align-items:center;justify-content:space-between;\">\n        <span style=\"color:var(--text-muted, #6b7280);font-size:0.875rem;\">Sincronizar backlogs desde tareas \"To Do\" asignadas</span>\n        <button id=\"syncBacklogBtn\" class=\"btn\" ${scanning ? 'disabled' : ''}>${scanning ? 'Sincronizando...' : 'Sincronizar Backlogs'}</button>\n      </div>\n    ` : '';\n\n    backlogContent.innerHTML = `\n      ${syncBacklogBtn}\n      <div class=\"dev-tabs-row\" style=\"display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;\">\n        <div class=\"dev-tabs\" style=\"flex:1;\">${tabs}</div>\n      </div>\n      <div class=\"backlog-card\" data-dev=\"${activeBacklogDev}\">\n        ${body}\n      </div>\n    `;\n\n    backlogContent.querySelectorAll('.dev-tab').forEach(btn => {\n      btn.onclick = () => {\n        activeBacklogDev = btn.dataset.dev;\n        URLStateManager.updateState({ developer: activeBacklogDev });\n        renderBacklog();\n      };\n    });\n\n    bindBacklogActions();\n  }\n\n  function render() {\n    renderWip();\n    renderBacklog();\n    updateTabs();\n  }\n\n  function bindActions() {\n    wipContent.querySelectorAll('button[data-action]').forEach(btn => {\n      btn.onclick = async () => {\n        const { action, key, task, project } = btn.dataset;\n        if (!canEditRow(key)) return;\n\n        setStatus('Procesando...', 'info');\n        try {\n          await handleAction(action, key, task, project);\n          setStatus('Actualizado correctamente.', 'success');\n        } catch (error) {\n          setStatus('Error: ' + error.message, 'error');\n        }\n      };\n    });\n\n    const scanBtn = document.getElementById('scanBtn');\n    if (scanBtn) {\n      scanBtn.onclick = () => scanAllTasks();\n    }\n  }\n\n  function bindBacklogActions() {\n    backlogContent.querySelectorAll('button[data-remove]').forEach(btn => {\n      btn.onclick = async () => {\n        const devId = btn.dataset.dev;\n        const cardKey = btn.dataset.remove;\n        const cardId = btn.dataset.cardid || '';\n        if (!canEditBacklog(devId)) return;\n\n        // Block renders during the operation to prevent race conditions\n        isRemovingFromBacklog = true;\n\n        try {\n          // Parse cardKey: format is \"projectId|cardType|firebaseKey\"\n          const parts = cardKey.split('|');\n          if (parts.length >= 3) {\n            const [projectId, cardType, firebaseKey] = parts;\n            const section = cardType.includes('proposal') ? 'PROPOSALS' : (cardType.includes('bug') ? 'BUGS' : 'TASKS');\n            const cardPath = `/cards/${projectId}/${section}_${projectId}/${firebaseKey}`;\n            const cardSnap = await get(ref(database, cardPath));\n            if (cardSnap.exists()) {\n              const card = cardSnap.val();\n              const devInfo = developerDirectory.get(devId) || entityDirectoryService.getDeveloper(devId);\n              const devName = devInfo?.name || devInfo?.email || devId;\n              card.developer = '';\n              card.developerName = '';\n              await set(ref(database, cardPath), card);\n              const itemLabel = cardType.includes('bug') ? 'bug' : 'tarea';\n              setStatus(`Desasignado ${devName} de ${itemLabel} ${card.cardId || cardId}`, 'success');\n            } else {\n              setStatus(`Elemento eliminado del backlog (ya no existe en el proyecto)`, 'info');\n            }\n          }\n          await developerBacklogService.removeItem(devId, cardKey);\n        } catch (error) {\n          setStatus('Error: ' + error.message, 'error');\n        } finally {\n          isRemovingFromBacklog = false;\n          render();\n        }\n      };\n    });\n\n    backlogContent.querySelectorAll('.backlog-items, .backlog-rows').forEach(list => {\n      const devId = list.dataset.dev;\n      if (!canEditBacklog(devId)) return;\n      list.querySelectorAll('.backlog-item, .backlog-row').forEach(item => {\n        item.addEventListener('dragstart', handleBacklogDragStart);\n        item.addEventListener('dragend', handleBacklogDragEnd);\n      });\n      list.addEventListener('dragover', handleBacklogDragOver);\n      list.addEventListener('drop', handleBacklogDrop);\n      list.addEventListener('dragenter', (e) => e.preventDefault());\n    });\n\n    backlogContent.querySelectorAll('.backlog-card').forEach(details => {\n      details.addEventListener('toggle', () => {\n        openState.set(details.dataset.dev, details.open);\n      });\n    });\n\n    backlogContent.querySelectorAll('.btn-view').forEach(btn => {\n      btn.addEventListener('click', async (e) => {\n        e.preventDefault();\n        const { project, cardid, cardtype, section, key, firebasekey, dev } = btn.dataset;\n        modalDevContext = dev || '';\n        if (!project || !cardid || !cardtype) {\n          setStatus('Card sin datos para abrir.', 'error');\n          return;\n        }\n\n        try {\n          setStatus('Cargando tarjeta...', 'info');\n          // Asegurar que los custom elements estén registrados antes de crear la tarjeta\n          const cardImport = cardtype.includes('proposal')\n            ? import('/js/wc/ProposalCard.js')\n            : (cardtype.includes('bug')\n              ? import('/js/wc/BugCard.js')\n              : import('/js/wc/TaskCard.js'));\n          await Promise.all([\n            import('/js/wc/ColorTabs.js'),\n            import('/js/wc/card-history-viewer.js'),\n            import('/js/wc/FirebaseStorageUploader.js'),\n            cardImport\n          ]);\n\n          // Use firebaseKey directly if available, fallback to extracting from cardKey\n          let fbKey = firebasekey;\n          if (!fbKey) {\n            const keyParts = (key || '').split('|');\n            fbKey = keyParts.length >= 3 ? keyParts[2] : cardid;\n          }\n          let cardData = await loadCardData(section, project, fbKey);\n          // If not found by firebaseKey, try by display cardId as fallback\n          if (!cardData && fbKey !== cardid && cardid) {\n            cardData = await loadCardData(section, project, cardid);\n          }\n          if (!cardData) {\n            // Remove stale entry from backlog and re-render\n            if (dev && key) {\n              await developerBacklogService.removeItem(dev, key);\n              // Update local state\n              const devBacklog = backlogEntries.get(dev);\n              if (devBacklog) {\n                delete devBacklog.items[key];\n                devBacklog.order = (devBacklog.order || []).filter(k => k !== key);\n              }\n              renderBacklog();\n              setStatus(`Tarjeta ${cardid || fbKey} eliminada del backlog (ya no existe en el proyecto).`, 'info');\n            } else {\n              setStatus(`No se encontró la tarjeta ${cardid || fbKey}.`, 'error');\n            }\n            return;\n          }\n\n          const tagName = cardtype.includes('proposal') ? 'proposal-card' : (cardtype.includes('bug') ? 'bug-card' : 'task-card');\n          const cardElement = document.createElement(tagName);\n\n          const statusList = await loadStatusList(cardtype);\n          const developersList = entityDirectoryService.getActiveDevelopers().map(dev => ({\n            id: dev.id,\n            email: dev.email,\n            name: dev.name || formatNameFromEmail(dev.email)\n          }));\n\n          // Load sprints for the specific project (needed when opening from backlog)\n          const projectSprintList = await FirebaseService.getSprintList(project);\n\n          // Clean UI state fields that shouldn't be in Firebase data\n          const { expanded: _, isEditable: __, isSaving: ___, ...cleanCardData } = cardData;\n\n          Object.assign(cardElement, cleanCardData, {\n            projectId: project,\n            cardType: cardtype,\n            cardKey: key,\n            userEmail,\n            expanded: true,\n            statusList,\n            developerList: developersList,\n            developers: developersList,\n            globalSprintList: projectSprintList,\n            _skipClone: true\n          });\n\n          const { showExpandedCardInModal } = await import('/js/utils/common-functions.js');\n          showExpandedCardInModal(cardElement);\n          setStatus('', 'info');\n        } catch (error) {\n          setStatus('Error abriendo tarjeta: ' + error.message, 'error');\n        }\n      });\n    });\n\n    // Bind sync backlog button\n    const syncBacklogBtn = document.getElementById('syncBacklogBtn');\n    if (syncBacklogBtn) {\n      syncBacklogBtn.onclick = () => syncBacklogs();\n    }\n  }\n\n  async function createNewTaskForDeveloper(devId) {\n    try {\n      await Promise.all([\n        import('/js/wc/ColorTabs.js'),\n        import('/js/wc/card-history-viewer.js'),\n        import('/js/wc/FirebaseStorageUploader.js'),\n        import('/js/wc/TaskCard.js')\n      ]);\n\n      const devInfo = developerDirectory.get(devId) || entityDirectoryService.getDeveloper(devId);\n      const devName = devInfo?.name || formatNameFromEmail(devInfo?.email) || devId;\n\n      const tagName = 'task-card';\n      const cardElement = document.createElement(tagName);\n\n      const developersList = entityDirectoryService.getActiveDevelopers().map(dev => ({\n        id: dev.id,\n        email: dev.email,\n        name: dev.name || formatNameFromEmail(dev.email)\n      }));\n\n      // Get available projects\n      const projectsSnap = await get(ref(database, '/projects'));\n      const projects = projectsSnap.exists() ? Object.keys(projectsSnap.val()) : [];\n      const defaultProject = projects[0] || '';\n\n      // Load sprints for the default project\n      const projectSprintList = defaultProject ? await FirebaseService.getSprintList(defaultProject) : {};\n\n      const statusList = ['To Do', 'In Progress', 'Code Review', 'Done', 'Blocked'];\n\n      Object.assign(cardElement, {\n        cardType: 'task-card',\n        title: '',\n        description: '',\n        status: 'To Do',\n        developer: devId,\n        developerName: devName,\n        projectId: defaultProject,\n        userEmail,\n        expanded: true,\n        statusList,\n        developerList: developersList,\n        developers: developersList,\n        globalSprintList: projectSprintList,\n        isNew: true,\n        _skipClone: true\n      });\n\n      const { showExpandedCardInModal } = await import('/js/utils/common-functions.js');\n      showExpandedCardInModal(cardElement);\n    } catch (error) {\n      setStatus('Error creando tarea: ' + error.message, 'error');\n    }\n  }\n\n  async function loadCardData(section, projectId, cardId) {\n    const path = FirebaseService.getPathBySectionAndProjectId(section, projectId);\n    const cards = await FirebaseService.getCards(path);\n    if (!cards) return null;\n\n    if (cards[cardId]) {\n      return { ...cards[cardId], firebaseId: cardId, cardId: cards[cardId].cardId || cardId };\n    }\n\n    for (const [firebaseId, card] of Object.entries(cards)) {\n      if (!card) continue;\n      if (card.cardId === cardId || card.id === cardId) {\n        return { ...card, firebaseId, cardId: card.cardId || firebaseId };\n      }\n    }\n\n    return null;\n  }\n\n  async function loadStatusList(cardType) {\n    const cached = statusCache.get(cardType);\n    if (cached) return cached;\n\n    const raw = await FirebaseService.getStatusList(cardType);\n    const list = Array.isArray(raw) ? raw : Object.keys(raw || {});\n    if (!list.length) {\n      throw new Error(`Sin status list para ${cardType}`);\n    }\n    statusCache.set(cardType, list);\n    return list;\n  }\n\n  function handleBacklogDragStart(e) {\n    const item = e.currentTarget.closest('.backlog-item, .backlog-row') || e.currentTarget;\n    draggedItem = item;\n    item.classList.add('dragging');\n    e.dataTransfer.effectAllowed = 'move';\n  }\n\n  function handleBacklogDragEnd() {\n    if (draggedItem) {\n      draggedItem.classList.remove('dragging');\n      draggedItem = null;\n    }\n  }\n\n  function handleBacklogDragOver(e) {\n    e.preventDefault();\n    const list = e.currentTarget.closest('.backlog-items, .backlog-rows');\n    if (!list || !draggedItem) return;\n    if (list.dataset.dev !== draggedItem.dataset.dev) return;\n\n    const target = e.target.closest('.backlog-item, .backlog-row');\n    if (!target || target === draggedItem) return;\n\n    const bounding = target.getBoundingClientRect();\n    const offset = e.clientY - bounding.top;\n    const shouldInsertAfter = offset > bounding.height / 2;\n    if (shouldInsertAfter) {\n      target.insertAdjacentElement('afterend', draggedItem);\n    } else {\n      target.insertAdjacentElement('beforebegin', draggedItem);\n    }\n  }\n\n  async function handleBacklogDrop(e) {\n    e.preventDefault();\n    const list = e.currentTarget;\n    const devId = list.dataset.dev;\n    if (!draggedItem || list.dataset.dev !== draggedItem.dataset.dev) {\n      handleBacklogDragEnd();\n      return;\n    }\n\n    openState.set(devId, true);\n    const container = list.closest('details');\n    if (container) container.setAttribute('open', '');\n\n    const newOrder = Array.from(list.querySelectorAll('.backlog-item, .backlog-row')).map(item => item.dataset.key);\n    try {\n      await developerBacklogService.reorder(devId, newOrder);\n      setStatus('Backlog reordenado.', 'success');\n    } catch (error) {\n      setStatus('Error al reordenar: ' + error.message, 'error');\n    }\n\n    handleBacklogDragEnd();\n  }\n\n  async function handleAction(action, devKey, taskId, projectId) {\n    const taskPath = `/cards/${projectId}/TASKS_${projectId}/${taskId}`;\n    const snap = await get(ref(database, taskPath));\n    if (!snap.exists()) throw new Error('Tarea no encontrada');\n\n    const task = snap.val();\n    task.firebaseId = taskId; // taskId is the Firebase key\n    task.id = taskId;\n    task.projectId = projectId;\n    task.group = 'tasks';\n    task.cardType = 'task-card';\n\n    if (action === 'tovalidate') {\n      const missingFields = [];\n      if (!task.title || task.title.trim() === '') missingFields.push('Título');\n      if (!task.developer) missingFields.push('Developer');\n      if (!task.startDate) missingFields.push('Fecha inicio');\n\n      if (missingFields.length > 0) {\n        throw new Error(`Faltan campos obligatorios: ${missingFields.join(', ')}`);\n      }\n\n      task.status = 'To Validate';\n      task.endDate = generateTimestamp(new Date(), 'end');\n    } else if (action === 'unassign') {\n      task.status = 'To Do';\n      task.developer = '';\n      task.developerName = '';\n    }\n\n    const { FirebaseService } = await import('/js/services/firebase-service.js');\n    await FirebaseService.saveCard(task, { silent: true });\n  }\n\n  // Scan all tasks across all projects\n  async function scanAllTasks() {\n    if (scanning) return;\n    scanning = true;\n    render();\n    setStatus('Escaneando tareas...', 'info');\n\n    try {\n      // Asegurar que el directorio esté inicializado\n      await entityDirectoryService.waitForInit();\n\n      const projectsSnap = await get(ref(database, '/projects'));\n      if (!projectsSnap.exists()) {\n        setStatus('No hay proyectos.', 'error');\n        scanning = false;\n        render();\n        return;\n      }\n\n      const projects = Object.keys(projectsSnap.val() || {});\n      const foundWip = new Map(); // devId -> entry\n\n      for (const projectId of projects) {\n        const tasksPath = `/cards/${projectId}/TASKS_${projectId}`;\n        const tasksSnap = await get(ref(database, tasksPath));\n        if (!tasksSnap.exists()) {\n          continue;\n        }\n\n        const tasks = tasksSnap.val() || {};\n        const statusCounts = {};\n        for (const t of Object.values(tasks)) {\n          const s = t.status || '(vacío)';\n          statusCounts[s] = (statusCounts[s] || 0) + 1;\n        }\n\n        for (const [taskKey, task] of Object.entries(tasks)) {\n          const status = (task.status || '').toLowerCase();\n          if (status === 'in progress') {\n          }\n          if (status !== 'in progress') continue;\n\n          const developerRaw = task.developer || '';\n          if (!developerRaw) {\n            continue;\n          }\n\n          // Resolver developer a ID (puede venir como email, nombre o ya como ID)\n          let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n\n          // Si no existe, crear una entrada nueva\n          if (!devId) {\n            devId = await entityDirectoryService.findOrCreateDeveloper(\n              developerRaw.includes('@') ? developerRaw : '',\n              developerRaw.includes('@') ? null : developerRaw\n            );\n          }\n\n          if (!devId) {\n            continue;\n          }\n\n\n          const startedAt = task.currentWip?.startedAt ||\n            (task.startDate ? new Date(task.startDate).toISOString() : new Date().toISOString());\n\n          const developerName = entityDirectoryService.getDeveloperDisplayName(devId);\n\n          foundWip.set(devId, {\n            taskId: taskKey,\n            taskTitle: task.title || task.cardId || taskKey,\n            projectId,\n            startedAt,\n            developer: devId,\n            developerName\n          });\n        }\n      }\n\n      for (const [k, v] of foundWip.entries()) {\n      }\n\n      // Update /wip in Firebase\n      const currentWipSnap = await get(ref(database, '/wip'));\n      const currentWip = currentWipSnap.exists() ? currentWipSnap.val() || {} : {};\n\n      // Remove entries that no longer have active tasks\n      for (const devId of Object.keys(currentWip)) {\n        if (!foundWip.has(devId)) {\n          await set(ref(database, `/wip/${devId}`), null);\n        }\n      }\n\n      // Add/update entries for developers with active tasks\n      for (const [devId, entry] of foundWip.entries()) {\n        await set(ref(database, `/wip/${devId}`), entry);\n      }\n\n      setStatus(`Escaneo completado. ${foundWip.size} tareas en progreso.`, 'success');\n    } catch (error) {\n      setStatus('Error escaneando: ' + error.message, 'error');\n    }\n\n    scanning = false;\n    render();\n  }\n\n  // Show loading layer\n  function showLoading(message = 'Sincronizando backlogs...') {\n    if (!loadingLayer) {\n      loadingLayer = document.createElement('loading-layer');\n      loadingLayer.setAttribute('color', '#003b82');\n      loadingLayer.setAttribute('size', '60');\n    }\n    loadingLayer.setAttribute('message', message);\n    document.body.appendChild(loadingLayer);\n  }\n\n  // Hide loading layer\n  function hideLoading() {\n    if (loadingLayer && loadingLayer.parentNode) {\n      loadingLayer.parentNode.removeChild(loadingLayer);\n    }\n  }\n\n  // Sync backlogs from existing \"To Do\" tasks\n  async function syncBacklogs() {\n    if (scanning) return;\n    scanning = true;\n    showLoading('Sincronizando backlogs...');\n    render();\n\n    try {\n      await entityDirectoryService.waitForInit();\n\n      const projectsSnap = await get(ref(database, '/projects'));\n      if (!projectsSnap.exists()) {\n        setStatus('No hay proyectos.', 'error');\n        scanning = false;\n        render();\n        return;\n      }\n\n      const projects = Object.keys(projectsSnap.val() || {});\n      const backlogsByDev = new Map(); // devId -> { order: [], items: {} }\n      let taskCount = 0;\n\n      for (const projectId of projects) {\n        // Scan tasks\n        const tasksPath = `/cards/${projectId}/TASKS_${projectId}`;\n        const tasksSnap = await get(ref(database, tasksPath));\n\n        if (tasksSnap.exists()) {\n          const tasks = tasksSnap.val() || {};\n\n          for (const [taskKey, task] of Object.entries(tasks)) {\n            const status = (task.status || '').toLowerCase();\n            // Only \"To Do\" tasks go to backlog (In Progress go to WIP)\n            if (!['to do', 'todo', 'pending'].includes(status)) continue;\n\n            const developerRaw = task.developer || '';\n            if (!developerRaw) continue;\n\n            let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n\n            if (!devId && developerRaw.startsWith('dev_')) {\n              devId = developerRaw; // Trust dev_XXX format\n            }\n            if (!devId) {\n              devId = await entityDirectoryService.findOrCreateDeveloper(\n                developerRaw.includes('@') ? developerRaw : '',\n                developerRaw.includes('@') ? null : developerRaw\n              );\n            }\n            if (!devId) continue;\n\n            const cardKey = `${projectId}|task-card|${taskKey}`;\n\n            if (!backlogsByDev.has(devId)) {\n              backlogsByDev.set(devId, { order: [], items: {}, email: entityDirectoryService.getDeveloper(devId)?.email || '' });\n            }\n\n            const devBacklog = backlogsByDev.get(devId);\n            if (!devBacklog.items[cardKey]) {\n              devBacklog.order.push(cardKey);\n              devBacklog.items[cardKey] = {\n                cardKey,\n                cardId: task.cardId || taskKey,\n                firebaseKey: taskKey,\n                projectId,\n                cardType: 'task-card',\n                title: task.title || task.cardId || taskKey,\n                status: task.status,\n                addedBy: 'sync',\n                addedAt: new Date().toISOString()\n              };\n              taskCount++;\n            }\n          }\n        }\n\n        // Scan proposals\n        const proposalsPath = `/cards/${projectId}/PROPOSALS_${projectId}`;\n        const proposalsSnap = await get(ref(database, proposalsPath));\n\n        if (proposalsSnap.exists()) {\n          const proposals = proposalsSnap.val() || {};\n          for (const [propKey, prop] of Object.entries(proposals)) {\n            const status = (prop.status || '').toLowerCase();\n            if (!['to do', 'todo', 'pending', ''].includes(status)) continue;\n\n            const developerRaw = prop.developer || '';\n            if (!developerRaw) continue;\n\n            let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n            if (!devId && developerRaw.startsWith('dev_')) {\n              devId = developerRaw;\n            }\n            if (!devId) continue;\n\n            const cardKey = `${projectId}|proposal-card|${prop.cardId || propKey}`;\n\n            if (!backlogsByDev.has(devId)) {\n              backlogsByDev.set(devId, { order: [], items: {}, email: entityDirectoryService.getDeveloper(devId)?.email || '' });\n            }\n\n            const devBacklog = backlogsByDev.get(devId);\n            if (!devBacklog.items[cardKey]) {\n              devBacklog.order.push(cardKey);\n              devBacklog.items[cardKey] = {\n                cardKey,\n                cardId: prop.cardId || propKey,\n                projectId,\n                cardType: 'proposal-card',\n                title: prop.title || prop.cardId || propKey,\n                status: prop.status || 'To Do',\n                addedBy: 'sync',\n                addedAt: new Date().toISOString()\n              };\n              taskCount++;\n            }\n          }\n        }\n\n        // Scan bugs (assigned, not finalized)\n        const bugsPath = `/cards/${projectId}/BUGS_${projectId}`;\n        const bugsSnap = await get(ref(database, bugsPath));\n\n        if (bugsSnap.exists()) {\n          const bugs = bugsSnap.val() || {};\n          // Bug statuses that are considered \"finalized\" (should NOT appear in backlog)\n          const finalizedBugStatuses = ['fixed', 'verified', 'closed', 'won\\'t fix', 'wontfix', 'duplicate', 'invalid'];\n\n          for (const [bugKey, bug] of Object.entries(bugs)) {\n            const status = (bug.status || '').toLowerCase();\n            // Skip finalized bugs\n            if (finalizedBugStatuses.includes(status)) continue;\n\n            const developerRaw = bug.developer || '';\n            if (!developerRaw) continue;\n\n            let devId = entityDirectoryService.resolveDeveloperId(developerRaw);\n            if (!devId && developerRaw.startsWith('dev_')) {\n              devId = developerRaw;\n            }\n            if (!devId) continue;\n\n            const cardKey = `${projectId}|bug-card|${bugKey}`;\n\n            if (!backlogsByDev.has(devId)) {\n              backlogsByDev.set(devId, { order: [], items: {}, email: entityDirectoryService.getDeveloper(devId)?.email || '' });\n            }\n\n            const devBacklog = backlogsByDev.get(devId);\n            if (!devBacklog.items[cardKey]) {\n              devBacklog.order.push(cardKey);\n              devBacklog.items[cardKey] = {\n                cardKey,\n                cardId: bug.cardId || bugKey,\n                firebaseKey: bugKey,\n                projectId,\n                cardType: 'bug-card',\n                title: bug.title || bug.cardId || bugKey,\n                status: bug.status || 'Assigned',\n                addedBy: 'sync',\n                addedAt: new Date().toISOString()\n              };\n              taskCount++;\n            }\n          }\n        }\n      }\n\n      // Merge with existing backlogs (don't overwrite, just add missing)\n      const existingBacklogsSnap = await get(ref(database, '/developerBacklogs'));\n      const existingBacklogs = existingBacklogsSnap.exists() ? existingBacklogsSnap.val() || {} : {};\n\n      for (const [devId, newBacklog] of backlogsByDev.entries()) {\n        const existing = existingBacklogs[devId] || { order: [], items: {} };\n        const mergedItems = { ...existing.items };\n        const mergedOrder = [...(existing.order || [])];\n\n        for (const [cardKey, item] of Object.entries(newBacklog.items)) {\n          if (!mergedItems[cardKey]) {\n            mergedItems[cardKey] = item;\n            if (!mergedOrder.includes(cardKey)) {\n              mergedOrder.push(cardKey);\n            }\n          }\n        }\n\n        await set(ref(database, `/developerBacklogs/${devId}`), {\n          order: mergedOrder,\n          items: mergedItems,\n          email: newBacklog.email || existing.email || ''\n        });\n      }\n\n      setStatus(`Sincronización completada. ${taskCount} tareas añadidas a backlogs de ${backlogsByDev.size} developers.`, 'success');\n    } catch (error) {\n      console.error('[syncBacklogs] Error:', error);\n      setStatus('Error sincronizando: ' + error.message, 'error');\n    }\n\n    hideLoading();\n    scanning = false;\n    render();\n  }\n\n  // Firebase listeners\n  function listenDevelopers() {\n    const syncDirectory = () => {\n      developerDirectory.clear();\n      const list = entityDirectoryService.getAllDevelopers();\n      list.forEach((info) => {\n        if (!info || !info.id) {\n          console.warn('[WIP] Developer without id ignored:', info);\n          return;\n        }\n        // Always use info.id as the unique identifier - never fallback to email\n        developerDirectory.set(info.id, {\n          id: info.id,\n          email: (info.email || '').toLowerCase().trim(),\n          name: info.name || formatNameFromEmail(info.email) || info.id,\n          active: info.active !== false\n        });\n      });\n      render();\n    };\n\n    syncDirectory();\n    entityDirectoryService.addChangeListener((type) => {\n      if (type === 'projects' || type === 'developers') {\n        syncDirectory();\n      }\n    });\n  }\n\n  function listenWip() {\n    const wipRef = ref(database, '/wip');\n    onValue(wipRef, (snapshot) => {\n      wipEntries.clear();\n      if (snapshot.exists()) {\n        const data = snapshot.val() || {};\n        for (const [devId, entry] of Object.entries(data)) {\n          if (entry) {\n            wipEntries.set(devId, entry);\n          }\n        }\n      }\n      render();\n    });\n  }\n\n  function listenBacklogs() {\n    const backlogRef = ref(database, '/developerBacklogs');\n    onValue(backlogRef, (snapshot) => {\n      backlogEntries.clear();\n      if (snapshot.exists()) {\n        const raw = snapshot.val() || {};\n        for (const [devId, data] of Object.entries(raw)) {\n          backlogEntries.set(devId, {\n            order: Array.isArray(data.order) ? data.order : [],\n            items: data.items || {},\n            email: data.email || ''\n          });\n        }\n      }\n      // Don't render if we're in the middle of removing an item\n      if (!isRemovingFromBacklog) {\n        render();\n      }\n    });\n  }\n\n  function setupCardEventHandlers() {\n    // Enable request-card-action (needed for _updateExistingTaskStatus in TaskCard)\n    FirebaseService.init();\n\n    // Handle request-project-tasks (needed for _validateDeveloperInProgressLimit in TaskCard)\n    document.addEventListener('request-project-tasks', async (e) => {\n      const { projectId, callback, fullData = false } = e.detail;\n      try {\n        const path = FirebaseService.getPathBySectionAndProjectId('tasks', projectId);\n        const tasks = await FirebaseService.getCards(path);\n\n        let taskList;\n        if (fullData) {\n          taskList = Object.entries(tasks || {}).map(([id, task]) => ({\n            id,\n            firebaseId: id,\n            ...task\n          }));\n        } else {\n          taskList = Object.entries(tasks || {}).map(([id, task]) => ({\n            id,\n            cardId: task.cardId,\n            title: task.title || 'Sin título'\n          }));\n        }\n\n        // Also check global /wip for cross-project In Progress tasks\n        if (fullData) {\n          const wipSnap = await get(ref(database, '/wip'));\n          if (wipSnap.exists()) {\n            const wipData = wipSnap.val() || {};\n            for (const [devId, wipEntry] of Object.entries(wipData)) {\n              if (!wipEntry || !wipEntry.taskId || wipEntry.projectId === projectId) continue;\n              const alreadyIncluded = taskList.some(t =>\n                t.firebaseId === wipEntry.taskId || t.cardId === wipEntry.cardId\n              );\n              if (!alreadyIncluded) {\n                // Fetch full card data from the other project\n                const wipTaskPath = FirebaseService.getPathBySectionAndProjectId('tasks', wipEntry.projectId);\n                const wipTasksData = await FirebaseService.getCards(wipTaskPath);\n                if (wipTasksData && wipTasksData[wipEntry.taskId]) {\n                  taskList.push({\n                    ...wipTasksData[wipEntry.taskId],\n                    id: wipEntry.taskId,\n                    firebaseId: wipEntry.taskId,\n                    group: 'tasks',\n                    cardType: 'task-card'\n                  });\n                }\n              }\n            }\n          }\n        }\n\n        if (callback) callback(taskList);\n      } catch (error) {\n        if (callback) callback([]);\n      }\n    });\n\n    // Handle save-card event (needed for BaseCard._handleSave to persist to Firebase)\n    document.addEventListener('save-card', async (e) => {\n      const { cardData } = e.detail;\n      if (!cardData) return;\n\n      if (!cardData.projectId) {\n        cardData.projectId = cardData.projectId || '';\n      }\n\n      try {\n        await FirebaseService.saveCard(cardData);\n      } catch (error) {\n        console.error('[WIP] Error saving card:', error);\n        document.dispatchEvent(new CustomEvent('card-save-error', {\n          detail: { error: error.message, cardData }\n        }));\n      }\n    });\n  }\n\n  function setupPermissionHandlers() {\n    document.addEventListener('request-task-permissions', (e) => {\n      const { callback } = e.detail;\n      const devMatch = modalDevContext && modalDevContext === currentUserId;\n      const isAdmin = isSuperAdmin || devMatch;\n      const permissions = {\n        canEdit: isAdmin,\n        canSave: isAdmin,\n        canDelete: isSuperAdmin,\n        userRole: { isResponsable: isAdmin },\n        viewMode: 'management'\n      };\n      if (callback) callback(permissions);\n    });\n\n    document.addEventListener('request-ownership-permissions', (e) => {\n      const { createdBy, callback } = e.detail;\n      const current = normalizeEmailSafe(userEmail);\n      const isOwner = createdBy && current && normalizeEmailSafe(createdBy) === current;\n      const devMatch = modalDevContext && modalDevContext === currentUserId;\n      const isAdmin = isSuperAdmin || devMatch;\n      const canEdit = isAdmin || isOwner;\n      const permissions = {\n        canEdit,\n        canSave: canEdit,\n        canDelete: isSuperAdmin,\n        canConvertToTask: canEdit,\n        userRole: { isResponsable: isAdmin },\n        viewMode: 'management',\n        isOwner,\n        isAdmin\n      };\n      if (callback) callback(permissions);\n    });\n  }\n\n  // Init\n  async function init() {\n    // Inicializar el servicio de directorio\n    await entityDirectoryService.init();\n    if (!window.cardRealtimeService) {\n      window.cardRealtimeService = new CardRealtimeService(FirebaseService);\n    }\n\n    const email = document.body.dataset.userEmail || '';\n    if (email) {\n      currentUserEmail = normalizeEmailSafe(email);\n      currentUserId = entityDirectoryService.resolveDeveloperId(currentUserEmail) || '';\n      isSuperAdmin = await isCurrentUserSuperAdmin(currentUserEmail);\n      setupCardEventHandlers();\n      setupPermissionHandlers();\n      tabButtons.forEach(btn => btn.addEventListener('click', () => updateTabs(btn.dataset.tab, true)));\n      document.getElementById('refreshBacklogBtn')?.addEventListener('click', () => syncBacklogs());\n      listenDevelopers();\n      listenWip();\n      listenBacklogs();\n      restoreTabFromUrl(); // Restore tab from URL on page load\n      render();\n    } else {\n      document.addEventListener('user-authenticated', async (event) => {\n        const email = event?.detail?.user?.email || document.body.dataset.userEmail || '';\n        currentUserEmail = normalizeEmailSafe(email);\n        currentUserId = entityDirectoryService.resolveDeveloperId(currentUserEmail) || '';\n        isSuperAdmin = await isCurrentUserSuperAdmin(currentUserEmail);\n        setupCardEventHandlers();\n        setupPermissionHandlers();\n        tabButtons.forEach(btn => btn.addEventListener('click', () => updateTabs(btn.dataset.tab, true)));\n        document.getElementById('refreshBacklogBtn')?.addEventListener('click', () => syncBacklogs());\n        listenDevelopers();\n        listenWip();\n        listenBacklogs();\n        restoreTabFromUrl(); // Restore tab from URL on page load\n        render();\n      }, { once: true });\n    }\n  }\n\n  init();\n</script>\n\n<style>\n  .wip-tabs {\n    display: flex;\n    gap: 0.5rem;\n    margin: 1rem 0;\n  }\n  .tab-button {\n    border: 1px solid var(--border-default, #d1d5db);\n    background: var(--bg-secondary, #f9fafb);\n    padding: 0.5rem 0.75rem;\n    border-radius: 6px;\n    cursor: pointer;\n    font-weight: 600;\n    color: var(--text-primary, #374151);\n  }\n  .tab-button.active {\n    background: var(--brand-primary, #111827);\n    color: var(--text-on-primary, #fff);\n    border-color: var(--brand-primary, #111827);\n  }\n  .tab-panel.hidden {\n    display: none;\n  }\n  .backlog-header {\n    display: flex;\n    justify-content: flex-end;\n    margin-bottom: 1rem;\n  }\n  .refresh-backlog-btn {\n    padding: 0.5rem 1rem;\n    background: var(--primary-color, #3b82f6);\n    color: var(--text-on-primary, #fff);\n    border: none;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.875rem;\n    transition: background 0.2s;\n  }\n  .refresh-backlog-btn:hover {\n    background: var(--primary-color-dark, #2563eb);\n  }\n  .refresh-backlog-btn:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n  .backlog-list {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n  }\n  .backlog-card {\n    border: 1px solid var(--border-default, #e5e7eb);\n    border-radius: 12px;\n    padding: 0.5rem 1rem 1rem;\n    background: var(--bg-primary, #fff);\n    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.05));\n    overflow: hidden;\n  }\n  .backlog-card__header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.75rem;\n    padding: 0.5rem 0;\n    cursor: pointer;\n    list-style: none;\n    user-select: none;\n    width: 100%;\n  }\n  .backlog-card__header::-webkit-details-marker {\n    display: none;\n  }\n  .backlog-card[open] {\n    border-color: var(--border-strong, #d1d5db);\n    box-shadow: var(--shadow-md, 0 2px 4px rgba(0,0,0,0.08));\n  }\n  .backlog-card[open] summary {\n    border-bottom: 1px solid var(--border-default, #e5e7eb);\n    margin-bottom: 0.5rem;\n  }\n  .summary-left {\n    display: flex;\n    flex-direction: column;\n    gap: 0.1rem;\n  }\n  .summary-name {\n    font-weight: 800;\n    color: var(--text-primary, #111827);\n    font-size: 1.05rem;\n  }\n  .summary-email {\n    color: var(--text-muted, #6b7280);\n    font-size: 0.9rem;\n  }\n  .summary-right {\n    display: flex;\n    gap: 0.35rem;\n    justify-content: flex-end;\n    align-items: center;\n    flex-wrap: wrap;\n  }\n  @media (max-width: 768px) {\n    .backlog-card__header {\n      flex-direction: column;\n      align-items: flex-start;\n    }\n    .backlog-table-head,\n    .backlog-row {\n      grid-template-columns: 32px 1fr;\n      grid-template-rows: repeat(5, auto);\n      grid-auto-flow: row;\n    }\n    .backlog-table-head .head-cell:nth-child(n+3),\n    .backlog-row .cell:nth-child(n+3) {\n      padding-left: 0.5rem;\n    }\n  }\n  .backlog-eyebrow {\n    font-size: 0.85rem;\n    color: var(--text-muted, #6b7280);\n  }\n  .backlog-chip-row {\n    display: flex;\n    gap: 0.35rem;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n  .backlog-items {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n  /* Styles moved to global block below */\n\n  /* Global overrides for dynamically generated backlog markup */\n  :global(.backlog-list) { display:flex; flex-direction:column; gap:0.75rem; }\n  :global(.backlog-card) { border:1px solid var(--border-default, #e5e7eb); border-radius:12px; padding:0.5rem 1rem 1rem; background:var(--bg-primary, #fff); box-shadow:var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.05)); overflow:hidden; }\n  :global(.backlog-card__header) { display:flex; align-items:center; justify-content:space-between; gap:0.75rem; padding:0.5rem 0; user-select:none; width:100%; }\n  :global(.backlog-card__header::-webkit-details-marker) { display:none; }\n  :global(.summary-left) { display:flex; flex-direction:column; gap:0.1rem; }\n  :global(.summary-name) { font-weight:800; color:var(--text-primary, #111827); font-size:1.05rem; }\n  :global(.summary-email) { color:var(--text-muted, #6b7280); font-size:0.9rem; }\n  :global(.summary-right) { display:flex; gap:0.35rem; justify-content:flex-end; align-items:center; flex-wrap:wrap; }\n  :global(.caret) { display:inline-block; transition: transform 0.2s ease; margin-right: 0.35rem; color:var(--text-muted, #6b7280); }\n  :global(details[open] .caret) { transform: rotate(90deg); }\n  :global(.backlog-table-head), :global(.backlog-row) { display:grid; grid-template-columns:40px 2fr 1fr 1fr 1fr 120px; align-items:center; gap:0.35rem; }\n  :global(.backlog-table-head) { font-size:0.9rem; color:var(--text-secondary, #4b5563); font-weight:700;