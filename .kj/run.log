"emailRegisterEmail\">Correo electrónico</label>\n   149→            <input id=\"emailRegisterEmail\" name=\"email\" type=\"email\" placeholder=\"Correo electrónico corporativo\" autocomplete=\"email\" required />\n   150→            <label class=\"sr-only\" for=\"emailRegisterPassword\">Contraseña deseada</label>\n   151→            <input id=\"emailRegisterPassword\" name=\"password\" type=\"password\" placeholder=\"Contraseña (mínimo 6 caracteres)\" autocomplete=\"new-password\" minlength=\"6\" required />\n   152→            <div class=\"email-login-actions\">\n   153→              <button type=\"submit\" id=\"emailRegisterSubmit\" class=\"login-button\">Enviar solicitud</button>\n   154→              <button type=\"button\" id=\"emailRegisterCancel\" class=\"secondary-button\">Cancelar</button>\n   155→            </div>\n   156→            <p id=\"emailRegisterError\" class=\"error-message hidden\"></p>\n   157→            <p id=\"emailRegisterSuccess\" class=\"success-message hidden\">Solicitud enviada. Revisaremos tus datos y te avisaremos por correo.</p>\n   158→            <p class=\"form-helper-text\">\n   159→              ¿Ya tienes cuenta?\n   160→              <button type=\"button\" id=\"emailRegisterToLogin\" class=\"link-button\">Volver a iniciar sesión</button>\n   161→            </p>\n   162→          </form>\n   163→          <button id=\"logoutButton\" class=\"logout-button hidden\">Logout</button>\n   164→        </div>\n   165→      </div>\n   166→    </header>\n   167→\n   168→    <MenuNav currentPath={Astro.url.pathname} />\n   169→\n   170→    <div id=\"subNavContainer\"></div>\n   171→\n   172→    <div id=\"welcomeMessage\" class=\"welcome-container hidden\">\n   173→      <div class=\"welcome-content\">\n   174→        <img src=\"/images/icono_PGame.png\" alt=\"Planning Game Logo\" class=\"welcome-logo\" />\n   175→        <h1 class=\"welcome-title\"></h1>\n   176→        <p class=\"welcome-subtitle\"></p>\n   177→      </div>\n   178→ 