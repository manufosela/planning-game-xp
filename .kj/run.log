l {\n   188→            display: block;\n   189→            margin-bottom: 1.5rem;\n   190→            font-weight: 500;\n   191→            font-size: 1.1rem;\n   192→            color: var(--text-on-primary, #fff);\n   193→          }\n   194→          \n   195→          .project-checkboxes {\n   196→            display: flex;\n   197→            flex-direction: row;\n   198→            flex-wrap: wrap;\n   199→            gap: 0.5rem;"}]},"parent_tool_use_id":null,"session_id":"e2c98fa9-2be4-4ba6-ab9c-0317162fa25c","uuid":"bd3c10c3-378e-468b-a2bf-10ebea1482fc","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/dashboard.astro","content":"            this.loadProjects();\n            unsubscribe(); // Solo cargar una vez\n          } else {\n            this.innerHTML = '<p class=\"error\">Please sign in to view projects</p>';\n            unsubscribe();\n          }\n        });\n        \n        // Timeout de seguridad después de 10 segundos\n        setTimeout(() => {\n          if (!auth.currentUser) {\nthis.innerHTML = '<p class=\"error\">Authentication timeout. Please refresh the page.</p>';\n            unsubscribe();\n          }\n        }, 10000);\n\n      } catch (error) {\nthis.innerHTML = '<p class=\"error\">Error initializing dashboard</p>';\n      }\n    }\n\n    async loadProjects() {\n      try {\n        // Wait for authentication\n        const { auth } = await import('/firebase-config.js');\n        const currentUser = auth.currentUser;\nif (!currentUser) {\n          this.innerHTML = '<p class=\"error\">Please sign in to view projects</p>';\n          return;\n        }\n        \n        // Import email sanitizer\n        const { encodeEmailForFirebase } = await import('/js/utils/email-sanitizer.js');\n        const userKey = encodeEmailForFirebase(currentUser.email);\n        \n        // Check user's project access\n        const userProjectsRef = ref(database, `/data/projectsByUser/${userKey}`);\n        const userProjectsSnapshot = await get(userProjectsRef);\n        const userProjectsData = userProjectsSnapshot.val();\n// Get all projects from Firebase\n        const projectsRef = ref(database, 'projects');\n        const allProjectsSnapshot = await get(projectsRef);\n        \n        \n        if (allProjectsSnapshot.exists()) {\n          const allProjectsRaw = allProjectsSnapshot.val();\nconst allProjects = Object.entries(allProjectsRaw).map(([id, project]) => ({\n            id,\n            name: project.name || id,\n            ...project\n          }));\n// Filter projects based on user access\n          const isSuperAdmin = superAdminEmail && currentUser.email.toLowerCase() === superAdminEmail.toLowerCase();\n          if (isSuperAdmin || userProjectsData === 'All') {\n            // SuperAdmin or user with \"All\" access sees all projects\n            this.allProjects = allProjects;\n} else if (userProjectsData) {\n            // User has access to specific projects\n            const allowedProjects = userProjectsData.split(',').map(p => p.trim());\nthis.allProjects = allProjects.filter(project =>\n              allowedProjects.includes(project.id) || allowedProjects.includes(project.name)\n            );\n} else {\n            // User has no project access\n            this.allProjects = [];\n}\nthis.render();\n        } else {\nthis.allProjects = [];\n          this.render();\n        }\n      } catch (error) {\nthis.innerHTML = '<p class=\"error\">Error loading projects</p>';\n      }\n    }\n\n    render() {\n      this.innerHTML = `\n        <style>\n          .project-selector {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            border-radius: 12px;\n            padding: 1.5rem;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n          }\n          \n          .project-selector > label {\n            display: block;\n            margin-bottom: 1.5rem;\n            font-weight: 500;\n            font-size: 1.1rem;\n            color: var(--text-on-primary, #fff);\n          }\n          \n          .project-checkboxes {\n            display: flex;\n            flex-direction: row;\n            flex-wrap: wrap;\n            gap: 0.5rem;","numLines":100,"startLine":100,"totalLines":2594}}} (stream=stdout)
