03:37:13.903 [agent:output] [coder] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011CiM4wGgZPraKi2yMUenEX","type":"tool_result","content":"     1→---\n     2→interface Props {\n     3→  currentPath?: string;\n     4→}\n     5→\n     6→const { currentPath = Astro.url.pathname } = Astro.props;\n     7→\n     8→const navItems = [\n     9→  { href: \"/projects\", label: \"Projects\", requiresAuth: true },\n    10→  { href: \"/adminproject/\", label: \"Admin Project\", requiresAuth: true },\n    11→  { href: \"/cleanview/\", label: \"Clean View\", requiresAuth: true, requiresStakeholderOnly: true },\n    12→  { href: \"/dashboard/\", label: \"Dashboard\", requiresAuth: true },\n    13→  { href: \"/proposals/\", label: \"Proposals\", requiresAuth: true },\n    14→  { href: \"/wip/\", label: \"WIP\", requiresAuth: true },\n    15→  { href: \"/development/\", label: \"Development\", requiresAuth: true, requiresSuperAdmin: true },\n    16→  { href: \"/global-config/\", label: \"Config\", requiresAuth: true, requiresSuperAdmin: true },\n    17→  { href: \"/doc/\", label: \"Docs\", requiresAuth: false, isDocLink: true }\n    18→];\n    19→\n    20→// Determine which link should be active based on current path\n    21→function isActiveLink(href: string, currentPath: string): boolean {\n    22→  // Clean paths by removing trailing slashes and query parameters\n    23→  const cleanHref = href === \"/\" ? \"/\" : href.replace(/\\/$/, \"\");\n    24→  const cleanCurrentPath = currentPath.split(\"?\")[0].split(\"#\")[0].replace(/\\/$/, \"\") || \"/\";\n    25→  \n    26→  // Exact match for root path\n    27→  if (cleanHref === \"/\" && cleanCurrentPath === \"/\") return true;\n    28→  \n    29→  // For non-root paths, use exact matching to avoid conflicts\n    30→  if (cleanHref !== \"/\" && cleanCurrentPath === cleanHref) return true;\n    31→  \n    32→  return false;\n    33→}\n    34→---\n    35→\n    36→<nav class=\"menu-nav\" id=\"menunav\" transition:animate=\"none\">\n    37→  {navItems.map(item => (\n    38→    <a\n    39→      href={item.href}\n    40→      data-astro-reload\n    41→      class:list={[\n    42→        \"nav-link\",\n    43→        { active: isActiveLink(item.href, currentPath) },\n    44→        { \"requires-auth\": item.requiresAuth },\n    45→        { \"requires-super-admin\": item.requiresSuperAdmin },\n    46→        { \"doc-link\": item.isDocLink }\n    47→      ]}\n    48→      data-href={item.href}\n    49→      data-requires-auth={item.requiresAuth}\n    50→      data-requires-super-admin={item.requiresSuperAdmin || false}\n    51→      data-requires-stakeholder-only={item.requiresStakeholderOnly || false}\n    52→      style={item.requiresSuperAdmin || item.requiresStakeholderOnly ? 'display: none;' : ''}\n    53→    >\n    54→      {item.label}\n    55→    </a>\n    56→  ))}\n    57→  <div class=\"nav-indicator top\"></div>\n    58→  <div class=\"nav-indicator bottom\"></div>\n    59→</nav>\n    60→\n    61→<script>\n    62→  // Helper function to get super admin email from firebase-config\n    63→  let cachedSuperAdminEmail = null;\n    64→\n    65→  const normalizeEmail = (email) => (email || '').toString().trim().toLowerCase();\n    66→  const legacyEncodeEmail = (email) => normalizeEmail(email).replace(/[@.#$\\[\\]\\/]/g, '_');\n    67→\n    68→  async function getSuperAdminEmail() {\n    69→    if (cachedSuperAdminEmail !== null) {\n    70→      return cachedSuperAdminEmail;\n    71→    }\n    72→    try {\n    73→      const module = await import(\n    74→        /* @vite-ignore */ `${window.location.origin}/firebase-config.js`\n    75→      );\n    76→      cachedSuperAdminEmail = module.superAdminEmail || '';\n    77→      return cachedSuperAdminEmail;\n    78→    } catch (error) {\n    79→      cachedSuperAdminEmail = '';\n    80→      return '';\n    81→    }\n    82→  }\n    83→\n    84→  /**\n    85→   * Check if user is SuperAdmin (only ONE, from .env)\n    86→   * NOTE: /data/superAdminEmails is DEPRECATED and no longer used\n    87→   */\n    88→  async function isUserSuperAdmin(currentUserEmail) {\n    89→    const normalizedUserEmail = normalizeEmail(currentUserEmail);\n    90→    if (!normalizedUserEmail) return false;\n    91→\n    92→    const superAdminEmail = normalizeEmail(await getSuperAdminEmail());\n    93→    return superAdminEmail && normalizedUserEmail === superAdminEmail;\n    94→  }\n    95→\n    96→  // JavaScript mínimo para interactividad preservando la funcionalidad original\n    97→  class MenuNavSSR {\n    98→    constructor() {\n    99→      this.activeElement = null;\n   100→      this.navLinks = [];\n   101→      this.indicatorTop = null;\n   102→      this.indicatorBottom = null;\n   103→      this.authObserver = null;\n   104→      this.init();\n   105→    }\n   106→\n   107→    init() {\n   108→      const nav = document.querySelector('.menu-nav');\n   109→      if (!nav) return;\n   110→\n   111→      this.navLinks = Array.from(nav.querySelectorAll('.nav-link'));\n   112→      this.indicatorTop = nav.querySelector('.nav-indicator.top');\n   113→      this.indicatorBottom = nav.querySelector('.nav-indicator.bottom');\n   114→\n   115→      this.updateNavLinks();\n   116→      this.markActiveLinkByURL();\n   117→\n   118→      // Listen for auth state changes\n   119→      document.addEventListener('user-authenticated', (event) => {\n   120→        this.updateAuthLinks(true);\n   121→        setTimeout(() => this.updateSuperAdminLinks(), 100);\n   122→        setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n   123→      });\n   124→      document.addEventListener('user-signed-out', () => {\n   125→        this.updateAuthLinks(false);\n   126→        this.updateSuperAdminLinks();\n   127→      });\n   128→\n   129→      // Initial auth state check (hide by default)\n   130→      const isAuthenticated = document.body.getAttribute('data-authenticated') === 'true';\n   131→      this.updateAuthLinks(isAuthenticated);\n   132→\n   133→      // Hide super admin and stakeholder-only links by default\n   134→      this.navLinks.forEach(link => {\n   135→        const requiresSuperAdmin = link.getAttribute('data-requires-super-admin') === 'true';\n   136→        const requiresStakeholderOnly = link.getAttribute('data-requires-stakeholder-only') === 'true';\n   137→        if (requiresSuperAdmin || requiresStakeholderOnly) {\n   138→          link.style.display = 'none';\n   139→        }\n   140→      });\n   141→\n   142→      // Check super admin status after a delay\n   143→      setTimeout(() => this.updateSuperAdminLinks(), 500);\n   144→      if (isAuthenticated) {\n   145→        setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n   146→      }\n   147→\n   148→      if (!this.authObserver) {\n   149→        this.authObserver = new MutationObserver((mutations) => {\n   150→          let authChanged = false;\n   151→          let emailChanged = false;\n   152→\n   153→          mutations.forEach((mutation) => {\n   154→            if (mutation.attributeName === 'data-authenticated') {\n   155→              authChanged = true;\n   156→            }\n   157→            if (mutation.attributeName === 'data-user-email') {\n   158→              emailChanged = true;\n   159→            }\n   160→          });\n   161→\n   162→          if (authChanged) {\n   163→            const authenticatedNow = document.body.getAttribute('data-authenticated') === 'true';\n   164→            this.updateAuthLinks(authenticatedNow);\n   165→            if (authenticatedNow) {\n   166→              setTimeout(() => this.updateSuperAdminLinks(), 100);\n   167→              setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n   168→            }\n   169→          }\n   170→\n   171→          if (emailChanged) {\n   172→            setTimeout(() => this.updateSuperAdminLinks(), 100);\n   173→            setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n   174→          }\n   175→        });\n   176→\n   177→        this.authObserver.observe(document.body, {\n   178→          attributes: true,\n   179→          attributeFilter: ['data-authenticated', 'data-user-email']\n   180→        });\n   181→      }\n   182→    }\n   183→\n   184→    updateNavLinks() {\n   185→      const normalizePath = (value) => {\n   186→        const cleaned = (value || '/').toString().split('?')[0].split('#')[0];\n   187→        const trimmed = cleaned.replace(/\\/$/, '');\n   188→        return trimmed || '/';\n   189→      };\n   190→      const getLinkPath = (href) => {\n   191→        if (!href) return '';\n   192→        try {\n   193→          return new URL(href, window.location.origin).pathname;\n   194→        } catch (error) {\n   195→          return href;\n   196→        }\n   197→      };\n   198→\n   199→      this.navLinks.forEach(link => {\n   200→        const requiresSuperAdmin = link.getAttribute('data-requires-super-admin') === 'true';\n   201→        const requiresStakeholderOnly = link.getAttribute('data-requires-stakeholder-only') === 'true';\n   202→        if (!requiresSuperAdmin && !requiresStakeholderOnly) {\n   203→          link.classList.remove('hidden');\n   204→        }\n   205→      });\n   206→\n   207→      // Add event listeners for interactivity\n   208→      this.navLinks.forEach((link) => {\n   209→        link.addEventListener('click', (event) => {\n   210→          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {\n   211→            return;\n   212→          }\n   213→          const router = window.appShellRouter;\n   214→          if (router?.canHandle?.(link.href)) {\n   215→            event.preventDefault();\n   216→            router.navigate(link.href);\n   217→          }\n   218→        });\n   219→\n   220→        link.addEventListener('mouseenter', (event) => this.moveIndicators(event.target));\n   221→        link.addEventListener('mouseleave', () => this.resetIndicators());\n   222→      });\n   223→    }\n   224→\n   225→    markActiveLinkByURL() {\n   226→      const path = new URL(window.location).pathname;\n   227→      const matchingLink = this.navLinks.find(link => {\n   228→        const href = link.getAttribute('href');\n   229→        const linkPath = href ? new URL(href, window.location.origin).pathname : '';\n   230→        // Clean paths by removing trailing slashes\n   231→        const cleanHref = linkPath === \"/\" ? \"/\" : linkPath.replace(/\\/$/, \"\");\n   232→        const cleanPath = path.replace(/\\/$/, \"\") || \"/\";\n   233→        \n   234→        // Exact match for root path\n   235→        if (cleanHref === \"/\" && cleanPath === \"/\") return true;\n   236→        \n   237→        // For non-root paths, use exact matching to avoid conflicts\n   238→        if (cleanHref !== \"/\" && cleanPath === cleanHref) return true;\n   239→        \n   240→        return false;\n   241→      });\n   242→      \n   243→      if (matchingLink) {\n   244→        this.setActiveLink(matchingLink);\n   245→      }\n   246→    }\n   247→\n   248→    updateAuthLinks(isAuthenticated) {\n   249→      this.navLinks.forEach(link => {\n   250→        const requiresAuth = link.getAttribute('data-requires-auth') === 'true';\n   251→        if (requiresAuth) {\n   252→          link.style.display = isAuthenticated ? '' : 'none';\n   253→        }\n   254→      });\n   255→\n   256→      // Reset indicators position after visibility change\n   257→      if (this.activeElement) {\n   258→        this.moveIndicators(this.activeElement);\n   259→      }\n   260→    }\n   261→\n   262→    async updateSuperAdminLinks() {\n   263→      const currentUserEmail = document.body.dataset.userEmail;\n   264→      const isSuperAdmin = await isUserSuperAdmin(currentUserEmail);\n   265→\n   266→      // Hide/show links that require super admin\n   267→      this.navLinks.forEach(link => {\n   268→        const requiresSuperAdmin = link.getAttribute('data-requires-super-admin') === 'true';\n   269→        if (requiresSuperAdmin) {\n   270→          link.style.display = isSuperAdmin ? 'block' : 'none';\n   271→        }\n   272→      });\n   273→\n   274→      // Reset indicators position after visibility change\n   275→      if (this.activeElement) {\n   276→        this.moveIndicators(this.activeElement);\n   277→      }\n   278→    }\n   279→\n   280→    async updateStakeholderOnlyLinks() {\n   281→      const currentUserEmail = normalizeEmail(document.body.dataset.userEmail);\n   282→      if (!currentUserEmail) return;\n   283→\n   284→      try {\n   285→        const { entityDirectoryService } = await import(\n   286→          /* @vite-ignore */ `${window.location.origin}/js/services/entity-directory-service.js`\n   287→        );\n   288→        await entityDirectoryService.init();\n   289→\n   290→        const devId = entityDirectoryService.resolveDeveloperId(currentUserEmail);\n   291→        const stkId = entityDirectoryService.resolveStakeholderId(currentUserEmail);\n   292→        const isStakeholderOnly = stkId && !devId;\n   293→\n   294→        this.navLinks.forEach(link => {\n   295→          const requiresStakeholderOnly = link.getAttribute('data-requires-stakeholder-only') === 'true';\n   296→          if (requiresStakeholderOnly) {\n   297→            link.style.display = isStakeholderOnly ? '' : 'none';\n   298→          }\n   299→          // Hide Admin Project for stakeholder-only users\n   300→          const href = link.getAttribute('href');\n   301→          if (href === '/adminproject/' && isStakeholderOnly) {\n   302→            link.style.display = 'none';\n   303→          }\n   304→        });\n   305→      } catch (error) {\n   306→        // On error, keep default visibility (cleanview hidden)\n   307→      }\n   308→    }\n   309→\n   310→    moveIndicators(target) {\n   311→      if (!target || !this.indicatorTop || !this.indicatorBottom) return;\n   312→\n   313→      const { offsetLeft, offsetWidth } = target;\n   314→      const nav = target.closest('nav');\n   315→      const navPaddingLeft = parseInt(getComputedStyle(nav).paddingLeft, 10) || 0;\n   316→      const offsetLeftFix = offsetLeft - navPaddingLeft;\n   317→\n   318→      this.indicatorTop.style.width = `${offsetWidth}px`;\n   319→      this.indicatorTop.style.transform = `translateX(${offsetLeftFix}px)`;\n   320→\n   321→      this.indicatorBottom.style.width = `${offsetWidth}px`;\n   322→      this.indicatorBottom.style.transform = `translateX(${offsetLeftFix}px)`;\n   323→    }\n   324→\n   325→    resetIndicators() {\n   326→      if (this.activeElement) {\n   327→        this.moveIndicators(this.activeElement);\n   328→      }\n   329→    }\n   330→\n   331→    setActiveLink(link) {\n   332→      this.activeElement = link;\n   333→      // Remover clase active de todos los links\n   334→      this.navLinks.forEach(l => {\n   335→        l.classList.remove('active');\n   336→        l.removeAttribute('active');\n   337→      });\n   338→      // Añadir clase active al link seleccionado\n   339→      link.classList.add('active');\n   340→      link.setAttribute('active', '');\n   341→      this.moveIndicators(link);\n   342→    }\n   343→\n   344→    // Public methods for backward compatibility\n   345→    updateNavLinksPublic() {\n   346→      this.updateNavLinks();\n   347→    }\n   348→\n   349→    markActiveLinkByURLPublic() {\n   350→      this.markActiveLinkByURL();\n   351→    }\n   352→  }\n   353→\n   354→  // Initialize on every page load (View Transitions compatible)\n   355→  document.addEventListener('astro:page-load', () => {\n   356→    if (window.menuNavSSR) {\n   357→      window.menuNavSSR.updateNavLinksPublic();\n   358→      window.menuNavSSR.markActiveLinkByURLPublic();\n   359→      return;\n   360→    }\n   361→    window.menuNavSSR = new MenuNavSSR();\n   362→\n   363→    // Make methods available globally for backward compatibility\n   364→    const menunav = document.getElementById('menunav');\n   365→    if (menunav) {\n   366→      menunav.updateNavLinks = () => window.menuNavSSR.updateNavLinksPublic();\n   367→      menunav.markActiveLinkByURL = () => window.menuNavSSR.markActiveLinkByURLPublic();\n   368→    }\n   369→  });\n   370→</script>\n   371→\n   372→<style>\n   373→  nav {\n   374→    display: flex;\n   375→    gap: 2px;\n   376→    position: relative;\n   377→    padding: 0 1.5rem;\n   378→    background: var(--bg-primary, #ffffff);\n   379→    height: 2.5rem;\n   380→    align-items: center;\n   381→    border-bottom: 1px solid var(--border-subtle, #e2e8f0);\n   382→  }\n   383→\n   384→  .nav-link {\n   385→    text-decoration: none;\n   386→    color: var(--text-muted, #64748b);\n   387→    padding: 0.35rem 0.75rem;\n   388→    position: relative;\n   389→    font-size: 0.85rem;\n   390→    font-weight: 500;\n   391→    transition: color 0.15s ease, background-color 0.15s ease;\n   392→    border-radius: 6px;\n   393→  }\n   394→\n   395→  .nav-link:hover {\n   396→    color: var(--text-primary, #0f172a);\n   397→    background: var(--bg-secondary, #f1f5f9);\n   398→  }\n   399→\n   400→  .nav-link[active],\n   401→  .nav-link.active {\n   402→    font-weight: 600;\n   403→    color: var(--brand-primary, #6366f1);\n   404→    background: rgba(99, 102, 241, 0.08);\n   405→  }\n   406→\n   407→  .nav-link[active]::after,\n   408→  .nav-link.active::after {\n   409→    content: '';\n   410→    position: absolute;\n   411→    bottom: -0.45rem;\n   412→    left: 50%;\n   413→    transform: translateX(-50%);\n   414→    width: 60%;\n   415→    height: 2px;\n   416→    background: var(--brand-primary, #6366f1);\n   417→    border-radius: 1px;\n   418→  }\n   419→\n   420→  .nav-link.hidden {\n   421→    display: none;\n   422→  }\n   423→\n   424→  .nav-indicator {\n   425→    position: absolute;\n   426→    height: 2px;\n   427→    background-color: var(--brand-primary, #6366f1);\n   428→    transition: all 0.2s ease-in-out;\n   429→    width: 0;\n   430→  }\n   431→\n   432→  .nav-indicator.top {\n   433→    top: 0;\n   434→  }\n   435→\n   436→  .nav-indicator.bottom {\n   437→    bottom: 0;\n   438→  }\n   439→\n   440→  .nav-link.doc-link {\n   441→    margin-left: auto;\n   442→    background: var(--bg-secondary, #f1f5f9);\n   443→    color: var(--text-muted, #64748b);\n   444→    border-radius: 6px;\n   445→    font-size: 0.8rem;\n   446→    padding: 0.2rem 0.65rem;\n   447→    border: 1px solid var(--border-subtle, #e2e8f0);\n   448→  }\n   449→\n   450→  .nav-link.doc-link:hover {\n   451→    background: var(--bg-tertiary, #e2e8f0);\n   452→    color: var(--text-primary, #0f172a);\n   453→  }\n   454→</style>\n   455→"}]},"parent_tool_use_id":null,"session_id":"c3386944-45a0-4575-bd5f-84e664020013","uuid":"04e9ef02-ac58-4230-8029-b4b5bde685e4","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/components/MenuNav.astro","content":"---\ninterface Props {\n  currentPath?: string;\n}\n\nconst { currentPath = Astro.url.pathname } = Astro.props;\n\nconst navItems = [\n  { href: \"/projects\", label: \"Projects\", requiresAuth: true },\n  { href: \"/adminproject/\", label: \"Admin Project\", requiresAuth: true },\n  { href: \"/cleanview/\", label: \"Clean View\", requiresAuth: true, requiresStakeholderOnly: true },\n  { href: \"/dashboard/\", label: \"Dashboard\", requiresAuth: true },\n  { href: \"/proposals/\", label: \"Proposals\", requiresAuth: true },\n  { href: \"/wip/\", label: \"WIP\", requiresAuth: true },\n  { href: \"/development/\", label: \"Development\", requiresAuth: true, requiresSuperAdmin: true },\n  { href: \"/global-config/\", label: \"Config\", requiresAuth: true, requiresSuperAdmin: true },\n  { href: \"/doc/\", label: \"Docs\", requiresAuth: false, isDocLink: true }\n];\n\n// Determine which link should be active based on current path\nfunction isActiveLink(href: string, currentPath: string): boolean {\n  // Clean paths by removing trailing slashes and query parameters\n  const cleanHref = href === \"/\" ? \"/\" : href.replace(/\\/$/, \"\");\n  const cleanCurrentPath = currentPath.split(\"?\")[0].split(\"#\")[0].replace(/\\/$/, \"\") || \"/\";\n  \n  // Exact match for root path\n  if (cleanHref === \"/\" && cleanCurrentPath === \"/\") return true;\n  \n  // For non-root paths, use exact matching to avoid conflicts\n  if (cleanHref !== \"/\" && cleanCurrentPath === cleanHref) return true;\n  \n  return false;\n}\n---\n\n<nav class=\"menu-nav\" id=\"menunav\" transition:animate=\"none\">\n  {navItems.map(item => (\n    <a\n      href={item.href}\n      data-astro-reload\n      class:list={[\n        \"nav-link\",\n        { active: isActiveLink(item.href, currentPath) },\n        { \"requires-auth\": item.requiresAuth },\n        { \"requires-super-admin\": item.requiresSuperAdmin },\n        { \"doc-link\": item.isDocLink }\n      ]}\n      data-href={item.href}\n      data-requires-auth={item.requiresAuth}\n      data-requires-super-admin={item.requiresSuperAdmin || false}\n      data-requires-stakeholder-only={item.requiresStakeholderOnly || false}\n      style={item.requiresSuperAdmin || item.requiresStakeholderOnly ? 'display: none;' : ''}\n    >\n      {item.label}\n    </a>\n  ))}\n  <div class=\"nav-indicator top\"></div>\n  <div class=\"nav-indicator bottom\"></div>\n</nav>\n\n<script>\n  // Helper function to get super admin email from firebase-config\n  let cachedSuperAdminEmail = null;\n\n  const normalizeEmail = (email) => (email || '').toString().trim().toLowerCase();\n  const legacyEncodeEmail = (email) => normalizeEmail(email).replace(/[@.#$\\[\\]\\/]/g, '_');\n\n  async function getSuperAdminEmail() {\n    if (cachedSuperAdminEmail !== null) {\n      return cachedSuperAdminEmail;\n    }\n    try {\n      const module = await import(\n        /* @vite-ignore */ `${window.location.origin}/firebase-config.js`\n      );\n      cachedSuperAdminEmail = module.superAdminEmail || '';\n      return cachedSuperAdminEmail;\n    } catch (error) {\n      cachedSuperAdminEmail = '';\n      return '';\n    }\n  }\n\n  /**\n   * Check if user is SuperAdmin (only ONE, from .env)\n   * NOTE: /data/superAdminEmails is DEPRECATED and no longer used\n   */\n  async function isUserSuperAdmin(currentUserEmail) {\n    const normalizedUserEmail = normalizeEmail(currentUserEmail);\n    if (!normalizedUserEmail) return false;\n\n    const superAdminEmail = normalizeEmail(await getSuperAdminEmail());\n    return superAdminEmail && normalizedUserEmail === superAdminEmail;\n  }\n\n  // JavaScript mínimo para interactividad preservando la funcionalidad original\n  class MenuNavSSR {\n    constructor() {\n      this.activeElement = null;\n      this.navLinks = [];\n      this.indicatorTop = null;\n      this.indicatorBottom = null;\n      this.authObserver = null;\n      this.init();\n    }\n\n    init() {\n      const nav = document.querySelector('.menu-nav');\n      if (!nav) return;\n\n      this.navLinks = Array.from(nav.querySelectorAll('.nav-link'));\n      this.indicatorTop = nav.querySelector('.nav-indicator.top');\n      this.indicatorBottom = nav.querySelector('.nav-indicator.bottom');\n\n      this.updateNavLinks();\n      this.markActiveLinkByURL();\n\n      // Listen for auth state changes\n      document.addEventListener('user-authenticated', (event) => {\n        this.updateAuthLinks(true);\n        setTimeout(() => this.updateSuperAdminLinks(), 100);\n        setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n      });\n      document.addEventListener('user-signed-out', () => {\n        this.updateAuthLinks(false);\n        this.updateSuperAdminLinks();\n      });\n\n      // Initial auth state check (hide by default)\n      const isAuthenticated = document.body.getAttribute('data-authenticated') === 'true';\n      this.updateAuthLinks(isAuthenticated);\n\n      // Hide super admin and stakeholder-only links by default\n      this.navLinks.forEach(link => {\n        const requiresSuperAdmin = link.getAttribute('data-requires-super-admin') === 'true';\n        const requiresStakeholderOnly = link.getAttribute('data-requires-stakeholder-only') === 'true';\n        if (requiresSuperAdmin || requiresStakeholderOnly) {\n          link.style.display = 'none';\n        }\n      });\n\n      // Check super admin status after a delay\n      setTimeout(() => this.updateSuperAdminLinks(), 500);\n      if (isAuthenticated) {\n        setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n      }\n\n      if (!this.authObserver) {\n        this.authObserver = new MutationObserver((mutations) => {\n          let authChanged = false;\n          let emailChanged = false;\n\n          mutations.forEach((mutation) => {\n            if (mutation.attributeName === 'data-authenticated') {\n              authChanged = true;\n            }\n            if (mutation.attributeName === 'data-user-email') {\n              emailChanged = true;\n            }\n          });\n\n          if (authChanged) {\n            const authenticatedNow = document.body.getAttribute('data-authenticated') === 'true';\n            this.updateAuthLinks(authenticatedNow);\n            if (authenticatedNow) {\n              setTimeout(() => this.updateSuperAdminLinks(), 100);\n              setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n            }\n          }\n\n          if (emailChanged) {\n            setTimeout(() => this.updateSuperAdminLinks(), 100);\n            setTimeout(() => this.updateStakeholderOnlyLinks(), 200);\n          }\n        });\n\n        this.authObserver.observe(document.body, {\n          attributes: true,\n          attributeFilter: ['data-authenticated', 'data-user-email']\n        });\n      }\n    }\n\n    updateNavLinks() {\n      const normalizePath = (value) => {\n        const cleaned = (value || '/').toString().split('?')[0].split('#')[0];\n        const trimmed = cleaned.replace(/\\/$/, '');\n        return trimmed || '/';\n      };\n      const getLinkPath = (href) => {\n        if (!href) return '';\n        try {\n          return new URL(href, window.location.origin).pathname;\n        } catch (error) {\n          return href;\n        }\n      };\n\n      this.navLinks.forEach(link => {\n        const requiresSuperAdmin = link.getAttribute('data-requires-super-admin') === 'true';\n        const requiresStakeholderOnly = link.getAttribute('data-requires-stakeholder-only') === 'true';\n        if (!requiresSuperAdmin && !requiresStakeholderOnly) {\n          link.classList.remove('hidden');\n        }\n      });\n\n      // Add event listeners for interactivity\n      this.navLinks.forEach((link) => {\n        link.addEventListener('click', (event) => {\n          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {\n            return;\n          }\n          const router = window.appShellRouter;\n          if (router?.canHandle?.(link.href)) {\n            event.preventDefault();\n            router.navigate(link.href);\n          }\n        });\n\n        link.addEventListener('mouseenter', (event) => this.moveIndicators(event.target));\n        link.addEventListener('mouseleave', () => this.resetIndicators());\n      });\n    }\n\n    markActiveLinkByURL() {\n      const path = new URL(window.location).pathname;\n      const matchingLink = this.navLinks.find(link => {\n        const href = link.getAttribute('href');\n        const linkPath = href ? new URL(href, window.location.origin).pathname : '';\n        // Clean paths by removing trailing slashes\n        const cleanHref = linkPath === \"/\" ? \"/\" : linkPath.replace(/\\/$/, \"\");\n        const cleanPath = path.replace(/\\/$/, \"\") || \"/\";\n        \n        // Exact match for root path\n        if (cleanHref === \"/\" && cleanPath === \"/\") return true;\n        \n        // For non-root paths, use exact matching to avoid conflicts\n        if (cleanHref !== \"/\" && cleanPath === cleanHref) return true;\n        \n        return false;\n      });\n      \n      if (matchingLink) {\n        this.setActiveLink(matchingLink);\n      }\n    }\n\n    updateAuthLinks(isAuthenticated) {\n      this.navLinks.forEach(link => {\n        const requiresAuth = link.getAttribute('data-requires-auth') === 'true';\n        if (requiresAuth) {\n          link.style.display = isAuthenticated ? '' : 'none';\n        }\n      });\n\n      // Reset indicators position after visibility change\n      if (this.activeElement) {\n        this.moveIndicators(this.activeElement);\n      }\n    }\n\n    async updateSuperAdminLinks() {\n      const currentUserEmail = document.body.dataset.userEmail;\n      const isSuperAdmin = await isUserSuperAdmin(currentUserEmail);\n\n      // Hide/show links that require super admin\n      this.navLinks.forEach(link => {\n        const requiresSuperAdmin = link.getAttribute('data-requires-super-admin') === 'true';\n        if (requiresSuperAdmin) {\n          link.style.display = isSuperAdmin ? 'block' : 'none';\n        }\n      });\n\n      // Reset indicators position after visibility change\n      if (this.activeElement) {\n        this.moveIndicators(this.activeElement);\n      }\n    }\n\n    async updateStakeholderOnlyLinks() {\n      const currentUserEmail = normalizeEmail(document.body.dataset.userEmail);\n      if (!currentUserEmail) return;\n\n      try {\n        const { entityDirectoryService } = await import(\n          /* @vite-ignore */ `${window.location.origin}/js/services/entity-directory-service.js`\n        );\n        await entityDirectoryService.init();\n\n        const devId = entityDirectoryService.resolveDeveloperId(currentUserEmail);\n        const stkId = entityDirectoryService.resolveStakeholderId(currentUserEmail);\n        const isStakeholderOnly = stkId && !devId;\n\n        this.navLinks.forEach(link => {\n          const requiresStakeholderOnly = link.getAttribute('data-requires-stakeholder-only') === 'true';\n          if (requiresStakeholderOnly) {\n            link.style.display = isStakeholderOnly ? '' : 'none';\n          }\n          // Hide Admin Project for stakeholder-only users\n          const href = link.getAttribute('href');\n          if (href === '/adminproject/' && isStakeholderOnly) {\n            link.style.display = 'none';\n          }\n        });\n      } catch (error) {\n        // On error, keep default visibility (cleanview hidden)\n      }\n    }\n\n    moveIndicators(target) {\n      if (!target || !this.indicatorTop || !this.indicatorBottom) return;\n\n      const { offsetLeft, offsetWidth } = target;\n      const nav = target.closest('nav');\n      const navPaddingLeft = parseInt(getComputedStyle(nav).paddingLeft, 10) || 0;\n      const offsetLeftFix = offsetLeft - navPaddingLeft;\n\n      this.indicatorTop.style.width = `${offsetWidth}px`;\n      this.indicatorTop.style.transform = `translateX(${offsetLeftFix}px)`;\n\n      this.indicatorBottom.style.width = `${offsetWidth}px`;\n      this.indicatorBottom.style.transform = `translateX(${offsetLeftFix}px)`;\n    }\n\n    resetIndicators() {\n      if (this.activeElement) {\n        this.moveIndicators(this.activeElement);\n      }\n    }\n\n    setActiveLink(link) {\n      this.activeElement = link;\n      // Remover clase active de todos los links\n      this.navLinks.forEach(l => {\n        l.classList.remove('active');\n        l.removeAttribute('active');\n      });\n      // Añadir clase active al link seleccionado\n      link.classList.add('active');\n      link.setAttribute('active', '');\n      this.moveIndicators(link);\n    }\n\n    // Public methods for backward compatibility\n    updateNavLinksPublic() {\n      this.updateNavLinks();\n    }\n\n    markActiveLinkByURLPublic() {\n      this.markActiveLinkByURL();\n    }\n  }\n\n  // Initialize on every page load (View Transitions compatible)\n  document.addEventListener('astro:page-load', () => {\n    if (window.menuNavSSR) {\n      window.menuNavSSR.updateNavLinksPublic();\n      window.menuNavSSR.markActiveLinkByURLPublic();\n      return;\n    }\n    window.menuNavSSR = new MenuNavSSR();\n\n    // Make methods available globally for backward compatibility\n    const menunav = document.getElementById('menunav');\n    if (menunav) {\n      menunav.updateNavLinks = () => window.menuNavSSR.updateNavLinksPublic();\n      menunav.markActiveLinkByURL = () => window.menuNavSSR.markActiveLinkByURLPublic();\n    }\n  });\n</script>\n\n<style>\n  nav {\n    display: flex;\n    gap: 2px;\n    position: relative;\n    padding: 0 1.5rem;\n    background: var(--bg-primary, #ffffff);\n    height: 2.5rem;\n    align-items: center;\n    border-bottom: 1px solid var(--border-subtle, #e2e8f0);\n  }\n\n  .nav-link {\n    text-decoration: none;\n    color: var(--text-muted, #64748b);\n    padding: 0.35rem 0.75rem;\n    position: relative;\n    font-size: 0.85rem;\n    font-weight: 500;\n    transition: color 0.15s ease, background-color 0.15s ease;\n    border-radius: 6px;\n  }\n\n  .nav-link:hover {\n    color: var(--text-primary, #0f172a);\n    background: var(--bg-secondary, #f1f5f9);\n  }\n\n  .nav-link[active],\n  .nav-link.active {\n    font-weight: 600;\n    color: var(--brand-primary, #6366f1);\n    background: rgba(99, 102, 241, 0.08);\n  }\n\n  .nav-link[active]::after,\n  .nav-link.active::after {\n    content: '';\n    position: absolute;\n    bottom: -0.45rem;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 60%;\n    height: 2px;\n    background: var(--brand-primary, #6366f1);\n    border-radius: 1px;\n  }\n\n  .nav-link.hidden {\n    display: none;\n  }\n\n  .nav-indicator {\n    position: absolute;\n    height: 2px;\n    background-color: var(--brand-primary, #6366f1);\n    transition: all 0.2s ease-in-out;\n    width: 0;\n  }\n\n  .nav-indicator.top {\n    top: 0;\n  }\n\n  .nav-indicator.bottom {\n    bottom: 0;\n  }\n\n  .nav-link.doc-link {\n    margin-left: auto;\n    background: var(--bg-secondary, #f1f5f9);\n    color: var(--text-muted, #64748b);\n    border-radius: 6px;\n    font-size: 0.8rem;\n    padding: 0.2rem 0.65rem;\n    border: 1px solid var(--border-subtle, #e2e8f0);\n  }\n\n  .nav-link.doc-link:hover {\n    background: var(--bg-tertiary, #e2e8f0);\n    color: var(--text-primary, #0f172a);\n  }\n</style>\n","numLines":455,"startLine":1,"totalLines":455}}} (stream=stdout)
