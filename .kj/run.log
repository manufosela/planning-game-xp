klogBtn')?.addEventListener('click', () => syncBacklogs());\n        listenDevelopers();\n        listenWip();\n        listenBacklogs();\n        restoreTabFromUrl(); // Restore tab from URL on page load\n        render();\n      }, { once: true });\n    }\n  }\n\n  init();\n</script>\n\n<style>\n  .wip-tabs {\n    display: flex;\n    gap: 0.5rem;\n    margin: 1rem 0;\n  }\n  .tab-button {\n    border: 1px solid var(--border-default, #d1d5db);\n    background: var(--bg-secondary, #f9fafb);\n    padding: 0.5rem 0.75rem;\n    border-radius: 6px;\n    cursor: pointer;\n    font-weight: 600;\n    color: var(--text-primary, #374151);\n  }\n  .tab-button.active {\n    background: var(--brand-primary, #111827);\n    color: var(--text-on-primary, #fff);\n    border-color: var(--brand-primary, #111827);\n  }\n  .tab-panel.hidden {\n    display: none;\n  }\n  .backlog-header {\n    display: flex;\n    justify-content: flex-end;\n    margin-bottom: 1rem;\n  }\n  .refresh-backlog-btn {\n    padding: 0.5rem 1rem;\n    background: var(--primary-color, #3b82f6);\n    color: var(--text-on-primary, #fff);\n    border: none;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.875rem;\n    transition: background 0.2s;\n  }\n  .refresh-backlog-btn:hover {\n    background: var(--primary-color-dark, #2563eb);\n  }\n  .refresh-backlog-btn:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n  .backlog-list {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n  }\n  .backlog-card {\n    border: 1px solid var(--border-default, #e5e7eb);\n    border-radius: 12px;\n    padding: 0.5rem 1rem 1rem;\n    background: var(--bg-primary, #fff);","numLines":100,"startLine":1370,"totalLines":1769}}} (stream=stdout)
