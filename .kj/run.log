03:07:12.126 [agent:output] [coder] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LwLwkSFkX8vbEXBm5NmjmE","type":"tool_result","content":"<persisted-output>\nOutput too large (62KB). Full output saved to: /home/manu/.claude/projects/-home-manu-ws-firebase-planning-game-xp/090f70b5-7077-4308-b00f-8c0e9128924e/tool-results/toolu_01LwLwkSFkX8vbEXBm5NmjmE.txt\n\nPreview (first 2KB):\n     1→---\n     2→import { ViewTransitions } from 'astro:transitions';\n     3→import MenuNav from '../components/MenuNav.astro';\n     4→import AppFooter from '../components/AppFooter.astro';\n     5→\n     6→interface Props {\n     7→  title: string;\n     8→  shellRoute?: string;\n     9→  shellPartial?: string;\n    10→  shellRoutes?: Record<string, string | { partial?: string; partialUrl?: string; cache?: boolean }>;\n    11→}\n    12→\n    13→const { title, shellRoute = '', shellPartial = '', shellRoutes } = Astro.props;\n    14→let user = null;\n    15→---\n    16→\n    17→<!doctype html>\n    18→<html lang=\"en\">\n    19→  <head>\n    20→    <meta charset=\"UTF-8\" />\n    21→    <meta name=\"description\" content=\"XP Planning Game\" />\n    22→    <meta name=\"viewport\" content=\"width=device-width\" />\n    23→    <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\" />\n    24→    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    25→    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    26→    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n    27→    <title>{title}</title>\n    28→    <ViewTransitions />\n    29→    <link rel=\"manifest\" href=\"/manifest.json\">\n    30→    <!-- Blocking: apply cached theme tokens before first paint to prevent FOUC -->\n    31→    <script is:inline>\n    32→      (function() {\n    33→        try {\n    34→          var raw = localStorage.getItem('pgxp-theme-config');\n    35→          if (!raw) return;\n    36→          var config = JSON.parse(raw);\n    37→          var tokens = config && config.tokens;\n    38→          if (!tokens) return;\n    39→          var root = document.documentElement;\n    40→          function kebab(s) { return s.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase(); }\n    41→          function apply(obj, prefix) {\n    42→            for (var k in obj) {\n    43→              if (!obj.hasOwnProperty(k)) continue;\n...\n</persisted-output>"}]},"parent_tool_use_id":null,"session_id":"090f70b5-7077-4308-b00f-8c0e9128924e","uuid":"0e13cbb8-bccd-4795-ba26-c427e58affe7","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/layouts/Layout.astro","content":"---\nimport { ViewTransitions } from 'astro:transitions';\nimport MenuNav from '../components/MenuNav.astro';\nimport AppFooter from '../components/AppFooter.astro';\n\ninterface Props {\n  title: string;\n  shellRoute?: string;\n  shellPartial?: string;\n  shellRoutes?: Record<string, string | { partial?: string; partialUrl?: string; cache?: boolean }>;\n}\n\nconst { title, shellRoute = '', shellPartial = '', shellRoutes } = Astro.props;\nlet user = null;\n---\n\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"description\" content=\"XP Planning Game\" />\n    <meta name=\"viewport\" content=\"width=device-width\" />\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n    <title>{title}</title>\n    <ViewTransitions />\n    <link rel=\"manifest\" href=\"/manifest.json\">\n    <!-- Blocking: apply cached theme tokens before first paint to prevent FOUC -->\n    <script is:inline>\n      (function() {\n        try {\n          var raw = localStorage.getItem('pgxp-theme-config');\n          if (!raw) return;\n          var config = JSON.parse(raw);\n          var tokens = config && config.tokens;\n          if (!tokens) return;\n          var root = document.documentElement;\n          function kebab(s) { return s.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase(); }\n          function apply(obj, prefix) {\n            for (var k in obj) {\n              if (!obj.hasOwnProperty(k)) continue;\n              var name = prefix ? '--' + prefix + '-' + kebab(k) : '--' + kebab(k);\n              var v = obj[k];\n              if (typeof v === 'object' && v !== null) {\n                apply(v, prefix ? prefix + '-' + kebab(k) : kebab(k));\n              } else {\n                root.style.setProperty(name, v);\n              }\n            }\n          }\n          apply(tokens, '');\n          // Apply text-on-primary alias for header/footer\n          if (tokens.text && tokens.text.onPrimary) {\n            root.style.setProperty('--text-on-primary', tokens.text.onPrimary);\n            root.style.setProperty('--footer-text', tokens.text.onPrimary);\n          }\n          // Apply dark/light mode from cache\n          var theme = localStorage.getItem('pgxp-theme');\n          if (theme === 'dark') {\n            root.classList.add('dark-theme');\n            // Apply critical dark tokens before ThemeManagerService loads\n            var dt = {\n              '--bg-primary':'#0f172a','--bg-secondary':'#1e293b','--bg-tertiary':'#334155',\n              '--text-primary':'#f8fafc','--text-secondary':'#e2e8f0','--text-muted':'#94a3b8',\n              '--border-default':'#475569','--border-subtle':'#334155',\n              '--card-bg':'#1e293b','--input-bg':'#1e293b','--input-border':'#475569',\n              '--header-bg':'#0f172a','--modal-bg':'#0f172a',\n              '--dropdown-bg':'#1e293b','--dropdown-border':'#334155',\n              '--table-header-bg':'#1e293b','--table-row-bg':'#0f172a'\n            };\n            for (var p in dt) root.style.setProperty(p, dt[p]);\n          }\n        } catch(e) {}\n      })();\n    </script>\n    <!-- Import Maps for npm packages -->\n    <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"lit\": \"https://cdn.jsdelivr.net/npm/lit@3.2.1/+esm\",\n        \"lit/\": \"https://cdn.jsdelivr.net/npm/lit@3.2.1/\",\n        \"lit-html\": \"https://cdn.jsdelivr.net/npm/lit-html@3.2.1/+esm\",\n        \"lit-html/\": \"https://cdn.jsdelivr.net/npm/lit-html@3.2.1/\",\n        \"@lit/reactive-element\": \"https://cdn.jsdelivr.net/npm/@lit/reactive-element@2.0.4/+esm\",\n        \"@lit/reactive-element/\": \"https://cdn.jsdelivr.net/npm/@lit/reactive-element@2.0.4/\",\n        \"@manufosela/slide-notification\": \"https://unpkg.com/@manufosela/slide-notification@2.1.0/src/slide-notification.js\",\n        \"@manufosela/multi-select\": \"https://unpkg.com/@manufosela/multi-select@2.1.0/src/multi-select.js\",\n        \"@manufosela/app-modal\": \"https://unpkg.com/@manufosela/app-modal@2.2.0/src/app-modal.js\"\n      }\n    }\n    </script>\n    <!-- Precargar módulos críticos para evitar retrasos en el renderizado -->\n    <link rel=\"modulepreload\" href=\"https://cdn.jsdelivr.net/npm/lit@3.2.1/+esm\" />\n    <link rel=\"modulepreload\" href=\"/firebase-config.js\" />\n    <!-- System Capabilities Lit Components - UMD Bundle para SSG -->\n    <script src=\"https://cdn.jsdelivr.net/npm/@system-capabilities/lit@1.1.1/dist/system-capabilities-lit.umd.min.js\"></script>\n  </head>\n  <body\n    data-user-email={user || ''}\n    data-authenticated=\"false\"\n    data-shell-route={shellRoute}\n    data-shell-partial={shellPartial}\n    data-shell-routes={shellRoutes ? JSON.stringify(shellRoutes) : undefined}\n  >\n    <header transition:animate=\"none\">\n      <a href=\"/\" class=\"header-logos\" data-astro-reload>\n        <img src=\"/images/icono_PGame.png\" alt=\"Planning Game\" class=\"planning-game-icon\" />\n        <span id=\"orgBranding\" class=\"org-branding hidden\"></span>\n      </a>\n      <div class=\"header-title-container\">\n        <h1>Planning Game</h1>\n        <system-status\n          id=\"systemStatusIndicator\"\n          size=\"medium\"\n          autoCheck\n          showTooltip\n        ></system-status>\n      </div>\n      <div class=\"user-info\">\n        <theme-toggle></theme-toggle>\n        <notification-bell id=\"notificationBell\" class=\"hidden\"></notification-bell>\n        <span id=\"user-status\">Cargando...</span>\n        <div class=\"auth-actions\">\n          <button id=\"oauthLoginButton\" class=\"login-button hidden\">Sign in</button>\n          <button id=\"emailLoginToggle\" class=\"secondary-button hidden\">Entrar con email</button>\n          <form id=\"emailLoginForm\" class=\"email-login-form hidden\">\n            <label class=\"sr-only\" for=\"emailLoginInput\">Correo electrónico</label>\n            <input id=\"emailLoginInput\" name=\"email\" type=\"email\" placeholder=\"Correo electrónico\" autocomplete=\"username\" required />\n            <label class=\"sr-only\" for=\"emailLoginPassword\">Contraseña</label>\n            <input id=\"emailLoginPassword\" name=\"password\" type=\"password\" placeholder=\"Contraseña\" autocomplete=\"current-password\" required />\n            <div class=\"email-login-actions\">\n              <button type=\"submit\" class=\"login-button\">Entrar</button>\n              <button type=\"button\" id=\"emailLoginCancel\" class=\"secondary-button\">Cancelar</button>\n            </div>\n            <p id=\"emailLoginError\" class=\"error-message hidden\"></p>\n            <p class=\"form-helper-text\">\n              ¿No tienes cuenta?\n              <button type=\"button\" id=\"emailRegisterLink\" class=\"link-button\">Solicitar acceso</button>\n            </p>\n          </form>\n          <form id=\"emailRegisterForm\" class=\"email-register-form hidden\">\n            <h2>Solicitar acceso</h2>\n            <p class=\"form-helper-text\">Al enviar la solicitud, el equipo aprobará tu cuenta antes de que puedas acceder.</p>\n            <label class=\"sr-only\" for=\"emailRegisterName\">Nombre completo</label>\n            <input id=\"emailRegisterName\" name=\"fullName\" type=\"text\" placeholder=\"Nombre completo\" autocomplete=\"name\" required />\n            <label class=\"sr-only\" for=\"emailRegisterEmail\">Correo electrónico</label>\n            <input id=\"emailRegisterEmail\" name=\"email\" type=\"email\" placeholder=\"Correo electrónico corporativo\" autocomplete=\"email\" required />\n            <label class=\"sr-only\" for=\"emailRegisterPassword\">Contraseña deseada</label>\n            <input id=\"emailRegisterPassword\" name=\"password\" type=\"password\" placeholder=\"Contraseña (mínimo 6 caracteres)\" autocomplete=\"new-password\" minlength=\"6\" required />\n            <div class=\"email-login-actions\">\n              <button type=\"submit\" id=\"emailRegisterSubmit\" class=\"login-button\">Enviar solicitud</button>\n              <button type=\"button\" id=\"emailRegisterCancel\" class=\"secondary-button\">Cancelar</button>\n            </div>\n            <p id=\"emailRegisterError\" class=\"error-message hidden\"></p>\n            <p id=\"emailRegisterSuccess\" class=\"success-message hidden\">Solicitud enviada. Revisaremos tus datos y te avisaremos por correo.</p>\n            <p class=\"form-helper-text\">\n              ¿Ya tienes cuenta?\n              <button type=\"button\" id=\"emailRegisterToLogin\" class=\"link-button\">Volver a iniciar sesión</button>\n            </p>\n          </form>\n          <button id=\"logoutButton\" class=\"logout-button hidden\">Logout</button>\n        </div>\n      </div>\n    </header>\n\n    <MenuNav currentPath={Astro.url.pathname} />\n\n    <div id=\"subNavContainer\"></div>\n\n    <div id=\"welcomeMessage\" class=\"welcome-container hidden\">\n      <div class=\"welcome-content\">\n        <img src=\"/images/icono_PGame.png\" alt=\"Planning Game Logo\" class=\"welcome-logo\" />\n        <h1 class=\"welcome-title\"></h1>\n        <p class=\"welcome-subtitle\"></p>\n      </div>\n    </div>\n\n    <main id=\"mainContainer\" class=\"hidden\">\n      <div id=\"mainLoader\" class=\"main-loader\">\n        <div class=\"spinner\"></div>\n      </div>\n      <slot />\n    </main>\n\n    <AppFooter />\n\n    <script>\n      // Ocultar spinner cuando aparezca cualquier contenido visible en main\n      (function() {\n        const loader = document.getElementById('mainLoader');\n        const main = document.getElementById('mainContainer');\n        if (!loader || !main) return;\n\n        const observer = new MutationObserver(function() {\n          // Buscar cualquier elemento visible que no sea el loader\n          const children = main.children;\n          for (let i = 0; i < children.length; i++) {\n            const child = children[i];\n            if (child.id !== 'mainLoader' && child.offsetHeight > 0) {\n              loader.classList.add('hidden');\n              observer.disconnect();\n              return;\n            }\n          }\n        });\n\n        observer.observe(main, { childList: true, subtree: true, attributes: true });\n      })();\n    </script>\n\n    <script type=\"module\">\n      import { LazyLoader } from '/js/utils/lazy-loader.js';\n      import { UserDisplayUtils } from '/js/utils/user-display-utils.js';\n      import { APP_CONSTANTS } from '/js/constants/app-constants.js';\n      import '/js/services/notification-service.js';\n      import '/js/debug-notifications.js';\n      import { database, ref, push, onValue, auth, authProvider, authProviderName, signOut, signInWithPopup, signInWithEmailAndPassword, functions, httpsCallable, app, get } from '/firebase-config.js';\n      import { encodeEmailForFirebase } from '/js/utils/email-sanitizer.js';\n      import { initAppShellRouterFromDataset } from '/js/core/app-shell-router.js';\n      import { SYSTEM_REQUIREMENTS } from '/js/config/system-requirements-config.js';\n\n      // Theme system - initialize on every page via Layout\n      // Blocking script in <head> applies cached tokens before first paint\n      import '/js/wc/ThemeToggle.js';\n      import { ThemeLoaderService } from '/js/services/theme-loader-service.js';\n      import { ThemeManagerService } from '/js/services/theme-manager-service.js';\n\n      // Initialize theme services (design tokens + dark/light mode)\n      // Non-blocking: init tokens synchronously, load config in background\n      ThemeManagerService.init();\n      ThemeLoaderService.loadAndApply().catch(() => {});\n\n      // Version check - detect new deployments and notify users on all pages\n      import '/js/wc/VersionUpdateModal.js';\n      import { versionCheckService } from '/js/services/version-check-service.js';\n      import { version as APP_VERSION } from '/js/version.js';\n      versionCheckService.init(APP_VERSION);\n      if (!document.querySelector('version-update-modal')) {\n        document.body.appendChild(document.createElement('version-update-modal'));\n      }\n\n      let userStatusElement;\n      let oauthLoginButton;\n      let emailLoginToggle;\n      let emailLoginForm;\n      let emailLoginInput;\n      let emailLoginPassword;\n      let emailLoginError;\n      let emailLoginCancel;\n      let emailRegisterForm;\n      let emailRegisterName;\n      let emailRegisterEmail;\n      let emailRegisterPassword;\n      let emailRegisterError;\n      let emailRegisterSuccess;\n      let emailRegisterCancel;\n      let emailRegisterSubmit;\n      let emailRegisterLink;\n      let emailRegisterToLogin;\n      let logoutButton;\n      let mainContainer;\n      let welcomeMessage;\n      let pagePath;\n      let menuNav;\n      let projectSelected = '';\n      let theUser;\n      let DOMisLoaded = false;\n      let _layoutInitialized = false;\n      let _authUnsubscribe = null;\n      let requestAccessCallable = null;\n      let _freshLoginType = null;\n\n      // Make Firebase modules available globally for debugging\n      window.database = database;\n      window.ref = ref;\n      window.get = get;\n      window.auth = auth;\n\n      function updatePageTitle(projectId) {\n        const baseTitle = 'Planning GameXP';\n        const pageTitle = document.querySelector('h1').textContent;\n        document.title = projectId ? `${baseTitle} - ${projectId} - ${pageTitle}` : `${baseTitle} - ${pageTitle}`;\n      }\n\n      const EMAIL_AUTH_ERROR_MESSAGES = {\n        'auth/invalid-email': 'El correo electrónico no es válido.',\n        'auth/user-disabled': 'Este usuario está deshabilitado. Contacta con un administrador.',\n        'auth/user-not-found': 'No existe ningún usuario con ese correo.',\n        'auth/wrong-password': 'La contraseña es incorrecta.',\n        'auth/invalid-credential': 'Credenciales no válidas. Revisa el correo y la contraseña.',\n        'auth/too-many-requests': 'Has realizado demasiados intentos. Espera unos segundos y vuelve a intentarlo.',\n        'auth/network-request-failed': 'No se puede contactar con el servidor. Revisa tu conexión a internet.'\n      };\n\n      const ACCOUNT_REQUEST_ERROR_MESSAGES = {\n        'invalid-argument': 'Revisa los datos introducidos y vuelve a intentarlo.',\n        'already-exists': 'Ya existe una solicitud activa o un usuario con este correo.',\n        'failed-precondition': 'Este correo no pertenece a un dominio permitido.',\n        'resource-exhausted': 'Has superado el número de intentos. Espera un momento antes de reintentarlo.',\n        'internal': 'No se ha podido registrar la solicitud en el servidor. Inténtalo de nuevo más tarde.',\n        default: 'No se ha podido enviar la solicitud. Inténtalo más tarde o contacta con soporte.'\n      };\n\n      // OAuth authentication function\n      async function authenticateWithOAuth() {\n        try {\n          _freshLoginType = 'oauth';\n          await signInWithPopup(auth, authProvider);\n        } catch (error) {\n          _freshLoginType = null;\n          console.error('[Auth] Authentication error:', error.code, error.message);\n\n          // Detect OAuth provider configuration errors (expired credentials, invalid config)\n          const isProviderError =\n            error.code === 'auth/invalid-credential' ||\n            error.code === 'auth/operation-not-allowed' ||\n            error.code === 'auth/internal-error' ||\n            (error.message && error.message.includes('400'));\n\n          if (isProviderError) {\n            const notification = document.createElement('slide-notification');\n            notification.message = 'Error de autenticación. Si el problema persiste, contacta al administrador (posibles credenciales expiradas).';\n            notification.type = 'error';\n            notification.timetohide = 8000;\n            document.body.appendChild(notification);\n          } else if (error.code === 'auth/popup-closed-by-user' || error.code === 'auth/cancelled-popup-request') {\n            // User closed the popup or multiple popups, no need to show error\n            return;\n          } else {\n            const notification = document.createElement('slide-notification');\n            notification.message = 'Error de autenticación. Por favor, inténtalo de nuevo.';\n            notification.type = 'error';\n            document.body.appendChild(notification);\n          }\n        }\n      }\n\n      const normalizeEmail = (email) => (email || '').toString().trim().toLowerCase();\n      const legacyEncodeEmail = (email) => normalizeEmail(email).replace(/[@.#$\\[\\]\\/]/g, '_');\n\n      window.isAppAdmin = false;\n\n      async function updateAppAdminAccess(user) {\n        if (!user?.email) {\n          resetAppAdminAccess();\n          return;\n        }\n\n        const normalizedEmail = normalizeEmail(user.email);\n        const encodedEmail = encodeEmailForFirebase(normalizedEmail || user.email);\n        const legacyEncodedEmail = legacyEncodeEmail(user.email);\n        if (!encodedEmail) {\n          resetAppAdminAccess();\n          return;\n        }\n\n          try {\n            let hasAccess = false;\n\n            // First check: Super Admin from environment variable\n            let superAdminEmail = '';\n            try {\n              const firebaseConfigModule = await import('/firebase-config.js');\n              superAdminEmail = normalizeEmail(firebaseConfigModule.superAdminEmail || '');\n            } catch (error) {\n            }\n\n            if (superAdminEmail && normalizedEmail === superAdminEmail) {\n              hasAccess = true;\n            }\n\n            // Second check: appAdmins from Firebase (only if not already granted)\n            if (!hasAccess) {\n              const appAdminsRef = ref(database, '/data/appAdmins');\n              const snapshot = await get(appAdminsRef);\n              if (snapshot.exists()) {\n                const value = snapshot.val();\n                if (Array.isArray(value)) {\n                  hasAccess = value.some(candidate => {\n                    const normalizedCandidate = normalizeEmail(candidate);\n                    return candidate === encodedEmail || normalizedCandidate === normalizedEmail;\n                  });\n                } else if (typeof value === 'object') {\n                  const candidates = [\n                    ...Object.keys(value),\n                    ...Object.values(value)\n                  ];\n                  hasAccess = candidates.some(candidate => {\n                    const normalizedCandidate = normalizeEmail(candidate);\n                    return candidate === encodedEmail || normalizedCandidate === normalizedEmail;\n                  });\n                }\n              }\n            }\n\n            // NOTE: /data/superAdminEmails is DEPRECATED and no longer used\n            // SuperAdmin is only the ONE defined in .env (superAdminEmail)\n            // AppAdmins are those in /data/appAdmins\n\n            window.isAppAdmin = hasAccess;\n        } catch (error) {\n          window.isAppAdmin = false;\n        }\n\n        document.dispatchEvent(new CustomEvent('app-admin-status-changed', {\n          detail: { isAppAdmin: window.isAppAdmin }\n        }));\n      }\n\n      function resetAppAdminAccess() {\n        window.isAppAdmin = false;\n        document.dispatchEvent(new CustomEvent('app-admin-status-changed', {\n          detail: { isAppAdmin: false }\n        }));\n      }\n\n      function showEmailLoginForm() {\n        if (!emailLoginForm || !emailLoginToggle) return;\n        emailLoginForm.classList.remove('hidden');\n        emailLoginToggle.classList.add('hidden');\n        hideEmailLoginError();\n        requestAnimationFrame(() => emailLoginInput?.focus());\n      }\n\n      function hideEmailLoginForm({ resetForm = false, showToggle = true } = {}) {\n        if (!emailLoginForm || !emailLoginToggle) return;\n        emailLoginForm.classList.add('hidden');\n        if (showToggle) {\n          emailLoginToggle.classList.remove('hidden');\n        } else {\n          emailLoginToggle.classList.add('hidden');\n        }\n        if (resetForm) {\n          emailLoginForm.reset();\n          hideEmailLoginError();\n        }\n      }\n\n      function hideEmailLoginError() {\n        if (!emailLoginError) return;\n        emailLoginError.textContent = '';\n        emailLoginError.classList.add('hidden');\n      }\n\n      function showEmailLoginError(message) {\n        if (!emailLoginError) return;\n        emailLoginError.textContent = message;\n        emailLoginError.classList.remove('hidden');\n      }\n\n      function showEmailRegisterForm() {\n        if (!emailRegisterForm) return;\n        hideEmailLoginForm({ resetForm: false, showToggle: false });\n        emailRegisterForm.classList.remove('hidden');\n        hideEmailRegisterFeedback();\n        requestAnimationFrame(() => emailRegisterName?.focus());\n      }\n\n      function hideEmailRegisterForm({ resetForm = false, showLoginToggle = true } = {}) {\n        if (!emailRegisterForm) return;\n        emailRegisterForm.classList.add('hidden');\n        if (resetForm) {\n          emailRegisterForm.reset();\n        }\n        hideEmailRegisterFeedback();\n        setEmailRegisterSubmitting(false);\n        if (showLoginToggle) {\n          emailLoginToggle?.classList.remove('hidden');\n        }\n      }\n\n      function hideEmailRegisterFeedback() {\n        if (emailRegisterError) {\n          emailRegisterError.textContent = '';\n          emailRegisterError.classList.add('hidden');\n        }\n        if (emailRegisterSuccess) {\n          emailRegisterSuccess.classList.add('hidden');\n        }\n      }\n\n      function showEmailRegisterError(message) {\n        if (!emailRegisterError) return;\n        emailRegisterError.textContent = message;\n        emailRegisterError.classList.remove('hidden');\n        if (emailRegisterSuccess) {\n          emailRegisterSuccess.classList.add('hidden');\n        }\n      }\n\n      function showEmailRegisterSuccess(message) {\n        if (!emailRegisterSuccess) return;\n        emailRegisterSuccess.textContent = message;\n        emailRegisterSuccess.classList.remove('hidden');\n        if (emailRegisterError) {\n          emailRegisterError.classList.add('hidden');\n        }\n      }\n\n      function setEmailRegisterSubmitting(isSubmitting) {\n        if (!emailRegisterSubmit) return;\n        emailRegisterSubmit.disabled = isSubmitting;\n        emailRegisterSubmit.textContent = isSubmitting ? 'Enviando...' : 'Enviar solicitud';\n        if (emailRegisterForm) {\n          const inputs = emailRegisterForm.querySelectorAll('input, select, textarea, button');\n          inputs.forEach((input) => {\n            if (input instanceof HTMLButtonElement && input.type === 'button') return;\n            input.disabled = isSubmitting;\n          });\n        }\n      }\n\n      function getRequestAccessCallable() {\n        if (!functions || !httpsCallable) return null;\n        if (!requestAccessCallable) {\n          try {\n            requestAccessCallable = httpsCallable(functions, 'requestEmailAccess');\n          } catch (error) {\n            requestAccessCallable = null;\n          }\n        }\n        return requestAccessCallable;\n      }\n\n      async function authenticateWithEmail(event) {\n        event.preventDefault();\n        if (!emailLoginInput || !emailLoginPassword) return;\n\n        hideEmailLoginError();\n\n        const email = emailLoginInput.value.trim();\n        const password = emailLoginPassword.value;\n\n        if (!email || !password) {\n          showEmailLoginError('Introduce un correo y una contraseña.');\n          return;\n        }\n\n        try {\n          _freshLoginType = 'email';\n          await signInWithEmailAndPassword(auth, email, password);\n        } catch (error) {\n          _freshLoginType = null;\n          const message = EMAIL_AUTH_ERROR_MESSAGES[error.code] || 'Ha ocurrido un error al iniciar sesión. Inténtalo de nuevo.';\n          showEmailLoginError(message);\n        }\n      }\n\n      async function submitEmailRegistration(event) {\n        event.preventDefault();\n        if (!emailRegisterForm || !emailRegisterEmail || !emailRegisterPassword) return;\n\n        hideEmailRegisterFeedback();\n\n        const fullName = (emailRegisterName?.value || '').trim();\n        const email = emailRegisterEmail.value.trim().toLowerCase();\n        const password = emailRegisterPassword.value;\n\n        if (!fullName || !email || !password) {\n          showEmailRegisterError('Completa todos los campos obligatorios antes de enviar.');\n          return;\n        }\n\n        if (password.length < 6) {\n          showEmailRegisterError('La contraseña debe tener al menos 6 caracteres.');\n          return;\n        }\n\n        const allowedDomains = Array.isArray(APP_CONSTANTS.AUTH_ALLOWED_EMAIL_DOMAINS)\n          ? APP_CONSTANTS.AUTH_ALLOWED_EMAIL_DOMAINS\n          : [];\n        const emailDomain = email.split('@')[1];\n        if (!emailDomain || !allowedDomains.includes(emailDomain)) {\n          showEmailRegisterError('El correo debe pertenecer a un dominio autorizado por la compañía.');\n          return;\n        }\n\n        const callable = getRequestAccessCallable();\n        if (!callable) {\n          showEmailRegisterError('Servicio no disponible temporalmente. Inténtalo más tarde.');\n          return;\n        }\n\n        setEmailRegisterSubmitting(true);\n\n        try {\n          await callable({\n            fullName,\n            email,\n            password\n          });\n\n          showEmailRegisterSuccess('Solicitud enviada. Revisaremos tus datos y activaremos la cuenta cuando sea aprobada.');\n          if (emailRegisterForm) {\n            emailRegisterForm.reset();\n          }\n        } catch (error) {\n          const errorCode = error?.code?.replace('functions/', '');\n          const message = ACCOUNT_REQUEST_ERROR_MESSAGES[errorCode] || ACCOUNT_REQUEST_ERROR_MESSAGES.default;\n          showEmailRegisterError(message);\n        } finally {\n          setEmailRegisterSubmitting(false);\n        }\n      }\n\n      function addProjectToLinks(projectId) {\n        const links = [...document.querySelectorAll('.menu-nav .nav-link')].slice(1);\n        links.forEach((link) => {\n          try {\n            const url = new URL(link.href, window.location.origin);\n            url.searchParams.set('projectId', projectId);\n            link.href = url.toString();\n          } catch (e) {\n            // Si algo falla, no romper la navegación\n          }\n        });\n        updatePageTitle(projectId);\n      }\n\n\n      function notSignedIn() {\n        getDomElements();\n        theUser = null;\n        window.currentUser = null; // Limpiar también window.currentUser\n        resetAppAdminAccess();\n        document.body.setAttribute('data-authenticated', 'false');\n\n        // Redirect to home if on a protected page\n        const protectedPages = ['/adminproject', '/dashboard', '/sprintview', '/development', '/wip', '/proposals'];\n        const currentPath = window.location.pathname;\n        if (protectedPages.some(page => currentPath.startsWith(page))) {\n          window.location.href = '/';\n          return;\n        }\n\n        userStatusElement.textContent = 'Not signed in';\n        oauthLoginButton?.classList.remove('hidden');\n        emailLoginToggle?.classList.remove('hidden');\n        hideEmailLoginForm({ resetForm: true });\n        hideEmailRegisterForm({ resetForm: true });\n        logoutButton.classList.add('hidden');\n        mainContainer.classList.add('hidden');\n        if (welcomeMessage) {\n          welcomeMessage.classList.remove('hidden');\n        }\n        const notificationBell = document.getElementById('notificationBell');\n        if (notificationBell) {\n          notificationBell.classList.add('hidden');\n        }\n\n        // Notify menu about user sign out\n        document.dispatchEvent(new CustomEvent('user-signed-out'));\n      }\n\n      function _recordLoginEvent(user) {\n        const sessionKey = `loginRecorded_${user.uid}`;\n        if (sessionStorage.getItem(sessionKey)) return;\n        const encodedEmail = encodeEmailForFirebase((user.email || '').toLowerCase());\n        if (!encodedEmail) return;\n        push(ref(database, `/loginHistory/${encodedEmail}`), {\n          timestamp: new Date().toISOString(),\n          email: user.email,\n          displayName: user.displayName || '',\n          provider: user.providerData?.[0]?.providerId || 'unknown',\n          loginType: _freshLoginType || 'session-restore',\n          userAgent: navigator.userAgent,\n        }).then(() => sessionStorage.setItem(sessionKey, 'true'))\n          .catch(e => console.error('[Auth] Login event failed:', e));\n        _freshLoginType = null;\n      }\n\n      function signedIn(user) {\n        getDomElements();\n        theUser = user;\n        window.currentUser = user; // Añadir para que lo use NotificationBell\n        document.body.setAttribute('data-authenticated', 'true');\n        const userName = user.displayName || user.email || 'Usuario sin nombre';\n        userStatusElement.textContent = `Signed in as ${userName}`;\n        oauthLoginButton?.classList.add('hidden');\n        emailLoginToggle?.classList.add('hidden');\n        hideEmailLoginForm({ resetForm: true, showToggle: false });\n        hideEmailRegisterForm({ resetForm: true, showLoginToggle: false });\n        logoutButton.classList.remove('hidden');\n        mainContainer.classList.remove('hidden');\n        if (welcomeMessage) {\n          welcomeMessage.classList.add('hidden');\n        }\n        // Navigation allowed - MenuNav SSR handles this automatically\n        if (pagePath !== '/') {\n          addProjectToLinks(projectSelected);\n        }\n        document.body.dataset.userEmail = user.email || '';\n\n        // Show notification bell\n        const notificationBell = document.getElementById('notificationBell');\n        if (notificationBell) {\n          notificationBell.classList.remove('hidden');\n        }\n\n        // Notify notification bell about user authentication\n        document.dispatchEvent(new CustomEvent('user-authenticated', {\n          detail: { user: user }\n        }));\n\n        updateAppAdminAccess(user);\n\n        // Record login event for history tracking\n        _recordLoginEvent(user);\n\n        // Initialize FCM for push notifications\n        if (window.pushNotificationService) {\n          window.pushNotificationService.reinitializeForUser(user.email).catch(error => {\n          });\n        }\n      }\n\n\n      function getDomElements() {\n        userStatusElement = document.getElementById('user-status');\n        oauthLoginButton = document.getElementById('oauthLoginButton');\n        emailLoginToggle = document.getElementById('emailLoginToggle');\n        emailLoginForm = document.getElementById('emailLoginForm');\n        emailLoginInput = document.getElementById('emailLoginInput');\n        emailLoginPassword = document.getElementById('emailLoginPassword');\n        emailLoginError = document.getElementById('emailLoginError');\n        emailLoginCancel = document.getElementById('emailLoginCancel');\n        emailRegisterForm = document.getElementById('emailRegisterForm');\n        emailRegisterName = document.getElementById('emailRegisterName');\n        emailRegisterEmail = document.getElementById('emailRegisterEmail');\n        emailRegisterPassword = document.getElementById('emailRegisterPassword');\n        emailRegisterError = document.getElementById('emailRegisterError');\n        emailRegisterSuccess = document.getElementById('emailRegisterSuccess');\n        emailRegisterCancel = document.getElementById('emailRegisterCancel');\n        emailRegisterSubmit = document.getElementById('emailRegisterSubmit');\n        emailRegisterLink = document.getElementById('emailRegisterLink');\n        emailRegisterToLogin = document.getElementById('emailRegisterToLogin');\n        logoutButton = document.getElementById('logoutButton');\n        mainContainer = document.getElementById('mainContainer');\n        welcomeMessage = document.getElementById('welcomeMessage');\n        menuNav = document.getElementById('menunav');\n      }\n\n      function applyOrganizationBranding() {\n        const container = document.getElementById('orgBranding');\n        if (!container) return;\n\n        const orgName = APP_CONSTANTS.ORG_NAME;\n        // If no org name configured, skip branding entirely\n        if (!orgName) return;\n\n        const imageExtensions = ['.png', '.jpg', '.jpeg', '.svg', '.webp'];\n        const isImagePath = imageExtensions.some(ext => orgName.toLowerCase().endsWith(ext));\n\n        // Try to load org logo image (symlinked from instance to /images/org-logo.*)\n        // We try common extensions since the instance may have any format\n        const extensionsToTry = isImagePath\n          ? [orgName.substring(orgName.lastIndexOf('.'))]\n          : [...imageExtensions];\n\n        function tryLoadImage(exts, index = 0) {\n          if (index >= exts.length) {\n            // No image found — fall back to text h1 if orgName is plain text\n            if (orgName && !isImagePath) {\n              const heading = document.createElement('h1');\n              heading.className = 'org-name-heading';\n              heading.textContent = orgName;\n              container.innerHTML = '';\n              container.append(heading);\n              container.classList.remove('hidden');\n              container.setAttribute('aria-label', `Organización: ${orgName}`);\n            }\n            return;\n          }\n          const img = new Image();\n          img.src = `/images/org-logo${exts[index]}`;\n          img.onload = () => {\n            img.alt = (isImagePath ? '' : orgName) || 'Organization logo';\n            img.className = 'org-logo';\n            container.innerHTML = '';\n            container.append(img);\n            container.classList.remove('hidden');\n          };\n          img.onerror = () => tryLoadImage(exts, index + 1);\n        }\n\n        tryLoadImage(extensionsToTry);\n      }\n\n      async function DOMContentLoadedActions() {\n        getDomElements();\n        applyOrganizationBranding();\n        pagePath = window.location.pathname;\n\n        if (!_layoutInitialized) {\n          if (oauthLoginButton) {\n            const providerLabels = { google: 'Google', microsoft: 'Microsoft', github: 'GitHub', gitlab: 'GitLab' };\n            oauthLoginButton.textContent = `Sign in with ${providerLabels[authProviderName] || 'OAuth'}`;\n            oauthLoginButton.addEventListener('click', authenticateWithOAuth);\n          }\n          if (emailLoginToggle) {\n            emailLoginToggle.addEventListener('click', showEmailLoginForm);\n          }\n          if (emailLoginForm) {\n            emailLoginForm.addEventListener('submit', authenticateWithEmail);\n          }\n          if (emailLoginCancel) {\n            emailLoginCancel.addEventListener('click', () => hideEmailLoginForm({ resetForm: true }));\n          }\n          if (emailRegisterForm) {\n            emailRegisterForm.addEventListener('submit', submitEmailRegistration);\n          }\n          if (emailRegisterCancel) {\n            emailRegisterCancel.addEventListener('click', () => hideEmailRegisterForm({ resetForm: true }));\n          }\n          if (emailRegisterLink) {\n            emailRegisterLink.addEventListener('click', showEmailRegisterForm);\n          }\n          if (emailRegisterToLogin) {\n            emailRegisterToLogin.addEventListener('click', () => {\n              hideEmailRegisterForm({ resetForm: false, showLoginToggle: false });\n              showEmailLoginForm();\n            });\n          }\n          if (logoutButton) {\n            logoutButton.addEventListener('click', () => signOut(auth));\n          }\n\n          // Subscribe to auth state changes (only once)\n          _authUnsubscribe = auth.onAuthStateChanged((user) => {\n            if (user) {\n              signedIn(user);\n            } else {\n              notSignedIn();\n            }\n          });\n\n          _layoutInitialized = true;\n        }\n\n        if (auth.currentUser && document.body.dataset.authenticated !== 'true') {\n          signedIn(auth.currentUser);\n        }\n\n        await getProjectIdFromURLparamProjectId();\n        if (document.body.dataset.authenticated === 'true' && projectSelected) {\n          addProjectToLinks(projectSelected);\n        }\n\n        // Set welcome messages from constants\n        const welcomeTitle = document.querySelector('.welcome-title');\n        const welcomeSubtitle = document.querySelector('.welcome-subtitle');\n        if (welcomeTitle) welcomeTitle.textContent = APP_CONSTANTS.WELCOME_MESSAGES.TITLE;\n        if (welcomeSubtitle) welcomeSubtitle.textContent = APP_CONSTANTS.WELCOME_MESSAGES.SUBTITLE;\n\n        // Wait for MenuNav SSR to initialize\n        if (window.menuNavSSR) {\n          window.menuNavSSR.updateNavLinks();\n          window.menuNavSSR.markActiveLinkByURL();\n        } else {\n          // Fallback if MenuNav SSR not ready yet\n          setTimeout(() => {\n            if (window.menuNavSSR) {\n              window.menuNavSSR.updateNavLinks();\n              window.menuNavSSR.markActiveLinkByURL();\n            }\n          }, 100);\n        }\n\n        // Load page-specific components with lazy loading\n        const currentPage = pagePath.split('/')[1] || 'index';\n        LazyLoader.loadPageComponents(currentPage);\n\n        if (!window.appShellRouter) {\n          const router = initAppShellRouterFromDataset();\n          if (router) {\n            window.appShellRouter = router;\n          }\n        }\n\n        DOMisLoaded = true;\n      }\n\n      function getProjectIdFromURLparamProjectId() {\n        const projectId = new URLSearchParams(window.location.search).get('projectId');\n        if (projectId) {\n          projectSelected = projectId;\n          updatePageTitle(projectId);\n        }\n      }\n\n      // Configurar requisitos del sistema usando el componente del paquete\n      function initSystemRequirementsChecker() {\n        try {\n\n          // Obtener el componente system-status\n          const statusIndicator = document.getElementById('systemStatusIndicator');\n\n          if (statusIndicator) {\n            // Configurar requisitos desde nuestra configuración\n            statusIndicator.requirements = {\n              features: SYSTEM_REQUIREMENTS.features.required.reduce((acc, feature) => {\n                acc[feature] = true;\n                return acc;\n              }, {}),\n              device: {\n                minMemory: SYSTEM_REQUIREMENTS.memory.minimum / 1024, // Convertir MB a GB\n                minCores: 2\n              },\n              screen: {\n                minWidth: SYSTEM_REQUIREMENTS.screen.minWidth,\n                minHeight: SYSTEM_REQUIREMENTS.screen.minHeight\n              }\n            };\n\n            // Escuchar eventos del componente\n            statusIndicator.addEventListener('status-change', (e) => {\n              if (e.detail.failures && e.detail.failures.length > 0) {\n              }\n            });\n\n            statusIndicator.addEventListener('click', (e) => {\n            });\n\n          } else {\n          }\n        } catch (error) {\n        }\n      }\n\n      // Run on every page load (initial + View Transition navigations)\n      document.addEventListener('astro:page-load', () => {\n        DOMContentLoadedActions();\n        setTimeout(initSystemRequirementsChecker, 100);\n      });\n    </script>\n\n    <style is:global>\n      :root {\n        /* Legacy aliases — values come from ThemeLoaderService (--brand-*) */\n        --primary-color: var(--brand-primary, #6366f1);\n        --primary-color-dark: var(--brand-primary-hover, #4f46e5);\n        --secondary-color: var(--brand-secondary, #10b981);\n        --terciary-color: #f8fafc;\n        --background-color: var(--bg-secondary, #f8fafc);\n\n        /* Aliases: map legacy variable names used by components to design system tokens */\n        --text-color: var(--text-primary, #0f172a);\n        --border-color: var(--border-default, #cbd5e1);\n      }\n\n      /*\n       * Note: Design tokens (--brand-primary, --bg-primary, --modal-*, --notification-*, etc.)\n       * are injected globally by ThemeManagerService from the design system.\n       * See: /public/js/ui/styles/tokens/ for token definitions.\n       */\n\n      /* Force 0 padding on all modal bodies */\n      app-modal {\n        --modal-body-padding: 0;\n      }\n\n      /* Spinner para zona central */\n      .main-loader {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        min-height: 200px;\n        width: 100%;\n      }\n\n      .main-loader .spinner {\n        width: 40px;\n        height: 40px;\n        border: 4px solid var(--terciary-color);\n        border-top-color: var(--primary-color);\n        border-radius: 50%;\n        animation: spin 0.8s linear infinite;\n      }\n\n      @keyframes spin {\n        to { transform: rotate(360deg); }\n      }\n\n      .main-loader.hidden {\n        display: none;\n      }\n\n      #subNavContainer:empty {\n        display: none;\n      }\n\n      #subNavContainer {\n        display: block;\n        width: 100%;\n        background: var(--bg-secondary, #f8fafc);\n        border-bottom: 1px solid var(--border-default, #e2e8f0);\n      }\n\n      * {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n      }\n\n      button, input, select, textarea {\n        color: inherit;\n      }\n\n      html {\n        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n        background: var(--background-color);\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n      }\n\n      body {\n        display: flex;\n        flex-direction: column;\n        min-height: 100vh;\n        color: var(--text-primary, #0f172a);\n      }\n\n      header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        background: var(--bg-primary, #ffffff);\n        padding: 0.6rem 1.5rem;\n        color: var(--text-primary, #0f172a);\n        border-bottom: 1px solid var(--border-subtle, #e2e8f0);\n        position: relative;\n        z-index: 200;\n      }\n\n      .header-title-container {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n      }\n\n      header h1 {\n        color: var(--brand-primary, #6366f1);\n        margin: 0;\n        font-size: 1.3rem;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      }\n\n      system-status {\n        display: flex;\n        align-items: center;\n      }\n\n      main {\n        flex: 1;\n        padding: 1.5rem 2rem;\n        padding-bottom: 4rem;\n      }\n\n      main h2 {\n        width: 100%;\n        text-align: center;\n        padding: 0.75rem 1rem;\n        background: var(--bg-secondary, #f1f5f9);\n        color: var(--text-primary, #0f172a);\n        border-radius: 8px;\n        font-size: 1.1rem;\n        font-weight: 600;\n        margin-bottom: 1rem;\n        border: 1px solid var(--border-subtle, #e2e8f0);\n      }\n\n      main stoy-card {\n        margin-bottom: 1rem;\n      }\n\n\n      .header-logos {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        text-decoration: none;\n      }\n\n      .logo {\n        height: 50px;\n        width: auto;\n      }\n\n      .planning-game-icon {\n        height: 36px;\n        width: auto;\n      }\n\n      .org-branding {\n        display: flex;\n        align-items: center;\n      }\n\n      .org-logo {\n        height: 40px;\n        width: auto;\n        max-width: 180px;\n        object-fit: contain;\n      }\n\n      .org-name-heading {\n        font-size: 1rem;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n        color: var(--text-muted, #64748b);\n        white-space: nowrap;\n        margin: 0;\n        line-height: 1;\n      }\n\n      @media (max-width: 768px) {\n        .org-branding {\n          display: none;\n        }\n      }\n\n      .user-info {\n        display: flex;\n        align-items: center;\n        gap: 1rem;\n        position: relative;\n      }\n\n      .auth-actions {\n        display: flex;\n        align-items: center;\n        gap: 0.75rem;\n        position: relative;\n      }\n\n      .login-button, .logout-button {\n        padding: 6px 14px;\n        background: var(--brand-primary, #6366f1);\n        color: var(--text-on-primary, #ffffff);\n        border: none;\n        border-radius: 8px;\n        cursor: pointer;\n        font-size: 0.85rem;\n        font-weight: 500;\n        transition: background 0.15s ease, box-shadow 0.15s ease;\n      }\n\n      .login-button {\n        background: var(--brand-primary, #6366f1);\n      }\n      .login-button:hover {\n        background: var(--brand-primary-hover, #4f46e5);\n        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25);\n      }\n\n      .logout-button {\n        background: transparent;\n        color: var(--text-muted, #64748b);\n        border: 1px solid var(--border-subtle, #e2e8f0);\n      }\n      .logout-button:hover {\n        background: var(--bg-secondary, #f1f5f9);\n        color: var(--text-primary, #0f172a);\n      }\n\n      .secondary-button {\n        padding: 6px 14px;\n        background: transparent;\n        color: var(--text-secondary, #334155);\n        border: 1px solid var(--border-subtle, #e2e8f0);\n        border-radius: 8px;\n        cursor: pointer;\n        font-size: 0.85rem;\n        font-weight: 500;\n        transition: background 0.15s ease;\n      }\n\n      .secondary-button:hover {\n        background: var(--bg-secondary, #f1f5f9);\n      }\n\n      .link-button {\n        border: none;\n        background: transparent;\n        color: var(--brand-primary, #6366f1);\n        cursor: pointer;\n        padding: 0;\n        margin-left: 0.25rem;\n        text-decoration: underline;\n        font: inherit;\n      }\n\n      .link-button:hover {\n        color: var(--brand-primary-hover, #4f46e5);\n      }\n\n      .email-login-form {\n        position: absolute;\n        top: calc(100% + 8px);\n        right: 0;\n        background: var(--bg-primary, white);\n        color: var(--text-primary, #1f2937);\n        padding: 1rem;\n        border-radius: 8px;\n        box-shadow: var(--shadow-xl, 0 8px 20px rgba(0, 0, 0, 0.15));\n        display: flex;\n        flex-direction: column;\n        gap: 0.75rem;\n        width: min(320px, 80vw);\n        z-index: 100;\n      }\n\n      .email-login-form input {\n        width: 100%;\n        padding: 0.5rem 0.75rem;\n        border: 1px solid var(--border-default, #d1d5db);\n        border-radius: 4px;\n        font-size: 0.95rem;\n        background: var(--input-bg, white);\n        color: var(--input-text, inherit);\n      }\n\n      .email-login-form input:focus {\n        outline: 2px solid var(--primary-color);\n        outline-offset: 2px;\n      }\n\n      .email-login-actions {\n        display: flex;\n        gap: 0.5rem;\n        justify-content: flex-end;\n      }\n\n      .email-login-form .secondary-button {\n        color: var(--secondary-color);\n        border: 1px solid var(--secondary-color);\n      }\n\n      .email-login-form .secondary-button:hover {\n        background: var(--hover-overlay, rgba(74, 158, 255, 0.1));\n      }\n\n      .email-register-form {\n        position: absolute;\n        top: calc(100% + 8px);\n        right: 0;\n        background: var(--bg-primary, white);\n        color: var(--text-primary, #1f2937);\n        padding: 1.25rem;\n        border-radius: 10px;\n        box-shadow: var(--shadow-xl, 0 10px 24px rgba(0, 0, 0, 0.18));\n        display: flex;\n        flex-direction: column;\n        gap: 0.75rem;\n        width: min(360px, 90vw);\n        max-height: 80vh;\n        overflow-y: auto;\n        z-index: 110;\n      }\n\n      .email-register-form h2 {\n        font-size: 1.1rem;\n        font-weight: 600;\n        margin-bottom: 0.25rem;\n        color: var(--text-primary, #1f2937);\n      }\n\n      .email-register-form input,\n      .email-register-form select,\n      .email-register-form textarea {\n        width: 100%;\n        padding: 0.55rem 0.75rem;\n        border: 1px solid var(--border-default, #d1d5db);\n        border-radius: 4px;\n        font-size: 0.95rem;\n        font-family: inherit;\n        background: var(--input-bg, white);\n        color: var(--input-text, inherit);\n      }\n\n      .email-register-form select {\n        background-color: var(--select-bg, #fff);\n      }\n\n      .email-register-form textarea {\n        resize: vertical;\n        min-height: 90px;\n      }\n\n      .email-register-form input:focus,\n      .email-register-form select:focus,\n      .email-register-form textarea:focus {\n        outline: 2px solid var(--primary-color);\n        outline-offset: 2px;\n      }\n\n      .email-register-form .secondary-button {\n        color: var(--secondary-color);\n        border: 1px solid var(--secondary-color);\n      }\n\n      .email-register-form .secondary-button:hover {\n        background: var(--hover-overlay, rgba(74, 158, 255, 0.1));\n      }\n\n      .error-message {\n        color: var(--color-error, #b91c1c);\n        font-size: 0.85rem;\n        text-align: left;\n      }\n\n      .success-message {\n        color: var(--color-success, #047857);\n        font-size: 0.85rem;\n        text-align: left;\n      }\n\n      .form-helper-text {\n        font-size: 0.85rem;\n        color: var(--text-muted, #6b7280);\n        margin-bottom: 0.25rem;\n      }\n\n      .sr-only {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        padding: 0;\n        margin: -1px;\n        overflow: hidden;\n        clip: rect(0, 0, 0, 0);\n        white-space: nowrap;\n        border: 0;\n      }\n\n      .hidden {\n        display: none !important;\n      }\n\n      .welcome-container {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        flex: 1;\n        min-height: calc(100vh - 200px);\n        text-align: center;\n      }\n\n      .welcome-content {\n        padding: 3rem;\n        background: var(--bg-primary, white);\n        border-radius: 16px;\n        border: 1px solid var(--border-subtle, #e2e8f0);\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n      }\n\n      .welcome-logo {\n        width: 120px;\n        height: auto;\n        margin-bottom: 2rem;\n      }\n\n      .welcome-title {\n        font-size: 2.5rem;\n        color: var(--brand-primary, #6366f1);\n        margin-bottom: 1rem;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n        text-align: center;\n      }\n\n      .welcome-subtitle {\n        font-size: 1.1rem;\n        color: var(--text-muted, #64748b);\n        margin: 0;\n        text-align: center;\n      }\n\n      /* ==================== DARK MODE GLOBAL OVERRIDES ==================== */\n      html.dark-theme {\n        background: var(--bg-primary, #0f172a);\n        color-scheme: dark;\n      }\n\n      .dark-theme body {\n        color: var(--text-primary, #f8fafc);\n      }\n\n      .dark-theme header {\n        background: var(--header-bg, #0f172a);\n        border-bottom-color: var(--border-subtle, #334155);\n      }\n\n      .dark-theme .welcome-content {\n        background: var(--card-bg, #1e293b);\n        border-color: var(--border-subtle, #334155);\n      }\n\n      .dark-theme .email-login-form,\n      .dark-theme .email-register-form {\n        background: var(--card-bg, #1e293b);\n        border: 1px solid var(--border-subtle, #334155);\n      }\n\n      .dark-theme .email-login-form input,\n      .dark-theme .email-register-form input,\n      .dark-theme .email-register-form select,\n      .dark-theme .email-register-form textarea {\n        background: var(--input-bg, #1e293b);\n        border-color: var(--input-border, #475569);\n        color: var(--text-primary, #f8fafc);\n      }\n\n      .dark-theme main h2 {\n        background: var(--bg-secondary, #1e293b);\n        border-color: var(--border-subtle, #334155);\n        color: var(--text-primary, #f8fafc);\n      }\n\n      .dark-theme .logout-button {\n        border-color: var(--border-subtle, #334155);\n        color: var(--text-muted, #94a3b8);\n      }\n\n      .dark-theme .logout-button:hover {\n        background: var(--bg-secondary, #1e293b);\n        color: var(--text-primary, #f8fafc);\n      }\n\n      .dark-theme .secondary-button {\n        color: var(--text-secondary, #e2e8f0);\n        border-color: var(--border-subtle, #334155);\n      }\n\n      .dark-theme .secondary-button:hover {\n        background: var(--bg-secondary, #1e293b);\n      }\n\n      /* Dark mode overrides for app-modal */\n      .dark-theme app-modal {\n        --modal-bg: var(--bg-primary, #0f172a);\n        --modal-text-color: var(--text-primary, #f8fafc);\n        --modal-body-color: var(--text-primary, #f8fafc);\n        --modal-header-bg: var(--bg-secondary, #1e293b);\n        --modal-header-text: var(--text-primary, #f8fafc);\n        --modal-footer-bg: var(--bg-secondary, #1e293b);\n        --modal-border-color: var(--border-default, #475569);\n        --modal-close-bg: var(--bg-tertiary, #334155);\n        --modal-close-color: var(--text-secondary, #e2e8f0);\n        --modal-close-hover-bg: var(--bg-primary, #0f172a);\n        --modal-close-hover-color: var(--text-primary, #f8fafc);\n        --modal-btn-primary-bg: var(--brand-primary, #6366f1);\n        --modal-btn-primary-text: #ffffff;\n        --modal-btn-secondary-bg: var(--color-error, #f43f5e);\n        --modal-btn-secondary-text: #ffffff;\n        --modal-btn-tertiary-bg: var(--bg-tertiary, #334155);\n        --modal-btn-tertiary-text: var(--text-primary, #f8fafc);\n        --modal-overlay-bg: rgba(0, 0, 0, 0.7);\n        --modal-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);\n      }\n    </style>\n  </body>\n</html>\n","numLines":1469,"startLine":1,"totalLines":1469}}} (stream=stdout)
