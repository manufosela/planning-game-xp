key of order) {\n   299→        if (items[key]) {\n   300→          orderedItems.push({ key, ...items[key] });\n   301→          seen.add(key);\n   302→        }\n   303→      }\n   304→\n   305→      for (const [key, value] of Object.entries(items)) {\n   306→        if (!seen.has(key)) {\n   307→          orderedItems.push({ key, ...value });\n   308→        }\n   309→      }\n   310→\n   311→      const activeWip = wipEntries.get(devId);\n   312→      const seenCardIds = new Set();\n   313→      const filteredItems = orderedItems.filter(item => {\n   314→        if (!item) return false;\n   315→        if (activeWip && activeWip.taskId && (item.cardId === activeWip.taskId || item.cardKey?.endsWith(`|${activeWip.taskId}`))) {\n   316→          return false;\n   317→        }\n   318→        const status = (item.status || '').toLowerCase();\n   319→        if (status === 'in progress') return false;\n   320→        // Dedupe by cardId to avoid showing duplicates with different cardKeys\n   321→        const cardId = item.cardId || item.cardKey;\n   322→        if (seenCardIds.has(cardId)) return false;\n   323→        seenCardIds.add(cardId);\n   324→        return true;\n   325→      });\n   326→\n   327→      const list = filteredItems.length ? filteredItems.map((item, idx) => {\n   328→        const cardType = item.cardType || '';\n   329→        const section = cardType.includes('proposal') ? 'proposals' : (cardType.includes('bug') ? 'bugs' : 'tasks');\n   330→        const cardLink = '#';\n   331→        return `\n   332→          <div class=\"backlog-row\" draggable=\"${canEditBacklog(devId)}\" data-dev=\"${devId}\" data-key=\"${item.cardKey}\">\n   333→            <div class=\"drag-cell\" title=\"Arrastrar para reordenar\">☰</div>\n   334→            <div class=\"cell cell-title\">${item.title || item.cardId || item.cardKey}</div>\n   335→            <div class=\"cell\">${item.projectId || '-'}</div>\n   336→            <div class=\"cell\">${(item.cardType |