EmailForFirebase } = await import('/js/utils/email-sanitizer.js');\n    const encodedEmail = encodeEmailForFirebase(userEmail);\n    const userProjectsSnapshot = await get(ref(database, `/data/projectsByUser/${encodedEmail}`));\n\n    if (!userProjectsSnapshot.exists()) return [];\n\n    const userProjectsValue = userProjectsSnapshot.val();\n    if (userProjectsValue === 'All') return allProjects;\n\n    const userProjects = userProjectsValue.split(',').map(p => p.trim());\n    return allProjects.filter(p => userProjects.includes(p));\n  }\n\n  function renderGanttChart(projectId) {\n    ganttContainer.innerHTML = '';\n    currentGanttChart = null;\n\n    if (!projectId) return;\n\n    const ganttChart = document.createElement('gantt-chart');\n    ganttChart.project = projectId;\n    ganttChart.year = new Date().getFullYear();\n    ganttContainer.appendChild(ganttChart);\n    currentGanttChart = ganttChart;\n  }\n\n  function selectProject(projectId, updateUrl = true) {\n    projectSelector.value = projectId;\n    renderGanttChart(projectId);\n    if (updateUrl) {\n      URLStateManager.updateState({ projectId });\n    }\n  }\n\n  async function init() {\n    const projects = await loadUserProjects();\n\n    projects.sort((a, b) => a.localeCompare(b));\n    projects.forEach(projectId => {\n      const option = document.createElement('option');\n      option.value = projectId;\n      option.textContent = projectId;\n      projectSelector.appendChild(option);\n    });\n\n    projectSelector.addEventListener('change', () => {\n      selectProject(projectSelector.value);\n    });\n\n    URLStateManager.onPopState((state) => {\n      if (state.projectId) {\n        selectProject(state.projectId, false);\n      }\n    });\n\n    // Restore project from URL or select first available\n    const urlState = URLStateManager.getState();\n    if (urlState.projectId && projects.includes(urlState.projectId)) {\n      selectProject(urlState.projectId, false);\n    } else if (projects.length > 0) {\n      selectProject(projects[0], true);\n    }\n  }\n\n  // Wait for auth if needed\n  const userEmail = document.body.dataset.userEmail || '';\n  if (userEmail) {","numLines":100,"startLine":1,"totalLines":164}}} (stream=stdout)
