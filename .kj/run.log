  hasAllProjectsAccess = true;\n      userProjects = [];\n      fetchProjects();\n      return;\n    }\n\n    const userKey = getUserKeyFromEmail(currentUserEmail);\n    const userProjectsRef = ref(database, `/data/projectsByUser/${userKey}`);\n\n    unsubscribeUserProjects = onValue(userProjectsRef, async (snapshot) => {\n      const projectsData = snapshot.val();\n\n      if (projectsData === 'All') {\n        hasAllProjectsAccess = true;\n        isUserAdmin = true; // Users with \"All\" are admins\n        userProjects = [];\n      } else if (projectsData && typeof projectsData === 'string') {\n        hasAllProjectsAccess = false;\n        isUserAdmin = false;\n        userProjects = projectsData.split(',').map(p => p.trim()).filter(p => p.length > 0);\n      } else {\n        // User not found in database - create entry with default projects\n        hasAllProjectsAccess = false;\n        isUserAdmin = false;\n        userProjects = APP_CONSTANTS.DEFAULT_USER_PROJECTS;\n\n        try {\n          // Create entry in Firebase with default projects\n          const defaultProjectsString = userProjects.join(', ');\n          await set(userProjectsRef, defaultProjectsString);\n        } catch (error) {\n        }\n      }\n\n      // Refresh projects display after permissions are loaded\n      fetchProjects();\n    }, (error) => {\n      userProjects = APP_CONSTANTS.DEFAULT_USER_PROJECTS;\n      hasAllProjectsAccess = false;\n      isUserAdmin = false;\n      // Continue showing projects even if permissions load fails\n      fetchProjects();\n    });\n  }\n\n  function extractMarkdownSummary(text) {\n    if (!text) return '';\n    const trimmed = text.trim();\n    // Detect if it's Markdown (starts with #)\n    if (!trimmed.startsWith('#')) return text;\n\n    const lines = trimmed.split('\\n');\n    let title = '';\n    let subtitle = '';\n\n    for (const line of lines) {\n      const trimmedLine = line.trim();\n      if (trimmedLine.startsWith('# ') && !title) {\n        title = trimmedLine.replace(/^#\\s+/, '');\n      } else if (trimmedLine.startsWith('## ')) {\n        // Stop at first section\n        break;\n      } else if (title && trimmedLine && !trimmedLine.startsWith('#')) {\n        // First paragraph after title\n        subtitle = trimmedLine;\n        break;\n      }\n    }\n\n    if (title && subtitle) {\n      return `<strong>${title}</strong> - ${subtitle}`;\n    }\n    return title || text.substring(0, 100) + '...';\n  }\n\n  function getProjectColor(index) {\n    const colors = [\n      '#6366f1', // indigo primary\n      '#10b981', // emerald secondary\n      '#10b981', // emerald\n      '#f59e0b', // amber\n      '#8b5cf6', // violet\n      '#ef4444', // red\n      '#06b6d4', // cyan\n      '#84cc16', // lime\n      '#f97316', // orange\n      '#6366f1', // indigo\n    ];\n    return colors[index % colors.length];\n  }\n\n  function fetchProjects() {\n    showLoading();\n    const projectsRef = ref(database, '/projects');\n    unsubscribeProjects = onValue(projectsRef, (snapshot) => {\n      const projectsInfo = snapshot.val() || {};\n      let groups = Object.keys(projectsInfo);\n\n      // Store all projects for user management\n      allProjects = groups.map(name => ({ name, ...projectsInfo[name] }));\n\n      // Filter projects by user permissions\n      if (!hasAllProjectsAccess && userProjects.length > 0) {\n        groups = groups.filter(projectName => userProjects.includes(projectName));\n      } else if (!hasAllProjectsAccess && userProjects.length === 0) {\n        groups = [];\n      } else {\n      }\n\n      if (groups.length === 0) {\n        showNoProjects();\n        return;\n      }\n\n      // Sort projects: by order field, then archived at the bottom\n      groups.sort((a, b) => {\n        const aArchived = projectsInfo[a]?.archived || false;\n        const bArchived = projectsInfo[b]?.archived || false;","numLines":130,"startLine":280,"totalLines":1361}}} (stream=stdout)
