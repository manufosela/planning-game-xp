ndUpdateDocButtons, 500);\n      }\n    };\n    setTimeout(checkAndUpdateDocButtons, 100);\n\n    // Initial tab visibility and permissions\n    window.updateTabVisibility();\n\n    // Listener for year-based permission changes\n    document.addEventListener('year-permissions-updated', function(e) {\n      const { year, isPastYear, isYearReadOnly: yearReadOnly } = e.detail;\n      isYearReadOnly = yearReadOnly;\n\n      // Update button visibility based on new year state\n      toggleEditButtons();\n\n      // Notify components about permission changes\n      window.notifyPermissionsUpdate();\n    });\n  });\n</script>\n\n<script type=\"module\" src=\"/js/main.js\"></script>\n<script type=\"module\">\n  import { modalService } from '/js/services/modal-service.js';\n  import { URLStateManager } from '/js/utils/url-utils.js';\n\n  window.modalService = modalService;\n\n  // Restore section from URL hash on page load\n  document.addEventListener('astro:page-load', () => {\n    const urlState = URLStateManager.getState();","numLines":100,"startLine":1100,"totalLines":2594}}} (stream=stdout)
