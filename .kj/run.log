0;\n    color: var(--text-muted, #64748b);\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n  .summary-chips {\n    display: flex;\n    gap: 0.5rem;\n    justify-content: flex-end;\n    margin-bottom: 0.75rem;\n    flex-wrap: wrap;\n  }\n  .summary-chip {\n    background: rgba(59, 130, 246, 0.1);\n    color: #0369a1;\n    padding: 0.4rem 0.8rem;\n    border-radius: 999px;\n    font-weight: 700;\n    font-size: 0.85rem;\n    border: 1px solid rgba(59, 130, 246, 0.2);\n  }\n  .chip-active { background: rgba(34, 197, 94, 0.15); color: #166534; border-color: rgba(34, 197, 94, 0.2); }\n  .chip-idle { background: var(--bg-tertiary, #f3f4f6); color: var(--text-muted, #4b5563); border-color: var(--border-default, #e5e7eb); }\n  .wip-subtitle {\n    color: var(--text-secondary, #4b5563);\n    margin-bottom: 1rem;\n  }\n  .wip-list { padding: 0; }\n  .wip-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  .wip-table th, .wip-table td {\n    padding: 0.8rem 1rem;\n    text-align: left;\n  }\n  .wip-table thead {\n    background: var(--table-header-bg, #f8fafc);\n    border-bottom: 1px solid var(--table-border, #e2e8f0);\n  }\n  .wip-table th {\n    font-weight: 700;\n    color: var(--table-header-text, #0f172a);\n    font-size: 0.95rem;\n  }\n  .wip-table tbody tr {\n    border-bottom: 1px solid var(--table-border, #e2e8f0);\n    transition: background 0.15s ease;\n  }\n  .wip-table tbody tr.row-active {\n    background: rgba(34, 197, 94, 0.08);\n  }\n  .wip-table tbody tr.row-idle {\n    background: var(--table-row-alt-bg, #fafafa);\n  }\n  .wip-table tbody tr:hover {\n    background: var(--table-row-hover-bg, rgba(59, 130, 246, 0.08));\n  }\n  .wip-table td.dev {\n    font-weight: 700;\n    color: var(--text-primary, #111827);\n  }\n  .wip-table td.task {\n    color: var(--text-primary, #0f172a);\n    font-weight: 600;\n  }\n  .wip-table td .pill {\n    display: inline-flex;\n    padding: 0.2rem 0.7rem;\n    background: rgba(59, 130, 246, 0.0