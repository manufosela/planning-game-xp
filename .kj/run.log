ameworksText = Array.isArray(projectData.frameworks) ? projectData.frameworks.join(', ') : '';\n  1310→      projectForm.businessContext = projectData.businessContext || '';\n  1311→      // Migration: if no businessContext but agentsGuidelines exists, migrate\n  1312→      if (!projectData.businessContext && projectData.agentsGuidelines) {\n  1313→        projectForm.businessContext = projectData.agentsGuidelines;\n  1314→        document.dispatchEvent(new CustomEvent('show-slide-notification', {\n  1315→          detail: { options: {\n  1316→            message: 'Se han migrado las directrices de agents al campo \"Contexto de Negocio\". Revisa y guarda.',\n  1317→            type: 'info'\n  1318→          }}\n  1319→        }));\n  1320→      }\n  1321→      projectForm.useIa = Boolean(projectData.iaEnabled);\n  1322→      projectForm.iaAvailable = projectData.iaEnabled || projectForm.iaAvailable;\n  1323→      projectForm.archived = Boolean(projectData.archived);\n  1324→      projectForm.requestUpdate();\n  1325→    };\n  1326→\n  1327→    // Apply initial data\n  1328→    applyProjectData();\n  1329→\n  1330→    showModal({\n  1331→      title: 'Editar Proyecto',\n  1332→      maxWidth: '50dvw',\n  1333→      maxHeight: '80dvh',\n  1334→      showFooter: true,\n  1335→      button1Text: 'Guardar Cambios',\n  1336→      button2Text: 'Cancelar',\n  1337→      button1Action: async () => {\n  1338→        const validation = projectForm.validateWithFeedback();\n  1339→        if (!validation.valid) {\n  1340→          const errorMsg = validation.errors.map(e => e.message).join('. ');\n  1341→          document.dispatchEvent(new CustomEvent('show-slide-notification', {\n  1342→            detail: { options: { message: errorMsg, type: 'error' } }\n  1343→          }));\n  1344→          return false;\n  1345→        }\n  1346→        await updateProject(projectForm, projectName, projectData);\n  1347→      },\n  1348→      button2Action: () => {}\n  1349→    });\n  1350→\n  1351→    // Add form to modal and wait for component to be ready\n  1352→    setTimeout(() => {\n  1353→      const modal = document.querySelector('app-modal');\n  1354→      if (modal) {\n  1355→        modal.setContent(projectForm);\n  1356→\n  1357→        // Wait for component to finish loading, then re-apply data\n  1358→        const waitForReady = () => {\n  1359→          if (!projectForm.isLoading) {\n  1360→            applyProjectData();\n  1361→          } else {\n  1362→            // Check again after a short delay\n  1363→            setTimeout(waitForReady, 50);\n  1364→          }\n  1365→        };\n  1366→        waitForReady();\n  1367→\n  1368→        projectForm.addEventListener('delete-project', (e) => {\n  1369→          deleteProject(e.detail.projectName);\n  1370→        });\n  1371→\n  1372→        projectForm.addEventListener('archive-project', (e) => {\n  1373→          archiveProject(e.detail.projectName, e.detail.archived);\n  1374→        });\n  1375→      }\n  1376→    }, 100);\n  1377→\n  1378→  } catch (error) {\n  1379→    console.error('Error loading project:', error);\n  1380→    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n  1381→      detail: { options: { message: 'Error al cargar los datos del proyecto', type: 'error' } }\n  1382→    }));\n  1383→  }\n  1384→}\n  1385→\n  1386→/**\n  1387→ * Sync project team assignments to /users/{email}/projects/{projectId}\n  1388→ * so entityDirectoryService sees them (single source of truth).\n  1389→ * Only updates users that already exist in /users/.\n  1390→ */\n  1391→async function syncProjectTeamToUsers(projectName, developers, stakeholders) {\n  1392→  const devEmails = new Set();\n  1393→  const stkEmails = new Set();\n  1394→\n  1395→  for (const dev of developers) {\n  1396→    if (dev.email) devEmails.add(dev.email.toLowerCase().trim());\n  1397→  }\n  1398→  for (const stk of stakeholders) {\n  1399→    if (stk.email) stkEmails.add(stk.email.toLowerCase().trim());\n  1400→  }\n  1401→\n  1402→  const allEmails = new Set([...devEmails, ...stkEmails]);\n  1403→  const updates = {};\n  1404→\n  1405→  for (const email of allEmails) {\n  1406→    const encodedEmail = encodeEmailForFirebase(email);\n  1407→    if (!encodedEmail) continue;\n  1408→\n  1409→    // Only sync if user exists in /users/\n  1410→    const userSnap = await get(ref(database, `/users/${encodedEmail}`));\n  1411→    if (!userSnap.exists()) continue;\n  1412→\n  1413→    const isDev = devEmails.has(email);\n  1414→    const isStk = stkEmails.has(email);\n  1415→    updates[`/users/${encodedEmail}/projects/${projectName}/developer`] = isDev;\n  1416→    updates[`/users/${encodedEmail}/projects/${projectName}/stakeholder`] = isStk;\n  1417→  }\n  1418→\n  1419→  if (Object.keys(updates).length > 0) {\n  1420→    await update(ref(database), updates);\n  1421→  }\n  1422→}\n  1423→"}]},"parent_tool_use_id":null,"session_id":"559d5f17-efbc-4351-b1c9-b915eca702cc","uuid":"caea1f2c-6f68-468e-afec-7b2e7b21d063","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/adminproject.astro","content":"<script type=\"module\">\n// Edit Project functionality\nimport { showModal } from '@manufosela/app-modal';\nimport 'https://esm.sh/@manufosela/md-renderer';\nimport { database, ref, get, set, update, auth, superAdminEmail } from '/firebase-config.js';\nimport { FirebaseService } from '/js/services/firebase-service.js';\nimport { encodeEmailForFirebase } from '/js/utils/email-sanitizer.js';\nimport '/js/wc/ProjectForm.js';\nimport '/js/wc/CardSearch.js';\n\nlet currentProjectName = '';\n\n// Initialize edit button visibility\nfunction initEditProjectButton() {\n  const editBtn = document.getElementById('editProjectBtn');\n  if (!editBtn) return;\n\n  // Check if user is superAdmin\n  const checkSuperAdmin = () => {\n    const user = auth.currentUser;\n    if (user && user.email === superAdminEmail) {\n      editBtn.style.display = '';\n    } else {\n      editBtn.style.display = 'none';\n    }\n  };\n\n  // Check on auth state change\n  auth.onAuthStateChanged(() => {\n    checkSuperAdmin();\n  });\n\n  // Initial check\n  checkSuperAdmin();\n\n  // Handle click\n  editBtn.addEventListener('click', () => {\n    const projectSelector = document.getElementById('projectSelector');\n    const projectName = projectSelector?.selectedProject || window.currentProjectId;\n    if (projectName) {\n      showEditProjectModal(projectName);\n    }\n  });\n}\n\n// Listen for project changes\ndocument.addEventListener('project-changed', (e) => {\n  currentProjectName = e.detail?.projectId || e.detail?.projectName || '';\n});\n\nasync function showEditProjectModal(projectName) {\n  try {\n    // Load project data\n    const projectRef = ref(database, `/projects/${projectName}`);\n    const snapshot = await get(projectRef);\n    const projectData = snapshot.val();\n\n    if (!projectData) {\n      document.dispatchEvent(new CustomEvent('show-slide-notification', {\n        detail: { options: { message: 'No se encontraron datos del proyecto', type: 'error' } }\n      }));\n      return;\n    }\n\n    // Check if project has existing cards (locks name and abbreviation)\n    const cardsRef = ref(database, `/cards/${projectName}`);\n    const cardsSnapshot = await get(cardsRef);\n    const hasCards = cardsSnapshot.exists();\n\n    const projectForm = document.createElement('project-form');\n\n    // Store project data to apply after component is ready\n    const applyProjectData = () => {\n      projectForm.editMode = true;\n      projectForm.hasCards = hasCards;\n      projectForm.originalProjectName = projectName;\n      projectForm.projectName = projectData.name || projectName;\n      projectForm.abbreviation = projectData.abbreviation || '';\n      projectForm.scoringSystem = projectData.scoringSystem || '1-5';\n      projectForm.stakeholders = projectData.stakeholders || [];\n      projectForm.developers = projectData.developers || [];\n      projectForm.allowExecutables = projectData.allowExecutables || false;\n      projectForm.description = projectData.description || '';\n      projectForm.repoUrl = projectData.repoUrl ?? projectData.repositoryUrl ?? '';\n      projectForm.languagesText = Array.isArray(projectData.languages) ? projectData.languages.join(', ') : '';\n      projectForm.frameworksText = Array.isArray(projectData.frameworks) ? projectData.frameworks.join(', ') : '';\n      projectForm.businessContext = projectData.businessContext || '';\n      // Migration: if no businessContext but agentsGuidelines exists, migrate\n      if (!projectData.businessContext && projectData.agentsGuidelines) {\n        projectForm.businessContext = projectData.agentsGuidelines;\n        document.dispatchEvent(new CustomEvent('show-slide-notification', {\n          detail: { options: {\n            message: 'Se han migrado las directrices de agents al campo \"Contexto de Negocio\". Revisa y guarda.',\n            type: 'info'\n          }}\n        }));\n      }\n      projectForm.useIa = Boolean(projectData.iaEnabled);\n      projectForm.iaAvailable = projectData.iaEnabled || projectForm.iaAvailable;\n      projectForm.archived = Boolean(projectData.archived);\n      projectForm.requestUpdate();\n    };\n\n    // Apply initial data\n    applyProjectData();\n\n    showModal({\n      title: 'Editar Proyecto',\n      maxWidth: '50dvw',\n      maxHeight: '80dvh',\n      showFooter: true,\n      button1Text: 'Guardar Cambios',\n      button2Text: 'Cancelar',\n      button1Action: async () => {\n        const validation = projectForm.validateWithFeedback();\n        if (!validation.valid) {\n          const errorMsg = validation.errors.map(e => e.message).join('. ');\n          document.dispatchEvent(new CustomEvent('show-slide-notification', {\n            detail: { options: { message: errorMsg, type: 'error' } }\n          }));\n          return false;\n        }\n        await updateProject(projectForm, projectName, projectData);\n      },\n      button2Action: () => {}\n    });\n\n    // Add form to modal and wait for component to be ready\n    setTimeout(() => {\n      const modal = document.querySelector('app-modal');\n      if (modal) {\n        modal.setContent(projectForm);\n\n        // Wait for component to finish loading, then re-apply data\n        const waitForReady = () => {\n          if (!projectForm.isLoading) {\n            applyProjectData();\n          } else {\n            // Check again after a short delay\n            setTimeout(waitForReady, 50);\n          }\n        };\n        waitForReady();\n\n        projectForm.addEventListener('delete-project', (e) => {\n          deleteProject(e.detail.projectName);\n        });\n\n        projectForm.addEventListener('archive-project', (e) => {\n          archiveProject(e.detail.projectName, e.detail.archived);\n        });\n      }\n    }, 100);\n\n  } catch (error) {\n    console.error('Error loading project:', error);\n    document.dispatchEvent(new CustomEvent('show-slide-notification', {\n      detail: { options: { message: 'Error al cargar los datos del proyecto', type: 'error' } }\n    }));\n  }\n}\n\n/**\n * Sync project team assignments to /users/{email}/projects/{projectId}\n * so entityDirectoryService sees them (single source of truth).\n * Only updates users that already exist in /users/.\n */\nasync function syncProjectTeamToUsers(projectName, developers, stakeholders) {\n  const devEmails = new Set();\n  const stkEmails = new Set();\n\n  for (const dev of developers) {\n    if (dev.email) devEmails.add(dev.email.toLowerCase().trim());\n  }\n  for (const stk of stakeholders) {\n    if (stk.email) stkEmails.add(stk.email.toLowerCase().trim());\n  }\n\n  const allEmails = new Set([...devEmails, ...stkEmails]);\n  const updates = {};\n\n  for (const email of allEmails) {\n    const encodedEmail = encodeEmailForFirebase(email);\n    if (!encodedEmail) continue;\n\n    // Only sync if user exists in /users/\n    const userSnap = await get(ref(database, `/users/${encodedEmail}`));\n    if (!userSnap.exists()) continue;\n\n    const isDev = devEmails.has(email);\n    const isStk = stkEmails.has(email);\n    updates[`/users/${encodedEmail}/projects/${projectName}/developer`] = isDev;\n    updates[`/users/${encodedEmail}/projects/${projectName}/stakeholder`] = isStk;\n  }\n\n  if (Object.keys(updates).length > 0) {\n    await update(ref(database), updates);\n  }\n}\n","numLines":200,"startLine":1224,"totalLines":2594}}} (stream=stdout)
