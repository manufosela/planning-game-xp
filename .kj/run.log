02:43:09.883 [agent:output] [coder] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012U5K1rpVHimfuHP3BTwc7b","type":"tool_result","content":"   100→        if (!this.projects.length) {\n   101→          this.setError('No tienes proyectos asignados. Solicita acceso a un administrador.');\n   102→          return;\n   103→        }\n   104→        this.populateProjectSelect();\n   105→        this.populateYearSelect();\n   106→        await Promise.all([\n   107→          this.loadDeveloperMappings(),\n   108→          this.loadSprintMappings()\n   109→        ]);\n   110→        this.elements.projectCount.textContent = `${this.projects.length} proyecto${this.projects.length === 1 ? '' : 's'}`;\n   111→\n   112→        await this.loadMetrics();\n   113→        this.bindEvents();\n   114→        // render() is now called inside loadMetrics()\n   115→      } catch (error) {\n   116→this.setError('No se pudo cargar la vista de desarrollo.');\n   117→      }\n   118→    }\n   119→\n   120→    async waitForAuth() {\n   121→      if (auth.currentUser) {\n   122→        return auth.currentUser;\n   123→      }\n   124→\n   125→      return new Promise((resolve) => {\n   126→        const unsubscribe = auth.onAuthStateChanged((user) => {\n   127→          unsubscribe();\n   128→          resolve(user);\n   129→        });\n   130→        setTimeout(() => {\n   131→          unsubscribe();\n   132→          resolve(null);\n   133→        }, 10000);\n   134→      });\n   135→    }\n   136→\n   137→    async loadAccessibleProjects(user) {\n   138→      try {\n   139→        const projectsRef = ref(database, '/projects');\n   140→        const projectsSnap = await get(projectsRef);\n   141→        if (!projectsSnap.exists()) {\n   142→          return [];\n   143→        }\n   144→\n   145→        const allProjects = Object.entries(projectsSnap.val() || {}).map(([id, project]) => ({\n   146→          id,\n   147→          name: project.name || id\n   148→        }));\n   149→\n   150→        // SuperAdmin always sees all projects\n   151→        const isSuperAdmin = envSuperAdminEmail && user.email.toLowerCase() === envSuperAdminEmail.toLowerCase();\n   152→        if (isSuperAdmin) {\n   153→          return allProjects;\n   154→        }\n   155→\n   156→        const userKey = encodeEmailForFirebase(user.email);\n   157→        const userProjectsRef = ref(database, `/data/projectsByUser/${userKey}`);\n   158→        const userProjectsSnap = await get(userProjectsRef);\n   159→        const userProjectData = userProjectsSnap.val();\n   160→\n   161→        if (userProjectData === 'All') {\n   162→          return allProjects;\n   163→        }\n   164→\n   165→        if (typeof userProjectData === 'string') {\n   166→          const allowed = userProjectData.split(',').map((p) => p.trim()).filter(Boolean);\n   167→          return allProjects.filter((project) => allowed.includes(project.id) || allowed.includes(project.name));\n   168→        }\n   169→\n   170→        return [];\n   171→      } catch (error) {\n   172→return [];\n   173→      }\n   174→    }\n   175→\n   176→    bindEvents() {\n   177→      if (this.elements.scopeSelect) {\n   178→        this.elements.scopeSelect.addEventListener('change', (event) => {\n   179→          this.selectedScope = event.target.value || 'all';\n   180→          this.render();\n   181→        });\n   182→      }\n   183→\n   184→      if (this.elements.yearSelect) {\n   185→        this.elements.yearSelect.addEventListener('change', (event) => {\n   186→          this.selectedYear = event.target.value || 'all';\n   187→          this.loadMetrics(true);\n   188→        });\n   189→      }\n   190→\n   191→      if (this.elements.reloadButton) {\n   192→        this.elements.reloadButton.addEventListener('click', () => {\n   193→          this.loadMetrics(true);\n   194→        });\n   195→      }\n   196→\n   197→      // Tab switching\n   198→      document.querySelectorAll('.dev-tab').forEach(tab => {\n   199→        tab.addEventListener('click', (event) => {\n   200→          const tabName = event.target.dataset.tab;\n   201→          this.switchTab(tabName);\n   202→        });\n   203→      });\n   204→    }\n   205→\n   206→    switchTab(tabName) {\n   207→      this.activeTab = tabName;\n   208→\n   209→      // Update tab buttons\n   210→      document.querySelectorAll('.dev-tab').forEach(tab => {\n   211→        tab.classList.toggle('active', tab.dataset.tab === tabName);\n   212→      });\n   213→\n   214→      // Update tab content\n   215→      if (this.elements.tabSummary) {\n   216→        this.elements.tabSummary.classList.toggle('active', tabName === 'summary');\n   217→      }\n   218→      if (this.elements.tabProjects) {\n   219→        this.elements.tabProjects.classList.toggle('active', tabName === 'projects');\n   220→      }\n   221→    }\n   222→\n   223→    populateProjectSelect() {\n   224→      const select = this.elements.scopeSelect;\n   225→      if (!select) return;\n   226→\n   227→      select.innerHTML = '';\n   228→      const optionAll = document.createElement('option');\n   229→      optionAll.value = 'all';\n   230→      optionAll.textContent = 'Todos mis proyectos';\n   231→      select.appendChild(optionAll);\n   232→\n   233→      this.projects.forEach((project) => {\n   234→        const option = document.createElement('option');\n   235→        option.value = project.id;\n   236→        option.textContent = project.name || project.id;\n   237→        select.appendChild(option);\n   238→      });\n   239→\n   240→      select.disabled = false;\n   241→      this.elements.reloadButton.disabled = false;\n   242→    }\n   243→\n   244→    populateYearSelect() {\n   245→      const select = this.elements.yearSelect;\n   246→      if (!select) return;\n   247→\n   248→      select.innerHTML = '';\n   249→\n   250→      // Add \"All years\" option\n   251→      const optionAll = document.createElement('option');\n   252→      optionAll.value = 'all';\n   253→      optionAll.textContent = 'Todos los años';\n   254→      select.appendChild(optionAll);\n   255→\n   256→      // Add years from current year back to 2020\n   257→      const currentYear = new Date().getFullYear();\n   258→      for (let year = currentYear; year >= 2020; year--) {\n   259→        const option = document.createElement('option');\n   260→        option.value = year.toString();\n   261→        option.textContent = year.toString();\n   262→        select.appendChild(option);\n   263→      }\n   264→\n   265→      // Set the value directly to ensure it's selected\n   266→      select.value = this.selectedYear;\n   267→      select.disabled = false;\n   268→    }\n   269→\n   270→    async loadDeveloperMappings() {\n   271→      // Load developer info from global entities and projects\n   272→      try {\n   273→        // First, load from global developers (/data/developers) - source of truth\n   274→        const entitiesSnap = await get(ref(database, '/data/developers'));\n   275→        if (entitiesSnap.exists()) {\n   276→          const entities = entitiesSnap.val() || {};\n   277→          Object.entries(entities).forEach(([id, dev]) => {\n   278→            if (!dev) return;\n   279→            const name = dev.name || '';\n   280→            const email = (dev.email || '').toLowerCase();\n   281→\n   282→            // Map dev_XXX ID to name\n   283→            if (id && name) {\n   284→              this.developerMap.set(id.toLowerCase(), name);\n   285→            }\n   286→            // Map email to name\n   287→            if (email && name) {\n   288→              this.developerMap.set(email, name);\n   289→            }\n   290→          });\n   291→        }\n   292→\n   293→        // Then, load from each project's developers list\n   294→        for (const project of this.projects) {\n   295→          const projectSnap = await get(ref(database, `/projects/${project.id}`));\n   296→          if (projectSnap.exists()) {\n   297→            const projectData = projectSnap.val() || {};\n   298→            const developers = projectData.developers || [];\n   299→\n   300→            // Process each developer entry\n   301→            (Array.isArray(developers) ? developers : Object.values(developers)).forEach(dev => {\n   302→              if (!dev) return;\n   303→\n   304→              const id = dev.id || dev.name || '';\n   305→              const name = dev.name || '';\n   306→              const email = (dev.email || '').toLowerCase();\n   307→\n   308→              // Map ID to name (don't overwrite if already exists from entities)\n   309→              if (id && name && !this.developerMap.has(id.toLowerCase())) {\n   310→                this.developerMap.set(id.toLowerCase(), name);\n   311→              }\n   312→              // Map email to name\n   313→              if (email && name && !this.developerMap.has(email)) {\n   314→                this.developerMap.set(email, name);\n   315→              }\n   316→            });\n   317→          }\n   318→        }\n   319→      } catch (error) {\n   320→        // Silently ignore errors loading developer mappings\n   321→      }\n   322→    }\n   323→\n   324→    async loadSprintMappings() {\n   325→      // Load sprint data to get year field for each sprint\n   326→      try {\n   327→        for (const project of this.projects) {\n   328→          const sprintsSnap = await get(ref(database, `/cards/${project.id}/SPRINTS_${project.id}`));\n   329→          if (sprintsSnap.exists()) {\n   330→            const sprints = sprintsSnap.val() || {};\n   331→            Object.entries(sprints).forEach(([sprintId, sprint]) => {\n   332→              if (!sprint) return;\n   333→\n   334→              // Use sprint's year field directly\n   335→              let sprintYear = sprint.year ? parseInt(sprint.year, 10) : null;\n   336→\n   337→              // Fallback to startDate if no year field\n   338→              if (!sprintYear && sprint.startDate) {\n   339→                sprintYear = new Date(sprint.startDate).getFullYear();\n   340→              }\n   341→\n   342→              if (sprintYear) {\n   343→                // Map by multiple keys for flexible lookup\n   344→                const keysToMap = [\n   345→                  sprintId,\n   346→                  sprint.cardId,\n   347→                  sprint.title,\n   348→                  sprint.name,\n   349→                  // Also map lowercase versions\n   350→                  sprintId?.toLowerCase?.(),\n   351→                  sprint.cardId?.toLowerCase?.(),\n   352→                  sprint.title?.toLowerCase?.(),\n   353→                  sprint.name?.toLowerCase?.()\n   354→                ].filter(Boolean);\n   355→\n   356→                keysToMap.forEach(key => {\n   357→                  this.sprintYearMap.set(key, sprintYear);\n   358→                });\n   359→              }\n   360→            });\n   361→          }\n   362→        }\n   363→      } catch (error) {\n   364→        // Silently ignore errors loading sprint mappings\n   365→      }\n   366→    }\n   367→\n   368→    async loadMetrics(force = false) {\n   369→      try {\n   370→        if (!force && this.datasets.length) {\n   371→          this.metrics = this.buildMetrics(this.datasets);\n   372→          this.setReady();\n   373→          this.render();\n   374→          return;\n   375→        }\n   376→\n   377→        this.setLoading('Calculando métricas de tareas y bugs...');\n   378→        this.datasets = await Promise.all(this.projects.map((project) => this.fetchProjectDataset(project)));\n   379→        this.metrics = this.buildMetrics(this.datasets);\n   380→        this.setReady();\n   381→        this.render();\n   382→      } catch (error) {\n   383→this.setError('Error calculando métricas de desarrollo.');\n   384→      }\n   385→    }\n   386→\n   387→    async fetchProjectDataset(project) {\n   388→      try {\n   389→        const [tasksSnap, bugsSnap] = await Promise.all([\n   390→          get(ref(database, `/cards/${project.id}/TASKS_${project.id}`)),\n   391→          get(ref(database, `/cards/${project.id}/BUGS_${project.id}`))\n   392→        ]);\n   393→\n   394→        let tasks = tasksSnap.exists() ? Object.values(tasksSnap.val() || {}) : [];\n   395→        let bugs = bugsSnap.exists() ? Object.values(bugsSnap.val() || {}) : [];\n   396→\n   397→        // Filter by year if a specific year is selected\n   398→        if (this.selectedYear && this.selectedYear !== 'all') {\n   399→          tasks = tasks.filter(task => this.isFromYear(task, this.selectedYear));\n   400→          bugs = bugs.filter(bug => this.isFromYear(bug, this.selectedYear));\n   401→        }\n   402→\n   403→        return {\n   404→          project,\n   405→          tasks,\n   406→          bugs\n   407→        };\n   408→      } catch (error) {\n   409→return {\n   410→          project,\n   411→          tasks: [],\n   412→          bugs: []\n   413→        };\n   414→      }\n   415→    }\n   416→\n   417→    isFromYear(card, year) {\n   418→      const yearInt = parseInt(year, 10);\n   419→      const currentYear = new Date().getFullYear();\n   420→\n   421→      // Primary: use task's year field directly\n   422→      if (card.year !== undefined && card.year !== null && card.year !== '') {\n   423→        return parseInt(card.year, 10) === yearInt;\n   424→      }\n   425→\n   426→      // Secondary: use sprint's year field\n   427→      if (card.sprint) {\n   428→        let sprintYear = this.sprintYearMap.get(card.sprint);\n   429→        if (!sprintYear && typeof card.sprint === 'string') {\n   430→          sprintYear = this.sprintYearMap.get(card.sprint.toLowerCase());\n   431→        }\n   432→        if (sprintYear) {\n   433→          return sprintYear === yearInt;\n   434→        }\n   435→      }\n   436→\n   437→      // No year field and no sprint: show in current year\n   438→      return yearInt === currentYear;\n   439→    }\n   440→\n   441→    buildMetrics(datasets) {\n   442→      const globalMap = new Map();\n   443→      const projectsMap = new Map();\n   444→\n   445→      datasets.forEach(({ project, tasks, bugs }) => {\n   446→        const projectMap = new Map();\n   447→\n   448→        tasks.forEach((task) => {\n   449→          const normalized = this.normalizeDeveloper(task.developer);\n   450→          if (!normalized) return;\n   451→\n   452→          const projectStats = this.getOrCreateStats(projectMap, normalized, project);\n   453→          const globalStats = this.getOrCreateStats(globalMap, normalized, project);\n   454→\n   455→          this.processTask(projectStats, task);\n   456→          this.processTask(globalStats, task);\n   457→        });\n   458→\n   459→        bugs.forEach((bug) => {\n   460→          const normalized = this.normalizeDeveloper(bug.developer || bug.assignee);\n   461→          if (!normalized) return;\n   462→\n   463→          const projectStats = this.getOrCreateStats(projectMap, normalized, project);\n   464→          const globalStats = this.getOrCreateStats(globalMap, normalized, project);\n   465→\n   466→          this.processBug(projectStats, bug);\n   467→          this.processBug(globalStats, bug);\n   468→        });\n   469→\n   470→        projectsMap.set(project.id, this.generateMetricsPayload(projectMap, project));\n   471→      });\n   472→\n   473→      return {\n   474→        global: this.generateMetricsPayload(globalMap),\n   475→        projects: projectsMap\n   476→      };\n   477→    }\n   478→\n   479→    normalizeDeveloper(rawDeveloper) {\n   480→      const normalized = normalizeDeveloperEntry(rawDeveloper || '');\n   481→      const needsFallbackUnassigned = !normalized.isUnassigned && !normalized.name && !normalized.email;\n   482→      const isUnassigned = normalized.isUnassigned || needsFallbackUnassigned;\n   483→      const developerKey = isUnassigned\n   484→        ? 'developer:unassigned'\n   485→        : (getDeveloperKey(rawDeveloper || normalized.name) || `developer:${(normalized.name || '').toLowerCase()}`);\n   486→\n   487→      // Try to resolve name from developerMap using various keys\n   488→      let resolvedName = null;\n   489→      if (!isUnassigned) {\n   490→        const rawLower = (rawDeveloper || '').toString().toLowerCase();\n   491→        const emailLower = (normalized.email || '').toLowerCase();\n   492→\n   493→        // Try raw value (could be ID like \"dev_abc\")\n   494→        if (this.developerMap.has(rawLower)) {\n   495→          resolvedName = this.developerMap.get(rawLower);\n   496→        }\n   497→        // Try email\n   498→        else if (emailLower && this.developerMap.has(emailLower)) {\n   499→          resolvedName = this.developerMap.get(emailLower);\n   500→        }\n   501→        // Try normalized name\n   502→        else if (normalized.name && this.developerMap.has(normalized.name.toLowerCase())) {\n   503→          resolvedName = this.developerMap.get(normalized.name.toLowerCase());\n   504→        }\n   505→      }\n   506→\n   507→      const developerName = isUnassigned\n   508→        ? 'Sin asignar'\n   509→        : (resolvedName || normalized.name || this.formatNameFromEmail(normalized.email) || 'Sin asignar');\n   510→\n   511→      const developerEmail = normalized.isUnassigned ? '' : (normalized.email || normalized.sourceEmail || '');\n   512→\n   513→      return {\n   514→        key: developerKey,\n   515→        name: developerName,\n   516→        email: developerEmail\n   517→      };\n   518→    }\n   519→\n   520→    getOrCreateStats(map, developerInfo, project) {\n   521→      if (!map.has(developerInfo.key)) {\n   522→        map.set(developerInfo.key, {\n   523→          developerKey: developerInfo.key,\n   524→          developer: developerInfo.name,\n   525→          email: developerInfo.email,\n   526→          projectNames: new Set(),\n   527→          totalTasks: 0,\n   528→          completedTasks: 0,\n   529→          inProgressTasks: 0,\n   530→          blockedTasks: 0,\n   531→          devPointsDone: 0,\n   532→          totalDevPoints: 0,\n   533→          bugsTotal: 0,\n   534→          bugsResolved: 0,\n   535→          bugsOpen: 0,\n   536→          aiTaskCount: 0,\n   537→          aiSessionCount: 0,\n   538→          aiTotalTokens: 0,\n   539→          aiTotalCostUSD: 0\n   540→        });\n   541→      }\n   542→\n   543→      const stats = map.get(developerInfo.key);\n   544→      if (project) {\n   545→        stats.projectNames.add(project.name || project.id);\n   546→      }\n   547→      return stats;\n   548→    }\n   549→\n   550→    processTask(stats, task) {\n   551→      stats.totalTasks += 1;\n   552→      const status = (task.status || '').toLowerCase();\n   553→      const devPoints = Number(task.devPoints) || 0;\n   554→\n   555→      if (status.includes('in progress')) {\n   556→        stats.inProgressTasks += 1;\n   557→      }\n   558→\n   559→      if (this.isTaskBlocked(task)) {\n   560→        stats.blockedTasks += 1;\n   561→      }\n   562→\n   563→      const isDone = status.includes('done') || status.includes('completed') || status.includes('ready for qa');\n   564→      if (isDone) {\n   565→        stats.completedTasks += 1;\n   566→        stats.devPointsDone += devPoints;\n   567→      }\n   568→\n   569→      stats.totalDevPoints += devPoints;\n   570→\n   571→      // Accumulate AI usage metrics\n   572→      const aiUsage = Array.isArray(task.aiUsage) ? task.aiUsage : [];\n   573→      if (aiUsage.length > 0) {\n   574→        stats.aiTaskCount += 1;\n   575→        stats.aiSessionCount += aiUsage.length;\n   576→        for (const entry of aiUsage) {\n   577→          stats.aiTotalTokens += Number(entry.totalTokens) || 0;\n   578→          stats.aiTotalCostUSD += Number(entry.estimatedCostUSD) || 0;\n   579→        }\n   580→      }\n   581→    }\n   582→\n   583→    processBug(stats, bug) {\n   584→      stats.bugsTotal += 1;\n   585→      const status = (bug.status || '').toLowerCase();\n   586→      const resolved = status.includes('done') || status.includes('fixed') || status.includes('closed') || status.includes('resolved');\n   587→      if (resolved) {\n   588→        stats.bugsResolved += 1;\n   589→      } else {\n   590→        stats.bugsOpen += 1;\n   591→      }\n   592→\n   593→      // Accumulate AI usage metrics from bugs\n   594→      const aiUsage = Array.isArray(bug.aiUsage) ? bug.aiUsage : [];\n   595→      if (aiUsage.length > 0) {\n   596→        stats.aiTaskCount += 1;\n   597→        stats.aiSessionCount += aiUsage.length;\n   598→        for (const entry of aiUsage) {\n   599→          stats.aiTotalTokens += Number(entry.totalTokens) || 0;\n   600→          stats.aiTotalCostUSD += Number(entry.estimatedCostUSD) || 0;\n   601→        }\n   602→      }\n   603→    }\n   604→\n   605→    generateMetricsPayload(map, project = null) {\n   606→      const developers = Array.from(map.values()).map((stats) => ({\n   607→        ...stats,\n   608→        projectList: Array.from(stats.projectNames)\n   609→      })).sort((a, b) => b.completedTasks - a.completedTasks || b.totalTasks - a.totalTasks);\n   610→\n   611→      const totals = developers.reduce((acc, row) => {\n   612→        acc.totalTasks += row.totalTasks;\n   613→        acc.completedTasks += row.completedTasks;\n   614→        acc.inProgressTasks += row.inProgressTasks;\n   615→        acc.blockedTasks += row.blockedTasks;\n   616→        acc.devPointsDone += row.devPointsDone;\n   617→        acc.totalDevPoints += row.totalDevPoints;\n   618→        acc.bugsTotal += row.bugsTotal;\n   619→        acc.bugsResolved += row.bugsResolved;\n   620→        acc.bugsOpen += row.bugsOpen;\n   621→        acc.aiTaskCount += row.aiTaskCount;\n   622→        acc.aiSessionCount += row.aiSessionCount;\n   623→        acc.aiTotalTokens += row.aiTotalTokens;\n   624→        acc.aiTotalCostUSD += row.aiTotalCostUSD;\n   625→        return acc;\n   626→      }, {\n   627→        totalTasks: 0,\n   628→        completedTasks: 0,\n   629→        inProgressTasks: 0,\n   630→        blockedTasks: 0,\n   631→        devPointsDone: 0,\n   632→        totalDevPoints: 0,\n   633→        bugsTotal: 0,\n   634→        bugsResolved: 0,\n   635→        bugsOpen: 0,\n   636→        aiTaskCount: 0,\n   637→        aiSessionCount: 0,\n   638→        aiTotalTokens: 0,\n   639→        aiTotalCostUSD: 0\n   640→      });\n   641→\n   642→      return {\n   643→        projectId: project?.id || null,\n   644→        projectName: project?.name || null,\n   645→        developers,\n   646→        totals\n   647→      };\n   648→    }\n   649→\n   650→    render() {\n   651→      if (!this.metrics) {\n   652→        this.setError('No hay métricas disponibles.');\n   653→        return;\n   654→      }\n   655→\n   656→      const scopeData = this.selectedScope === 'all'\n   657→        ? this.metrics.global\n   658→        : this.metrics.projects.get(this.selectedScope);\n   659→\n   660→      if (!scopeData) {\n   661→        this.setError('No existen datos para el proyecto seleccionado.');\n   662→        return;\n   663→      }\n   664→\n   665→      this.renderSummary(scopeData);\n   666→      this.renderDeveloperTable(scopeData);\n   667→      this.renderProjectBreakdown();\n   668→    }\n   669→\n   670→    renderSummary(scopeData) {\n   671→      const totals = scopeData.totals || {};\n   672→      const cards = [\n   673→        {\n   674→          label: 'Tareas totales',\n   675→          value: totals.totalTasks,\n   676→          detail: `${this.formatNumber(totals.completedTasks)} completadas`\n   677→        },\n   678→        {\n   679→          label: 'En progreso',\n   680→          value: totals.inProgressTasks,\n   681→          detail: `${this.formatNumber(totals.blockedTasks)} bloqueadas`\n   682→        },\n   683→        {\n   684→          label: 'Dev points',\n   685→          value: totals.devPointsDone,\n   686→          detail: `${this.formatNumber(totals.totalDevPoints)} estimados`\n   687→        },\n   688→        {\n   689→          label: 'Bugs',\n   690→          value: totals.bugsOpen,\n   691→          detail: `${this.formatNumber(totals.bugsResolved)} resueltos`\n   692→        },\n   693→        ...(totals.aiTaskCount > 0 ? [\n   694→          {\n   695→            label: 'Tareas con IA',\n   696→            value: totals.aiTaskCount,\n   697→            detail: `${this.formatNumber(totals.aiSessionCount)} sesiones`\n   698→          },\n   699→          {\n   700→            label: 'Coste IA',\n   701→            value: `$${totals.aiTotalCostUSD.toFixed(2)}`,\n   702→            detail: `${this.formatNumber(totals.aiTotalTokens)} tokens`\n   703→          }\n   704→        ] : [])\n   705→      ];\n   706→\n   707→      this.elements.summaryCards.innerHTML = cards.map((card) => `\n   708→        <article class=\"summary-card\">\n   709→          <p class=\"card-label\">${card.label}</p>\n   710→          <p class=\"card-value\">${this.formatNumber(card.value)}</p>\n   711→          <p class=\"card-detail\">${card.detail}</p>\n   712→        </article>\n   713→      `).join('');\n   714→    }\n   715→\n   716→    renderDeveloperTable(scopeData) {\n   717→      const rows = scopeData.developers || [];\n   718→      if (!rows.length) {\n   719→        this.elements.tableContainer.innerHTML = '<div class=\"dev-empty\">No hay developers con métricas registradas.</div>';\n   720→        return;\n   721→      }\n   722→\n   723→      const tableRows = rows.map((row) => {\n   724→        const projectsLabel = row.projectList.length <= 2\n   725→          ? row.projectList.join(', ')\n   726→          : `${row.projectList.length} proyectos`;\n   727→        return `\n   728→          <tr>\n   729→            <td>${row.developer}</td>\n   730→            <td>${projectsLabel || '—'}</td>\n   731→            <td>${this.formatNumber(row.totalTasks)}</td>\n   732→            <td>${this.formatNumber(row.completedTasks)}</td>\n   733→            <td>${this.formatNumber(row.inProgressTasks)}</td>\n   734→            <td>${this.formatNumber(row.blockedTasks)}</td>\n   735→            <td>${this.formatNumber(row.devPointsDone)}</td>\n   736→            <td>${this.formatNumber(row.bugsOpen)} / ${this.formatNumber(row.bugsTotal)}</td>\n   737→          </tr>\n   738→        `;\n   739→      }).join('');\n   740→\n   741→      const scopeLabel = this.selectedScope === 'all' ? 'Todos mis proyectos' : scopeData.projectName;\n   742→      const highlightRow = rows[0];\n   743→\n   744→      this.elements.tableContainer.innerHTML = `\n   745→        <div class=\"developer-table-header\">\n   746→          <div>\n   747→            <p class=\"eyebrow\">Resumen · ${scopeLabel}</p>\n   748→            <h2>Performance de developers</h2>\n   749→            <p class=\"subtitle\">Tareas, bloqueos y carga de bugs por persona.</p>\n   750→          </div>\n   751→          ${highlightRow ? `\n   752→            <div class=\"dev-highlight-card\">\n   753→              <p class=\"highlight-label\">Top performer</p>\n   754→              <p class=\"highlight-name\">${highlightRow.developer}</p>\n   755→              <p class=\"highlight-metrics\">${this.formatNumber(highlightRow.completedTasks)} tareas done · ${this.formatNumber(highlightRow.bugsOpen)} bugs abiertos</p>\n   756→            </div>` : ''}\n   757→        </div>\n   758→        <div class=\"developer-table-wrapper\">\n   759→          <table class=\"developer-summary-table\">\n   760→            <thead>\n   761→              <tr>\n   762→                <th>Developer</th>\n   763→                <th>Proyectos</th>\n   764→                <th>Asignadas</th>\n   765→                <th>Completadas</th>\n   766→                <th>En progreso</th>\n   767→                <th>Bloqueadas</th>\n   768→                <th>Dev points (Done)</th>\n   769→                <th>Bugs (Abiertos/Totales)</th>\n   770→              </tr>\n   771→            </thead>\n   772→            <tbody>\n   773→              ${tableRows}\n   774→            </tbody>\n   775→          </table>\n   776→        </div>\n   777→      `;\n   778→    }\n   779→\n   780→    renderProjectBreakdown() {\n   781→      if (!this.metrics || !this.metrics.projects || !this.metrics.projects.size) {\n   782→        this.elements.projectBreakdown.innerHTML = '<div class=\"dev-empty\">No hay datos de proyectos disponibles.</div>';\n   783→        return;\n   784→      }\n   785→\n   786→      const cards = Array.from(this.metrics.projects.values()).map((projectMetric) => {\n   787→        const totals = projectMetric.totals || {};\n   788→        const topDevelopers = (projectMetric.developers || []).slice(0, 3);\n   789→        const topList = topDevelopers.length\n   790→          ? topDevelopers.map((dev) => `\n   791→            <li>\n   792→              <span class=\"dev-name\">${dev.developer}</span>\n   793→              <span class=\"dev-metric\"><strong>${this.formatNumber(dev.completedTasks)}</strong> done</span>\n   794→              <span class=\"dev-metric\"><strong>${this.formatNumber(dev.bugsOpen)}</strong> bugs abiertos</span>\n   795→            </li>\n   796→          `).join('')\n   797→          : '<li class=\"dev-empty-item\">Sin developers asignados</li>';\n   798→\n   799→        const completionRate = totals.totalTasks ? (totals.completedTasks / Math.max(totals.totalTasks, 1)) * 100 : 0;\n   800→        const bugRatio = totals.bugsTotal ? (totals.bugsOpen / Math.max(totals.bugsTotal, 1)) * 100 : 0;\n   801→        const stats = [\n   802→          { label: 'Completadas', value: totals.completedTasks },\n   803→          { label: 'En progreso', value: totals.inProgressTasks },\n   804→          { label: 'Bloqueadas', value: totals.blockedTasks },\n   805→          { label: 'Dev points (done)', value: totals.devPointsDone }\n   806→        ];\n   807→\n   808→        return `\n   809→          <article class=\"project-card\">\n   810→            <header>\n   811→              <div>\n   812→                <h3>${projectMetric.projectName || projectMetric.projectId}</h3>\n   813→                <p>${this.formatNumber(totals.totalTasks)} tareas · ${this.formatNumber(totals.bugsOpen)} bugs abiertos</p>\n   814→              </div>\n   815→              <span class=\"project-chip\">${projectMetric.projectName?.slice(0, 3).toUpperCase() || 'PRJ'}</span>\n   816→            </header>\n   817→            <div class=\"project-stat-grid\">\n   818→              ${stats.map((stat) => `\n   819→                <div class=\"project-stat\">\n   820→                  <span class=\"stat-label\">${stat.label}</span>\n   821→                  <strong class=\"stat-value\">${this.formatNumber(stat.value)}</strong>\n   822→                </div>\n   823→              `).join('')}\n   824→            </div>\n   825→            <div class=\"project-progress\">\n   826→              <div class=\"progress-block\">\n   827→                <div class=\"progress-label\">Tareas completadas</div>\n   828→                <div class=\"progress-track\">\n   829→                  <div class=\"progress-fill completed\" style=\"width:${completionRate}%\"></div>\n   830→                </div>\n   831→                <div class=\"progress-values\">${this.formatNumber(totals.completedTasks)} / ${this.formatNumber(totals.totalTasks)}</div>\n   832→              </div>\n   833→              <div class=\"progress-block\">\n   834→                <div class=\"progress-label\">Bugs abiertos</div>\n   835→                <div class=\"progress-track\">\n   836→                  <div class=\"progress-fill bugs\" style=\"width:${bugRatio}%\"></div>\n   837→                </div>\n   838→                <div class=\"progress-values\">${this.formatNumber(totals.bugsOpen)} / ${this.formatNumber(totals.bugsTotal)}</div>\n   839→              </div>\n   840→            </div>\n   841→            <div class=\"top-devs\">\n   842→              <p>Top developers</p>\n   843→              <ul>${topList}</ul>\n   844→            </div>\n   845→          </article>\n   846→        `;\n   847→      }).join('');\n   848→\n   849→      this.elements.projectBreakdown.innerHTML = `\n   850→        <h2>Detalle por proyecto</h2>\n   851→        <div class=\"project-card-grid\">\n   852→          ${cards}\n   853→        </div>\n   854→      `;\n   855→    }\n   856→\n   857→    setLoading(message) {\n   858→      if (!this.elements.loading || !this.elements.contentSection) return;\n   859→      this.elements.loading.textContent = message;\n   860→      this.elements.loading.classList.remove('hidden');\n   861→      this.elements.contentSection.classList.add('hidden');\n   862→    }\n   863→\n   864→    setReady() {\n   865→      if (!this.elements.loading || !this.elements.contentSection) return;\n   866→      this.elements.loading.classList.add('hidden');\n   867→      this.elements.contentSection.classList.remove('hidden');\n   868→    }\n   869→\n   870→    setError(message) {\n   871→      if (!this.elements.loading || !this.elements.contentSection) return;\n   872→      this.elements.loading.textContent = message;\n   873→      this.elements.loading.classList.remove('hidden');\n   874→      this.elements.contentSection.classList.add('hidden');\n   875→    }\n   876→\n   877→    formatNumber(value) {\n   878→      if (value === null || value === undefined) {\n   879→        return '0';\n   880→      }\n   881→      return Number(value).toLocaleString('es-ES');\n   882→    }\n   883→\n   884→    formatNameFromEmail(email) {\n   885→      if (!email || typeof email !== 'string') {\n   886→        return email || '';\n   887→      }\n   888→      const localPart = email.split('@')[0] || email;\n   889→      let cleaned = localPart.replace(/#ext#/gi, '');\n   890→      cleaned = cleaned.replace(/[._-]+/g, ' ');\n   891→      cleaned = cleaned.replace(/\\s+/g, ' ').trim();\n   892→      if (!cleaned) {\n   893→        return email;\n   894→      }\n   895→      return cleaned.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\n   896→    }\n   897→\n   898→    isTaskBlocked(task) {\n   899→      if (!task) return false;\n   900→      const status = (task.status || '').toLowerCase();\n   901→      return status.includes('block') || Boolean(task.blockedByBusiness) || Boolean(task.blockedByDevelopment);\n   902→    }\n   903→  }\n   904→\n   905→  // Security check: redirect if not super admin\n   906→  async function checkSuperAdminAccess() {\n   907→    try {\n   908→      const currentUserEmail = document.body.dataset.userEmail;\n   909→      const normalizedUserEmail = normalizeEmail(currentUserEmail);\n   910→\n   911→      if (!normalizedUserEmail) {\n   912→window.location.href = '/';\n   913→        return false;\n   914→      }\n   915→\n   916→      let hasAccess = false;\n   917→\n   918→      // First check: Environment variable (fastest)\n   919→      const normalizedSuperAdmin = normalizeEmail(envSuperAdminEmail);\n   920→      if (normalizedSuperAdmin && normalizedUserEmail === normalizedSuperAdmin) {\n   921→        hasAccess = true;\n   922→}\n   923→\n   924→      // NOTE: /data/superAdminEmails is DEPRECATED - SuperAdmin is only from .env\n   925→if (!hasAccess) {\n   926→window.location.href = '/dashboard/';\n   927→        return false;\n   928→      }\n   929→\n   930→      return true;\n   931→    } catch (error) {\n   932→window.location.href = '/dashboard/';\n   933→      return false;\n   934→    }\n   935→  }\n   936→\n   937→  document.addEventListener('astro:page-load', async () => {\n   938→    // Wait for user authentication using auth.currentUser or onAuthStateChanged\n   939→    const waitForUser = () => new Promise((resolve) => {\n   940→      if (auth.currentUser) {\n   941→        document.body.dataset.userEmail = auth.currentUser.email;\n   942→        resolve(auth.currentUser);\n   943→      } else {\n   944→        const unsubscribe = auth.onAuthStateChanged((user) => {\n   945→          unsubscribe();\n   946→          if (user) {\n   947→            document.body.dataset.userEmail = user.email;\n   948→          }\n   949→          resolve(user);\n   950→        });\n   951→        // Timeout after 10 seconds\n   952→        setTimeout(() => {\n   953→          unsubscribe();\n   954→          resolve(null);\n   955→        }, 10000);\n   956→      }\n   957→    });\n   958→\n   959→    const user = await waitForUser();\n   960→    if (!user) {\n   961→      window.location.href = '/';\n   962→      return;\n   963→    }\n   964→\n   965→    const isAllowed = await checkSuperAdminAccess();\n   966→\n   967→    // Only initialize if access is allowed\n   968→    if (isAllowed) {\n   969→      new DevelopmentAnalytics();\n   970→    }\n   971→  });\n   972→</script>\n   973→\n   974→<style is:global>\n   975→  :global(body) {\n   976→    background: var(--bg-secondary, #f5f7fb);\n   977→  }\n   978→\n   979→  .dev-content {\n   980→    margin-top: 1.5rem;\n   981→  }\n   982→\n   983→  .dev-tabs {\n   984→    display: flex;\n   985→    gap: 0.5rem;\n   986→    margin-bottom: 1.5rem;\n   987→    border-bottom: 2px solid var(--border-default, #e1e5ef);\n   988→    padding-bottom: 0;\n   989→  }\n   990→\n   991→  .dev-tab {\n   992→    padding: 0.75rem 1.5rem;\n   993→    border: none;\n   994→    background: transparent;\n   995→    font-size: 1rem;\n   996→    font-weight: 600;\n   997→    color: var(--text-muted, #6b7280);\n   998→    cursor: pointer;\n   999→    border-bottom: 3px solid transparent;\n  1000→    margin-bottom: -2px;\n  1001→    transition: all 0.2s ease;\n  1002→  }\n  1003→\n  1004→  .dev-tab:hover {\n  1005→    color: var(--text-secondary, #374151);\n  1006→  }\n  1007→\n  1008→  .dev-tab.active {\n  1009→    color: var(--brand-primary, #2563eb);\n  1010→    border-bottom-color: var(--brand-primary, #2563eb);\n  1011→  }\n  1012→\n  1013→  .dev-tab-content {\n  1014→    display: none;\n  1015→  }\n  1016→\n  1017→  .dev-tab-content.active {\n  1018→    display: block;\n  1019→  }\n  1020→\n  1021→  .dev-dashboard-header {\n  1022→    display: flex;\n  1023→    justify-content: space-between;\n  1024→    align-items: flex-end;\n  1025→    gap: 1.5rem;\n  1026→    padding: 2rem 1rem;\n  1027→    background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);\n  1028→    color: var(--text-on-primary, #fff);\n  1029→    border-radius: 18px;\n  1030→    margin-bottom: 2rem;\n  1031→  }\n  1032→\n  1033→  .dev-dashboard-header h1 {\n  1034→    margin: 0;\n  1035→    font-size: 2.5rem;\n  1036→  }\n  1037→\n  1038→  .dev-dashboard-header p {\n  1039→    margin: 0.35rem 0 0;\n  1040→    color: rgba(255, 255, 255, 0.8);\n  1041→  }\n  1042→\n  1043→  .dev-header-actions {\n  1044→    font-weight: 600;\n  1045→    letter-spacing: 0.05em;\n  1046→    text-transform: uppercase;\n  1047→    opacity: 0.8;\n  1048→  }\n  1049→\n  1050→  .dev-controls {\n  1051→    display: flex;\n  1052→    gap: 1rem;\n  1053→    flex-wrap: wrap;\n  1054→    padding: 1rem;\n  1055→    background: var(--bg-primary, white);\n  1056→    border-radius: 12px;\n  1057→    border: 1px solid var(--border-default, #e1e5ef);\n  1058→    margin-bottom: 1.5rem;\n  1059→  }\n  1060→\n  1061→  .control-group {\n  1062→    display: flex;\n  1063→    flex-direction: column;\n  1064→    min-width: 220px;\n  1065→  }\n  1066→\n  1067→  .control-group label {\n  1068→    font-size: 0.85rem;\n  1069→    font-weight: 600;\n  1070→    margin-bottom: 0.25rem;\n  1071→    color: var(--text-secondary, #4a5568);\n  1072→  }\n  1073→\n  1074→  .control-group select {\n  1075→    padding: 0.5rem 0.75rem;\n  1076→    border-radius: 8px;\n  1077→    border: 1px solid var(--border-default, #cbd5f5);\n  1078→    font-size: 1rem;\n  1079→    background: var(--input-bg, var(--bg-primary, white));\n  1080→    color: var(--text-primary, #111827);\n  1081→  }\n  1082→\n  1083→  .ghost {\n  1084→    padding: 0.55rem 1.25rem;\n  1085→    border-radius: 8px;\n  1086→    border: 1px solid var(--border-default, #cbd5f5);\n  1087→    color: var(--text-primary, #111827);\n  1088→    background: transparent;\n  1089→    cursor: pointer;\n  1090→    font-weight: 600;\n  1091→  }\n  1092→\n  1093→  .ghost:disabled {\n  1094→    opacity: 0.6;\n  1095→    cursor: not-allowed;\n  1096→  }\n  1097→\n  1098→  .dev-loading {\n  1099→    padding: 2.5rem;\n  1100→    text-align: center;\n  1101→    border-radius: 12px;\n  1102→    border: 1px dashed var(--border-default, #d0d7eb);\n  1103→    background: var(--bg-primary, white);\n  1104→    color: var(--text-primary, #111827);\n  1105→    margin-bottom: 1.5rem;\n  1106→    font-weight: 500;\n  1107→  }\n  1108→\n  1109→  .hidden {\n  1110→    display: none !important;\n  1111→  }\n  1112→\n  1113→  .summary-cards {\n  1114→    display: grid;\n  1115→    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  1116→    gap: 1rem;\n  1117→  }\n  1118→\n  1119→  .summary-card {\n  1120→    background: var(--bg-primary, white);\n  1121→    border-radius: 12px;\n  1122→    border: 1px solid var(--border-subtle, #e6e9f3);\n  1123→    padding: 1.25rem;\n  1124→    box-shadow: 0 10px 30px -25px rgba(15, 23, 42, 0.65);\n  1125→  }\n  1126→\n  1127→  .summary-card .card-label {\n  1128→    margin: 0;\n  1129→    text-transform: uppercase;\n  1130→    font-size: 0.75rem;\n  1131→    letter-spacing: 0.1em;\n  1132→    color: var(--text-muted, #6b7280);\n  1133→  }\n  1134→\n  1135→  .summary-card .card-value {\n  1136→    font-size: 2rem;\n  1137→    margin: 0.25rem 0 0.15rem;\n  1138→    font-weight: 600;\n  1139→    color: var(--text-primary, #111827);\n  1140→  }\n  1141→\n  1142→  .summary-card .card-detail {\n  1143→    margin: 0;\n  1144→    color: var(--text-secondary, #4b5563);\n  1145→  }\n  1146→\n  1147→  .developer-table-container {\n  1148→    margin-top: 2rem;\n  1149→    background: var(--bg-primary, white);\n  1150→    border-radius: 12px;\n  1151→    border: 1px solid var(--border-default, #e1e5ef);\n  1152→    padding: 1.5rem;\n  1153→  }\n  1154→\n  1155→  .developer-table-header {\n  1156→    margin-bottom: 1.5rem;\n  1157→    display: flex;\n  1158→    justify-content: space-between;\n  1159→    gap: 1rem;\n  1160→    align-items: center;\n  1161→  }\n  1162→\n  1163→  .developer-table-header h2 {\n  1164→    margin: 0.15rem 0 0;\n  1165→  }\n  1166→\n  1167→  .dev-highlight-card {\n  1168→    background: linear-gradient(120deg, rgba(14,165,233,0.12), rgba(79,70,229,0.12));\n  1169→    border: 1px solid rgba(59,130,246,0.3);\n  1170→    border-radius: 16px;\n  1171→    padding: 0.85rem 1.15rem;\n  1172→    min-width: 240px;\n  1173→  }\n  1174→\n  1175→  .dev-highlight-card .highlight-label {\n  1176→    margin: 0;\n  1177→    text-transform: uppercase;\n  1178→    font-size: 0.7rem;\n  1179→    letter-spacing: 0.12em;\n  1180→    color: var(--brand-primary, #2563eb);\n  1181→  }\n  1182→\n  1183→  .dev-highlight-card .highlight-name {\n  1184→    margin: 0.25rem 0 0;\n  1185→    font-size: 1.1rem;\n  1186→    font-weight: 600;\n  1187→  }\n  1188→\n  1189→  .dev-highlight-card .highlight-metrics {\n  1190→    margin: 0.15rem 0 0;\n  1191→    color: var(--text-secondary, #4b5563);\n  1192→    font-size: 0.9rem;\n  1193→  }\n  1194→\n  1195→  .developer-table-wrapper {\n  1196→    overflow-x: auto;\n  1197→  }\n  1198→\n  1199→  table {\n  1200→    width: 100%;\n  1201→    border-collapse: collapse;\n  1202→  }\n  1203→\n  1204→  .developer-summary-table {\n  1205→    border-radius: 18px;\n  1206→    overflow: hidden;\n  1207→    border: 1px solid var(--border-subtle, #e5e7f3);\n  1208→    box-shadow: var(--shadow-lg, 0 15px 40px -35px rgba(15,23,42,0.7));\n  1209→    min-width: 900px;\n  1210→  }\n  1211→\n  1212→  thead th {\n  1213→    text-align: left;\n  1214→    padding: 1rem;\n  1215→    background: var(--table-header-bg, linear-gradient(120deg, #eef2ff, #fdf2ff));\n  1216→    font-size: 0.9rem;\n  1217→    color: var(--text-secondary, #4a5568);\n  1218→    border-bottom: 1px solid var(--border-subtle, #dee5fb);\n  1219→  }\n  1220→\n  1221→  tbody td {\n  1222→    padding: 1rem;\n  1223→    border-bottom: 1px solid var(--border-subtle, #f0f4ff);\n  1224→    font-size: 0.95rem;\n  1225→    color: var(--text-primary, #111827);\n  1226→  }\n  1227→\n  1228→  tbody tr:nth-child(even) {\n  1229→    background: var(--bg-tertiary, #fbfcff);\n  1230→  }\n  1231→\n  1232→  tbody tr:hover {\n  1233→    background: var(--hover-overlay, rgba(99, 102, 241, 0.08));\n  1234→  }\n  1235→\n  1236→  .project-breakdown {\n  1237→    margin-top: 2rem;\n  1238→  }\n  1239→\n  1240→  .project-card-grid {\n  1241→    display: grid;\n  1242→    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  1243→    gap: 1.25rem;\n  1244→  }\n  1245→\n  1246→  .project-card {\n  1247→    background: var(--card-bg, linear-gradient(145deg, rgba(255,255,255,0.95), rgba(245,247,255,0.9)));\n  1248→    border-radius: 20px;\n  1249→    border: 1px solid var(--border-subtle, rgba(147, 155, 183, 0.2));\n  1250→    padding: 1.75rem;\n  1251→    box-shadow: var(--shadow-lg, 0 35px 65px -45px rgba(15, 23, 42, 0.8));\n  1252→  }\n  1253→\n  1254→  .project-card header h3 {\n  1255→    margin: 0 0 0.35rem;\n  1256→  }\n  1257→\n  1258→  .project-card header {\n  1259→    display: flex;\n  1260→    justify-content: space-between;\n  1261→    align-items: flex-start;\n  1262→    gap: 1rem;\n  1263→    border-bottom: 1px solid rgba(148, 163, 184, 0.25);\n  1264→    padding-bottom: 0.75rem;\n  1265→  }\n  1266→\n  1267→  .project-card header p {\n  1268→    margin: 0;\n  1269→    color: var(--text-secondary, #4a5568);\n  1270→  }\n  1271→\n  1272→  .project-chip {\n  1273→    padding: 0.3rem 0.75rem;\n  1274→    border-radius: 999px;\n  1275→    font-weight: 600;\n  1276→    letter-spacing: 0.05em;\n  1277→    font-size: 0.85rem;\n  1278→    color: var(--text-primary, #1d3557);\n  1279→    background: var(--hover-overlay, rgba(29, 53, 87, 0.08));\n  1280→  }\n  1281→\n  1282→  .project-stat-grid {\n  1283→    display: grid;\n  1284→    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  1285→    gap: 0.75rem;\n  1286→    margin: 1rem 0 1.5rem;\n  1287→  }\n  1288→\n  1289→  .project-stat {\n  1290→    background: rgba(22, 82, 240, 0.07);\n  1291→    border-radius: 14px;\n  1292→    padding: 0.85rem 1rem;\n  1293→    border: 1px solid rgba(22, 82, 240, 0.15);\n  1294→    backdrop-filter: blur(12px);\n  1295→  }\n  1296→\n  1297→  .project-stat .stat-label {\n  1298→    display: block;\n  1299→    font-size: 0.75rem;\n  1300→    text-transform: uppercase;\n  1301→    letter-spacing: 0.08em;\n  1302→    color: var(--text-muted, #5c6b8a);\n  1303→    margin-bottom: 0.25rem;\n  1304→  }\n  1305→\n  1306→  .project-stat .stat-value {\n  1307→    font-size: 1.45rem;\n  1308→    color: var(--text-primary, #1f2937);\n  1309→  }\n  1310→\n  1311→  .project-progress {\n  1312→    display: grid;\n  1313→    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  1314→    gap: 1rem;\n  1315→    margin-bottom: 1.2rem;\n  1316→  }\n  1317→\n  1318→  .progress-block {\n  1319→    background: rgba(15, 23, 42, 0.035);\n  1320→    border-radius: 12px;\n  1321→    padding: 0.75rem 1rem;\n  1322→    border: 1px dashed rgba(99, 102, 241, 0.3);\n  1323→  }\n  1324→\n  1325→  .progress-label {\n  1326→    font-size: 0.8rem;\n  1327→    text-transform: uppercase;\n  1328→    letter-spacing: 0.08em;\n  1329→    color: var(--text-muted, #6b7280);\n  1330→    margin-bottom: 0.4rem;\n  1331→  }\n  1332→\n  1333→  .progress-track {\n  1334→    height: 8px;\n  1335→    border-radius: 999px;\n  1336→    background: var(--progress-track-bg, rgba(229, 231, 235, 0.9));\n  1337→    overflow: hidden;\n  1338→    margin-bottom: 0.35rem;\n  1339→  }\n  1340→\n  1341→  .progress-fill {\n  1342→    height: 100%;\n  1343→    border-radius: 999px;\n  1344→    transition: width 0.4s ease;\n  1345→  }\n  1346→\n  1347→  .progress-fill.completed {\n  1348→    background: linear-gradient(135deg, #22d3ee, #6366f1);\n  1349→  }\n  1350→\n  1351→  .progress-fill.bugs {\n  1352→    background: linear-gradient(135deg, #f97316, #ef4444);\n  1353→  }\n  1354→\n  1355→  .progress-values {\n  1356→    font-size: 0.85rem;\n  1357→    color: var(--text-primary, #1f2937);\n  1358→  }\n  1359→\n  1360→  .top-devs ul {\n  1361→    margin: 0.5rem 0 0;\n  1362→    padding-left: 0;\n  1363→  }\n  1364→\n  1365→  .top-devs ul li {\n  1366→    margin-bottom: 0.35rem;\n  1367→    list-style: none;\n  1368→    padding: 0.55rem 0.85rem;\n  1369→    border-radius: 12px;\n  1370→    background: rgba(15, 23, 42, 0.04);\n  1371→    display: flex;\n  1372→    flex-wrap: wrap;\n  1373→    gap: 0.75rem;\n  1374→    align-items: center;\n  1375→  }\n  1376→\n  1377→  .top-devs ul li .dev-name {\n  1378→    font-weight: 600;\n  1379→    color: var(--text-primary, #111827);\n  1380→  }\n  1381→\n  1382→  .top-devs ul li .dev-metric {\n  1383→    font-size: 0.9rem;\n  1384→    color: var(--text-secondary, #4b5563);\n  1385→  }\n  1386→\n  1387→  .dev-empty-item {\n  1388→    opacity: 0.7;\n  1389→  }\n  1390→\n  1391→  .dev-empty {\n  1392→    padding: 2rem;\n  1393→    text-align: center;\n  1394→    color: var(--text-muted, #6b7280);\n  1395→  }\n  1396→\n  1397→  @media (max-width: 768px) {\n  1398→    .dev-controls {\n  1399→      flex-direction: column;\n  1400→    }\n  1401→    .control-group {\n  1402→      width: 100%;\n  1403→    }\n  1404→  }\n  1405→</style>\n  1406→\n  1407→</div>\n  1408→"}]},"parent_tool_use_id":null,"session_id":"e2c98fa9-2be4-4ba6-ab9c-0317162fa25c","uuid":"6d66f6a3-24d1-48be-8dfe-44a20071deb7","tool_use_result":{"type":"text","file":{"filePath":"/home/manu/ws_firebase/planning-game-xp/src/pages/partials/development.astro","content":"        if (!this.projects.length) {\n          this.setError('No tienes proyectos asignados. Solicita acceso a un administrador.');\n          return;\n        }\n        this.populateProjectSelect();\n        this.populateYearSelect();\n        await Promise.all([\n          this.loadDeveloperMappings(),\n          this.loadSprintMappings()\n        ]);\n        this.elements.projectCount.textContent = `${this.projects.length} proyecto${this.projects.length === 1 ? '' : 's'}`;\n\n        await this.loadMetrics();\n        this.bindEvents();\n        // render() is now called inside loadMetrics()\n      } catch (error) {\nthis.setError('No se pudo cargar la vista de desarrollo.');\n      }\n    }\n\n    async waitForAuth() {\n      if (auth.currentUser) {\n        return auth.currentUser;\n      }\n\n      return new Promise((resolve) => {\n        const unsubscribe = auth.onAuthStateChanged((user) => {\n          unsubscribe();\n          resolve(user);\n        });\n        setTimeout(() => {\n          unsubscribe();\n          resolve(null);\n        }, 10000);\n      });\n    }\n\n    async loadAccessibleProjects(user) {\n      try {\n        const projectsRef = ref(database, '/projects');\n        const projectsSnap = await get(projectsRef);\n        if (!projectsSnap.exists()) {\n          return [];\n        }\n\n        const allProjects = Object.entries(projectsSnap.val() || {}).map(([id, project]) => ({\n          id,\n          name: project.name || id\n        }));\n\n        // SuperAdmin always sees all projects\n        const isSuperAdmin = envSuperAdminEmail && user.email.toLowerCase() === envSuperAdminEmail.toLowerCase();\n        if (isSuperAdmin) {\n          return allProjects;\n        }\n\n        const userKey = encodeEmailForFirebase(user.email);\n        const userProjectsRef = ref(database, `/data/projectsByUser/${userKey}`);\n        const userProjectsSnap = await get(userProjectsRef);\n        const userProjectData = userProjectsSnap.val();\n\n        if (userProjectData === 'All') {\n          return allProjects;\n        }\n\n        if (typeof userProjectData === 'string') {\n          const allowed = userProjectData.split(',').map((p) => p.trim()).filter(Boolean);\n          return allProjects.filter((project) => allowed.includes(project.id) || allowed.includes(project.name));\n        }\n\n        return [];\n      } catch (error) {\nreturn [];\n      }\n    }\n\n    bindEvents() {\n      if (this.elements.scopeSelect) {\n        this.elements.scopeSelect.addEventListener('change', (event) => {\n          this.selectedScope = event.target.value || 'all';\n          this.render();\n        });\n      }\n\n      if (this.elements.yearSelect) {\n        this.elements.yearSelect.addEventListener('change', (event) => {\n          this.selectedYear = event.target.value || 'all';\n          this.loadMetrics(true);\n        });\n      }\n\n      if (this.elements.reloadButton) {\n        this.elements.reloadButton.addEventListener('click', () => {\n          this.loadMetrics(true);\n        });\n      }\n\n      // Tab switching\n      document.querySelectorAll('.dev-tab').forEach(tab => {\n        tab.addEventListener('click', (event) => {\n          const tabName = event.target.dataset.tab;\n          this.switchTab(tabName);\n        });\n      });\n    }\n\n    switchTab(tabName) {\n      this.activeTab = tabName;\n\n      // Update tab buttons\n      document.querySelectorAll('.dev-tab').forEach(tab => {\n        tab.classList.toggle('active', tab.dataset.tab === tabName);\n      });\n\n      // Update tab content\n      if (this.elements.tabSummary) {\n        this.elements.tabSummary.classList.toggle('active', tabName === 'summary');\n      }\n      if (this.elements.tabProjects) {\n        this.elements.tabProjects.classList.toggle('active', tabName === 'projects');\n      }\n    }\n\n    populateProjectSelect() {\n      const select = this.elements.scopeSelect;\n      if (!select) return;\n\n      select.innerHTML = '';\n      const optionAll = document.createElement('option');\n      optionAll.value = 'all';\n      optionAll.textContent = 'Todos mis proyectos';\n      select.appendChild(optionAll);\n\n      this.projects.forEach((project) => {\n        const option = document.createElement('option');\n        option.value = project.id;\n        option.textContent = project.name || project.id;\n        select.appendChild(option);\n      });\n\n      select.disabled = false;\n      this.elements.reloadButton.disabled = false;\n    }\n\n    populateYearSelect() {\n      const select = this.elements.yearSelect;\n      if (!select) return;\n\n      select.innerHTML = '';\n\n      // Add \"All years\" option\n      const optionAll = document.createElement('option');\n      optionAll.value = 'all';\n      optionAll.textContent = 'Todos los años';\n      select.appendChild(optionAll);\n\n      // Add years from current year back to 2020\n      const currentYear = new Date().getFullYear();\n      for (let year = currentYear; year >= 2020; year--) {\n        const option = document.createElement('option');\n        option.value = year.toString();\n        option.textContent = year.toString();\n        select.appendChild(option);\n      }\n\n      // Set the value directly to ensure it's selected\n      select.value = this.selectedYear;\n      select.disabled = false;\n    }\n\n    async loadDeveloperMappings() {\n      // Load developer info from global entities and projects\n      try {\n        // First, load from global developers (/data/developers) - source of truth\n        const entitiesSnap = await get(ref(database, '/data/developers'));\n        if (entitiesSnap.exists()) {\n          const entities = entitiesSnap.val() || {};\n          Object.entries(entities).forEach(([id, dev]) => {\n            if (!dev) return;\n            const name = dev.name || '';\n            const email = (dev.email || '').toLowerCase();\n\n            // Map dev_XXX ID to name\n            if (id && name) {\n              this.developerMap.set(id.toLowerCase(), name);\n            }\n            // Map email to name\n            if (email && name) {\n              this.developerMap.set(email, name);\n            }\n          });\n        }\n\n        // Then, load from each project's developers list\n        for (const project of this.projects) {\n          const projectSnap = await get(ref(database, `/projects/${project.id}`));\n          if (projectSnap.exists()) {\n            const projectData = projectSnap.val() || {};\n            const developers = projectData.developers || [];\n\n            // Process each developer entry\n            (Array.isArray(developers) ? developers : Object.values(developers)).forEach(dev => {\n              if (!dev) return;\n\n              const id = dev.id || dev.name || '';\n              const name = dev.name || '';\n              const email = (dev.email || '').toLowerCase();\n\n              // Map ID to name (don't overwrite if already exists from entities)\n              if (id && name && !this.developerMap.has(id.toLowerCase())) {\n                this.developerMap.set(id.toLowerCase(), name);\n              }\n              // Map email to name\n              if (email && name && !this.developerMap.has(email)) {\n                this.developerMap.set(email, name);\n              }\n            });\n          }\n        }\n      } catch (error) {\n        // Silently ignore errors loading developer mappings\n      }\n    }\n\n    async loadSprintMappings() {\n      // Load sprint data to get year field for each sprint\n      try {\n        for (const project of this.projects) {\n          const sprintsSnap = await get(ref(database, `/cards/${project.id}/SPRINTS_${project.id}`));\n          if (sprintsSnap.exists()) {\n            const sprints = sprintsSnap.val() || {};\n            Object.entries(sprints).forEach(([sprintId, sprint]) => {\n              if (!sprint) return;\n\n              // Use sprint's year field directly\n              let sprintYear = sprint.year ? parseInt(sprint.year, 10) : null;\n\n              // Fallback to startDate if no year field\n              if (!sprintYear && sprint.startDate) {\n                sprintYear = new Date(sprint.startDate).getFullYear();\n              }\n\n              if (sprintYear) {\n                // Map by multiple keys for flexible lookup\n                const keysToMap = [\n                  sprintId,\n                  sprint.cardId,\n                  sprint.title,\n                  sprint.name,\n                  // Also map lowercase versions\n                  sprintId?.toLowerCase?.(),\n                  sprint.cardId?.toLowerCase?.(),\n                  sprint.title?.toLowerCase?.(),\n                  sprint.name?.toLowerCase?.()\n                ].filter(Boolean);\n\n                keysToMap.forEach(key => {\n                  this.sprintYearMap.set(key, sprintYear);\n                });\n              }\n            });\n          }\n        }\n      } catch (error) {\n        // Silently ignore errors loading sprint mappings\n      }\n    }\n\n    async loadMetrics(force = false) {\n      try {\n        if (!force && this.datasets.length) {\n          this.metrics = this.buildMetrics(this.datasets);\n          this.setReady();\n          this.render();\n          return;\n        }\n\n        this.setLoading('Calculando métricas de tareas y bugs...');\n        this.datasets = await Promise.all(this.projects.map((project) => this.fetchProjectDataset(project)));\n        this.metrics = this.buildMetrics(this.datasets);\n        this.setReady();\n        this.render();\n      } catch (error) {\nthis.setError('Error calculando métricas de desarrollo.');\n      }\n    }\n\n    async fetchProjectDataset(project) {\n      try {\n        const [tasksSnap, bugsSnap] = await Promise.all([\n          get(ref(database, `/cards/${project.id}/TASKS_${project.id}`)),\n          get(ref(database, `/cards/${project.id}/BUGS_${project.id}`))\n        ]);\n\n        let tasks = tasksSnap.exists() ? Object.values(tasksSnap.val() || {}) : [];\n        let bugs = bugsSnap.exists() ? Object.values(bugsSnap.val() || {}) : [];\n\n        // Filter by year if a specific year is selected\n        if (this.selectedYear && this.selectedYear !== 'all') {\n          tasks = tasks.filter(task => this.isFromYear(task, this.selectedYear));\n          bugs = bugs.filter(bug => this.isFromYear(bug, this.selectedYear));\n        }\n\n        return {\n          project,\n          tasks,\n          bugs\n        };\n      } catch (error) {\nreturn {\n          project,\n          tasks: [],\n          bugs: []\n        };\n      }\n    }\n\n    isFromYear(card, year) {\n      const yearInt = parseInt(year, 10);\n      const currentYear = new Date().getFullYear();\n\n      // Primary: use task's year field directly\n      if (card.year !== undefined && card.year !== null && card.year !== '') {\n        return parseInt(card.year, 10) === yearInt;\n      }\n\n      // Secondary: use sprint's year field\n      if (card.sprint) {\n        let sprintYear = this.sprintYearMap.get(card.sprint);\n        if (!sprintYear && typeof card.sprint === 'string') {\n          sprintYear = this.sprintYearMap.get(card.sprint.toLowerCase());\n        }\n        if (sprintYear) {\n          return sprintYear === yearInt;\n        }\n      }\n\n      // No year field and no sprint: show in current year\n      return yearInt === currentYear;\n    }\n\n    buildMetrics(datasets) {\n      const globalMap = new Map();\n      const projectsMap = new Map();\n\n      datasets.forEach(({ project, tasks, bugs }) => {\n        const projectMap = new Map();\n\n        tasks.forEach((task) => {\n          const normalized = this.normalizeDeveloper(task.developer);\n          if (!normalized) return;\n\n          const projectStats = this.getOrCreateStats(projectMap, normalized, project);\n          const globalStats = this.getOrCreateStats(globalMap, normalized, project);\n\n          this.processTask(projectStats, task);\n          this.processTask(globalStats, task);\n        });\n\n        bugs.forEach((bug) => {\n          const normalized = this.normalizeDeveloper(bug.developer || bug.assignee);\n          if (!normalized) return;\n\n          const projectStats = this.getOrCreateStats(projectMap, normalized, project);\n          const globalStats = this.getOrCreateStats(globalMap, normalized, project);\n\n          this.processBug(projectStats, bug);\n          this.processBug(globalStats, bug);\n        });\n\n        projectsMap.set(project.id, this.generateMetricsPayload(projectMap, project));\n      });\n\n      return {\n        global: this.generateMetricsPayload(globalMap),\n        projects: projectsMap\n      };\n    }\n\n    normalizeDeveloper(rawDeveloper) {\n      const normalized = normalizeDeveloperEntry(rawDeveloper || '');\n      const needsFallbackUnassigned = !normalized.isUnassigned && !normalized.name && !normalized.email;\n      const isUnassigned = normalized.isUnassigned || needsFallbackUnassigned;\n      const developerKey = isUnassigned\n        ? 'developer:unassigned'\n        : (getDeveloperKey(rawDeveloper || normalized.name) || `developer:${(normalized.name || '').toLowerCase()}`);\n\n      // Try to resolve name from developerMap using various keys\n      let resolvedName = null;\n      if (!isUnassigned) {\n        const rawLower = (rawDeveloper || '').toString().toLowerCase();\n        const emailLower = (normalized.email || '').toLowerCase();\n\n        // Try raw value (could be ID like \"dev_abc\")\n        if (this.developerMap.has(rawLower)) {\n          resolvedName = this.developerMap.get(rawLower);\n        }\n        // Try email\n        else if (emailLower && this.developerMap.has(emailLower)) {\n          resolvedName = this.developerMap.get(emailLower);\n        }\n        // Try normalized name\n        else if (normalized.name && this.developerMap.has(normalized.name.toLowerCase())) {\n          resolvedName = this.developerMap.get(normalized.name.toLowerCase());\n        }\n      }\n\n      const developerName = isUnassigned\n        ? 'Sin asignar'\n        : (resolvedName || normalized.name || this.formatNameFromEmail(normalized.email) || 'Sin asignar');\n\n      const developerEmail = normalized.isUnassigned ? '' : (normalized.email || normalized.sourceEmail || '');\n\n      return {\n        key: developerKey,\n        name: developerName,\n        email: developerEmail\n      };\n    }\n\n    getOrCreateStats(map, developerInfo, project) {\n      if (!map.has(developerInfo.key)) {\n        map.set(developerInfo.key, {\n          developerKey: developerInfo.key,\n          developer: developerInfo.name,\n          email: developerInfo.email,\n          projectNames: new Set(),\n          totalTasks: 0,\n          completedTasks: 0,\n          inProgressTasks: 0,\n          blockedTasks: 0,\n          devPointsDone: 0,\n          totalDevPoints: 0,\n          bugsTotal: 0,\n          bugsResolved: 0,\n          bugsOpen: 0,\n          aiTaskCount: 0,\n          aiSessionCount: 0,\n          aiTotalTokens: 0,\n          aiTotalCostUSD: 0\n        });\n      }\n\n      const stats = map.get(developerInfo.key);\n      if (project) {\n        stats.projectNames.add(project.name || project.id);\n      }\n      return stats;\n    }\n\n    processTask(stats, task) {\n      stats.totalTasks += 1;\n      const status = (task.status || '').toLowerCase();\n      const devPoints = Number(task.devPoints) || 0;\n\n      if (status.includes('in progress')) {\n        stats.inProgressTasks += 1;\n      }\n\n      if (this.isTaskBlocked(task)) {\n        stats.blockedTasks += 1;\n      }\n\n      const isDone = status.includes('done') || status.includes('completed') || status.includes('ready for qa');\n      if (isDone) {\n        stats.completedTasks += 1;\n        stats.devPointsDone += devPoints;\n      }\n\n      stats.totalDevPoints += devPoints;\n\n      // Accumulate AI usage metrics\n      const aiUsage = Array.isArray(task.aiUsage) ? task.aiUsage : [];\n      if (aiUsage.length > 0) {\n        stats.aiTaskCount += 1;\n        stats.aiSessionCount += aiUsage.length;\n        for (const entry of aiUsage) {\n          stats.aiTotalTokens += Number(entry.totalTokens) || 0;\n          stats.aiTotalCostUSD += Number(entry.estimatedCostUSD) || 0;\n        }\n      }\n    }\n\n    processBug(stats, bug) {\n      stats.bugsTotal += 1;\n      const status = (bug.status || '').toLowerCase();\n      const resolved = status.includes('done') || status.includes('fixed') || status.includes('closed') || status.includes('resolved');\n      if (resolved) {\n        stats.bugsResolved += 1;\n      } else {\n        stats.bugsOpen += 1;\n      }\n\n      // Accumulate AI usage metrics from bugs\n      const aiUsage = Array.isArray(bug.aiUsage) ? bug.aiUsage : [];\n      if (aiUsage.length > 0) {\n        stats.aiTaskCount += 1;\n        stats.aiSessionCount += aiUsage.length;\n        for (const entry of aiUsage) {\n          stats.aiTotalTokens += Number(entry.totalTokens) || 0;\n          stats.aiTotalCostUSD += Number(entry.estimatedCostUSD) || 0;\n        }\n      }\n    }\n\n    generateMetricsPayload(map, project = null) {\n      const developers = Array.from(map.values()).map((stats) => ({\n        ...stats,\n        projectList: Array.from(stats.projectNames)\n      })).sort((a, b) => b.completedTasks - a.completedTasks || b.totalTasks - a.totalTasks);\n\n      const totals = developers.reduce((acc, row) => {\n        acc.totalTasks += row.totalTasks;\n        acc.completedTasks += row.completedTasks;\n        acc.inProgressTasks += row.inProgressTasks;\n        acc.blockedTasks += row.blockedTasks;\n        acc.devPointsDone += row.devPointsDone;\n        acc.totalDevPoints += row.totalDevPoints;\n        acc.bugsTotal += row.bugsTotal;\n        acc.bugsResolved += row.bugsResolved;\n        acc.bugsOpen += row.bugsOpen;\n        acc.aiTaskCount += row.aiTaskCount;\n        acc.aiSessionCount += row.aiSessionCount;\n        acc.aiTotalTokens += row.aiTotalTokens;\n        acc.aiTotalCostUSD += row.aiTotalCostUSD;\n        return acc;\n      }, {\n        totalTasks: 0,\n        completedTasks: 0,\n        inProgressTasks: 0,\n        blockedTasks: 0,\n        devPointsDone: 0,\n        totalDevPoints: 0,\n        bugsTotal: 0,\n        bugsResolved: 0,\n        bugsOpen: 0,\n        aiTaskCount: 0,\n        aiSessionCount: 0,\n        aiTotalTokens: 0,\n        aiTotalCostUSD: 0\n      });\n\n      return {\n        projectId: project?.id || null,\n        projectName: project?.name || null,\n        developers,\n        totals\n      };\n    }\n\n    render() {\n      if (!this.metrics) {\n        this.setError('No hay métricas disponibles.');\n        return;\n      }\n\n      const scopeData = this.selectedScope === 'all'\n        ? this.metrics.global\n        : this.metrics.projects.get(this.selectedScope);\n\n      if (!scopeData) {\n        this.setError('No existen datos para el proyecto seleccionado.');\n        return;\n      }\n\n      this.renderSummary(scopeData);\n      this.renderDeveloperTable(scopeData);\n      this.renderProjectBreakdown();\n    }\n\n    renderSummary(scopeData) {\n      const totals = scopeData.totals || {};\n      const cards = [\n        {\n          label: 'Tareas totales',\n          value: totals.totalTasks,\n          detail: `${this.formatNumber(totals.completedTasks)} completadas`\n        },\n        {\n          label: 'En progreso',\n          value: totals.inProgressTasks,\n          detail: `${this.formatNumber(totals.blockedTasks)} bloqueadas`\n        },\n        {\n          label: 'Dev points',\n          value: totals.devPointsDone,\n          detail: `${this.formatNumber(totals.totalDevPoints)} estimados`\n        },\n        {\n          label: 'Bugs',\n          value: totals.bugsOpen,\n          detail: `${this.formatNumber(totals.bugsResolved)} resueltos`\n        },\n        ...(totals.aiTaskCount > 0 ? [\n          {\n            label: 'Tareas con IA',\n            value: totals.aiTaskCount,\n            detail: `${this.formatNumber(totals.aiSessionCount)} sesiones`\n          },\n          {\n            label: 'Coste IA',\n            value: `$${totals.aiTotalCostUSD.toFixed(2)}`,\n            detail: `${this.formatNumber(totals.aiTotalTokens)} tokens`\n          }\n        ] : [])\n      ];\n\n      this.elements.summaryCards.innerHTML = cards.map((card) => `\n        <article class=\"summary-card\">\n          <p class=\"card-label\">${card.label}</p>\n          <p class=\"card-value\">${this.formatNumber(card.value)}</p>\n          <p class=\"card-detail\">${card.detail}</p>\n        </article>\n      `).join('');\n    }\n\n    renderDeveloperTable(scopeData) {\n      const rows = scopeData.developers || [];\n      if (!rows.length) {\n        this.elements.tableContainer.innerHTML = '<div class=\"dev-empty\">No hay developers con métricas registradas.</div>';\n        return;\n      }\n\n      const tableRows = rows.map((row) => {\n        const projectsLabel = row.projectList.length <= 2\n          ? row.projectList.join(', ')\n          : `${row.projectList.length} proyectos`;\n        return `\n          <tr>\n            <td>${row.developer}</td>\n            <td>${projectsLabel || '—'}</td>\n            <td>${this.formatNumber(row.totalTasks)}</td>\n            <td>${this.formatNumber(row.completedTasks)}</td>\n            <td>${this.formatNumber(row.inProgressTasks)}</td>\n            <td>${this.formatNumber(row.blockedTasks)}</td>\n            <td>${this.formatNumber(row.devPointsDone)}</td>\n            <td>${this.formatNumber(row.bugsOpen)} / ${this.formatNumber(row.bugsTotal)}</td>\n          </tr>\n        `;\n      }).join('');\n\n      const scopeLabel = this.selectedScope === 'all' ? 'Todos mis proyectos' : scopeData.projectName;\n      const highlightRow = rows[0];\n\n      this.elements.tableContainer.innerHTML = `\n        <div class=\"developer-table-header\">\n          <div>\n            <p class=\"eyebrow\">Resumen · ${scopeLabel}</p>\n            <h2>Performance de developers</h2>\n            <p class=\"subtitle\">Tareas, bloqueos y carga de bugs por persona.</p>\n          </div>\n          ${highlightRow ? `\n            <div class=\"dev-highlight-card\">\n              <p class=\"highlight-label\">Top performer</p>\n              <p class=\"highlight-name\">${highlightRow.developer}</p>\n              <p class=\"highlight-metrics\">${this.formatNumber(highlightRow.completedTasks)} tareas done · ${this.formatNumber(highlightRow.bugsOpen)} bugs abiertos</p>\n            </div>` : ''}\n        </div>\n        <div class=\"developer-table-wrapper\">\n          <table class=\"developer-summary-table\">\n            <thead>\n              <tr>\n                <th>Developer</th>\n                <th>Proyectos</th>\n                <th>Asignadas</th>\n                <th>Completadas</th>\n                <th>En progreso</th>\n                <th>Bloqueadas</th>\n                <th>Dev points (Done)</th>\n                <th>Bugs (Abiertos/Totales)</th>\n              </tr>\n            </thead>\n            <tbody>\n              ${tableRows}\n            </tbody>\n          </table>\n        </div>\n      `;\n    }\n\n    renderProjectBreakdown() {\n      if (!this.metrics || !this.metrics.projects || !this.metrics.projects.size) {\n        this.elements.projectBreakdown.innerHTML = '<div class=\"dev-empty\">No hay datos de proyectos disponibles.</div>';\n        return;\n      }\n\n      const cards = Array.from(this.metrics.projects.values()).map((projectMetric) => {\n        const totals = projectMetric.totals || {};\n        const topDevelopers = (projectMetric.developers || []).slice(0, 3);\n        const topList = topDevelopers.length\n          ? topDevelopers.map((dev) => `\n            <li>\n              <span class=\"dev-name\">${dev.developer}</span>\n              <span class=\"dev-metric\"><strong>${this.formatNumber(dev.completedTasks)}</strong> done</span>\n              <span class=\"dev-metric\"><strong>${this.formatNumber(dev.bugsOpen)}</strong> bugs abiertos</span>\n            </li>\n          `).join('')\n          : '<li class=\"dev-empty-item\">Sin developers asignados</li>';\n\n        const completionRate = totals.totalTasks ? (totals.completedTasks / Math.max(totals.totalTasks, 1)) * 100 : 0;\n        const bugRatio = totals.bugsTotal ? (totals.bugsOpen / Math.max(totals.bugsTotal, 1)) * 100 : 0;\n        const stats = [\n          { label: 'Completadas', value: totals.completedTasks },\n          { label: 'En progreso', value: totals.inProgressTasks },\n          { label: 'Bloqueadas', value: totals.blockedTasks },\n          { label: 'Dev points (done)', value: totals.devPointsDone }\n        ];\n\n        return `\n          <article class=\"project-card\">\n            <header>\n              <div>\n                <h3>${projectMetric.projectName || projectMetric.projectId}</h3>\n                <p>${this.formatNumber(totals.totalTasks)} tareas · ${this.formatNumber(totals.bugsOpen)} bugs abiertos</p>\n              </div>\n              <span class=\"project-chip\">${projectMetric.projectName?.slice(0, 3).toUpperCase() || 'PRJ'}</span>\n            </header>\n            <div class=\"project-stat-grid\">\n              ${stats.map((stat) => `\n                <div class=\"project-stat\">\n                  <span class=\"stat-label\">${stat.label}</span>\n                  <strong class=\"stat-value\">${this.formatNumber(stat.value)}</strong>\n                </div>\n              `).join('')}\n            </div>\n            <div class=\"project-progress\">\n              <div class=\"progress-block\">\n                <div class=\"progress-label\">Tareas completadas</div>\n                <div class=\"progress-track\">\n                  <div class=\"progress-fill completed\" style=\"width:${completionRate}%\"></div>\n                </div>\n                <div class=\"progress-values\">${this.formatNumber(totals.completedTasks)} / ${this.formatNumber(totals.totalTasks)}</div>\n              </div>\n              <div class=\"progress-block\">\n                <div class=\"progress-label\">Bugs abiertos</div>\n                <div class=\"progress-track\">\n                  <div class=\"progress-fill bugs\" style=\"width:${bugRatio}%\"></div>\n                </div>\n                <div class=\"progress-values\">${this.formatNumber(totals.bugsOpen)} / ${this.formatNumber(totals.bugsTotal)}</div>\n              </div>\n            </div>\n            <div class=\"top-devs\">\n              <p>Top developers</p>\n              <ul>${topList}</ul>\n            </div>\n          </article>\n        `;\n      }).join('');\n\n      this.elements.projectBreakdown.innerHTML = `\n        <h2>Detalle por proyecto</h2>\n        <div class=\"project-card-grid\">\n          ${cards}\n        </div>\n      `;\n    }\n\n    setLoading(message) {\n      if (!this.elements.loading || !this.elements.contentSection) return;\n      this.elements.loading.textContent = message;\n      this.elements.loading.classList.remove('hidden');\n      this.elements.contentSection.classList.add('hidden');\n    }\n\n    setReady() {\n      if (!this.elements.loading || !this.elements.contentSection) return;\n      this.elements.loading.classList.add('hidden');\n      this.elements.contentSection.classList.remove('hidden');\n    }\n\n    setError(message) {\n      if (!this.elements.loading || !this.elements.contentSection) return;\n      this.elements.loading.textContent = message;\n      this.elements.loading.classList.remove('hidden');\n      this.elements.contentSection.classList.add('hidden');\n    }\n\n    formatNumber(value) {\n      if (value === null || value === undefined) {\n        return '0';\n      }\n      return Number(value).toLocaleString('es-ES');\n    }\n\n    formatNameFromEmail(email) {\n      if (!email || typeof email !== 'string') {\n        return email || '';\n      }\n      const localPart = email.split('@')[0] || email;\n      let cleaned = localPart.replace(/#ext#/gi, '');\n      cleaned = cleaned.replace(/[._-]+/g, ' ');\n      cleaned = cleaned.replace(/\\s+/g, ' ').trim();\n      if (!cleaned) {\n        return email;\n      }\n      return cleaned.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\n    }\n\n    isTaskBlocked(task) {\n      if (!task) return false;\n      const status = (task.status || '').toLowerCase();\n      return status.includes('block') || Boolean(task.blockedByBusiness) || Boolean(task.blockedByDevelopment);\n    }\n  }\n\n  // Security check: redirect if not super admin\n  async function checkSuperAdminAccess() {\n    try {\n      const currentUserEmail = document.body.dataset.userEmail;\n      const normalizedUserEmail = normalizeEmail(currentUserEmail);\n\n      if (!normalizedUserEmail) {\nwindow.location.href = '/';\n        return false;\n      }\n\n      let hasAccess = false;\n\n      // First check: Environment variable (fastest)\n      const normalizedSuperAdmin = normalizeEmail(envSuperAdminEmail);\n      if (normalizedSuperAdmin && normalizedUserEmail === normalizedSuperAdmin) {\n        hasAccess = true;\n}\n\n      // NOTE: /data/superAdminEmails is DEPRECATED - SuperAdmin is only from .env\nif (!hasAccess) {\nwindow.location.href = '/dashboard/';\n        return false;\n      }\n\n      return true;\n    } catch (error) {\nwindow.location.href = '/dashboard/';\n      return false;\n    }\n  }\n\n  document.addEventListener('astro:page-load', async () => {\n    // Wait for user authentication using auth.currentUser or onAuthStateChanged\n    const waitForUser = () => new Promise((resolve) => {\n      if (auth.currentUser) {\n        document.body.dataset.userEmail = auth.currentUser.email;\n        resolve(auth.currentUser);\n      } else {\n        const unsubscribe = auth.onAuthStateChanged((user) => {\n          unsubscribe();\n          if (user) {\n            document.body.dataset.userEmail = user.email;\n          }\n          resolve(user);\n        });\n        // Timeout after 10 seconds\n        setTimeout(() => {\n          unsubscribe();\n          resolve(null);\n        }, 10000);\n      }\n    });\n\n    const user = await waitForUser();\n    if (!user) {\n      window.location.href = '/';\n      return;\n    }\n\n    const isAllowed = await checkSuperAdminAccess();\n\n    // Only initialize if access is allowed\n    if (isAllowed) {\n      new DevelopmentAnalytics();\n    }\n  });\n</script>\n\n<style is:global>\n  :global(body) {\n    background: var(--bg-secondary, #f5f7fb);\n  }\n\n  .dev-content {\n    margin-top: 1.5rem;\n  }\n\n  .dev-tabs {\n    display: flex;\n    gap: 0.5rem;\n    margin-bottom: 1.5rem;\n    border-bottom: 2px solid var(--border-default, #e1e5ef);\n    padding-bottom: 0;\n  }\n\n  .dev-tab {\n    padding: 0.75rem 1.5rem;\n    border: none;\n    background: transparent;\n    font-size: 1rem;\n    font-weight: 600;\n    color: var(--text-muted, #6b7280);\n    cursor: pointer;\n    border-bottom: 3px solid transparent;\n    margin-bottom: -2px;\n    transition: all 0.2s ease;\n  }\n\n  .dev-tab:hover {\n    color: var(--text-secondary, #374151);\n  }\n\n  .dev-tab.active {\n    color: var(--brand-primary, #2563eb);\n    border-bottom-color: var(--brand-primary, #2563eb);\n  }\n\n  .dev-tab-content {\n    display: none;\n  }\n\n  .dev-tab-content.active {\n    display: block;\n  }\n\n  .dev-dashboard-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: 1.5rem;\n    padding: 2rem 1rem;\n    background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);\n    color: var(--text-on-primary, #fff);\n    border-radius: 18px;\n    margin-bottom: 2rem;\n  }\n\n  .dev-dashboard-header h1 {\n    margin: 0;\n    font-size: 2.5rem;\n  }\n\n  .dev-dashboard-header p {\n    margin: 0.35rem 0 0;\n    color: rgba(255, 255, 255, 0.8);\n  }\n\n  .dev-header-actions {\n    font-weight: 600;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    opacity: 0.8;\n  }\n\n  .dev-controls {\n    display: flex;\n    gap: 1rem;\n    flex-wrap: wrap;\n    padding: 1rem;\n    background: var(--bg-primary, white);\n    border-radius: 12px;\n    border: 1px solid var(--border-default, #e1e5ef);\n    margin-bottom: 1.5rem;\n  }\n\n  .control-group {\n    display: flex;\n    flex-direction: column;\n    min-width: 220px;\n  }\n\n  .control-group label {\n    font-size: 0.85rem;\n    font-weight: 600;\n    margin-bottom: 0.25rem;\n    color: var(--text-secondary, #4a5568);\n  }\n\n  .control-group select {\n    padding: 0.5rem 0.75rem;\n    border-radius: 8px;\n    border: 1px solid var(--border-default, #cbd5f5);\n    font-size: 1rem;\n    background: var(--input-bg, var(--bg-primary, white));\n    color: var(--text-primary, #111827);\n  }\n\n  .ghost {\n    padding: 0.55rem 1.25rem;\n    border-radius: 8px;\n    border: 1px solid var(--border-default, #cbd5f5);\n    color: var(--text-primary, #111827);\n    background: transparent;\n    cursor: pointer;\n    font-weight: 600;\n  }\n\n  .ghost:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n\n  .dev-loading {\n    padding: 2.5rem;\n    text-align: center;\n    border-radius: 12px;\n    border: 1px dashed var(--border-default, #d0d7eb);\n    background: var(--bg-primary, white);\n    color: var(--text-primary, #111827);\n    margin-bottom: 1.5rem;\n    font-weight: 500;\n  }\n\n  .hidden {\n    display: none !important;\n  }\n\n  .summary-cards {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 1rem;\n  }\n\n  .summary-card {\n    background: var(--bg-primary, white);\n    border-radius: 12px;\n    border: 1px solid var(--border-subtle, #e6e9f3);\n    padding: 1.25rem;\n    box-shadow: 0 10px 30px -25px rgba(15, 23, 42, 0.65);\n  }\n\n  .summary-card .card-label {\n    margin: 0;\n    text-transform: uppercase;\n    font-size: 0.75rem;\n    letter-spacing: 0.1em;\n    color: var(--text-muted, #6b7280);\n  }\n\n  .summary-card .card-value {\n    font-size: 2rem;\n    margin: 0.25rem 0 0.15rem;\n    font-weight: 600;\n    color: var(--text-primary, #111827);\n  }\n\n  .summary-card .card-detail {\n    margin: 0;\n    color: var(--text-secondary, #4b5563);\n  }\n\n  .developer-table-container {\n    margin-top: 2rem;\n    background: var(--bg-primary, white);\n    border-radius: 12px;\n    border: 1px solid var(--border-default, #e1e5ef);\n    padding: 1.5rem;\n  }\n\n  .developer-table-header {\n    margin-bottom: 1.5rem;\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    align-items: center;\n  }\n\n  .developer-table-header h2 {\n    margin: 0.15rem 0 0;\n  }\n\n  .dev-highlight-card {\n    background: linear-gradient(120deg, rgba(14,165,233,0.12), rgba(79,70,229,0.12));\n    border: 1px solid rgba(59,130,246,0.3);\n    border-radius: 16px;\n    padding: 0.85rem 1.15rem;\n    min-width: 240px;\n  }\n\n  .dev-highlight-card .highlight-label {\n    margin: 0;\n    text-transform: uppercase;\n    font-size: 0.7rem;\n    letter-spacing: 0.12em;\n    color: var(--brand-primary, #2563eb);\n  }\n\n  .dev-highlight-card .highlight-name {\n    margin: 0.25rem 0 0;\n    font-size: 1.1rem;\n    font-weight: 600;\n  }\n\n  .dev-highlight-card .highlight-metrics {\n    margin: 0.15rem 0 0;\n    color: var(--text-secondary, #4b5563);\n    font-size: 0.9rem;\n  }\n\n  .developer-table-wrapper {\n    overflow-x: auto;\n  }\n\n  table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  .developer-summary-table {\n    border-radius: 18px;\n    overflow: hidden;\n    border: 1px solid var(--border-subtle, #e5e7f3);\n    box-shadow: var(--shadow-lg, 0 15px 40px -35px rgba(15,23,42,0.7));\n    min-width: 900px;\n  }\n\n  thead th {\n    text-align: left;\n    padding: 1rem;\n    background: var(--table-header-bg, linear-gradient(120deg, #eef2ff, #fdf2ff));\n    font-size: 0.9rem;\n    color: var(--text-secondary, #4a5568);\n    border-bottom: 1px solid var(--border-subtle, #dee5fb);\n  }\n\n  tbody td {\n    padding: 1rem;\n    border-bottom: 1px solid var(--border-subtle, #f0f4ff);\n    font-size: 0.95rem;\n    color: var(--text-primary, #111827);\n  }\n\n  tbody tr:nth-child(even) {\n    background: var(--bg-tertiary, #fbfcff);\n  }\n\n  tbody tr:hover {\n    background: var(--hover-overlay, rgba(99, 102, 241, 0.08));\n  }\n\n  .project-breakdown {\n    margin-top: 2rem;\n  }\n\n  .project-card-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n    gap: 1.25rem;\n  }\n\n  .project-card {\n    background: var(--card-bg, linear-gradient(145deg, rgba(255,255,255,0.95), rgba(245,247,255,0.9)));\n    border-radius: 20px;\n    border: 1px solid var(--border-subtle, rgba(147, 155, 183, 0.2));\n    padding: 1.75rem;\n    box-shadow: var(--shadow-lg, 0 35px 65px -45px rgba(15, 23, 42, 0.8));\n  }\n\n  .project-card header h3 {\n    margin: 0 0 0.35rem;\n  }\n\n  .project-card header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 1rem;\n    border-bottom: 1px solid rgba(148, 163, 184, 0.25);\n    padding-bottom: 0.75rem;\n  }\n\n  .project-card header p {\n    margin: 0;\n    color: var(--text-secondary, #4a5568);\n  }\n\n  .project-chip {\n    padding: 0.3rem 0.75rem;\n    border-radius: 999px;\n    font-weight: 600;\n    letter-spacing: 0.05em;\n    font-size: 0.85rem;\n    color: var(--text-primary, #1d3557);\n    background: var(--hover-overlay, rgba(29, 53, 87, 0.08));\n  }\n\n  .project-stat-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n    gap: 0.75rem;\n    margin: 1rem 0 1.5rem;\n  }\n\n  .project-stat {\n    background: rgba(22, 82, 240, 0.07);\n    border-radius: 14px;\n    padding: 0.85rem 1rem;\n    border: 1px solid rgba(22, 82, 240, 0.15);\n    backdrop-filter: blur(12px);\n  }\n\n  .project-stat .stat-label {\n    display: block;\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--text-muted, #5c6b8a);\n    margin-bottom: 0.25rem;\n  }\n\n  .project-stat .stat-value {\n    font-size: 1.45rem;\n    color: var(--text-primary, #1f2937);\n  }\n\n  .project-progress {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 1rem;\n    margin-bottom: 1.2rem;\n  }\n\n  .progress-block {\n    background: rgba(15, 23, 42, 0.035);\n    border-radius: 12px;\n    padding: 0.75rem 1rem;\n    border: 1px dashed rgba(99, 102, 241, 0.3);\n  }\n\n  .progress-label {\n    font-size: 0.8rem;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--text-muted, #6b7280);\n    margin-bottom: 0.4rem;\n  }\n\n  .progress-track {\n    height: 8px;\n    border-radius: 999px;\n    background: var(--progress-track-bg, rgba(229, 231, 235, 0.9));\n    overflow: hidden;\n    margin-bottom: 0.35rem;\n  }\n\n  .progress-fill {\n    height: 100%;\n    border-radius: 999px;\n    transition: width 0.4s ease;\n  }\n\n  .progress-fill.completed {\n    background: linear-gradient(135deg, #22d3ee, #6366f1);\n  }\n\n  .progress-fill.bugs {\n    background: linear-gradient(135deg, #f97316, #ef4444);\n  }\n\n  .progress-values {\n    font-size: 0.85rem;\n    color: var(--text-primary, #1f2937);\n  }\n\n  .top-devs ul {\n    margin: 0.5rem 0 0;\n    padding-left: 0;\n  }\n\n  .top-devs ul li {\n    margin-bottom: 0.35rem;\n    list-style: none;\n    padding: 0.55rem 0.85rem;\n    border-radius: 12px;\n    background: rgba(15, 23, 42, 0.04);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n    align-items: center;\n  }\n\n  .top-devs ul li .dev-name {\n    font-weight: 600;\n    color: var(--text-primary, #111827);\n  }\n\n  .top-devs ul li .dev-metric {\n    font-size: 0.9rem;\n    color: var(--text-secondary, #4b5563);\n  }\n\n  .dev-empty-item {\n    opacity: 0.7;\n  }\n\n  .dev-empty {\n    padding: 2rem;\n    text-align: center;\n    color: var(--text-muted, #6b7280);\n  }\n\n  @media (max-width: 768px) {\n    .dev-controls {\n      flex-direction: column;\n    }\n    .control-group {\n      width: 100%;\n    }\n  }\n</style>\n\n</div>\n","numLines":1309,"startLine":100,"totalLines":1408}}} (stream=stdout)
