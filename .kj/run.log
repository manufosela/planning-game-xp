div>\n    </section>\n  </div>\n  <div id=\"proposalsTabContent\" class=\"tabcontent\">\n    <section class=\"subheader\">\n      <h3>Proposals</h3>\n      <div class=\"view-buttons\">\n        <button id=\"proposalsTableViewBtn\" class=\"view-button active\">Table View</button>\n        <button id=\"proposalsListViewBtn\" class=\"view-button\">Cards View</button>\n        <button id=\"importProposalsBtn\" class=\"import-backlog-btn\" style=\"display: none;\">\n          Importar de <span id=\"importProposalsYear\"></span> (<span id=\"importProposalsCount\">0</span>)\n        </button>\n        <button id=\"addProposalCard\" class=\"add-button\">+ New Proposal</button>\n      </div>\n    </section>\n    <section class=\"cards-container\" id=\"proposalsCardsList\" style=\"display:none\"></section>\n    <section class=\"table-view\" id=\"proposalsTableView\"></section>\n  </div>\n  <div id=\"qaTabContent\" class=\"tabcontent\">\n    <section class=\"subheader\">\n      <h3>QA Cards</h3>\n      <button id=\"addQACard\" class=\"add-button\">+ New QA</button>\n    </section>\n    <section class=\"cards-container\" id=\"qaCardsList\"></section>\n  </div>\n  <div id=\"adrsTabContent\" class=\"tabcontent\">\n    <adr-list id=\"adrList\"></adr-list>\n  </div>\n  <div id=\"devPlansTabContent\" class=\"tabcontent\">\n    <dev-plans-section id=\"devPlansSection\"></dev-plans-section>\n  </div>\n  <div id=\"usersTabContent\" class=\"tabcontent\">\n    <entity-directory-manager id=\"entityDirectoryManager\"></entity-directory-manager>\n  </div>\n  <div id=\"appTabContent\" class=\"tabcontent\">\n    <section class=\"subheader\">\n      <h3>Aplicaciones del Proyecto</h3>\n    </section>\n    <app-manager id=\"appManager\"></app-manager>\n  </div>\n  <div id=\"trashTabContent\" class=\"tabcontent\">\n    <section class=\"subheader\">\n      <h3>Trash</h3>\n      <p class=\"subheader-hint\">Cards eliminadas del proyecto. Solo visible para administradores.</p>\n    </section>\n    <section id=\"trashCardsList\" class=\"trash-list\">\n      <p class=\"loading-message\">Cargando...</p>\n    </section>\n  </div>\n\n<style>\n  .no-project-message {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 50vh;\n    text-align: center;\n  }\n  .no-project-content {\n    background: var(--bg-secondary);\n    padding: 3rem;\n    border-radius: 12px;\n    box-shadow: var(--shadow-md);\n  }\n  .no-project-content h2 {\n    margin: 0 0 1rem 0;\n    color: var(--text-primary);\n  }\n  .no-project-content p {\n    margin: 0;\n    color: var(--text-muted);\n  }\n  /* Hide tabs and content when no project */\n  body.no-project-selected .header-tabs,\n  body.no-project-selected .tabcontent,\n  body.no-project-selected #yearSelector {\n    display: none !important;\n  }\n\n  .cleanview-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    padding: 6px 12px;\n    border-radius: 6px;\n    font-size: 13px;\n    font-weight: 500;\n    text-decoration: none;\n    color: var(--brand-primary, #6366f1);\n    background: var(--bg-secondary, #f1f5f9);\n    border: 1px solid var(--border-default, #e2e8f0);\n    transition: background 0.2s, border-color 0.2s;\n    white-space: nowrap;\n  }\n\n  .cleanview-link:hover {\n    background: var(--brand-primary, #6366f1);\n    color: var(--text-on-primary, #fff);\n    border-color: var(--brand-primary, #6366f1);\n  }\n\n  .trash-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.9rem;\n  }\n  .trash-table th,\n  .trash-table td {\n    padding: 0.5rem 0.75rem;\n    border-bottom: 1px solid var(--border-default);\n    text-align: left;\n  }\n  .trash-table th {\n    background: var(--bg-secondary);\n    font-weight: 600;\n    color: var(--text-secondary);\n  }\n  .trash-table tr:hover {\n    background: var(--bg-tertiary);\n  }\n  .moved-badge {\n    display: inline-block;\n    font-size: 0.75rem;\n    padding: 0.1rem 0.4rem;\n    border-radius: