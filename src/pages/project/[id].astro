---
/**
 * Project detail page — full view system with tabs, filters, and multiple views.
 * Param: id (project ID from URL).
 */
import App from '../../layouts/App.astro';

export function getStaticPaths() {
  return [{ params: { id: '_' } }];
}

const { id } = Astro.params;
---

<App title={`${id} — Planning Game`}>
  <!-- Project header -->
  <div class="project-header" id="project-header">
    <div class="project-header-left">
      <a href="/projects" class="back-link" aria-label="Back to projects">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </a>
      <div class="project-title-group">
        <h1 id="project-name">{id}</h1>
        <span class="project-abbr" id="project-abbr"></span>
      </div>
    </div>
    <div class="project-header-right">
      <pg-year id="year-selector"></pg-year>
      <pg-view-switcher id="view-switcher"></pg-view-switcher>
      <div class="header-tabs">
        <button class="tab-btn active" data-tab="cards" id="tab-cards">Cards</button>
        <button class="tab-btn" data-tab="team" id="tab-team">Team</button>
      </div>
    </div>
  </div>

  <!-- Cards tab -->
  <div id="cards-tab">
    <!-- Type tabs -->
    <pg-tabs id="type-tabs"></pg-tabs>

    <!-- Filters -->
    <pg-filters id="card-filters"></pg-filters>

    <!-- View container -->
    <div class="view-container" id="view-container">
      <!-- table view -->
      <pg-table id="view-table" hidden></pg-table>
      <!-- kanban view -->
      <pg-board id="view-kanban" mode="status" hidden></pg-board>
      <!-- sprint view -->
      <pg-board id="view-sprint" mode="sprint" hidden></pg-board>
      <!-- gantt view -->
      <pg-gantt id="view-gantt" hidden></pg-gantt>
      <!-- list view -->
      <div class="card-grid" id="view-list" hidden></div>
    </div>

    <!-- Empty state -->
    <div class="empty-state" id="empty-cards" hidden>
      <div class="empty-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
        </svg>
      </div>
      <h2>No cards yet</h2>
      <p>Create your first card to start tracking work.</p>
    </div>

    <!-- FAB -->
    <button class="fab" id="create-card-btn" aria-label="Create new card">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </button>
  </div>

  <!-- Team tab -->
  <div id="team-tab" hidden>
    <pg-team id="team-manager"></pg-team>
  </div>

  <!-- Card panel (right-side slide) -->
  <pg-card-panel id="card-panel"></pg-card-panel>

  <script type="module" define:vars={{ id }}>
    import '../../components/pg-card.js';
    import '../../components/pg-card-panel.js';
    import '../../components/pg-badge.js';
    import '../../components/pg-team.js';
    import '../../components/pg-toast.js';
    import '../../components/pg-tabs.js';
    import '../../components/pg-view-switcher.js';
    import '../../components/pg-year.js';
    import '../../components/pg-filters.js';
    import '../../components/pg-table.js';
    import '../../components/pg-board.js';
    import '../../components/pg-gantt.js';
    import '../../components/pg-select.js';
    import {
      getProject, getCards, getTeam, getTagRegistry,
      addTeamMember, removeTeamMember, updateCard,
    } from '../../lib/firestore.js';
    import {
      currentProject, cards as cardsSignal, currentCard, panelOpen,
      filters as filtersSignal, filteredCards, setFilters, authUser,
    } from '../../lib/store.js';
    import { PgToast } from '../../components/pg-toast.js';

    const projectId = id === '_'
      ? window.location.pathname.split('/project/')[1]?.split('/')[0]
      : id;

    // Elements
    const panelEl = document.getElementById('card-panel');
    const teamEl = document.getElementById('team-manager');
    const emptyEl = document.getElementById('empty-cards');
    const typeTabs = document.getElementById('type-tabs');
    const filtersEl = document.getElementById('card-filters');
    const viewSwitcher = document.getElementById('view-switcher');
    const yearSelector = document.getElementById('year-selector');

    // View elements
    const viewTable = document.getElementById('view-table');
    const viewKanban = document.getElementById('view-kanban');
    const viewSprint = document.getElementById('view-sprint');
    const viewGantt = document.getElementById('view-gantt');
    const viewList = document.getElementById('view-list');

    let tagRegistry = [];
    let allCards = [];
    let team = [];
    let currentView = viewSwitcher.current || 'table';

    // -----------------------------------------------------------------------
    // Data loading
    // -----------------------------------------------------------------------

    async function loadProject() {
      try {
        const project = await getProject(projectId);
        if (!project) {
          PgToast.show('Project not found', 'error');
          window.location.href = '/projects';
          return;
        }
        currentProject.value = project;
        document.getElementById('project-name').textContent = project.name;
        document.getElementById('project-abbr').textContent = project.abbreviation;
        document.title = `${project.name} — Planning Game`;
      } catch (err) {
        console.error('Failed to load project:', err);
        PgToast.show('Failed to load project', 'error');
      }
    }

    async function loadCards() {
      try {
        allCards = await getCards(projectId);
        cardsSignal.value = allCards;
        updateTypeTabs();
        updateFilterOptions();
        renderCurrentView();
      } catch (err) {
        console.error('Failed to load cards:', err);
      }
    }

    async function loadTags() {
      try {
        tagRegistry = await getTagRegistry(projectId);
      } catch (err) {
        console.error('Failed to load tags:', err);
      }
    }

    async function loadTeam() {
      try {
        team = await getTeam(projectId);
        teamEl.members = team;
        teamEl.projectId = projectId;
        updateFilterOptions();
      } catch (err) {
        console.error('Failed to load team:', err);
      }
    }

    // -----------------------------------------------------------------------
    // Type tabs
    // -----------------------------------------------------------------------

    function updateTypeTabs() {
      const cards = allCards;
      const counts = { task: 0, bug: 0, epic: 0, sprint: 0, proposal: 0, qa: 0 };
      for (const c of cards) {
        if (counts[c.type] != null) counts[c.type]++;
      }

      typeTabs.tabs = [
        { id: 'all', label: 'All', count: cards.length },
        { id: 'task', label: 'Tasks', count: counts.task, color: 'var(--color-type-task)' },
        { id: 'bug', label: 'Bugs', count: counts.bug, color: 'var(--color-type-bug)' },
        { id: 'sprint', label: 'Sprints', count: counts.sprint, color: 'var(--color-type-sprint)' },
        { id: 'epic', label: 'Epics', count: counts.epic, color: 'var(--color-type-epic)' },
        { id: 'proposal', label: 'Proposals', count: counts.proposal, color: 'var(--color-type-proposal)' },
        { id: 'qa', label: 'QA', count: counts.qa, color: 'var(--color-type-qa)' },
      ];
      typeTabs.active = filtersSignal.get().type ?? 'all';
    }

    // -----------------------------------------------------------------------
    // Filter options
    // -----------------------------------------------------------------------

    function updateFilterOptions() {
      const devs = team
        .filter((m) => m.role === 'developer' || m.role === 'both')
        .map((m) => ({ id: m.id, name: m.name }));
      filtersEl.developers = devs;

      const sprints = allCards
        .filter((c) => c.type === 'sprint')
        .map((c) => ({ cardId: c.cardId, title: c.title }));
      filtersEl.sprints = sprints;

      const epics = allCards
        .filter((c) => c.type === 'epic')
        .map((c) => ({ cardId: c.cardId, title: c.title }));
      filtersEl.epics = epics;

      filtersEl.tags = tagRegistry;
    }

    // -----------------------------------------------------------------------
    // View rendering
    // -----------------------------------------------------------------------

    function getFilteredCards() {
      return filteredCards.get();
    }

    function renderCurrentView() {
      const cards = getFilteredCards();
      const hasCards = cards.length > 0;

      // Hide all views
      viewTable.hidden = true;
      viewKanban.hidden = true;
      viewSprint.hidden = true;
      viewGantt.hidden = true;
      viewList.hidden = true;
      emptyEl.hidden = hasCards;

      if (!hasCards) return;

      switch (currentView) {
        case 'table':
          viewTable.hidden = false;
          viewTable.cards = cards;
          viewTable.tagRegistry = tagRegistry;
          break;

        case 'kanban':
          viewKanban.hidden = false;
          viewKanban.cards = cards;
          viewKanban.tagRegistry = tagRegistry;
          break;

        case 'sprint': {
          viewSprint.hidden = false;
          viewSprint.cards = cards;
          viewSprint.tagRegistry = tagRegistry;
          viewSprint.sprints = allCards.filter((c) => c.type === 'sprint');
          break;
        }

        case 'gantt':
          viewGantt.hidden = false;
          viewGantt.cards = cards;
          break;

        case 'list':
          viewList.hidden = false;
          renderListView(cards);
          break;
      }
    }

    function renderListView(cards) {
      viewList.innerHTML = '';
      for (const card of cards) {
        const el = document.createElement('pg-card');
        el.card = card;
        el.mode = 'preview';
        el.tagRegistry = tagRegistry;
        el.addEventListener('card-click', (e) => openPanel(e.detail.card));
        viewList.append(el);
      }
    }

    function openPanel(card) {
      panelEl.card = card;
      panelEl.open = true;
      panelEl.tagRegistry = tagRegistry;
      currentCard.value = card;
      panelOpen.value = true;
    }

    // -----------------------------------------------------------------------
    // Event handlers
    // -----------------------------------------------------------------------

    // Type tabs
    typeTabs.addEventListener('tab-change', (e) => {
      const type = e.detail.tab;
      setFilters({ type: type === 'all' ? 'all' : type });
      renderCurrentView();
    });

    // View switcher
    viewSwitcher.addEventListener('view-change', (e) => {
      currentView = e.detail.view;
      renderCurrentView();
    });

    // Year selector
    yearSelector.addEventListener('year-change', (e) => {
      setFilters({ year: e.detail.year });
      renderCurrentView();
    });

    // Filters
    filtersEl.addEventListener('filters-change', () => {
      renderCurrentView();
    });

    // Card select from table/board/gantt
    document.addEventListener('card-select', (e) => {
      openPanel(e.detail.card);
    });

    // Card move (drag-drop on board)
    document.addEventListener('card-move', async (e) => {
      const { cardId, field, value } = e.detail;
      try {
        const user = authUser.get();
        const changedBy = {
          uid: user?.email ?? 'anonymous',
          name: user?.name ?? 'Anonymous',
        };
        await updateCard(projectId, cardId, { [field]: value }, changedBy);
        PgToast.show(`Card moved to ${value || 'Backlog'}`, 'success');
        await loadCards();
      } catch (err) {
        console.error('Failed to move card:', err);
        PgToast.show('Failed to move card', 'error');
      }
    });

    // Main tab switching (Cards / Team)
    document.getElementById('tab-cards').addEventListener('click', () => {
      document.getElementById('cards-tab').hidden = false;
      document.getElementById('team-tab').hidden = true;
      document.getElementById('tab-cards').classList.add('active');
      document.getElementById('tab-team').classList.remove('active');
    });

    document.getElementById('tab-team').addEventListener('click', () => {
      document.getElementById('cards-tab').hidden = true;
      document.getElementById('team-tab').hidden = false;
      document.getElementById('tab-cards').classList.remove('active');
      document.getElementById('tab-team').classList.add('active');
      loadTeam();
    });

    // Panel events
    panelEl.addEventListener('panel-close', () => {
      panelOpen.value = false;
      currentCard.value = null;
    });

    panelEl.addEventListener('panel-delete', async (e) => {
      const { PgModal } = await import('../../components/pg-modal.js');
      const confirmed = await PgModal.confirm({
        title: 'Delete card',
        message: `Delete ${e.detail.card.cardId}? This will move it to trash.`,
        confirmText: 'Delete',
        variant: 'danger',
      });
      if (confirmed) {
        try {
          const { deleteCard } = await import('../../lib/firestore.js');
          await deleteCard(projectId, e.detail.card.cardId);
          PgToast.show('Card deleted', 'success');
          panelEl.open = false;
          await loadCards();
        } catch (err) {
          console.error('Failed to delete card:', err);
          PgToast.show('Failed to delete card', 'error');
        }
      }
    });

    // Team events
    teamEl.addEventListener('team-add', async (e) => {
      try {
        await addTeamMember(projectId, e.detail.member);
        PgToast.show('Member added', 'success');
        await loadTeam();
      } catch (err) {
        console.error('Failed to add member:', err);
        PgToast.show('Failed to add member', 'error');
      }
    });

    teamEl.addEventListener('team-remove', async (e) => {
      try {
        await removeTeamMember(projectId, e.detail.memberId);
        PgToast.show('Member removed', 'success');
        await loadTeam();
      } catch (err) {
        console.error('Failed to remove member:', err);
        PgToast.show('Failed to remove member', 'error');
      }
    });

    // -----------------------------------------------------------------------
    // Initialize
    // -----------------------------------------------------------------------

    // Set initial year from selector
    setFilters({ year: yearSelector.value });

    // Show initial view
    currentView = viewSwitcher.current || 'table';

    Promise.all([loadProject(), loadTags(), loadTeam()]).then(() => loadCards());
  </script>

  <style>
    /* Project header */
    .project-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-lg, 1rem);
      gap: var(--space-md);
    }

    .project-header-left {
      display: flex;
      align-items: center;
      gap: var(--space-sm, 0.5rem);
    }

    .project-header-right {
      display: flex;
      align-items: center;
      gap: var(--space-md, 0.75rem);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: var(--radius-md, 0.5rem);
      color: var(--color-text-secondary, #64748b);
      text-decoration: none;
      transition: background var(--transition-fast, 150ms ease);
    }

    .back-link:hover {
      background: var(--color-surface-sunken, #f1f5f9);
      text-decoration: none;
    }

    .back-link svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .project-title-group {
      display: flex;
      align-items: center;
      gap: var(--space-sm, 0.5rem);
    }

    .project-title-group h1 {
      font-size: 1.5rem;
      font-weight: var(--font-weight-bold, 700);
      letter-spacing: var(--tracking-tight, -0.01em);
    }

    .project-abbr {
      font-size: 0.6875rem;
      font-weight: var(--font-weight-medium, 500);
      padding: var(--space-2xs, 0.125rem) var(--space-sm, 0.5rem);
      border-radius: var(--radius-full, 9999px);
      background: var(--color-primary-subtle, #eef2ff);
      color: var(--color-primary, #4f46e5);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide, 0.025em);
    }

    /* Header tabs */
    .header-tabs {
      display: flex;
      gap: 0;
      background: var(--color-surface-sunken, #f1f5f9);
      border-radius: var(--radius-md, 0.5rem);
      padding: var(--space-2xs, 0.125rem);
    }

    .tab-btn {
      padding: var(--space-xs, 0.25rem) var(--space-lg, 1rem);
      font-size: 0.8125rem;
      font-weight: var(--font-weight-medium, 500);
      color: var(--color-text-secondary, #64748b);
      background: transparent;
      border: none;
      border-radius: var(--radius-sm, 0.25rem);
      cursor: pointer;
      transition: background var(--transition-fast), color var(--transition-fast);
    }

    .tab-btn:hover {
      color: var(--color-text, #0f172a);
    }

    .tab-btn.active {
      background: var(--color-surface-raised, #fff);
      color: var(--color-text, #0f172a);
      box-shadow: var(--shadow-sm);
    }

    /* View container */
    .view-container {
      margin-top: var(--space-sm, 0.5rem);
    }

    /* Card grid (list view) */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
      gap: var(--space-md, 0.75rem);
    }

    /* Empty state */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: var(--space-4xl, 4rem) var(--space-lg, 1rem);
      text-align: center;
    }

    .empty-icon {
      width: 3rem;
      height: 3rem;
      color: var(--color-text-muted, #94a3b8);
      margin-bottom: var(--space-lg, 1rem);
    }

    .empty-icon svg {
      width: 100%;
      height: 100%;
    }

    .empty-state h2 {
      font-size: 1.125rem;
      font-weight: var(--font-weight-semibold, 600);
      color: var(--color-text, #0f172a);
      margin-bottom: var(--space-xs, 0.25rem);
    }

    .empty-state p {
      font-size: 0.875rem;
      color: var(--color-text-muted, #94a3b8);
    }

    /* FAB */
    .fab {
      position: fixed;
      bottom: var(--space-xl, 1.5rem);
      right: var(--space-xl, 1.5rem);
      width: 3rem;
      height: 3rem;
      border-radius: var(--radius-full, 9999px);
      background: var(--color-primary, #4f46e5);
      color: var(--color-primary-text, #fff);
      border: none;
      box-shadow: var(--shadow-lg);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--transition-fast), box-shadow var(--transition-fast);
      z-index: var(--z-sticky, 200);
    }

    .fab:hover {
      background: var(--color-primary-hover, #4338ca);
      box-shadow: var(--shadow-xl);
    }

    .fab svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    @media (max-width: 640px) {
      .project-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .project-header-right {
        flex-wrap: wrap;
        width: 100%;
      }

      .card-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</App>
