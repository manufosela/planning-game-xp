---
/**
 * Dashboard page — multi-project metrics and charts.
 */
import App from '../layouts/App.astro';
---

<App title="Dashboard — Planning Game">
  <div class="page-header">
    <h1>Dashboard</h1>
  </div>

  <pg-dashboard id="dashboard"></pg-dashboard>

  <script type="module">
    import '../components/pg-dashboard.js';
    import '../components/pg-chart.js';
    import '../components/pg-select.js';
    import '../components/pg-toast.js';
    import { getProjects, getCards } from '../lib/firestore.js';
    import { PgToast } from '../components/pg-toast.js';

    const dashboardEl = document.getElementById('dashboard');
    const currentYear = new Date().getFullYear();

    async function loadDashboard() {
      try {
        const projects = await getProjects();
        const activeProjects = projects.filter((p) => !p.archived);
        dashboardEl.projects = activeProjects;
        dashboardEl.selectedYear = currentYear;

        // Load cards from all active projects
        const allCards = [];
        for (const project of activeProjects) {
          try {
            const cards = await getCards(project.id);
            allCards.push(...cards);
          } catch (err) {
            console.error(`Failed to load cards for ${project.name}:`, err);
          }
        }
        dashboardEl.cards = allCards;
      } catch (err) {
        console.error('Failed to load dashboard:', err);
        PgToast.show('Failed to load dashboard data', 'error');
      }
    }

    loadDashboard();
  </script>

  <style>
    .page-header {
      margin-bottom: var(--space-xl, 1.5rem);
    }

    .page-header h1 {
      font-size: 1.5rem;
      font-weight: var(--font-weight-bold, 700);
      letter-spacing: var(--tracking-tight, -0.01em);
    }
  </style>
</App>
