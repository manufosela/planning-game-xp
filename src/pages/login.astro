---
/**
 * Login page — standalone layout (no App wrapper).
 * Shows Google and Microsoft sign-in buttons.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Sign in — Planning Game</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('pg-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="login-page">
      <div class="login-card">
        <div class="logo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
        </div>

        <h1>Planning Game</h1>
        <p class="subtitle">Agile project management for XP teams</p>

        <div class="buttons">
          <button id="btn-google" class="btn btn-google">
            <svg viewBox="0 0 24 24" width="20" height="20">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Sign in with Google
          </button>

          <button id="btn-microsoft" class="btn btn-microsoft">
            <svg viewBox="0 0 24 24" width="20" height="20">
              <rect x="1" y="1" width="10" height="10" fill="#f25022"/>
              <rect x="13" y="1" width="10" height="10" fill="#7fba00"/>
              <rect x="1" y="13" width="10" height="10" fill="#00a4ef"/>
              <rect x="13" y="13" width="10" height="10" fill="#ffb900"/>
            </svg>
            Sign in with Microsoft
          </button>
        </div>

        <p class="error" id="error-msg" hidden></p>
      </div>

      <pg-theme-toggle class="theme-toggle"></pg-theme-toggle>
    </div>

    <script>
      import '../components/pg-theme-toggle.js';
      import '../components/pg-toast.js';
      import { signInWithGoogle, signInWithMicrosoft, onAuthStateChange } from '../lib/auth.js';

      // If already signed in, redirect
      onAuthStateChange((user) => {
        if (user) {
          window.location.href = '/projects';
        }
      });

      const errorMsg = /** @type {HTMLElement} */ (document.getElementById('error-msg'));

      document.getElementById('btn-google')?.addEventListener('click', async () => {
        try {
          await signInWithGoogle();
          window.location.href = '/projects';
        } catch (err) {
          errorMsg.textContent = /** @type {Error} */ (err).message;
          errorMsg.hidden = false;
        }
      });

      document.getElementById('btn-microsoft')?.addEventListener('click', async () => {
        try {
          await signInWithMicrosoft();
          window.location.href = '/projects';
        } catch (err) {
          errorMsg.textContent = /** @type {Error} */ (err).message;
          errorMsg.hidden = false;
        }
      });
    </script>

    <style>
      @import '../styles/base.css';

      .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100dvh;
        padding: var(--space-lg, 1rem);
        position: relative;
      }

      .login-card {
        width: 100%;
        max-width: 22rem;
        text-align: center;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: var(--radius-lg, 0.75rem);
        background: var(--color-primary-subtle, #eef2ff);
        color: var(--color-primary, #4f46e5);
        margin-bottom: var(--space-lg, 1rem);
      }

      .logo svg {
        width: 1.75rem;
        height: 1.75rem;
      }

      h1 {
        font-size: 1.5rem;
        font-weight: var(--font-weight-bold, 700);
        letter-spacing: var(--tracking-tight, -0.01em);
        color: var(--color-text, #0f172a);
        margin-bottom: var(--space-xs, 0.25rem);
      }

      .subtitle {
        font-size: 0.875rem;
        color: var(--color-text-muted, #94a3b8);
        margin-bottom: var(--space-2xl, 2rem);
      }

      .buttons {
        display: flex;
        flex-direction: column;
        gap: var(--space-md, 0.75rem);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-sm, 0.5rem);
        width: 100%;
        padding: var(--space-md, 0.75rem) var(--space-lg, 1rem);
        border-radius: var(--radius-md, 0.5rem);
        border: 1px solid var(--color-border, #e2e8f0);
        background: var(--color-surface-raised, #fff);
        font-size: 0.875rem;
        font-weight: var(--font-weight-medium, 500);
        color: var(--color-text, #0f172a);
        cursor: pointer;
        transition: background var(--transition-fast, 150ms ease),
                    border-color var(--transition-fast, 150ms ease),
                    box-shadow var(--transition-fast, 150ms ease);
      }

      .btn:hover {
        background: var(--color-surface-sunken, #f1f5f9);
        border-color: var(--color-border-strong, #cbd5e1);
        box-shadow: var(--shadow-sm);
      }

      .btn:active {
        transform: translateY(1px);
      }

      .error {
        margin-top: var(--space-lg, 1rem);
        padding: var(--space-sm, 0.5rem) var(--space-md, 0.75rem);
        border-radius: var(--radius-md, 0.5rem);
        background: var(--color-error-subtle, #fef2f2);
        color: var(--color-error, #dc2626);
        font-size: 0.8125rem;
      }

      .theme-toggle {
        position: fixed;
        bottom: var(--space-lg, 1rem);
        right: var(--space-lg, 1rem);
      }
    </style>
  </body>
</html>
