<div data-main>
  <div class="page-header">
    <h1>Global Configuration</h1>
    <p class="subtitle">Manage global agents, prompts, and instructions that can be assigned to projects</p>
  </div>

  <global-config-list id="globalConfigList"></global-config-list>


<script type="module">
  import '/js/wc/GlobalConfigList.js';
  import { onPageEnter, registerCleanup } from '/js/utils/page-lifecycle.js';

  onPageEnter(() => {
    const el = document.getElementById('globalConfigList');
    if (!el) return;

    const onSaved = (e) => {
      document.dispatchEvent(new CustomEvent('show-slide-notification', {
        detail: { options: { message: `${e.detail.name} saved successfully`, type: 'success' } }
      }));
    };

    const onDeleted = (e) => {
      document.dispatchEvent(new CustomEvent('show-slide-notification', {
        detail: { options: { message: `${e.detail.name} deleted`, type: 'info' } }
      }));
    };

    const onCreated = () => {
      document.dispatchEvent(new CustomEvent('show-slide-notification', {
        detail: { options: { message: `New config created`, type: 'success' } }
      }));
    };

    el.addEventListener('config-saved', onSaved);
    el.addEventListener('config-deleted', onDeleted);
    el.addEventListener('config-created', onCreated);

    registerCleanup(() => {
      el.removeEventListener('config-saved', onSaved);
      el.removeEventListener('config-deleted', onDeleted);
      el.removeEventListener('config-created', onCreated);
    });
  });
</script>

<style>
  .page-header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem 0.5rem;
  }

  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary, #333);
    margin: 0 0 0.5rem 0;
  }

  .page-header .subtitle {
    color: var(--text-secondary, #666);
    margin: 0;
    font-size: 0.95rem;
  }
</style>

</div>
