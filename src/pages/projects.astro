---
/**
 * Projects listing page.
 * Uses pg-project component for listing, creating, and managing projects.
 */
import App from '../layouts/App.astro';
---

<App title="Projects — Planning Game">
  <pg-project id="project-list" loading></pg-project>

  <script type="module">
    import '../components/pg-project.js';
    import '../components/pg-toast.js';
    import { getProjects, createProject, updateProject, archiveProject } from '../lib/firestore.js';
    import { projects as projectsSignal } from '../lib/store.js';
    import { getCurrentUser } from '../lib/auth.js';
    import { PgToast } from '../components/pg-toast.js';

    const el = document.getElementById('project-list');

    async function loadProjects() {
      try {
        const list = await getProjects();
        el.projects = list;
        el.loading = false;
        projectsSignal.value = list;
      } catch (err) {
        console.error('Failed to load projects:', err);
        el.loading = false;
        PgToast.show('Failed to load projects', 'error');
      }
    }

    el.addEventListener('project-select', (e) => {
      const { project } = e.detail;
      window.location.href = `/project/${project.id}`;
    });

    el.addEventListener('project-create', async (e) => {
      try {
        const user = getCurrentUser();
        const id = await createProject({
          ...e.detail.data,
          createdBy: user?.uid ?? 'unknown',
        });
        PgToast.show('Project created', 'success');
        await loadProjects();
      } catch (err) {
        console.error('Failed to create project:', err);
        PgToast.show('Failed to create project', 'error');
      }
    });

    el.addEventListener('project-update', async (e) => {
      try {
        await updateProject(e.detail.id, e.detail.data);
        PgToast.show('Project updated', 'success');
        await loadProjects();
      } catch (err) {
        console.error('Failed to update project:', err);
        PgToast.show('Failed to update project', 'error');
      }
    });

    el.addEventListener('project-archive', async (e) => {
      try {
        await archiveProject(e.detail.id);
        PgToast.show('Project archived', 'success');
        await loadProjects();
      } catch (err) {
        console.error('Failed to archive project:', err);
        PgToast.show('Failed to archive project', 'error');
      }
    });

    loadProjects();
  </script>
</App>
