---
// Read version and changelog at build time
import pkg from '../../package.json';
import fs from 'node:fs';
import path from 'node:path';

const version = pkg.version;
const currentYear = new Date().getFullYear();

// Read CHANGELOG.md at build time
let changelogContent = '';
try {
  const changelogPath = path.resolve(process.cwd(), 'CHANGELOG.md');
  changelogContent = fs.readFileSync(changelogPath, 'utf-8');
} catch {
  changelogContent = 'Changelog not available.';
}
---

<footer class="app-footer" transition:persist="shell-footer" transition:animate="none">
  <div class="footer-content">
    <div class="footer-left">
      <span class="copyright">&copy; {currentYear} Planning GameXP</span>
    </div>
    <div class="footer-right">
      <button class="version" id="versionBtn" title="Ver changelog">v{version}</button>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ changelogContent }}>
  document.addEventListener('astro:page-load', () => {
    const versionBtn = document.getElementById('versionBtn');
    if (!versionBtn || versionBtn._footerInit) return;
    versionBtn._footerInit = true;

    let changelogModal = null;

    versionBtn.addEventListener('click', async () => {
      // Close existing changelog modal if open (toggle behavior)
      if (changelogModal) {
        changelogModal.remove();
        changelogModal = null;
        return;
      }

      // Ensure app-modal custom element is registered
      if (!customElements.get('app-modal')) {
        await import('@manufosela/app-modal');
      }

      const { modalService } = await import('/js/services/modal-service.js');

      // Convert markdown to simple HTML
      const htmlContent = changelogContent
        .replace(/^## \[([^\]]+)\](.*)/gm, '<h3 class="changelog-version">$1 <span class="changelog-date">$2</span></h3>')
        .replace(/^### (.+)/gm, '<h4 class="changelog-section">$1</h4>')
        .replace(/^# (.+)/gm, '<h2>$1</h2>')
        .replace(/^- \*\*([^*]+)\*\*: (.+)/gm, '<li><strong>$1</strong>: $2</li>')
        .replace(/^- (.+)/gm, '<li>$1</li>')
        .replace(/(<li>[\s\S]*?<\/li>)/gm, (match) => match)
        .replace(/(<li>[^]*?(?=<h|<li>|$))/g, (match) => match)
        .replace(/\n{2,}/g, '\n');

      // Wrap consecutive <li> in <ul>
      const wrappedHtml = htmlContent.replace(
        /(<li>.*?<\/li>\n?)+/g,
        (match) => `<ul>${match}</ul>`
      );

      const content = `
        <div style="padding: 1.5rem; max-height: 70vh; overflow-y: auto; font-family: system-ui, -apple-system, sans-serif; color: var(--text-primary, #333); text-align: left;">
          <style>
            .changelog-version {
              color: var(--brand-primary, #4a9eff);
              border-bottom: 2px solid var(--border-subtle, #e2e8f0);
              padding-bottom: 0.5rem;
              margin-top: 1.5rem;
            }
            .changelog-version:first-child { margin-top: 0; }
            .changelog-date {
              font-size: 0.8em;
              color: var(--text-muted, #666);
              font-weight: normal;
            }
            .changelog-section {
              color: var(--text-secondary, #555);
              margin: 1rem 0 0.5rem;
            }
            ul {
              margin: 0.25rem 0;
              padding-left: 1.5rem;
              text-align: left;
              list-style-position: outside;
            }
            li {
              margin: 0.3rem 0;
              line-height: 1.5;
              color: var(--text-primary, #333);
              text-align: left;
            }
            li strong {
              color: var(--brand-primary, #4a9eff);
            }
          </style>
          ${wrappedHtml}
        </div>
      `;

      changelogModal = await modalService.createModal({
        title: 'Changelog',
        content,
        maxWidth: '700px',
        maxHeight: '85vh',
        className: 'changelog-modal',
        onClose: () => { changelogModal = null; }
      });
    });
  });
</script>

<style>
  .app-footer {
    display: block;
    background: var(--bg-primary, #ffffff);
    color: var(--text-muted, #64748b);
    padding: 0.25rem 1.5rem;
    text-align: center;
    position: fixed;
    width: 100%;
    bottom: 0;
    z-index: 1000;
    border-top: 1px solid var(--border-subtle, #e2e8f0);
    font-weight: 400;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .version {
    background: var(--bg-secondary, #f1f5f9);
    color: var(--text-muted, #64748b);
    padding: 0.15rem 0.6rem;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.75rem;
    border: 1px solid var(--border-subtle, #e2e8f0);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .version:hover {
    background: var(--brand-primary, #6366f1);
    color: var(--text-on-primary, #ffffff);
    border-color: var(--brand-primary, #6366f1);
  }

  .version:active {
    transform: scale(0.97);
  }

  .copyright {
    color: var(--text-muted, #64748b);
    font-size: 0.75rem;
    font-weight: 400;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }

    .footer-left,
    .footer-right {
      justify-content: center;
    }
  }
</style>
