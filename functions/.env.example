# Cloud Functions Environment Variables
PUBLIC_APP_URL=https://your-app-url.web.app
PUBLIC_ALLOWED_EMAIL_DOMAINS=yourdomain.com,otherdomain.com
PUBLIC_DEFAULT_API_EMAIL=api@yourdomain.com
PUBLIC_SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Email provider: msgraph | smtp | sendgrid | none
EMAIL_PROVIDER=none

# MS Graph
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_FROM_EMAIL=
MS_ALERT_EMAIL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Planning Game XP
