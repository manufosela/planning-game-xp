{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@lib/*": [
        "src/lib/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@styles/*": [
        "src/styles/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.astro",
    "src/**/*.d.ts",
    "tests/**/*.js",
    "astro.config.mjs",
    "vitest.config.js",
    "playwright.config.js"
  ]
}
