# === FIREBASE CONFIGURATION ===
PUBLIC_FIREBASE_API_KEY=your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# === ADMIN ===
PUBLIC_SUPER_ADMIN_EMAIL=admin@your-org.com

# === BRANDING ===
PUBLIC_APP_NAME=Planning Game XP
PUBLIC_APP_URL=https://planning.your-org.com
PUBLIC_BRAND_COLOR=#4a9eff

# === AUTHENTICATION ===
PUBLIC_AUTH_PROVIDER=google
PUBLIC_ALLOWED_EMAIL_DOMAINS=your-org.com,another-domain.com

# === EMULATOR (development only) ===
USE_FIREBASE_EMULATOR=true
