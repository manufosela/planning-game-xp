# === EMAIL PROVIDER ===
# Options: msgraph, smtp, sendgrid, none
EMAIL_PROVIDER=none

# --- Microsoft Graph (if EMAIL_PROVIDER=msgraph) ---
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-secret
MS_TENANT_ID=your-azure-tenant-id
MS_FROM_EMAIL=noreply@your-org.com
MS_ALERT_EMAIL=it-alerts@your-org.com

# --- SMTP (if EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@your-org.com

# --- SendGrid (if EMAIL_PROVIDER=sendgrid) ---
SENDGRID_API_KEY=SG.your-api-key
SENDGRID_FROM_EMAIL=noreply@your-org.com
SENDGRID_FROM_NAME=Planning Game XP
